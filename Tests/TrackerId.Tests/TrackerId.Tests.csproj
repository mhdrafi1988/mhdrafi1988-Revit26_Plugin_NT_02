<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for Tracker ID's Revit-free code (ID planner, grid and zone lookup, status file
    reading and merge, status colours, health check, CSV / Excel export). The tool's Core files are
    linked, not copied. Core has no Revit or WPF dependency, so all of it builds here.
    Run:  dotnet test Tests/TrackerId.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <ToolDir>..\..\Menu\Manage\TrackerId_V002\</ToolDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ToolDir)Core\**\*.cs" Link="Tool\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
