<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for Void Openings' Revit-free code (geometry, clash engine, clearance rules, opening
    calculator, Job IDs). The tool's Core files are linked, not copied. This project references
    neither Revit nor WPF, so a Core file that starts using either fails this build: that is how the
    layer boundary is enforced.
    Run:  dotnet test Tests/VoidOpenings.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <ToolDir>..\..\Menu\Coordination\Openings\VoidOpenings_V001\</ToolDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ToolDir)Core\**\*.cs" Link="Tool\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
