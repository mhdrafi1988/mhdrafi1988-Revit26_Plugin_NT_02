<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for Auto Slope By Point's Revit-free code: the ridge finder, loading older
    settings files and (V034) the run orchestrator with fake Revit steps. They follow the newest
    version, V034 (its Core is V033's). The tool's files are linked, not copied.
    Run:  dotnet test Tests/AutoSlopeByPoint.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <ToolDir>..\..\Menu\RoofTools\RoofSlope\ByPoints\AutoSlopeByPoint_V034\</ToolDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ToolDir)Core\Models\Point3.cs" Link="Tool\Models\Point3.cs" />
    <Compile Include="$(ToolDir)Core\Models\RunEnums.cs" Link="Tool\Models\RunEnums.cs" />
    <Compile Include="$(ToolDir)Core\Models\AutoSlopeConstants.cs" Link="Tool\Models\AutoSlopeConstants.cs" />
    <Compile Include="$(ToolDir)Core\Models\AutoSlopeSettings.cs" Link="Tool\Models\AutoSlopeSettings.cs" />
    <Compile Include="$(ToolDir)Core\Services\SpatialGrid2D.cs" Link="Tool\Services\SpatialGrid2D.cs" />
    <Compile Include="$(ToolDir)Core\Services\ShortestPathSolver.cs" Link="Tool\Services\ShortestPathSolver.cs" />
    <Compile Include="$(ToolDir)Core\Services\RidgeFinder.cs" Link="Tool\Services\RidgeFinder.cs" />
    <Compile Include="$(ToolDir)Infrastructure\Helpers\AutoSlopeSettingsStore.cs" Link="Tool\Helpers\AutoSlopeSettingsStore.cs" />
    <Compile Include="$(ToolDir)Core\Models\AutoSlopeRequest.cs" Link="Tool\Models\AutoSlopeRequest.cs" />
    <Compile Include="$(ToolDir)Core\Models\AutoSlopeResult.cs" Link="Tool\Models\AutoSlopeResult.cs" />
    <Compile Include="$(ToolDir)Core\Models\VertexData.cs" Link="Tool\Models\VertexData.cs" />
    <Compile Include="$(ToolDir)Core\Models\RunOutcomes.cs" Link="Tool\Models\RunOutcomes.cs" />
    <Compile Include="$(ToolDir)Core\Models\RunProgressInfo.cs" Link="Tool\Models\RunProgressInfo.cs" />
    <Compile Include="$(ToolDir)Core\Services\RunPhases.cs" Link="Tool\Services\RunPhases.cs" />
    <Compile Include="$(ToolDir)Application\**\*.cs" Link="Tool\Application\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Shared\LogLevel.cs" Link="Shared\LogLevel.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
