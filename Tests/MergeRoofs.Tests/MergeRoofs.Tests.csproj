<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for Merge Roofs V001's Revit-free Core (footprint union, analysis, slope mapping, arc re-fit).
    The tool's Core files are linked, not copied.
    Run:  dotnet test Tests/MergeRoofs.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ToolDir>..\..\Menu\RoofTools\Modelling\MergeRoofs_V001\</ToolDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ToolDir)Core\**\*.cs" Link="Tool\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="1.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
