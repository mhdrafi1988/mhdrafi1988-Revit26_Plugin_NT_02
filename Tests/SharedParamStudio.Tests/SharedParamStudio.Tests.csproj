<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for Shared Parameter Studio's Revit-free code (file reader / writer, duplicate
    check, merger). The tool's Core files are linked, not copied. Core has no Revit or WPF
    dependency, so all of it builds here.
    Run:  dotnet test Tests/SharedParamStudio.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <ToolDir>..\..\Menu\Manage\SharedParamStudio_V001\</ToolDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ToolDir)Core\**\*.cs" Link="Tool\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
