<!--
=======================================================
File: WorksetCreatorWindow.xaml
Workset Creator V017.

Changes vs V016:
  - Namespace / class / Title / shell Version → V017. Nothing else differs:
    V017 is a version bump of the V016 code, not a behaviour change.

Carried from V015 -> V016:
  - Namespace / class / Title / shell Version were bumped to V016.
  - Header tile 4 reads NOT PLACED, not NO INSTANCES: an unloaded link that is
    placed now counts properly and belongs to Grid 2, so Grid 3 really is
    "nothing in the model".
  - Pattern toolbar carries the exclusion note ("3 IFC link(s) hidden"), so a
    link missing from the list is explained on screen.
  - Grid 2 gains a Load state column — Loaded / Unloaded / Not found.
  - Grid 3's Status column binds to StatusText instead of the hard-coded
    "Unloaded / not placed" string V015 had to use, and its header hint no
    longer promises that assignment happens on load.
  - Layout, shell zones, styles and every other binding are V015's.

Added later in V016 — IFC toggle and duplicate prevention:
  - Pattern toolbar gains the "Exclude IFC links" check box (ticked by default)
    and a Detected Naming Conventions strip showing what the matcher found.
  - Metrics card goes to six tiles: Rename match and Needs review join it.
  - Grid 2 gains Existing match, Action (a restricted-selection ComboBox) and
    Final workset, plus a review-only toggle and a Refresh button.
  - Two local row styles: IfcRowStyle tints an IFC row, ReviewRowStyle an
    unresolved review row. Colours come from SharedStyles.xaml only — no new
    brushes anywhere in this file.
  - MinWidth/Width 1060 -> 1180 for the three new columns.
=======================================================
-->
<Window
    x:Class="Revit26_Plugin_Revised.WorksetCreator.V017.UI.Views.WorksetCreatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Revit26_Plugin_Revised.WorksetCreator.V017.UI.Views"
    xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
    xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Workset Creator — V017"
    Height="860"
    Width="1180"
    MinHeight="860"
    MinWidth="1180"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter   x:Key="BoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter    x:Key="LogLevelToColorConverter"/>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding"           Value="8,0"/>
                <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize"          Value="10"/>
            </Style>

            <Style x:Key="MonoCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                <Setter Property="FontSize"   Value="10"/>
            </Style>

            <Style x:Key="CurrentWorksetCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>

            <!-- Load state cell (V016) — colour comes from the state, no inline colours -->
            <Style x:Key="LoadStateCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LoadState}" Value="Unloaded">
                        <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LoadState}" Value="NotFound">
                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Run-result pill — colour comes from the outcome, no inline colours -->
            <Style x:Key="OutcomePill" TargetType="Border">
                <Setter Property="CornerRadius"        Value="10"/>
                <Setter Property="Padding"             Value="7,2"/>
                <Setter Property="Margin"              Value="8,0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background"          Value="{StaticResource BrushTextSecondary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Outcome}" Value="Created">
                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Outcome}" Value="CreatedNoInstances">
                        <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Outcome}" Value="Reused">
                        <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Outcome}" Value="Missed">
                        <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Outcome}" Value="Error">
                        <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Existing match cell — grey when there is nothing, amber on a conflict -->
            <Style x:Key="MatchCell" TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MatchConfidence}" Value="None">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MatchConfidence}" Value="Ambiguous">
                        <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MatchConfidence}" Value="Weak">
                        <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Final workset cell — blue for an IFC row, grey when the link is skipped -->
            <Style x:Key="FinalWorksetCell" TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIfc}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedAction}" Value="Skip">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Linked file cell — an IFC row reads in the accent colour -->
            <Style x:Key="LinkNameCell" TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIfc}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
              Grid 2 row style. An IFC row is tinted so a link that came in through an
              .ifc.rvt shadow file is obvious; an unresolved review row is tinted amber
              and wins, because a decision outstanding matters more than the file type.
              Trigger order is the precedence: the later trigger takes effect.
            -->
            <Style x:Key="MatchRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIfc}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding NeedsReview}"      Value="True"/>
                            <Condition Binding="{Binding IsReviewResolved}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource BrushTintWarning}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Action picker — restricted selection: the option set is fixed per row -->
            <Style x:Key="ActionCombo" TargetType="ComboBox">
                <Setter Property="FontSize"            Value="10"/>
                <Setter Property="Height"              Value="22"/>
                <Setter Property="VerticalAlignment"   Value="Center"/>
                <Setter Property="Margin"              Value="4,0"/>
                <Setter Property="IsEditable"          Value="False"/>
                <Setter Property="DisplayMemberPath"   Value="Label"/>
                <Setter Property="Foreground"          Value="{StaticResource BrushTextPrimary}"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Workset Creator"
                           Subtitle="Creates a workset per linked file and assigns its instances"
                           Version="V017"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Border CornerRadius="6" Margin="0,0,0,8"
                    Background="{StaticResource BrushSystemBackground}"
                    BorderBrush="{StaticResource BrushSeparatorThin}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Links -->
                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource BrushSeparatorThin}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,7"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushTextSecondary}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="TOTAL LINKS" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding TotalLinksCount}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Assigned -->
                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource BrushSuccess}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{StaticResource BrushTintSuccess}"
                            Padding="12,7"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="ASSIGNED" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushSuccess}"/>
                                <TextBlock Text="{Binding Grid1Count}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource BrushSuccess}"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Needs Workset -->
                    <Border Grid.Column="2"
                            BorderBrush="{StaticResource BrushAppleBlue}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{StaticResource BrushTintInfo}"
                            Padding="12,7"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAppleBlue}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="NEEDS WORKSET" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAppleBlue}"/>
                                <TextBlock Text="{Binding Grid2Count}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource BrushAppleBlue}"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Rename match — links whose existing workset will be renamed -->
                    <Border Grid.Column="3"
                            BorderBrush="{StaticResource BrushSuccess}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{StaticResource BrushTintSuccess}"
                            Padding="12,7"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="RENAME MATCH" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushSuccess}"/>
                                <TextBlock Text="{Binding RenameMatchCount}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource BrushSuccess}"
                                           FontFamily="Consolas"
                                           ToolTip="Links that already have a workset under a different naming pattern. Renaming it keeps one workset per link."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Needs review — the matcher will not decide these -->
                    <Border Grid.Column="4"
                            BorderBrush="{StaticResource BrushWarning}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{StaticResource BrushTintWarning}"
                            Padding="12,7"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushWarning}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="NEEDS REVIEW" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushWarning}"/>
                                <TextBlock Text="{Binding NeedsReviewCount}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource BrushWarning}"
                                           FontFamily="Consolas"
                                           ToolTip="Rows held out of the run until you pick an action — a naming pattern too rare to trust, or more than one candidate workset."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Not placed -->
                    <Border Grid.Column="5"
                            BorderBrush="{StaticResource BrushSeparatorThin}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushTextSecondary}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="NOT PLACED" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding Grid3Count}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- ══ ROW 2 — Pattern toolbar ══════════════════════════════════════ -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                  <StackPanel>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Pattern"
                                   Style="{StaticResource FieldLabel}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox Grid.Column="1"
                                 Width="140"
                                 MaxLength="60"
                                 FontSize="10"
                                 Style="{StaticResource StyledTextInput}"
                                 Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Use {name} as a placeholder for the linked file name"/>

                        <TextBlock Grid.Column="2"
                                   Text="Use {name} for the link file name"
                                   Style="{StaticResource HintText}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>

                        <!--
                          There is deliberately no IFC check box here. The inclusion rule
                          is by extension: a link is listed when its file ends in .rvt,
                          and a Revit-linked IFC is a ".ifc.rvt" shadow model, so it
                          always qualifies and always gets a workset. A bare .ifc is not a
                          Revit file and is never listed. With both ends fixed there was
                          nothing left for a switch to govern (Rafi, 2026-10-18).
                        -->

                        <!-- V016 — what the scan left out or let in, so the count is explained -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding ExclusionText}"
                                   Style="{StaticResource HintText}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasExclusions, Converter={StaticResource BoolToVisibilityConverter}}"
                                   ToolTip="IFC links come in through a generated .ifc.rvt shadow file; a nested link's workset follows its parent link, so nested links are never listed."/>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding PatternErrorMessage}"
                                   Foreground="{StaticResource BrushDanger}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding HasPatternError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>

                    <!--
                      Detected Naming Conventions. The matcher does not know your naming
                      patterns — it finds the link name inside each workset name and
                      counts what is left over. A residue many worksets share is a
                      convention; one used once or twice is a coincidence and sends the
                      row to Needs review. These are those counts, so the logic is
                      visible rather than taken on trust.
                    -->
                    <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                            BorderBrush="{StaticResource BrushSeparatorThin}"
                            BorderThickness="0,1,0,0"
                            Padding="12,6"
                            Visibility="{Binding HasConventions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Detected Naming Conventions"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushNavyPrimary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <ItemsControl ItemsSource="{Binding DetectedConventions}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgePill}"
                                                Margin="0,2,6,2"
                                                ToolTip="{Binding Tooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Display}"
                                                           FontFamily="Consolas, Courier New"
                                                           FontSize="10"
                                                           Foreground="{StaticResource BrushNavyPrimary}"/>
                                                <TextBlock Text="{Binding Occurrences, StringFormat=' ×{0}'}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Margin="2,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAccepted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="green = treated as a convention · amber = too rare, sent to review"
                                       Style="{StaticResource HintText}"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- ══ ROW 2b — Last run summary ════════════════════════════════════ -->
                <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0"
                        Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BrushSystemSecondaryBackground}"
                                CornerRadius="10,10,0,0"
                                Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource BrushAppleBlue}"/>
                                    <TextBlock Text="Last run"
                                               Style="{StaticResource SectionTitle}"
                                               FontSize="10" Margin="0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource HintText}"
                                               FontSize="10"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding LastRunSummary.Mode, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding LastRunSummary.Label, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding LastRunSummary.FinishedAt, StringFormat=HH:mm:ss, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Show report"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ShowSummaryCommand}"
                                            Margin="0,0,6,0"
                                            ToolTip="Re-open the run report dialog"/>
                                    <Button Content="Copy report"
                                            Style="{StaticResource OutlineButton}"
                                            Command="{Binding CopySummaryCommand}"
                                            ToolTip="Copy the counts and every linked file row to the clipboard"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Counts -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BrushSystemBackground}"
                                BorderBrush="{StaticResource BrushSeparatorThin}"
                                BorderThickness="0,1,0,1"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource MetricTile}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="LINKED FILES" Style="{StaticResource MetricTileLabel}"/>
                                        <TextBlock Text="{Binding LastRunSummary.LinksInModel, Mode=OneWay}"
                                                   Style="{StaticResource MetricTileNumber}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource MetricTileSuccess}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="CREATED" Style="{StaticResource MetricTileLabelSuccess}"/>
                                        <TextBlock Text="{Binding LastRunSummary.WorksetsCreated, Mode=OneWay}"
                                                   Style="{StaticResource MetricTileNumberSuccess}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource MetricTileInfo}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="LINKS ASSIGNED" Style="{StaticResource MetricTileLabelInfo}"/>
                                        <TextBlock Text="{Binding LastRunSummary.LinksAssigned, Mode=OneWay}"
                                                   Style="{StaticResource MetricTileNumberInfo}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource MetricTileWarning}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="SKIPPED" Style="{StaticResource MetricTileLabelWarning}"/>
                                        <TextBlock Text="{Binding LastRunSummary.Skipped, Mode=OneWay}"
                                                   Style="{StaticResource MetricTileNumberWarning}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource MetricTileWarning}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="MISSED" Style="{StaticResource MetricTileLabelWarning}"/>
                                        <TextBlock Text="{Binding LastRunSummary.Missed, Mode=OneWay}"
                                                   Style="{StaticResource MetricTileNumberWarning}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="5" Style="{StaticResource MetricTileDanger}">
                                    <StackPanel>
                                        <TextBlock Text="ERRORS" Style="{StaticResource MetricTileLabelDanger}"/>
                                        <TextBlock Text="{Binding LastRunSummary.Errors, Mode=OneWay}"
                                                   Style="{StaticResource MetricTileNumberDanger}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- One row per linked file -->
                        <DataGrid Grid.Row="2" MinHeight="90"
                                  shell:ShellBehaviors.MaxHeightRatio="0.28"
                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                  ItemsSource="{Binding LastRunSummary.Outcomes, Mode=OneWay}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Linked File" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LinkName}" Style="{StaticResource MonoCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Workset" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WorksetName}" Style="{StaticResource MonoCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Result" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OutcomePill}">
                                                <TextBlock Text="{Binding OutcomeLabel}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextOnAccent}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Instances" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InstancesText}"
                                                       Style="{StaticResource MonoCell}"
                                                       ToolTip="Assigned / found in model"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Note" Width="300">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Note}"
                                                       Style="{StaticResource CellText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Note}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ══ ROW 3 — Three section grids ══════════════════════════════════ -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── GRID 1 — Already created & assigned ─────────────────── -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource BrushSystemSecondaryBackground}"
                                    CornerRadius="10,10,0,0"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource BrushSuccess}"/>
                                    <TextBlock Text="Already created &amp; assigned"
                                               Style="{StaticResource SectionTitle}"
                                               FontSize="10" Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource BadgePill}"
                                            Background="{StaticResource BrushSuccess}"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Grid1Count}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                    </Border>
                                    <TextBlock Text="Exact match confirmed — read only"
                                               Style="{StaticResource HintText}"
                                               FontSize="10"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Per-section search -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource BrushSystemBackground}"
                                    BorderBrush="{StaticResource BrushSeparatorThin}"
                                    BorderThickness="0,1,0,1"
                                    Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⌕" FontSize="12"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource StyledTextInput}"
                                             FontFamily="Consolas, Courier New"
                                             FontSize="10"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="4,2"
                                             Text="{Binding SearchText1, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter by link name"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Height="0.5"
                                    Background="{StaticResource BrushSeparatorThin}"
                                    VerticalAlignment="Bottom"/>

                            <DataGrid Grid.Row="2" MinHeight="120" shell:ShellBehaviors.MaxHeightRatio="0.3" shell:ShellBehaviors.ForwardMouseWheel="True"
                                      ItemsSource="{Binding Grid1AssignedItems}"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      RowStyle="{StaticResource MatchRowStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding SerialNumber}"
                                                        Width="40"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTemplateColumn Header="Linked File" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource LinkNameCell}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Workset" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProposedWorksetName}"
                                                           Style="{StaticResource MonoCell}"
                                                           Foreground="{StaticResource BrushSuccess}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Load State" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LoadStateText}"
                                                           Style="{StaticResource LoadStateCell}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Instances"
                                                        Binding="{Binding InstanceCount}"
                                                        IsReadOnly="True"
                                                        Width="80"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTemplateColumn Header="Status" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10"
                                                        Background="{StaticResource BrushSuccess}"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Left"
                                                        Margin="8,0">
                                                    <TextBlock Text="Assigned"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ── GRID 2 — Needs workset ──────────────────────────────── -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource BrushSystemSecondaryBackground}"
                                    CornerRadius="10,10,0,0"
                                    Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource BrushAppleBlue}"/>
                                        <TextBlock Text="Linked files — instances placed, workset not matching"
                                                   Style="{StaticResource SectionTitle}"
                                                   FontSize="10" Margin="0"
                                                   VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource BadgePill}"
                                                Background="{StaticResource BrushAppleBlue}"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Grid2Count}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                        </Border>
                                        <TextBlock Text="Unloaded links are included — their instances still carry a workset"
                                                   Style="{StaticResource HintText}"
                                                   FontSize="10"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!--
                                          Narrows the grid to the rows still awaiting a
                                          decision, so a 59-link model shows the 2 that
                                          matter instead of all of them.
                                        -->
                                        <!--
                                          A Button, not a ToggleButton: SmallSecondaryButton
                                          targets Button, and WPF refuses a Style whose
                                          TargetType is not the element's own type. The
                                          on/off state is carried by ReviewFilterText
                                          ("Needs review only" / "Showing review only"),
                                          which the ViewModel swaps on each press.
                                        -->
                                        <Button Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding ToggleReviewOnlyCommand}"
                                                Margin="0,0,6,0"
                                                ToolTip="Show only the rows that need your decision">
                                            <TextBlock Text="{Binding ReviewFilterText}" FontSize="10"/>
                                        </Button>
                                        <Button Content="Refresh"
                                                Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding RefreshCommand}"
                                                Margin="0,0,6,0"
                                                ToolTip="Re-scan the model and re-match every link"/>
                                        <Button Content="Select all"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SelectAllCommand}"
                                                Margin="0,0,6,0"
                                                ToolTip="Tick every visible row. Rows needing a decision stay unticked."/>
                                        <Button Content="Select none"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SelectNoneCommand}"
                                                Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource OutlineButton}"
                                                Command="{Binding ResyncGrid2Command}"
                                                Margin="0,0,6,0"
                                                ToolTip="Re-assign the checked links in this grid to their matching worksets">
                                            <TextBlock>
                                                <Run Text="Resync ("/><Run Text="{Binding Grid2ResyncableCount, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Command="{Binding CreateGrid2Command}"
                                                ToolTip="Create worksets for the checked links in this grid">
                                            <TextBlock>
                                                <Run Text="Create selected ("/><Run Text="{Binding Grid2SelectedCount, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Per-section search -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource BrushSystemBackground}"
                                    BorderBrush="{StaticResource BrushSeparatorThin}"
                                    BorderThickness="0,1,0,1"
                                    Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⌕" FontSize="12"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource StyledTextInput}"
                                             FontFamily="Consolas, Courier New"
                                             FontSize="10"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="4,2"
                                             Text="{Binding SearchText2, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter by link name"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Height="0.5"
                                    Background="{StaticResource BrushSeparatorThin}"
                                    VerticalAlignment="Bottom"/>

                            <DataGrid Grid.Row="2" MinHeight="120" shell:ShellBehaviors.MaxHeightRatio="0.3" shell:ShellBehaviors.ForwardMouseWheel="True"
                                      ItemsSource="{Binding Grid2ActionableItems}"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      RowStyle="{StaticResource MatchRowStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding SerialNumber}"
                                                        IsReadOnly="True"
                                                        Width="40"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTemplateColumn Header="Create" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!--
                                      DisplayName, not LinkName: the file name with its
                                      extension, so a double extension like
                                      "Z3_IFC_21-08-2026.ifc.rvt" is visible rather than
                                      silently trimmed. LinkName stays the stem, because
                                      that is what {name} resolves to and what the
                                      matcher searches for.
                                    -->
                                    <DataGridTemplateColumn Header="Linked File" Width="*" SortMemberPath="DisplayName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource LinkNameCell}"
                                                           ToolTip="{Binding MatchExplanation}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Load State" Width="80" SortMemberPath="LoadStateText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LoadStateText}"
                                                           Style="{StaticResource LoadStateCell}"
                                                           ToolTip="An unloaded link still has instances in the model, and they still carry a workset"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Current Workset" Width="130" SortMemberPath="CurrentWorksetName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CurrentWorksetName}"
                                                           Style="{StaticResource CurrentWorksetCell}"
                                                           ToolTip="MIXED = instances assigned to more than one workset"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--
                                      Existing Match — the workset the matcher believes is
                                      already this link's, found by looking for the link
                                      name inside each workset name. The tooltip carries
                                      the reasoning and the element count, so a workset
                                      holding more than this link's instances is visible
                                      before a rename is accepted.
                                    -->
                                    <DataGridTemplateColumn Header="Existing Match" Width="170" SortMemberPath="MatchedWorksetName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MatchText}"
                                                           Style="{StaticResource MatchCell}">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel MaxWidth="420">
                                                                <TextBlock Text="{Binding MatchExplanation}"
                                                                           TextWrapping="Wrap"
                                                                           FontSize="11"/>
                                                                <TextBlock Text="{Binding MatchedWorksetElementCount, StringFormat='Elements currently in that workset: {0}'}"
                                                                           FontSize="10"
                                                                           Margin="0,6,0,0"
                                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                                           Visibility="{Binding HasMatch, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--
                                      Action — restricted selection, because the options
                                      depend on the match and a free-typed value would
                                      mean nothing. Picking one on a review row is what
                                      resolves it (WorksetItem.SelectedActionOption).
                                    -->
                                    <DataGridTemplateColumn Header="Action" Width="150" SortMemberPath="ActionText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource ActionCombo}"
                                                          ItemsSource="{Binding AvailableActions}"
                                                          SelectedItem="{Binding SelectedActionOption, Mode=TwoWay}"
                                                          ToolTip="{Binding SelectedActionOption.Tooltip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--
                                      Final Workset — the one answer to "where does this
                                      link end up". The pre-flight gate checks this value
                                      and the request carries it; nothing re-derives it.
                                    -->
                                    <DataGridTemplateColumn Header="Final Workset" Width="190" SortMemberPath="FinalWorksetName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FinalWorksetName}"
                                                           Style="{StaticResource FinalWorksetCell}"
                                                           ToolTip="{Binding ProposedWorksetTooltip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Instances"
                                                        Binding="{Binding InstanceCount}"
                                                        IsReadOnly="True"
                                                        Width="70"
                                                        ElementStyle="{StaticResource CellText}"
                                                        HeaderStyle="{StaticResource StandardDataGridColumnHeader}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ── GRID 3 — Nothing placed ─────────────────────────────── -->
                    <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource BrushSystemSecondaryBackground}"
                                    CornerRadius="10,10,0,0"
                                    Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource BrushWarning}"/>
                                        <TextBlock Text="No instances in model"
                                                   Style="{StaticResource SectionTitle}"
                                                   FontSize="10" Margin="0"
                                                   VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource BadgePill}"
                                                Background="{StaticResource BrushWarning}"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Grid3Count}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                        </Border>
                                        <TextBlock Text="Nothing is placed — the workset is created empty and fills only when the link is placed and re-run"
                                                   Style="{StaticResource HintText}"
                                                   FontSize="10"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Select all"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SelectAllG3Command}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Select none"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SelectNoneG3Command}"
                                                Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource OutlineButton}"
                                                Command="{Binding ResyncGrid3Command}"
                                                Margin="0,0,6,0"
                                                ToolTip="Re-assign the checked links in this grid to their matching worksets">
                                            <TextBlock>
                                                <Run Text="Resync ("/><Run Text="{Binding Grid3ResyncableCount, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Command="{Binding CreateGrid3Command}"
                                                ToolTip="Create worksets for the checked links in this grid">
                                            <TextBlock>
                                                <Run Text="Create selected ("/><Run Text="{Binding Grid3SelectedCount, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Per-section search -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource BrushSystemBackground}"
                                    BorderBrush="{StaticResource BrushSeparatorThin}"
                                    BorderThickness="0,1,0,1"
                                    Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⌕" FontSize="12"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource StyledTextInput}"
                                             FontFamily="Consolas, Courier New"
                                             FontSize="10"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="4,2"
                                             Text="{Binding SearchText3, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter by link name"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Height="0.5"
                                    Background="{StaticResource BrushSeparatorThin}"
                                    VerticalAlignment="Bottom"/>

                            <DataGrid Grid.Row="2" MinHeight="120" shell:ShellBehaviors.MaxHeightRatio="0.3" shell:ShellBehaviors.ForwardMouseWheel="True"
                                      ItemsSource="{Binding Grid3NoInstanceItems}"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      RowStyle="{StaticResource MatchRowStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding SerialNumber}"
                                                        IsReadOnly="True"
                                                        Width="40"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTemplateColumn Header="Create" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Linked File" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource MonoCell}"
                                                           Opacity="0.6"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Proposed Workset" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProposedWorksetName}"
                                                           Style="{StaticResource MonoCell}"
                                                           Opacity="0.6"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Status" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10"
                                                        Background="{StaticResource BrushSystemTertiaryBackground}"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Left"
                                                        Margin="8,0">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                               ToolTip="No RevitLinkInstance of this link exists in the model"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══ ROW 4 — Live log (collapsed by default) ══════════════════════ -->
                <Border Background="{StaticResource BrushLogBg}"
                        CornerRadius="10"
                        Margin="0,8,0,0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Log title bar — click toggles content -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BrushLogTitleBar}"
                                CornerRadius="10,10,0,0"
                                Padding="10,4"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleLogCommand}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding LogChevron}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource BrushLogTextDim}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="Live Log"
                                           FontFamily="Consolas"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushLogTextDim}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="Copy All"
                                            Style="{StaticResource DarkGhostButton}"
                                            Command="{Binding CopyAllLogCommand}"
                                            Margin="0,0,6,0"
                                            ToolTip="Copy all log entries to clipboard"/>
                                    <Button Content="Copy Selected"
                                            Style="{StaticResource DarkGhostButton}"
                                            Click="CopySelectedLog_Click"
                                            Margin="0,0,6,0"
                                            ToolTip="Copy only the selected log rows"/>
                                    <Button Content="Clear"
                                            Style="{StaticResource DarkGhostButton}"
                                            Command="{Binding ClearLogCommand}"
                                            ToolTip="Clear the log"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Log entries — hidden when collapsed -->
                        <ListBox Grid.Row="1"
                                 x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MinHeight="90"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Padding="0"
                                 Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"    Value="0"/>
                                    <Setter Property="Margin"     Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushNavyLight}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,1">
                                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   Width="58"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Level}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   Width="60"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Message}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextSecondary}">
                    <Run Text="{Binding TotalSelectedCount, Mode=OneWay}"/>
                    <Run Text=" link(s) selected for creation"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Resync All"
                            Style="{StaticResource OutlineButton}"
                            Command="{Binding ResyncCommand}"
                            IsEnabled="{Binding IsResyncEnabled}"
                            Margin="0,0,8,0"
                            ToolTip="Re-assign selected links to their matching worksets"/>
                    <Button Content="Close"
                            Style="{StaticResource OutlineButton}"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
