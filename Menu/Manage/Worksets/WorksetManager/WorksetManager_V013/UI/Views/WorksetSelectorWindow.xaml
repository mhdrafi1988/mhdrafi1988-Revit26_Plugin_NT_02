<!--
=======================================================
File: WorksetSelectorWindow.xaml
Changes vs V012 (layout only, per Revit_Plugin_UI_Standard.md):
  - Already three-zone (header · metrics · pattern toolbar / three
    section grids / live log · footer); this version updates the version
    badge, locks MinWidth/MinHeight to the default size, adds a resize
    grip and uses Title Case labels.
  - No behaviour change — every binding/command is the V012 one.
=======================================================
-->
<Window
    x:Class="Revit26_Plugin_Revised.WorksetManager.V013.UI.Views.WorksetSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Revit26_Plugin_Revised.WorksetManager.V013.UI.Views"
    xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Workset Manager — V013"
    Height="860"
    Width="1060"
    MinHeight="860"
    MinWidth="1060"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter   x:Key="BoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter    x:Key="LogLevelToColorConverter"/>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding"           Value="8,0"/>
                <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize"          Value="10"/>
            </Style>

            <Style x:Key="MonoCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                <Setter Property="FontSize"   Value="10"/>
            </Style>

            <Style x:Key="CurrentWorksetCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemSecondaryBackground}">
        <Grid.RowDefinitions>
            <!-- Row 0: Navy header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Metrics strip -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Pattern toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Three section grids -->
            <RowDefinition Height="*"/>
            <!-- Row 4: Live log (collapsible) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 5: Footer buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — Navy header ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Workset Manager" Style="{StaticResource HeaderTitle}"/>
                        <Border Style="{StaticResource BadgePill}"
                                Background="{StaticResource BrushNavyLight}"
                                Margin="8,0,0,0">
                            <TextBlock Text="V013" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Assigns each linked file to its own workset"
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 1 — Metrics strip ════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushSystemBackground}"
                BorderBrush="{StaticResource BrushSeparatorThin}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Links -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource BrushSeparatorThin}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,7"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrushTextSecondary}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="TOTAL LINKS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding TotalLinksCount}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Assigned -->
                <Border Grid.Column="1"
                        BorderBrush="{StaticResource BrushSuccess}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#0A34C759"
                        Padding="12,7"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="ASSIGNED" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushSuccess}"/>
                            <TextBlock Text="{Binding Grid1Count}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushSuccess}"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Needs Workset -->
                <Border Grid.Column="2"
                        BorderBrush="{StaticResource BrushAppleBlue}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#0A3A82F7"
                        Padding="12,7"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAppleBlue}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="NEEDS WORKSET" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAppleBlue}"/>
                            <TextBlock Text="{Binding Grid2Count}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAppleBlue}"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- No Instances -->
                <Border Grid.Column="3"
                        BorderBrush="{StaticResource BrushWarning}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#0AFF9F0A"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrushWarning}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="NO INSTANCES" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushWarning}"/>
                            <TextBlock Text="{Binding Grid3Count}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushWarning}"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ ROW 2 — Pattern toolbar ══════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="12,10,12,0">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Pattern"
                           Style="{StaticResource FieldLabel}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Width="140"
                         MaxLength="10"
                         FontSize="10"
                         Style="{StaticResource StyledTextInput}"
                         Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Use {name} as a placeholder for the linked file name"/>

                <TextBlock Grid.Column="2"
                           Text="Use {name} for the link file name"
                           Style="{StaticResource HintText}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding PatternErrorMessage}"
                           Foreground="{StaticResource BrushDanger}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Visibility="{Binding HasPatternError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ══ ROW 3 — Three section grids ══════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="12,8,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── GRID 1 — Already created & assigned ─────────────────── -->
            <Border Grid.Row="0" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BrushSystemSecondaryBackground}"
                            CornerRadius="10,10,0,0"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource BrushSuccess}"/>
                            <TextBlock Text="Already created &amp; assigned"
                                       Style="{StaticResource SectionTitle}"
                                       FontSize="10" Margin="0"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource BadgePill}"
                                    Background="{StaticResource BrushSuccess}"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding Grid1Count}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Exact match confirmed — read only"
                                       Style="{StaticResource HintText}"
                                       FontSize="10"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Per-section search -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BrushSystemBackground}"
                            BorderBrush="{StaticResource BrushSeparatorThin}"
                            BorderThickness="0,1,0,1"
                            Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⌕" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource StyledTextInput}"
                                     FontFamily="Consolas, Courier New"
                                     FontSize="10"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="4,2"
                                     Text="{Binding SearchText1, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter by link name"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Height="0.5"
                            Background="{StaticResource BrushSeparatorThin}"
                            VerticalAlignment="Bottom"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Grid1AssignedItems}"
                              Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding SerialNumber}"
                                                Width="40"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Linked file" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LinkName}" Style="{StaticResource MonoCell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Workset" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProposedWorksetName}"
                                                   Style="{StaticResource MonoCell}"
                                                   Foreground="{StaticResource BrushSuccess}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Instances"
                                                Binding="{Binding InstanceCount}"
                                                IsReadOnly="True"
                                                Width="80"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Background="{StaticResource BrushSuccess}"
                                                Padding="7,2"
                                                HorizontalAlignment="Left"
                                                Margin="8,0">
                                            <TextBlock Text="Assigned"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── GRID 2 — Needs workset ──────────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BrushSystemSecondaryBackground}"
                            CornerRadius="10,10,0,0"
                            Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource BrushAppleBlue}"/>
                                <TextBlock Text="Linked files — workset not yet created"
                                           Style="{StaticResource SectionTitle}"
                                           FontSize="10" Margin="0"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource BadgePill}"
                                        Background="{StaticResource BrushAppleBlue}"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Grid2Count}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Select all"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectAllCommand}"
                                        Margin="0,0,6,0"/>
                                <Button Content="Select none"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectNoneCommand}"
                                        Margin="0,0,6,0"/>
                                <Button Style="{StaticResource OutlineButton}"
                                        Command="{Binding ResyncGrid2Command}"
                                        Margin="0,0,6,0"
                                        ToolTip="Re-assign the checked links in this grid to their matching worksets">
                                    <TextBlock>
                                        <Run Text="Resync ("/><Run Text="{Binding Grid2ResyncableCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource RunButton}"
                                        Command="{Binding CreateGrid2Command}"
                                        ToolTip="Create worksets for the checked links in this grid">
                                    <TextBlock>
                                        <Run Text="Create selected ("/><Run Text="{Binding Grid2SelectedCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Per-section search -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BrushSystemBackground}"
                            BorderBrush="{StaticResource BrushSeparatorThin}"
                            BorderThickness="0,1,0,1"
                            Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⌕" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource StyledTextInput}"
                                     FontFamily="Consolas, Courier New"
                                     FontSize="10"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="4,2"
                                     Text="{Binding SearchText2, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter by link name"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Height="0.5"
                            Background="{StaticResource BrushSeparatorThin}"
                            VerticalAlignment="Bottom"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Grid2ActionableItems}"
                              Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding SerialNumber}"
                                                IsReadOnly="True"
                                                Width="40"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Create" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Linked file" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LinkName}" Style="{StaticResource MonoCell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Current workset" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CurrentWorksetName}"
                                                   Style="{StaticResource CurrentWorksetCell}"
                                                   ToolTip="MIXED = instances assigned to more than one workset"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Proposed workset" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProposedWorksetName}"
                                                   Style="{StaticResource MonoCell}"
                                                   ToolTip="{Binding ProposedWorksetTooltip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Instances"
                                                Binding="{Binding InstanceCount}"
                                                IsReadOnly="True"
                                                Width="80"
                                                ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── GRID 3 — No instances ───────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BrushSystemSecondaryBackground}"
                            CornerRadius="10,10,0,0"
                            Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource BrushWarning}"/>
                                <TextBlock Text="No instances in model"
                                           Style="{StaticResource SectionTitle}"
                                           FontSize="10" Margin="0"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource BadgePill}"
                                        Background="{StaticResource BrushWarning}"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Grid3Count}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Workset will be created; assignment happens when link is loaded"
                                           Style="{StaticResource HintText}"
                                           FontSize="10"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Select all"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectAllG3Command}"
                                        Margin="0,0,6,0"/>
                                <Button Content="Select none"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectNoneG3Command}"
                                        Margin="0,0,6,0"/>
                                <Button Style="{StaticResource OutlineButton}"
                                        Command="{Binding ResyncGrid3Command}"
                                        Margin="0,0,6,0"
                                        ToolTip="Re-assign the checked links in this grid to their matching worksets">
                                    <TextBlock>
                                        <Run Text="Resync ("/><Run Text="{Binding Grid3ResyncableCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource RunButton}"
                                        Command="{Binding CreateGrid3Command}"
                                        ToolTip="Create worksets for the checked links in this grid">
                                    <TextBlock>
                                        <Run Text="Create selected ("/><Run Text="{Binding Grid3SelectedCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Per-section search -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BrushSystemBackground}"
                            BorderBrush="{StaticResource BrushSeparatorThin}"
                            BorderThickness="0,1,0,1"
                            Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⌕" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource StyledTextInput}"
                                     FontFamily="Consolas, Courier New"
                                     FontSize="10"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="4,2"
                                     Text="{Binding SearchText3, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter by link name"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Height="0.5"
                            Background="{StaticResource BrushSeparatorThin}"
                            VerticalAlignment="Bottom"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Grid3NoInstanceItems}"
                              Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding SerialNumber}"
                                                IsReadOnly="True"
                                                Width="40"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Create" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Linked file" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LinkName}"
                                                   Style="{StaticResource MonoCell}"
                                                   Opacity="0.6"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Proposed workset" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProposedWorksetName}"
                                                   Style="{StaticResource MonoCell}"
                                                   Opacity="0.6"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Background="{StaticResource BrushSystemTertiaryBackground}"
                                                Padding="7,2"
                                                HorizontalAlignment="Left"
                                                Margin="8,0">
                                            <TextBlock Text="Unloaded / not placed"
                                                       FontSize="10"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ ROW 4 — Live log (collapsed by default) ══════════════════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource BrushLogBg}"
                CornerRadius="10"
                Margin="12,8,12,0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Log title bar — click toggles content -->
                <Border Grid.Row="0"
                        Background="{StaticResource BrushLogTitleBar}"
                        CornerRadius="10,10,0,0"
                        Padding="10,4"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleLogCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding LogChevron}"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="{StaticResource BrushLogTextDim}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="Live Log"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushLogTextDim}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="Copy All"
                                    Style="{StaticResource DarkGhostButton}"
                                    Command="{Binding CopyLogCommand}"
                                    Margin="0,0,6,0"
                                    ToolTip="Copy all log entries to clipboard"/>
                            <Button Content="Copy Selected"
                                    Style="{StaticResource DarkGhostButton}"
                                    Click="CopySelectedLog_Click"
                                    Margin="0,0,6,0"
                                    ToolTip="Copy only the selected log rows"/>
                            <Button Content="Clear"
                                    Style="{StaticResource DarkGhostButton}"
                                    Command="{Binding ClearLogCommand}"
                                    ToolTip="Clear the log"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log entries — hidden when collapsed -->
                <ListBox Grid.Row="1"
                         x:Name="LogListBox"
                         ItemsSource="{Binding Log}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Height="90"
                         Padding="0"
                         Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"    Value="0"/>
                            <Setter Property="Margin"     Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushNavyLight}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="10,1">
                                <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource BrushLogTextDim}"
                                           Width="58"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Level}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           Width="60"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Message}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource BrushLogText}"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ══ ROW 5 — Footer ═══════════════════════════════════════════════ -->
        <Border Grid.Row="5"
                Background="{StaticResource BrushSystemBackground}"
                BorderBrush="{StaticResource BrushSeparatorThin}"
                BorderThickness="0,1,0,0"
                Padding="12,10"
                Margin="12,8,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextSecondary}">
                    <Run Text="{Binding TotalSelectedCount, Mode=OneWay}"/>
                    <Run Text=" link(s) selected for creation"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Resync All"
                            Style="{StaticResource OutlineButton}"
                            Command="{Binding ResyncCommand}"
                            IsEnabled="{Binding IsResyncEnabled}"
                            Margin="0,0,8,0"
                            ToolTip="Re-assign selected links to their matching worksets"/>
                    <Button Content="Close"
                            Style="{StaticResource OutlineButton}"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
