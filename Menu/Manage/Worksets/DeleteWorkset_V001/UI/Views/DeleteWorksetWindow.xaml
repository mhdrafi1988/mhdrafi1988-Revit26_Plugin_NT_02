<Window
    x:Class="Revit26_Plugin_Revised.DeleteWorkset.V001.UI.Views.DeleteWorksetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
    xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
    mc:Ignorable="d"
    Title="{Binding Source={x:Static svc:ToolCatalog.DeleteWorkset}, Path=Title}"
    Background="{DynamicResource BrushSurfaceWindow}"
    Height="700"
    Width="800"
    MinHeight="560"
    MinWidth="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter         x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter  x:Key="InverseBoolToVis"/>
            <converters:InverseBoolConverter              x:Key="InverseBool"/>
            <converters:LogLevelToColorConverter          x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter                 x:Key="NativeBoolToVis"/>

            <!-- Row style: dims non-deletable rows -->
            <Style x:Key="WorksetRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDeletable}" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding"           Value="8,0"/>
                <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize"          Value="11"/>
            </Style>
            <Style x:Key="MonoCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                <Setter Property="TextAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- UI standard v4.0: shared ToolWindowShell.
         HEADER  title / subtitle / version + three metric tiles
         BODY    filter toolbar + workset grid (capped by ShellBehaviors),
                 migration target + options, run log
         FOOTER  status strip (busy bar) · Reset left · Delete → Close right
         Bindings, commands, handlers and x:Names are unchanged. -->
    <shell:ToolWindowShell Title="Delete Workset"
                           Subtitle="Delete worksets and migrate or hard-delete their elements"
                           Version="{Binding Source={x:Static svc:ToolCatalog.DeleteWorkset}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True">

        <!-- ═══ HEADER ═══ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                <!-- Total -->
                <Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL WORKSETS" Style="{StaticResource MetricTileLabel}"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricTileNumber}"/>
                    </StackPanel>
                </Border>
                <!-- Deletable -->
                <Border Style="{StaticResource MetricTileSuccess}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="DELETABLE" Style="{StaticResource MetricTileLabel}"
                                   Foreground="{StaticResource BrushStatusOk}"/>
                        <TextBlock Text="{Binding DeletableCount}" Style="{StaticResource MetricTileNumberSuccess}"/>
                    </StackPanel>
                </Border>
                <!-- Non-deletable -->
                <Border Style="{StaticResource MetricTileDanger}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="NON-DELETABLE" Style="{StaticResource MetricTileLabel}"
                                   Foreground="{StaticResource BrushStatusError}"/>
                        <TextBlock Text="{Binding NonDeletableCount}" Style="{StaticResource MetricTileNumberDanger}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═══ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- Workset grid -->
                <!-- Toolbar -->
                <Border Background="{StaticResource BrushSystemSecondaryBackground}" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1,1,1,0"
                        CornerRadius="4,4,0,0" Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StyledTextInput}"
                                 Margin="0,0,8,0"
                                 FontSize="11"/>

                        <Button Grid.Column="1" Content="Select All"
                                Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SmallSecondaryButton}"
                                Margin="0,0,4,0"/>
                        <Button Grid.Column="2" Content="Clear"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource SmallSecondaryButton}"
                                Margin="0,0,4,0"/>
                        <Button Grid.Column="3" Content="↺ Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid MinHeight="160"
                          shell:ShellBehaviors.MaxHeightRatio="0.4"
                          shell:ShellBehaviors.ForwardMouseWheel="True"
                          ItemsSource="{Binding RowsView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          IsReadOnly="False"
                          RowStyle="{StaticResource WorksetRowStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BrushBorderDefault}">
                    <DataGrid.Columns>
                        <!-- Checkbox -->
                        <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              IsEnabled="{Binding IsDeletable}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Name -->
                        <DataGridTemplateColumn Header="Workset Name" Width="*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}"
                                                   FontWeight="Medium" ToolTip="{Binding NonDeletableReason}"/>
                                        <!-- Non-deletable badge -->
                                        <Border Visibility="{Binding IsDeletable, Converter={StaticResource InverseBoolToVis}}"
                                                Background="{StaticResource BrushSystemTertiaryBackground}"
                                                BorderBrush="{StaticResource BrushSeparator}"
                                                BorderThickness="1"
                                                CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                                ToolTip="{Binding NonDeletableReason}">
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Element count -->
                        <DataGridTemplateColumn Header="Elements" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ElementCount}" Style="{StaticResource MonoCell}"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Owner -->
                        <DataGridTemplateColumn Header="Owner" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Owner}" Style="{StaticResource CellText}"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Status -->
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                            Margin="6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource BrushStatusOk}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Closed"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                            <Setter Property="Text" Value="Open"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ══ ROW 3 — Migration target + options ═══════════════════════════ -->
                <Border Margin="0,8,0,0" Padding="12" Background="{StaticResource BrushSurfaceCard}"
                        BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <!-- Migration target -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Migrate elements to →"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding MigrationTargets}"
                                      SelectedItem="{Binding MigrationTarget}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource StandardComboBox}"
                                      IsEditable="True"
                                      TextSearch.TextPath="Name"/>
                        </Grid>

                        <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,8"/>

                        <!-- Options -->
                        <StackPanel>
                            <CheckBox IsChecked="{Binding HardDeleteUnmigratable}" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Also delete elements that cannot be migrated"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Hard-deletes annotation elements, view-specific elements, and hosted elements with no valid target."
                                               FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ConfirmEachDeletion}">
                                <StackPanel>
                                    <TextBlock Text="Confirm before each deletion"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Shows a per-workset confirmation prompt during the run."
                                               FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ ROW 4 — Log panel ════════════════════════════════════════════ -->
                <Border Margin="0,8,0,0"
                        Background="{StaticResource BrushLogBg}"
                        CornerRadius="4">
                    <DockPanel>
                        <!-- Log title bar -->
                        <Border DockPanel.Dock="Top"
                                Background="{StaticResource BrushLogTitleBar}"
                                CornerRadius="4,4,0,0" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RUN LOG"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextOnDark}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Copy All"
                                        Command="{Binding CopyAllLogCommand}"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                                <Button Grid.Column="2" Content="Copy Selected"
                                        Command="{Binding CopySelectedLogCommand}"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                                <ToggleButton Grid.Column="3"
                                              IsChecked="{Binding IsLogExpanded}"
                                              Style="{StaticResource LogHeaderToggle}"/>
                            </Grid>
                        </Border>

                        <!-- Log entries (collapsible) -->
                        <ListBox x:Name="LogListBox"
                                 Visibility="{Binding IsLogExpanded, Converter={StaticResource NativeBoolToVis}}"
                                 ItemsSource="{Binding Log}"
                                 Background="{StaticResource BrushLogBg}"
                                 BorderThickness="0"
                                 Height="120"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"           Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background"        Value="Transparent"/>
                                    <Setter Property="BorderThickness"   Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                   FontFamily="Consolas, Courier New" FontSize="10"
                                                   Foreground="{StaticResource BrushLogTextDim}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Message}"
                                                   FontFamily="Consolas, Courier New" FontSize="10"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Reset" Command="{Binding ResetCommand}"
                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Delete Workset"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
