<Window x:Class="Revit26_Plugin_Revised.WorksetsElementsBrowser.WSEB003.UI.Views.View3DPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Show in 3D View"
        Height="420" Width="380"
        MinHeight="320" MinWidth="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Show in 3D View" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
        <TextBlock x:Name="PromptText" Grid.Row="1" Margin="0,4,0,12" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"/>

        <TextBox x:Name="SearchBox"
                 Grid.Row="2"
                 Margin="0,0,0,8"
                 Padding="8,6"
                 Style="{StaticResource BorderlessTextInput}"
                 Background="{StaticResource BrushSystemSecondaryBackground}"
                 BorderBrush="{StaticResource BrushSeparator}"
                 BorderThickness="1"
                 Tag="Type to search views…"
                 TextChanged="SearchBox_TextChanged"
                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>

        <Border Grid.Row="3" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="ViewsListBox"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ViewsListBox_MouseDoubleClick"
                     DisplayMemberPath="Name"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="No" Width="80" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="No_Click" IsCancel="True"/>
            <Button Content="Open View" Width="100" Style="{StaticResource RunButton}" Click="OpenView_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
