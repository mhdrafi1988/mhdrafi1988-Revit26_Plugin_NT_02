<Window
    x:Class="Revit26_Plugin_Revised.WorksetMemory.V001.UI.Views.WorksetMemoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
    xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
    xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
    xmlns:vm="clr-namespace:Revit26_Plugin_Revised.WorksetMemory.V001.UI.ViewModels"
    Title="{Binding Source={x:Static svc:ToolCatalog.WorksetMemory}, Path=Title}"
    Background="{DynamicResource BrushSurfaceWindow}"
    Height="760"
    Width="760"
    MinHeight="560"
    MinWidth="600"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding"           Value="8,0"/>
                <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize"          Value="11"/>
            </Style>

            <!-- Open / Closed text: green when open -->
            <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="Open">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WorksetRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                        <Setter Property="Opacity" Value="0.6"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Saved-set row: name / date / count -->
            <DataTemplate x:Key="SetTemplate" DataType="{x:Type vm:SetRow}">
                <Grid Margin="2,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SavedText}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- UI standard v4.0: shared ToolWindowShell.
         HEADER  title / subtitle / version + three metric tiles
         BODY    model picker, saved sets card, comparison grid, option, notice
         FOOTER  status strip (what a reload changes) · Reload worksets → Close -->
    <shell:ToolWindowShell Title="Workset Memory"
                           Subtitle="Remember which worksets are open in this model, then reopen it with exactly those worksets in one click."
                           Version="{Binding Source={x:Static svc:ToolCatalog.WorksetMemory}, Path=Version, StringFormat=v{0}}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="USER WORKSETS" Style="{StaticResource MetricTileLabel}"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding WorksetCount}" Style="{StaticResource MetricTileNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileSuccess}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="OPEN NOW" Style="{StaticResource MetricTileLabel}"
                                   Foreground="{StaticResource BrushStatusOk}"/>
                        <TextBlock Text="{Binding OpenNowCount}" Style="{StaticResource MetricTileNumberSuccess}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileInfo}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="SAVED SETS" Style="{StaticResource MetricTileLabelInfo}"/>
                        <TextBlock Text="{Binding SavedSetCount}" Style="{StaticResource MetricTileNumberInfo}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═══ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- Model picker -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Model" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                              DisplayMemberPath="Display" Style="{StaticResource StandardComboBox}"/>
                </Grid>

                <!-- Saved sets -->
                <Border Margin="0,0,0,8" Padding="12,10" Background="{StaticResource BrushSurfaceCard}"
                        BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Saved sets" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="{Binding ModelLocation}" FontSize="11" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}"
                                 ItemTemplate="{StaticResource SetTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 MinHeight="70" MaxHeight="130"
                                 BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewSetName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}" FontSize="11" Margin="0,0,8,0"
                                     IsEnabled="{Binding IsCurrentModel}"/>
                            <Button Grid.Column="2" Content="Remember current" Command="{Binding RememberCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"
                                    ToolTip="Save the worksets open now, and the active workset, as a set"/>
                            <Button Grid.Column="3" Content="Overwrite" Command="{Binding OverwriteCommand}"
                                    Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"
                                    ToolTip="Replace the selected set with the worksets open now"/>
                            <Button Grid.Column="4" Content="Delete" Command="{Binding DeleteCommand}"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    ToolTip="Delete the selected set"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Comparison grid -->
                <DataGrid MinHeight="160"
                          shell:ShellBehaviors.MaxHeightRatio="0.45"
                          shell:ShellBehaviors.ForwardMouseWheel="True"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowStyle="{StaticResource WorksetRowStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BrushBorderDefault}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Workset" Width="*" MinWidth="180" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource CellText}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Now" Width="80" SortMemberPath="Now">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Now}" Style="{StaticResource StateText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="In set" Width="90" SortMemberPath="InSet">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InSet}" Style="{StaticResource StateText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="On reload" Width="100" SortMemberPath="Change">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,1" Margin="6,0" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Change}" Value="Opens">
                                                        <Setter Property="Background" Value="{StaticResource BrushPillInfoBackground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Change}" Value="Closes">
                                                        <Setter Property="Background" Value="{StaticResource BrushBannerWarningBackground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Change}" Value="Skipped">
                                                        <Setter Property="Background" Value="{StaticResource BrushPillMutedBackground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ChangeText}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Change}" Value="Opens">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushPillInfoText}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Change}" Value="Closes">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushBannerWarningText}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Change}" Value="Skipped">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushPillMutedText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <CheckBox Margin="0,10,0,0" IsChecked="{Binding RestoreActiveWorkset}">
                    <TextBlock Text="Make the set's active workset current again after reload" FontSize="11.5"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                </CheckBox>

                <!-- Why the model reopens -->
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4" BorderThickness="1"
                        Background="{StaticResource BrushBannerWarningBackground}"
                        BorderBrush="{StaticResource BrushBannerWarningBorder}">
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushBannerWarningText}">
                        Revit can't open or close worksets in a model that is already open. <Bold>Reload worksets</Bold>
                        closes this model and reopens it with the saved set. Save or Synchronize first — it is blocked
                        while the model has unsaved changes.
                    </TextBlock>
                </Border>

                <TextBlock Margin="0,8,0,0" Text="{Binding HintText}" TextWrapping="Wrap" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushStatusError}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reload worksets" Command="{Binding ReloadCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Click="CloseButton_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>

</Window>
