<Window x:Class="Revit26_Plugin_Revised.WorksetsElementsBrowser.WSEB004.UI.Views.View3DPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        mc:Ignorable="d"
        Title="Show in 3D View"
        Height="480" Width="420"
        MinHeight="360" MinWidth="360"
        Background="{DynamicResource BrushSurfaceWindow}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- UI standard v4.0: shared ToolWindowShell. HEADER title + prompt,
         BODY search + view list (list capped by ShellBehaviors),
         FOOTER No · Open View. Names/handlers unchanged. -->
    <shell:ToolWindowShell Title="Show in 3D View"
                           Version="{Binding Source={x:Static svc:ToolCatalog.WorksetsElementsBrowser}, Path=Version, StringFormat=v{0}}">
        <shell:ToolWindowShell.HeaderContent>
            <TextBlock x:Name="PromptText" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"/>
        </shell:ToolWindowShell.HeaderContent>

        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <TextBox x:Name="SearchBox"
                         Margin="0,0,0,8"
                         Style="{StaticResource BoxedTextInput}"
                         Tag="Type to search views…"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>

                <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="4">
                    <ListBox x:Name="ViewsListBox"
                             BorderThickness="0"
                             MinHeight="160"
                             shell:ShellBehaviors.MaxHeightRatio="0.5"
                             shell:ShellBehaviors.ForwardMouseWheel="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ViewsListBox_MouseDoubleClick"
                             DisplayMemberPath="Name"/>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="No" Width="80" Margin="0,0,8,0" Style="{StaticResource OutlineButton}" Click="No_Click" IsCancel="True"/>
                <Button Content="Open View" MinWidth="100" Style="{StaticResource PrimaryButton}" Click="OpenView_Click" IsDefault="True"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
