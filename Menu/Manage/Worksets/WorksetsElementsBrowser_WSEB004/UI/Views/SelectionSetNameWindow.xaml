<Window x:Class="Revit26_Plugin_Revised.WorksetsElementsBrowser.WSEB004.UI.Views.SelectionSetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        Title="Save as Selection Set"
        Height="260" Width="420"
        MinHeight="240" MinWidth="360"
        Background="{DynamicResource BrushSurfaceWindow}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Save as Selection Set"
                           Version="{Binding Source={x:Static svc:ToolCatalog.WorksetsElementsBrowser}, Path=Version, StringFormat=v{0}}">
        <shell:ToolWindowShell.HeaderContent>
            <TextBlock x:Name="PromptText" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"/>
        </shell:ToolWindowShell.HeaderContent>

        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <TextBlock Text="Selection set name" Style="{StaticResource MetricLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource BoxedTextInput}" Tag="Selection set name…"
                         PreviewKeyDown="NameBox_PreviewKeyDown"/>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Margin="0,0,8,0" Style="{StaticResource OutlineButton}" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="Save" MinWidth="100" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
