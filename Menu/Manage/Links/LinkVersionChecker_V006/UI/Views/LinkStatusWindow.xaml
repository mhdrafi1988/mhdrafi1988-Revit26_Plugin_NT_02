<Window x:Class="Revit26_Plugin_Revised.LinkVersionChecker.V006.UI.Views.LinkStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Revit26_Plugin_Revised.LinkVersionChecker.V006.UI.Views"
        Title="Link Version Checker — ACC Desktop Connector links"
        Width="1240" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Background="White" Foreground="#1F2937">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <v:EqualsMultiConverter x:Key="EqualsMulti"/>

        <SolidColorBrush x:Key="Blue" Color="#0B6BCB"/>
        <SolidColorBrush x:Key="Green" Color="#2E7D32"/>
        <SolidColorBrush x:Key="Grey" Color="#4B5563"/>
        <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>

        <!-- Plain button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#0B6BCB"/>
            <Setter Property="BorderBrush" Value="#0B6BCB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Count tile: a button that toggles a filter; highlighted while its filter is active -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Command" Value="{Binding DataContext.SetTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EqualsMulti}">
                                        <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="DataContext.ActiveTile" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Bd" Property="Background" Value="#E6F0FB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B6BCB"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Desktop Connector icons, 14 x 14 -->
        <DataTemplate x:Key="IconAlwaysKept">
            <Grid Width="14" Height="14">
                <Ellipse Fill="#2E7D32"/>
                <Path Data="M3.6,7.2 L6,9.6 L10.5,4.6" Stroke="White" StrokeThickness="1.8"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="IconAvailable">
            <Grid Width="14" Height="14">
                <Ellipse Fill="White" Stroke="#2E7D32" StrokeThickness="1.3"/>
                <Path Data="M3.6,7.2 L6,9.6 L10.5,4.6" Stroke="#2E7D32" StrokeThickness="1.8"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="IconOnline">
            <Grid Width="14" Height="14">
                <Path Data="M3.8,11.5 L10.4,11.5 A2.4,2.4 0 0 0 10.7,6.7 A3.7,3.7 0 0 0 3.7,6 A2.75,2.75 0 0 0 3.8,11.5 Z"
                      Stroke="#0B6BCB" StrokeThickness="1.3"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="IconSync">
            <Grid Width="14" Height="14">
                <Path Data="M11.6,6 A4.8,4.8 0 0 0 3,4.6 M2.4,8 A4.8,4.8 0 0 0 11,9.4 M11.8,2.4 L11.8,6 L8.2,6 M2.2,11.6 L2.2,8 L5.8,8"
                      Stroke="#0B6BCB" StrokeThickness="1.3"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="IconOther">
            <Grid Width="14" Height="14">
                <Ellipse Stroke="#9CA3AF" StrokeThickness="1.3" StrokeDashArray="1.5 1.5"/>
            </Grid>
        </DataTemplate>

        <!-- Picks the icon from the row's DcText -->
        <Style x:Key="DcIcon" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconOther}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DcText}" Value="Always kept">
                    <Setter Property="ContentTemplate" Value="{StaticResource IconAlwaysKept}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DcText}" Value="Available locally">
                    <Setter Property="ContentTemplate" Value="{StaticResource IconAvailable}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DcText}" Value="Online only">
                    <Setter Property="ContentTemplate" Value="{StaticResource IconOnline}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DcText}" Value="Sync pending">
                    <Setter Property="ContentTemplate" Value="{StaticResource IconSync}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pill for the "In model" column -->
        <Style x:Key="ModelPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModelText}" Value="Loaded">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ModelText}" Value="Not found">
                    <Setter Property="Background" Value="#FDECEA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelPillText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModelText}" Value="Loaded">
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ModelText}" Value="Not found">
                    <Setter Property="Foreground" Value="#B71C1C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Text colour for "Latest from ACC?" -->
        <Style x:Key="LatestText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LatestText}" Value="Yes">
                    <Setter Property="Foreground" Value="#1B5E20"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatestText}" Value="Reload needed">
                    <Setter Property="Foreground" Value="#8A4B00"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatestText}" Value="Sync pending">
                    <Setter Property="Foreground" Value="#0B6BCB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0" Content="Export to Excel" Command="{Binding ExportCommand}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Refresh" Command="{Binding RefreshCommand}"/>
                <StackPanel>
                    <TextBlock Text="{Binding HostName}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource Grey}" TextTrimming="CharacterEllipsis">
                        <Run Text="Desktop Connector project folder:"/>
                        <Run Text="{Binding ProjectRoot, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Count tiles (each one is a filter) -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="IN THE MODEL"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Tile}" Tag="Loaded" ToolTip="Show loaded links">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="#1B5E20" Text="{Binding LoadedCount}"/><TextBlock Text="Loaded"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="Unloaded" ToolTip="Unloaded for everyone, for you only, or in a closed workset">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding UnloadedCount}"/><TextBlock Text="Unloaded"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="NotFound" ToolTip="Revit cannot find the file at its saved path">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="#B71C1C" Text="{Binding NotFoundCount}"/><TextBlock Text="Not found"/></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="ON THIS PC (DESKTOP CONNECTOR)"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Tile}" Tag="AlwaysKept" ToolTip="Full green: Always keep on this device">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconAlwaysKept}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding AlwaysKeptCount}"/><TextBlock Text="Always kept"/></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="Available" ToolTip="Green outline: downloaded, but Windows may free it up">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconAvailable}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding AvailableCount}"/><TextBlock Text="Available locally"/></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="OnlineOnly" ToolTip="Cloud: only a placeholder is on this PC">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconOnline}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding OnlineOnlyCount}"/><TextBlock Text="Online only"/></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="SyncPending" ToolTip="Desktop Connector is still syncing">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconSync}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding SyncPendingCount}"/><TextBlock Text="Sync pending"/></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="OtherDc" ToolTip="Not on this PC, not a cloud file, or Windows did not say">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconOther}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding OtherDcCount}"/><TextBlock Text="Missing / other"/></StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource GroupLabel}" Text="LATEST FROM ACC?"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Tile}" Tag="UpToDate" ToolTip="Loaded copy is the file Desktop Connector has">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="#1B5E20" Text="{Binding UpToDateCount}"/><TextBlock Text="Up to date"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="ReloadNeeded" ToolTip="A newer save is on this PC than the copy loaded in the model">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="#8A4B00" Text="{Binding ReloadNeededCount}"/><TextBlock Text="Reload needed"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="LatestUnknown" ToolTip="Could not compare yet — see the note on the selected link">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding LatestUnknownCount}"/><TextBlock Text="Unknown"/></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Grey}" VerticalAlignment="Center" Text="{Binding ShowingText}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="220" Height="26" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by link name"/>
                    <CheckBox Content="Problems only" IsChecked="{Binding ProblemsOnly}" VerticalAlignment="Center" Margin="16,0,0,0"
                              ToolTip="Not loaded, not kept on this PC, sync pending, or reload needed"/>
                    <TextBlock Text="Click a count above to filter; click it again to clear." Foreground="{StaticResource Grey}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Grid -->
        <Grid Grid.Row="3">
            <DataGrid ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F1F3"
                      BorderThickness="0" RowHeight="28" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Link name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTemplateColumn Header="In model" Width="130" SortMemberPath="ModelText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModelPill}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ModelPillText}" Text="{Binding ModelText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="On this PC (DC)" Width="160" SortMemberPath="DcSort">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource DcIcon}" Content="{Binding}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DcText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Latest from ACC?" Width="130" SortMemberPath="LatestText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource LatestText}" Text="{Binding LatestText}" ToolTip="{Binding LatestReason}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Folder in ACC" Binding="{Binding AccFolder}" Width="1.3*"/>
                    <DataGridTextColumn Header="Local file date" Binding="{Binding FileDateText}" SortMemberPath="FileDate" Width="120"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeMb" Width="80"/>
                    <DataGridTextColumn Header="Instances" Binding="{Binding Instances}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource Grey}" FontSize="14" TextWrapping="Wrap" MaxWidth="520"
                       Text="This model has no Revit links from Desktop Connector. Only .rvt links stored under an ACCDocs folder are listed."/>
        </Grid>

        <!-- Selected link: details and actions -->
        <Border Grid.Row="4" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Width="520" Margin="24,0,0,0">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="ACTIONS ON THE SELECTED LINK"/>
                    <WrapPanel>
                        <Button Style="{StaticResource Btn}" Content="Reload" Command="{Binding ReloadCommand}"
                                ToolTip="Reload the link from its file. A link unloaded only for you is restored."/>
                        <Button Style="{StaticResource Btn}" Content="Unload" Command="{Binding UnloadCommand}"
                                ToolTip="Workshared model: unloads for you only. Otherwise unloads for everyone."/>
                        <Button Style="{StaticResource Btn}" Content="Always keep on this device" Command="{Binding AlwaysKeepCommand}"
                                ToolTip="Pin the file so Desktop Connector downloads it and keeps it current."/>
                        <Button Style="{StaticResource Btn}" Content="Open folder" Command="{Binding OpenFolderCommand}"/>
                    </WrapPanel>
                </StackPanel>

                <Grid>
                    <TextBlock Foreground="{StaticResource Grey}" VerticalAlignment="Center" Text="Select a link to see its details.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Opacity" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel DataContext="{Binding Selected}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}">
                            <Run Text="In model:"/> <Run Text="{Binding ModelText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" · On this PC:"/> <Run Text="{Binding DcText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="—"/> <Run Text="{Binding DcExplain, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}">
                            <Run Text="Latest from ACC:"/> <Run Text="{Binding LatestText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="—"/> <Run Text="{Binding LatestReason, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="#B71C1C" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding OwnedBy, StringFormat='Being edited by {0} — Reload / Unload for everyone is blocked until they relinquish it.'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OwnedBy}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource Grey}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="5" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="12,0,0,0" Height="26" Content="Close" Click="Close_Click" IsCancel="True"/>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Grey}" FontSize="12" VerticalAlignment="Center" Text="{Binding FooterText}"/>
                <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
