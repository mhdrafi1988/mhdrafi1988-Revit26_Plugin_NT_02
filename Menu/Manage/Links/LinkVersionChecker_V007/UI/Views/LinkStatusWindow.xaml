<Window x:Class="Revit26_Plugin_Revised.LinkVersionChecker.V007.UI.Views.LinkStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Revit26_Plugin_Revised.LinkVersionChecker.V007.UI.Views"
        Title="Link Version Checker — ACC links (Desktop Connector + Cloud)"
        Width="1240" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Background="White" Foreground="#1F2937">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <v:EqualsMultiConverter x:Key="EqualsMulti"/>

        <SolidColorBrush x:Key="Blue" Color="#0B6BCB"/>
        <SolidColorBrush x:Key="Green" Color="#2E7D32"/>
        <SolidColorBrush x:Key="Grey" Color="#4B5563"/>
        <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Purple" Color="#6D28D9"/>

        <!-- Plain button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#0B6BCB"/>
            <Setter Property="BorderBrush" Value="#0B6BCB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Count tile: a button that toggles a filter; highlighted while its filter is active -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Command" Value="{Binding DataContext.SetTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EqualsMulti}">
                                        <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="DataContext.ActiveTile" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Bd" Property="Background" Value="#E6F0FB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B6BCB"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Desktop Connector icons, 14 x 14, as in Explorer. On a selected grid row they turn white
             so they stay visible on the selection (in the tiles there is no row, so they keep their colours). -->
        <DataTemplate x:Key="IconAlwaysKept">
            <Grid Width="14" Height="14">
                <Ellipse x:Name="Disc" Fill="#2E7D32"/>
                <Path x:Name="Tick" Data="M3.6,7.2 L6,9.6 L10.5,4.6" Stroke="White" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter TargetName="Disc" Property="Fill" Value="White"/>
                    <Setter TargetName="Tick" Property="Stroke" Value="#0B6BCB"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IconAvailable">
            <Grid Width="14" Height="14">
                <Ellipse x:Name="Ring" Fill="White" Stroke="#2E7D32" StrokeThickness="1.3"/>
                <Path x:Name="Tick" Data="M3.6,7.2 L6,9.6 L10.5,4.6" Stroke="#2E7D32" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter TargetName="Ring" Property="Fill" Value="Transparent"/>
                    <Setter TargetName="Ring" Property="Stroke" Value="White"/>
                    <Setter TargetName="Tick" Property="Stroke" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IconOnline">
            <Grid Width="14" Height="14">
                <Path x:Name="Cloud" Data="M3.8,11.5 L10.4,11.5 A2.4,2.4 0 0 0 10.7,6.7 A3.7,3.7 0 0 0 3.7,6 A2.75,2.75 0 0 0 3.8,11.5 Z"
                      Stroke="#0B6BCB" StrokeThickness="1.3"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter TargetName="Cloud" Property="Stroke" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IconSync">
            <Grid Width="14" Height="14">
                <Path x:Name="Arrows" Data="M11.6,6 A4.8,4.8 0 0 0 3,4.6 M2.4,8 A4.8,4.8 0 0 0 11,9.4 M11.8,2.4 L11.8,6 L8.2,6 M2.2,11.6 L2.2,8 L5.8,8"
                      Stroke="#0B6BCB" StrokeThickness="1.3"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter TargetName="Arrows" Property="Stroke" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IconOther">
            <Grid Width="14" Height="14">
                <Ellipse x:Name="Dots" Stroke="#9CA3AF" StrokeThickness="1.3" StrokeDashArray="1.5 1.5"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter TargetName="Dots" Property="Stroke" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Picks the icon from the row's DcText -->
        <Style x:Key="DcIcon" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconOther}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DcText}" Value="Always kept">
                    <Setter Property="ContentTemplate" Value="{StaticResource IconAlwaysKept}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DcText}" Value="Available locally">
                    <Setter Property="ContentTemplate" Value="{StaticResource IconAvailable}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DcText}" Value="Online only">
                    <Setter Property="ContentTemplate" Value="{StaticResource IconOnline}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DcText}" Value="Sync pending">
                    <Setter Property="ContentTemplate" Value="{StaticResource IconSync}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pill for the "In model" column -->
        <Style x:Key="ModelPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModelText}" Value="Loaded">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ModelText}" Value="Not found">
                    <Setter Property="Background" Value="#FDECEA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelPillText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModelText}" Value="Loaded">
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ModelText}" Value="Not found">
                    <Setter Property="Foreground" Value="#B71C1C"/>
                </DataTrigger>
                <!-- Selected row: white text on the selection highlight (last, so it wins) -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Badge for the "Source" column -->
        <Style x:Key="SourceBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="DesktopConnector">
                    <Setter Property="Background" Value="#E6F0FB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Cloud">
                    <Setter Property="Background" Value="#EDE9FE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SourceBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="DesktopConnector">
                    <Setter Property="Foreground" Value="#0B6BCB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Cloud">
                    <Setter Property="Foreground" Value="#6D28D9"/>
                </DataTrigger>
                <!-- Selected row: white text on the selection highlight (last, so it wins) -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Filter drop-down boxes -->
        <Style x:Key="FilterBox" TargetType="Border">
            <Setter Property="Margin" Value="0,0,12,6"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="DisplayMemberPath" Value="Text"/>
            <Setter Property="SelectedValuePath" Value="Value"/>
        </Style>

        <!-- Text colour for "Latest from ACC?" -->
        <Style x:Key="LatestText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LatestText}" Value="Yes">
                    <Setter Property="Foreground" Value="#1B5E20"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatestText}" Value="Reload needed">
                    <Setter Property="Foreground" Value="#8A4B00"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatestText}" Value="Sync pending">
                    <Setter Property="Foreground" Value="#0B6BCB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatestText}" Value="Newer in ACC">
                    <Setter Property="Foreground" Value="#8A4B00"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <!-- Selected row: white text on the selection highlight (last, so it wins) -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Date part of "Latest from ACC?" -->
        <Style x:Key="LatestDate" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <!-- Selected row: white text on the selection highlight (last, so it wins) -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0" Content="Export to Excel" Command="{Binding ExportCommand}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Check cloud versions" Command="{Binding CheckCloudCommand}"
                        ToolTip="Ask ACC whether each loaded cloud link is the current version. Needs a connection and a signed-in session; one request per cloud link."/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Refresh" Command="{Binding RefreshCommand}"/>
                <StackPanel>
                    <TextBlock Text="{Binding HostName}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource Grey}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectRoot}">
                        <Run Text="ACC project:"/>
                        <Run Text="{Binding HostProjectText, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" · Desktop Connector folder:"/>
                        <Run Text="{Binding ProjectRoot, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Count tiles (each one is a filter) -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="SOURCE"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Tile}" Tag="SrcDc" ToolTip="Saved path is inside an ACCDocs (Desktop Connector) folder">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="{StaticResource Blue}" Text="{Binding SrcDcCount}"/><TextBlock Text="Desktop Connector"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="SrcCloud" ToolTip="Saved as an Autodesk Docs:// or BIM 360:// cloud link">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="{StaticResource Purple}" Text="{Binding SrcCloudCount}"/><TextBlock Text="Cloud link"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="SrcOther" ToolTip="Network share or local file, not in ACC. Click to list them.">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding SrcOtherCount}"/><TextBlock Text="Other path"/></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="IN THE MODEL"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Tile}" Tag="Loaded" ToolTip="Show loaded links">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="#1B5E20" Text="{Binding LoadedCount}"/><TextBlock Text="Loaded"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="Unloaded" ToolTip="Unloaded for everyone, for you only, or in a closed workset">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding UnloadedCount}"/><TextBlock Text="Unloaded"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="NotFound" ToolTip="Revit cannot find the file at its saved path">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="#B71C1C" Text="{Binding NotFoundCount}"/><TextBlock Text="Not found"/></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="ON THIS PC (DESKTOP CONNECTOR)"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Tile}" Tag="AlwaysKept" ToolTip="Full green: Always keep on this device">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconAlwaysKept}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding AlwaysKeptCount}"/><TextBlock Text="Always kept"/></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="Available" ToolTip="Green outline: downloaded, but Windows may free it up">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconAvailable}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding AvailableCount}"/><TextBlock Text="Available locally"/></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="OnlineOnly" ToolTip="Cloud: only a placeholder is on this PC">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconOnline}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding OnlineOnlyCount}"/><TextBlock Text="Online only"/></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="SyncPending" ToolTip="Desktop Connector is still syncing">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconSync}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding SyncPendingCount}"/><TextBlock Text="Sync pending"/></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="OtherDc" ToolTip="Not on this PC, not a cloud file, a cloud link with no Desktop Connector copy, or Windows did not say">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IconOther}" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding OtherDcCount}"/><TextBlock Text="Missing / no DC copy"/></StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource GroupLabel}" Text="LATEST FROM ACC?"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Tile}" Tag="UpToDate" ToolTip="Loaded copy is the file Desktop Connector has, or ACC says it is current">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="#1B5E20" Text="{Binding UpToDateCount}"/><TextBlock Text="Up to date"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="ReloadNeeded" ToolTip="A newer save is on this PC, or a newer version is published in ACC, than the copy loaded in the model">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Foreground="#8A4B00" Text="{Binding ReloadNeededCount}"/><TextBlock Text="Reload needed"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="LatestUnknown" ToolTip="Could not compare yet — see the note on the selected link">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding LatestUnknownCount}"/><TextBlock Text="Unknown"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Tag="NotChecked" ToolTip="Loaded cloud links not asked yet — press Check cloud versions">
                            <StackPanel><TextBlock Style="{StaticResource TileNum}" Text="{Binding NotCheckedCount}"/><TextBlock Text="Not checked"/></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,8,16,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,6" VerticalAlignment="Top">
                    <TextBlock Foreground="{StaticResource Grey}" HorizontalAlignment="Right" Text="{Binding ShowingText}"/>
                    <Button Style="{StaticResource Btn}" Height="26" Margin="0,6,0,0" HorizontalAlignment="Right" Content="Clear filters"
                            Command="{Binding ClearFiltersCommand}" ToolTip="Clear every filter and the selected count tile"/>
                </StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="200" Height="26" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter by link name or full path"/>
                    </StackPanel>
                    <Border Style="{StaticResource FilterBox}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Source" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="140" ItemsSource="{Binding SourceOptions}" SelectedValue="{Binding SourceFilter, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FilterBox}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ACC project" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="200" ItemsSource="{Binding ProjectOptions}" SelectedValue="{Binding ProjectFilter, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FilterBox}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Folder" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="180" ItemsSource="{Binding FolderOptions}" SelectedValue="{Binding FolderFilter, Mode=TwoWay}"
                                      ToolTip="A folder and every folder below it"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FilterBox}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="In model" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="130" ItemsSource="{Binding ModelOptions}" SelectedValue="{Binding ModelFilter, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FilterBox}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Latest" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="170" ItemsSource="{Binding LatestOptions}" SelectedValue="{Binding LatestFilter, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="Problems only" IsChecked="{Binding ProblemsOnly}" VerticalAlignment="Center" Margin="0,0,12,6"
                              ToolTip="Not loaded, not kept on this PC, sync pending, reload needed, or newer in ACC"/>
                    <CheckBox Content="Show other links" IsChecked="{Binding ShowOtherLinks}" VerticalAlignment="Center" Margin="0,0,12,6"
                              ToolTip="Also list .rvt links on a network share or this PC (not in ACC). Remembered per user."/>
                    <Border Style="{StaticResource FilterBox}"
                            ToolTip="How the Folder in ACC column is shortened. Hover a folder, or right-click → Copy full path, for the full path.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Folder display" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="130" Height="26" VerticalContentAlignment="Center" SelectedIndex="{Binding FolderModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Last N folders"/>
                                <ComboBoxItem Content="First N folders"/>
                                <ComboBoxItem Content="Full folder"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0" Visibility="{Binding ShowFolderDepth, Converter={StaticResource BoolToVis}}">
                                <Button Width="26" Height="26" Content="−" Command="{Binding FolderLessCommand}" ToolTip="Fewer folder names"/>
                                <TextBlock Text="{Binding FolderDepth}" MinWidth="22" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Width="26" Height="26" Content="+" Command="{Binding FolderMoreCommand}" ToolTip="More folder names"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Active filters as removable chips -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,5"
                Visibility="{Binding HasChips, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#E6F0FB" CornerRadius="10" Padding="9,1,3,1" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource Blue}" VerticalAlignment="Center"/>
                                <Button Content="✕" Margin="4,0,0,0" Padding="3,0" Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource Blue}" Cursor="Hand" ToolTip="Remove this filter"
                                        Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Grid -->
        <Grid Grid.Row="4">
            <DataGrid x:Name="LinkGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      SelectionChanged="LinkGrid_SelectionChanged"
                      SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F1F3"
                      BorderThickness="0" RowHeight="28" Background="White">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Copy full path" Command="{Binding CopyPathCommand}"/>
                        <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}"/>
                        <MenuItem Header="Always keep on this device" Command="{Binding AlwaysKeepCommand}"/>
                        <MenuItem Header="Filter to this folder" Command="{Binding FilterToFolderCommand}"/>
                        <MenuItem Header="Filter to this ACC project" Command="{Binding FilterToProjectCommand}"/>
                        <Separator/>
                        <MenuItem Header="Reload (one link)" Command="{Binding ReloadCommand}"/>
                        <MenuItem Header="Unload (one link)" Command="{Binding UnloadCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Link name" Width="2*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Source" Width="135" SortMemberPath="SourceText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SourceBadge}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SourceBadgeText}" Text="{Binding SourceText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="In model" Width="130" SortMemberPath="ModelText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModelPill}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ModelPillText}" Text="{Binding ModelText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="On this PC (DC)" Width="160" SortMemberPath="DcSort">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding DcTip}">
                                    <ContentControl Style="{StaticResource DcIcon}" Content="{Binding}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DcText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="230" SortMemberPath="LatestText">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock ToolTip="Status of the loaded copy, then the date and time of the latest version (Date modified of the Desktop Connector file)">
                                    <Run Text="Latest from ACC?"/> <Run Text="status · latest version" Foreground="#6B7280"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource LatestText}" Text="{Binding LatestText}" ToolTip="{Binding LatestReason}" MinWidth="96"/>
                                    <TextBlock Style="{StaticResource LatestDate}" Text="{Binding FileDateText}" ToolTip="{Binding LatestDateTip}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="1.3*" SortMemberPath="AccFolder">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.FolderHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FolderShown}" ToolTip="{Binding AccFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeMb" Width="80"/>
                    <DataGridTextColumn Header="Instances" Binding="{Binding Instances}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource Grey}" FontSize="14" TextWrapping="Wrap" MaxWidth="560"
                       Text="{Binding EmptyText}"/>
        </Grid>

        <!-- Selected link: details and actions -->
        <Border Grid.Row="5" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Width="520" Margin="24,0,0,0">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="ACTIONS ON THE SELECTED LINKS"/>
                    <WrapPanel>
                        <Button Style="{StaticResource Btn}" Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,8,6"
                                ToolTip="One link only. Reload the link from its file; a link unloaded only for you is restored."/>
                        <Button Style="{StaticResource Btn}" Content="Unload" Command="{Binding UnloadCommand}" Margin="0,0,8,6"
                                ToolTip="One link only. Workshared model: unloads for you only. Otherwise unloads for everyone."/>
                        <Button Style="{StaticResource Btn}" Content="Always keep on this device" Command="{Binding AlwaysKeepCommand}" Margin="0,0,8,6"
                                ToolTip="Every selected Desktop Connector file: pin it so Desktop Connector downloads it and keeps it current."/>
                        <Button Style="{StaticResource Btn}" Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,6"
                                ToolTip="One Explorer window per folder, with the selected files highlighted. Cloud links have no folder on this PC."/>
                        <Button Style="{StaticResource Btn}" Content="Copy full path" Command="{Binding CopyPathCommand}" Margin="0,0,8,6"
                                ToolTip="Copy the full path of every selected link, one per line."/>
                    </WrapPanel>
                </StackPanel>

                <Grid>
                    <TextBlock Foreground="{StaticResource Grey}" VerticalAlignment="Center" Text="Select a link to see its details.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMultiSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Visibility="{Binding IsMultiSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding Selection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource Grey}" FontFamily="Consolas" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel DataContext="{Binding Selected}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}">
                            <Run Text="In model:"/> <Run Text="{Binding ModelText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" · Source:"/> <Run Text="{Binding SourceText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" · On this PC:"/> <Run Text="{Binding DcText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="—"/> <Run Text="{Binding DcExplain, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}">
                            <Run Text="Latest from ACC:"/> <Run Text="{Binding LatestText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" · latest version"/> <Run Text="{Binding FileDateText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="—"/> <Run Text="{Binding LatestReason, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource Grey}" TextWrapping="Wrap" Text="{Binding CloudDetail}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CloudDetail}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource Grey}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DcCopyText}" Text="{Binding DcCopyText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DcCopyText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#B71C1C" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding OwnedBy, StringFormat='Being edited by {0} — Reload / Unload for everyone is blocked until they relinquish it.'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OwnedBy}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource Grey}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="6" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="12,0,0,0" Height="26" Content="Close" Click="Close_Click" IsCancel="True"/>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Grey}" FontSize="12" VerticalAlignment="Center" Text="{Binding FooterText}"/>
                <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
