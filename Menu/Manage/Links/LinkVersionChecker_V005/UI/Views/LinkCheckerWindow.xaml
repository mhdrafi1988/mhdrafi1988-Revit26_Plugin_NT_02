<Window x:Class="Revit26_Plugin_Revised.LinkVersionChecker_V005.UI.Views.LinkCheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Revit26_Plugin_Revised.LinkVersionChecker_V005.UI.Infrastructure"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.LinkVersionCheckerV005}, Path=Title}"
        Width="1280" Height="800" MinWidth="1280" MinHeight="800" MaxWidth="1664" MaxHeight="1040" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12.5" Background="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}"/>

        <SolidColorBrush x:Key="Accent" Color="#0B6BCB"/>
        <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Head" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource Head}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SideBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Padding="14,6" Background="Transparent" Cursor="Hand">
                            <TextBlock x:Name="tx" Text="{TemplateBinding Content}" Foreground="#1F2937"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B6BCB"/>
                                <Setter TargetName="tx" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="tx" Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="CardNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="K" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style x:Key="V" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <!-- Check pill coloured by severity -->
        <DataTemplate x:Key="CheckPill">
            <Border x:Name="pill" CornerRadius="9" Padding="8,1" Background="#E8F5E9" HorizontalAlignment="Left">
                <TextBlock x:Name="txt" Text="{Binding CheckText}" FontWeight="SemiBold" FontSize="11.5" Foreground="#2E7D32"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter TargetName="pill" Property="Background" Value="#FDECEA"/>
                    <Setter TargetName="txt" Property="Foreground" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="pill" Property="Background" Value="#FFF4E0"/>
                    <Setter TargetName="txt" Property="Foreground" Value="#B26A00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info">
                    <Setter TargetName="pill" Property="Background" Value="#E6F0FB"/>
                    <Setter TargetName="txt" Property="Foreground" Value="#0B6BCB"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ModeText}" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource ModeRadio}" Content="Pre-Open" GroupName="Mode" IsChecked="{Binding IsPreOpen, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ModeRadio}" Content="In-Model" GroupName="Mode" IsChecked="{Binding IsInModel, Mode=TwoWay}" IsEnabled="{Binding HasActiveDoc}"/>
                                <RadioButton Style="{StaticResource ModeRadio}" Content="Folder Audit" GroupName="Mode" IsChecked="{Binding IsFolder, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0" Content="Export to Excel" Command="{Binding ExportCommand}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Scan" Command="{Binding ScanCommand}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Check Cloud Status" Command="{Binding CheckSyncCommand}"
                                ToolTip="Ask ACC whether each cloud link is the current version. In-Model only — Pre-Open and Folder Audit have no Revit session to ask with. Cancellable; rows not reached stay &quot;Not checked&quot;."/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Browse…" Command="{Binding BrowseCommand}"/>
                        <Grid Margin="0,0,8,0">
                            <ComboBox IsEditable="True" ItemsSource="{Binding RecentHosts}"
                                      Text="{Binding HostPath, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding IsPreOpen, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Host model (.rvt) — recent files in the list" VerticalContentAlignment="Center"/>
                            <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                     Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                                     ToolTip="Project folder to audit" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveDocTitle}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Visibility="{Binding IsInModel, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,14,0"
                                      Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                            <CheckBox Content="Include nested links" IsChecked="{Binding IncludeNested}"
                                      Visibility="{Binding IsNotInModel, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Summary cards -->
            <Grid DockPanel.Dock="Top" Margin="12,12,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Text="{Binding CountTotal}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="Linked Files"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Foreground="#0B6BCB" Text="{Binding CountAcc}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="From ACC"/></StackPanel>
                </Border>
                <!-- V005: the two ACC sync tiles -->
                <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="#0B6BCB"
                        ToolTip="ACC links whose version is behind the one published in ACC. Needs In-Model and the Check Cloud Status button.">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Foreground="#B26A00" Text="{Binding CountOutOfDate}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="Out Of Date"/>
                        <TextBlock Style="{StaticResource CardLbl}" FontSize="10.5" Text="{Binding SyncCheckText}"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" BorderBrush="#0B6BCB"
                        ToolTip="Desktop Connector / OneDrive files that are still placeholders on this PC — the first open pays for the download.">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Foreground="#B26A00" Text="{Binding CountNotDownloaded}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="Not Downloaded"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Text="{Binding CountDisk}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="On Disk"/></StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Foreground="#C62828" Text="{Binding CountUpgrade}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="Temporary Upgrades"/></StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Foreground="#B26A00" Text="{Binding CountIfc}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="IFC Cache Issues"/></StackPanel>
                </Border>
                <Border Grid.Column="7" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Foreground="#C62828" Text="{Binding CountMissing}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="Not Found"/></StackPanel>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Foreground="#B26A00" Text="{Binding EstTotalText}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="Est. Extra Load Time"/></StackPanel>
                </Border>
                <Border Grid.Column="9" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Style="{StaticResource CardNum}" Foreground="#0B6BCB" Text="{Binding MeasuredHostText}"/>
                        <TextBlock Style="{StaticResource CardLbl}" Text="{Binding MeasuredHostSub}"/></StackPanel>
                </Border>
            </Grid>

            <!-- Filters + check helpers -->
            <DockPanel DockPanel.Dock="Top" Margin="12,10,12,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkBtn}" Content="Tick problems" Command="{Binding CheckProblemsCommand}"/>
                    <Button Style="{StaticResource LinkBtn}" Content="Tick all shown" Command="{Binding CheckVisibleCommand}"/>
                    <Button Style="{StaticResource LinkBtn}" Margin="0" Content="Clear ticks" Command="{Binding ClearChecksCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- V005: overrides every other filter; the rest grey out while it is on -->
                    <Border BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="6" Background="#E8F5E9" Padding="7,3" Margin="0,0,14,0">
                        <CheckBox Content="ACC links only" IsChecked="{Binding AccOnly}" FontWeight="SemiBold" VerticalAlignment="Center"
                                  ToolTip="Show only ACC-sourced links (ACC this project, ACC other project, legacy BIM 360 and Desktop Connector). While this is on it OVERRIDES every other filter, including the search box."/>
                    </Border>
                  <StackPanel Orientation="Horizontal" IsEnabled="{Binding FiltersEnabled}">
                    <CheckBox Content="Problems only" IsChecked="{Binding FilterProblems}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox Content="Upgrade needed only" IsChecked="{Binding FilterUpgrade}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SourceFilter, Mode=TwoWay}"
                              IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              Width="200" Margin="0,0,14,0"
                              ToolTip="Where the link lives. Pick a group (ACC, On disk, Server, No file) or one value. Type to search."/>
                    <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter, Mode=TwoWay}"
                              IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              Width="140" Margin="0,0,14,0"/>
                    <CheckBox Content="Available only" IsChecked="{Binding AvailableOnly}" VerticalAlignment="Center" Margin="0,0,14,0"
                              ToolTip="Ticked: the Source and Type lists show only the values found in this scan. Unticked: every possible value, zero counts included."/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding HostOptions}" SelectedItem="{Binding HostFilter}" Width="180" Margin="0,0,14,0"/>
                    </StackPanel>
                    <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="4,3"/>
                  </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Grid + side panel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0" ItemsSource="{Binding LinksView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Line}" BorderBrush="{StaticResource Line}"
                          RowHeight="28" CanUserAddRows="False" CanUserDeleteRows="False" Background="White"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource Head}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="✓" Width="34" SortMemberPath="IsChecked">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              PreviewMouseLeftButtonDown="CheckBoxCell_PreviewMouseLeftButtonDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.ShowHostColumn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*" SortMemberPath="Name" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="Auto" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Source" Width="Auto" SortMemberPath="SourceText" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourceText}" Foreground="{Binding SourceColour}" FontWeight="SemiBold"
                                               ToolTip="{Binding SourceTip}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- V005: ACC Docs status — green radio dot + text, sorted problems-first -->
                        <DataGridTemplateColumn Width="Auto" SortMemberPath="SyncSortOrder" IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="ACC Docs" ToolTip="ACC Docs status. Filled green: current / on this PC. Hollow green: not downloaded. Amber: out of date. Red: failed. Grey ring: not checked yet. Faint ring: not an ACC link."/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding SyncTip}">
                                        <shell:AccStatusDot State="{Binding AccDot}" AutoToolTip="False" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding SyncCellText}" Foreground="{Binding SyncColour}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Saved In" Binding="{Binding SavedInText}" Width="Auto" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Check" CellTemplate="{StaticResource CheckPill}" SortMemberPath="Severity" Width="Auto"/>
                        <DataGridTextColumn Header="Workshared" Binding="{Binding WorksharedText}" Width="Auto" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeMb" Width="Auto" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding PathText}" Width="Auto" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Est." Binding="{Binding EstText}" SortMemberPath="EstSeconds" Width="Auto" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Measured" Binding="{Binding MeasuredText}" SortMemberPath="MeasuredSeconds" Width="Auto" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="1" Background="{StaticResource Head}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <!-- Actions (always visible, batch-aware) -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding TargetText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SideBtn}" Content="Upgrade &amp; Save to current version" Command="{Binding UpgradeCommand}"/>
                                <Button Style="{StaticResource SideBtn}" Content="Rebuild IFC cache" Command="{Binding RebuildIfcCommand}"/>
                                <Button Style="{StaticResource SideBtn}" Content="{Binding SkipLoadText}" Command="{Binding SkipLoadCommand}"/>
                                <Button Style="{StaticResource SideBtn}" Content="Repath selected…" Command="{Binding RepathCommand}"/>
                                <Button Style="{StaticResource SideBtn}" Content="Open folder" Command="{Binding OpenFolderCommand}"/>
                                <Button Style="{StaticResource SideBtn}" Margin="0" Content="Copy cloud reference info" Command="{Binding CopyCloudInfoCommand}"
                                        ToolTip="Copies everything Revit will say about this cloud reference — version, status, server id and every GetReferenceInformation() key — to the clipboard."/>
                            </StackPanel>
                        </Border>

                        <!-- Details -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <TextBlock Text="Select a link to see details and recommendations."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel DataContext="{Binding Selected}"
                                            Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CheckPill}" Margin="0,4,0,0"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Style="{StaticResource K}" Text="Host"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource V}" Text="{Binding HostName}"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource K}" Text="Type"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource V}" Text="{Binding KindText}"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource K}" Text="Saved in"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource V}" Text="{Binding SavedInText}"/>
                                        <TextBlock Grid.Row="3" Style="{StaticResource K}" Text="Workshared"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource V}" Text="{Binding WorksharedText}"/>
                                        <TextBlock Grid.Row="4" Style="{StaticResource K}" Text="Size"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource V}" Text="{Binding SizeText}"/>
                                        <TextBlock Grid.Row="5" Style="{StaticResource K}" Text="Status"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource V}" Text="{Binding Status}"/>
                                        <TextBlock Grid.Row="6" Style="{StaticResource K}" Text="Attachment"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource V}" Text="{Binding Attachment}"/>
                                        <TextBlock Grid.Row="7" Style="{StaticResource K}" Text="Instances"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource V}" Text="{Binding InstancesText}"/>
                                        <TextBlock Grid.Row="8" Style="{StaticResource K}" Text="Worksets"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource V}" Text="{Binding WorksetsText}"/>
                                        <TextBlock Grid.Row="9" Style="{StaticResource K}" Text="IFC cache"/>
                                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource V}" Text="{Binding CacheText}"/>
                                        <TextBlock Grid.Row="10" Style="{StaticResource K}" Text="Est. / Measured"/>
                                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding EstText}"/>
                                            <TextBlock Text="  /  " Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding MeasuredText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="11" Style="{StaticResource K}" Text="Full path"/>
                                        <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding FullPath, Mode=OneWay}" IsReadOnly="True"
                                                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,2"/>
                                        <TextBlock Grid.Row="12" Style="{StaticResource K}" Text="Source"/>
                                        <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource V}" Text="{Binding SourceText}"
                                                   Foreground="{Binding SourceColour}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="13" Style="{StaticResource K}" Text="Detected by"/>
                                        <TextBlock Grid.Row="13" Grid.Column="1" Style="{StaticResource V}" Text="{Binding SourceDetectedBy}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="14" Style="{StaticResource K}" Text="Cloud ids"/>
                                        <TextBlock Grid.Row="14" Grid.Column="1" Style="{StaticResource V}" Text="{Binding CloudIdText}"
                                                   TextWrapping="Wrap"/>
                                        <!-- V005 -->
                                        <TextBlock Grid.Row="15" Style="{StaticResource K}" Text="ACC Docs"/>
                                        <StackPanel Grid.Row="15" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                            <shell:AccStatusDot State="{Binding AccDot}" AutoToolTip="False" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding SyncText}" Foreground="{Binding SyncColour}" FontWeight="SemiBold"
                                                       ToolTip="{Binding SyncTip}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="16" Style="{StaticResource K}" Text="Cloud version"/>
                                        <TextBlock Grid.Row="16" Grid.Column="1" Style="{StaticResource V}" Text="{Binding SyncVersionText}"/>
                                        <TextBlock Grid.Row="17" Style="{StaticResource K}" Text="Sync checked"/>
                                        <TextBlock Grid.Row="17" Grid.Column="1" Style="{StaticResource V}" Text="{Binding SyncCheckedText}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>

                                    <Border Background="White" BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0"
                                            CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Recommendations" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Progress overlay -->
        <Grid Background="#99FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Width="460" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Working…" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,10"/>
                    <ProgressBar Height="8" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Foreground="{StaticResource Accent}"/>
                    <Button Style="{StaticResource Btn}" Content="Cancel" Command="{Binding CancelCommand}"
                            HorizontalAlignment="Right" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
