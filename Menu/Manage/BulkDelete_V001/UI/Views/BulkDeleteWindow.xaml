<!--
=======================================================
File: BulkDeleteWindow.xaml  (Bulk Delete V001 - ToolWindowShell)
  HEADER  metric cards: items / can delete / to delete / locked
  BODY    what-to-delete + filter card, selection row, items grid, log
  FOOTER  Delete, Close
  DataContext: BulkDeleteViewModel. The grid, filter and counters bind through Table
  (DeleteTableViewModel). Everything above the log is disabled while Revit runs a job.
  Rows start unticked; Delete asks for confirmation (default No) before anything is removed.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.BulkDelete.V001.UI.Views.BulkDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="Bulk Delete"
        Width="960" Height="800"
        MinWidth="960" MinHeight="800"
        ResizeMode="CanResizeWithGrip"
        MaxWidth="1248" MaxHeight="1040"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally per suite convention -->
            <converters:InverseBoolConverter     x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>

            <!-- Dims rows that cannot be deleted (built-in, owned by another user) -->
            <Style x:Key="BulkDeleteRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter Property="Opacity" Value="0.55"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BulkStatusText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Delete">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Locked">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BulkStatusDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource BrushTextDisabled}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Delete">
                        <Setter Property="Fill" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GridCellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Bulk Delete"
                           Subtitle="Delete many line styles, line patterns, arrowheads or fill patterns at once"
                           Version="{Binding Source={x:Static svc:ToolCatalog.BulkDelete}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Items" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Table.TotalCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Can delete" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Table.DeletableCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="To delete" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Table.TickedCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Locked" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Table.LockedCount}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>

                <!-- Disabled while Revit runs a job (loading or deleting) -->
                <StackPanel IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}">

                    <!-- ══ What to delete + filter ══ -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="10,8,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="What to delete"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource StandardComboBox}" FontSize="12"
                                          ItemsSource="{Binding Sources}"
                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="Filter"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <TextBox Grid.Column="3" Style="{StaticResource StyledTextInput}"
                                         ToolTip="Shows only rows whose name contains this text. Only visible rows are ticked and deleted."
                                         Text="{Binding Table.FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="4" Content="Reload" Style="{StaticResource SmallSecondaryButton}"
                                        Margin="10,0,0,0" Command="{Binding ReloadCommand}"
                                        ToolTip="List the items again from the model. Clears the ticks."/>
                            </Grid>
                            <TextBlock Text="{Binding SourceDescription}" Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Margin="10,0,10,8"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ Selection row ══ -->
                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                            <Button Content="Select None" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SelectNoneCommand}" Margin="0,0,6,0"/>
                            <Button Content="Select Unused" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SelectUnusedCommand}"
                                    ToolTip="Tick the visible rows known to be unused and untick the rest. Usage is only known for line styles."/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                   Text="Only ticked rows that match the filter are deleted. Locked rows cannot be ticked."/>
                    </DockPanel>

                    <!-- ══ Names grid ══ -->
                    <Border Style="{StaticResource ContentCard}">
                        <DataGrid ItemsSource="{Binding Table.RowsView}"
                                  MinHeight="180"
                                  shell:ShellBehaviors.MaxHeightRatio="0.5"
                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                                  AlternationCount="2"
                                  RowStyle="{StaticResource BulkDeleteRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  Background="{StaticResource BrushSurfaceWindow}"
                                  BorderThickness="0"
                                  RowHeight="28"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>

                                <!-- Ticked -->
                                <DataGridTemplateColumn Header="☑" Width="36" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      PreviewMouseLeftButtonDown="CheckBoxCell_PreviewMouseLeftButtonDown"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Current name (read-only) -->
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name, Mode=OneWay}"
                                                    Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <!-- Details: Drafting / Model for fill patterns, arrow style for arrowheads, Built-in / Custom for line styles -->
                                <DataGridTextColumn Header="Details"
                                                    Binding="{Binding Details, Mode=OneWay}"
                                                    Width="100" IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Used By"
                                                    Binding="{Binding UsedBy, Mode=OneWay}"
                                                    Width="80" IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <!-- Status -->
                                <DataGridTemplateColumn Header="Status" Width="96" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        ToolTip="{Binding StatusMessage}">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                                         Style="{StaticResource BulkStatusDot}"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource BulkStatusText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <!-- ══ Log ══ -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLog_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ClearLogCommand}"/>
                                <Button Content="Export Log" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Click="ExportLog_Click"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                 MinHeight="90"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                        <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogTextDim}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold" Width="60"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding Message, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Text="Delete asks first, then removes every ticked row in one step. Ctrl+Z in Revit undoes it."/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Delete" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}" MinWidth="90" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
