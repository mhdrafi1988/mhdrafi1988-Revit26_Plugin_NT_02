<!--
=======================================================
File: AnnotationOverlapReportWindow.xaml (V001)
Annotation Overlap Report 1.0.0: report-only list of overlapping annotations of every type,
on the active view or a chosen batch of views and sheets. Left column: Scope, Annotation types,
Check overlaps. Right column: Show filters and the results grid grouped by view.
Footer: status, Export to Excel, Zoom to pair, Close.
Title / version read ToolCatalog.AnnotationOverlapReport.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.AnnotationOverlapReport.V001.UI.AnnotationOverlapReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.AnnotationOverlapReport}, Path=Title}"
        Width="980" Height="860"
        MinWidth="900" MinHeight="700"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Annotation Overlap Report"
                           Subtitle="Find overlapping annotations across views and sheets. Report only."
                           Version="{Binding Source={x:Static svc:ToolCatalog.AnnotationOverlapReport}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER: summary tiles ═════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Overlaps" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalOverlaps}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Views with overlaps" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ViewsWithOverlapsText}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Scanned" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalScanned}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Types checked" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TypesChecked}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: what to check -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Border Style="{StaticResource ContentCard}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Scope" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <RadioButton Content="Active view" GroupName="Scope" IsChecked="{Binding ActiveViewOnly}"
                                         IsEnabled="{Binding IsIdle}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Chosen views and sheets" GroupName="Scope"
                                             IsChecked="{Binding IsChosenScope}" IsEnabled="{Binding IsIdle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ScopeCountText}" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel IsEnabled="{Binding IsChosenScope}">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BoxedTextInput}" Margin="0,0,0,6"
                                         ToolTip="Type to filter the list of views and sheets"/>
                                <ListBox ItemsSource="{Binding ViewsView}" Height="170"
                                         shell:ShellBehaviors.ForwardMouseWheel="True"
                                         BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MetricLabel}" Margin="4,4,0,2"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <TextBlock Text="A sheet is checked through the annotations on it and the views placed on it."
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ContentCard}" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Annotation types" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectAllTypesCommand}" Margin="0,0,6,0"/>
                                    <Button Content="None" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectNoTypesCommand}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding TypesSummary}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ListBox ItemsSource="{Binding Types}" Height="220"
                                     shell:ShellBehaviors.ForwardMouseWheel="True"
                                     BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1" IsEnabled="{Binding CanCheck}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Content="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource BrushTextSecondary}"
                                                       Margin="8,0,4,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <CheckBox IsChecked="{Binding AcrossTypes}" IsEnabled="{Binding IsIdle}" Margin="0,8,0,0">
                                <TextBlock Text="Also check overlaps between different types" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="On by default, so a door tag over a text note is found."
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Check overlaps" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CheckOverlapsCommand}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Right column: results -->
                <StackPanel Grid.Column="1">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Show" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding SelectedTypeFilter}"
                                  Style="{StaticResource StandardComboBox}" MinWidth="150" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ViewFilterOptions}" SelectedItem="{Binding SelectedViewFilter}"
                                  Style="{StaticResource StandardComboBox}" MinWidth="170"/>
                        <TextBlock Grid.Column="3" Text="{Binding ResultSummary}" Style="{StaticResource HintText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                              MinHeight="300"
                              shell:ShellBehaviors.MaxHeightRatio="0.6"
                              shell:ShellBehaviors.ForwardMouseWheel="True"
                              Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                              CellStyle="{StaticResource StandardDataGridCell}"
                              RowStyle="{StaticResource StandardDataGridRow}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSystemTertiaryBackground}" Padding="7,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat=' · {0} overlap(s)'}"
                                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Annotation A" Binding="{Binding LabelA}" Width="2*"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdA}" Width="Auto"/>
                            <DataGridTextColumn Header="Annotation B" Binding="{Binding LabelB}" Width="2*"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdB}" Width="Auto"/>
                            <DataGridTextColumn Header="Overlap (mm)" Binding="{Binding OverlapMm, StringFormat={}{0:F1}}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Overlap is how far one annotation sits inside the other, in millimetres on paper. Double-click a row, or select it and press Zoom to pair."
                               Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel>
                <Border Background="{StaticResource BrushInputBackground}" BorderBrush="{StaticResource BrushStatusError}" BorderThickness="1"
                        CornerRadius="6" Padding="8" Margin="0,0,0,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushStatusError}" TextWrapping="Wrap"/>
                </Border>
                <Border Background="{StaticResource BrushStatusOkSoft}" BorderBrush="{StaticResource BrushStatusOkBorder}" BorderThickness="1"
                        CornerRadius="6" Padding="8" Margin="0,0,0,8"
                        Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding InfoMessage}" Foreground="{StaticResource BrushStatusOk}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Export to Excel" Style="{StaticResource OutlineButton}"
                            Command="{Binding ExportToExcelCommand}" MinWidth="130" Height="38" Margin="0,0,8,0"/>
                    <Button Content="Zoom to pair" Style="{StaticResource OutlineButton}"
                            Command="{Binding ZoomToPairCommand}" MinWidth="120" Height="38" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38" Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
