<!--
=======================================================
File: ParaManagerWindow.xaml
Changes vs V004 (layout only, per CLAUDE.md v1.1 — ToolWindowShell):
  - Window content is a shared ToolWindowShell:
      HEADER  title bar + V005, metrics bar and step indicator
      BODY    current step (outer ScrollViewer and the step-3 parameter
              list's own ScrollViewer removed), docked Activity Log
              (collapsible as before, now part of the body)
      FOOTER  status strip (IsRunning / Progress / SummaryLine — was the
              footer status line), step counter, Back · Next/Run → Close
  - Queue grid (fixed MaxHeight=300 replaced) and log:
    ShellBehaviors.MaxHeightRatio + ForwardMouseWheel.
  - No behaviour change — every binding/command is the V004 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.ParaManager.V005.Views.ParaManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:models="clr-namespace:Revit26_Plugin_Revised.ParaManager.V005.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.ParaManager}, Path=Title}"
        Height="720" Width="880"
        MinHeight="720" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushSurfaceWindow}"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally per convention — never in SharedStyles.xaml -->
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

            <!-- Step indicator visuals -->
            <Style x:Key="StepDot" TargetType="Border">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Background" Value="{StaticResource BrushNavyLight}"/>
            </Style>
            <Style x:Key="StepLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="ParaManager — Bulk Parameter Assignment"
                           Subtitle="Revit 2026"
                           Version="{Binding Source={x:Static svc:ToolCatalog.ParaManager}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryLine}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <StackPanel>
                <!-- ═══════════ METRICS BAR ═══════════ -->
                <Border Background="{StaticResource BrushNavyDark}" Padding="16,10" CornerRadius="6,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BrushNavyLight}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding MetricParamsFileCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                <TextBlock Text="Param File Loaded" FontSize="10.5" Foreground="{StaticResource BrushAppleBlueLight}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="6" Padding="10,8" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding MetricCategoriesSelected}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                <TextBlock Text="Categories Selected" FontSize="10.5" Foreground="{StaticResource BrushAppleBlueLight}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BrushNavyLight}" CornerRadius="6" Padding="10,8" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding MetricParametersSelected}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                <TextBlock Text="Parameters Selected" FontSize="10.5" Foreground="{StaticResource BrushAppleBlueLight}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{StaticResource BrushNavyLight}" CornerRadius="6" Padding="10,8" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding MetricAssignedThisSession}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                <TextBlock Text="Assigned This Session" FontSize="10.5" Foreground="{StaticResource BrushAppleBlueLight}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <!-- ═══════════ STEPPER ═══════════ -->
                <Border Background="{StaticResource BrushNavyDark}" Padding="16,4,16,12" CornerRadius="0,0,6,6" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <Button Command="{Binding GoToStepCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                    <Setter Property="Background" Value="{StaticResource BrushStatusOk}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="Background" Value="{StaticResource BrushStatusOk}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                    <Setter Property="Background" Value="{StaticResource BrushStatusOk}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                </Border>
                                <TextBlock Text="Source" Style="{StaticResource StepLabel}" Margin="6,0,0,0" Foreground="{StaticResource BrushTextOnDark}"/>
                            </StackPanel>
                        </Button>

                        <Border Width="28" Height="1" Background="{StaticResource BrushNavyLight}" Margin="8,0" VerticalAlignment="Center"/>

                        <Button Command="{Binding GoToStepCommand}" CommandParameter="2" Style="{StaticResource SecondaryButton}"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="Background" Value="{StaticResource BrushStatusOk}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                    <Setter Property="Background" Value="{StaticResource BrushStatusOk}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                </Border>
                                <TextBlock Text="Scope" Style="{StaticResource StepLabel}" Margin="6,0,0,0" Foreground="{StaticResource BrushTextOnDark}"/>
                            </StackPanel>
                        </Button>

                        <Border Width="28" Height="1" Background="{StaticResource BrushNavyLight}" Margin="8,0" VerticalAlignment="Center"/>

                        <Button Command="{Binding GoToStepCommand}" CommandParameter="3" Style="{StaticResource SecondaryButton}"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                    <Setter Property="Background" Value="{StaticResource BrushStatusOk}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                </Border>
                                <TextBlock Text="Parameters" Style="{StaticResource StepLabel}" Margin="6,0,0,0" Foreground="{StaticResource BrushTextOnDark}"/>
                            </StackPanel>
                        </Button>

                        <Border Width="28" Height="1" Background="{StaticResource BrushNavyLight}" Margin="8,0" VerticalAlignment="Center"/>

                        <Button Command="{Binding GoToStepCommand}" CommandParameter="4" Style="{StaticResource SecondaryButton}"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextOnAccent}"/>
                                </Border>
                                <TextBlock Text="Review &amp; Run" Style="{StaticResource StepLabel}" Margin="6,0,0,0" Foreground="{StaticResource BrushTextOnDark}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Grid>

                    <!-- ── STEP 1 — Source ── -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GroupBox Header="Shared Parameter File" Style="{StaticResource CardGroupBox}">
                            <StackPanel Margin="12,8,12,12">
                                <TextBlock Text="Load the shared parameter file this batch will assign from."
                                           Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource BrushSystemSecondaryBackground}"
                                            CornerRadius="4" Padding="8,6" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SharedParameterFilePath, TargetNullValue='No file selected'}"
                                                   Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource OutlineButton}"
                                            Command="{Binding BrowseSharedParameterFileCommand}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="Reload" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ReloadSharedParameterFileCommand}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- ── STEP 2 — Scope (Categories) ── -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GroupBox Header="Target Categories" Style="{StaticResource CardGroupBox}">
                            <StackPanel Margin="12,8,12,12">
                                <TextBlock Text="Choose which categories this batch will apply parameters to."
                                           Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsCategoryPopupOpen}"
                                                  Style="{StaticResource StageHeaderToggle}"
                                                  HorizontalAlignment="Stretch" Padding="8,6">
                                        <Grid>
                                            <TextBlock Text="{Binding SelectedCategories.Count, StringFormat='{}{0} categories selected'}"
                                                       Style="{StaticResource FieldValue}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="▾" Foreground="{StaticResource BrushTextTertiary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </ToggleButton>

                                    <Popup IsOpen="{Binding IsCategoryPopupOpen}" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                           Placement="Bottom" StaysOpen="False" Width="320">
                                        <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderDefault}"
                                                BorderThickness="1" CornerRadius="5"
                                                Effect="{x:Null}">
                                            <ItemsControl ItemsSource="{Binding AvailableCategories}" MaxHeight="260">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:CategoryInfo}">
                                                        <Button Command="{Binding DataContext.ToggleCategoryCommand,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                                Padding="10,6">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Popup>

                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ClearCategoriesCommand}" Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Chip row -->
                                <ItemsControl ItemsSource="{Binding SelectedCategories}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:CategoryInfo}">
                                            <Border Background="{StaticResource BrushNavyPrimary}" CornerRadius="10"
                                                    Padding="8,3" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextOnAccent}" FontSize="11"/>
                                                    <Button Content="✕" Margin="6,0,0,0" Background="Transparent"
                                                            BorderThickness="0" Foreground="{StaticResource BrushTextOnAccent}" Cursor="Hand"
                                                            FontSize="9"
                                                            Command="{Binding DataContext.RemoveCategoryCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- ── STEP 3 — Parameters ── -->
                    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GroupBox Header="Parameters to Assign" Style="{StaticResource CardGroupBox}">
                            <StackPanel Margin="12,8,12,12">
                                <TextBlock Text="Binding type is chosen once per Run (applies to the whole batch)."
                                           Style="{StaticResource HintText}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource StyledTextInput}" Width="220" HorizontalAlignment="Left"
                                             Text="{Binding ParameterFilterText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="25"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding SelectAllParametersCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Clear Selection" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding ClearParameterSelectionCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Grouped list -->
                                <ItemsControl ItemsSource="{Binding ParameterGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ParameterGroupNode}">
                                            <StackPanel>
                                                <Border Background="{StaticResource BrushSystemSecondaryBackground}" Padding="12,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontWeight="SemiBold"
                                                                   FontSize="11.5" Foreground="{StaticResource BrushNavyPrimary}"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ParameterCount, StringFormat='{}{0} params'}"
                                                                   Foreground="{StaticResource BrushTextTertiary}" FontSize="10.5"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Parameters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:ParameterLeafNode}">
                                                            <StackPanel Orientation="Horizontal" Margin="26,4,12,4">
                                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Parameter.Name}" Style="{StaticResource BodyText}"
                                                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Apply to Queue" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyParameterPopoverCommand}"
                                        HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- ── STEP 4 — Review & Run ── -->
                    <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GroupBox Header="Assignment Queue" Style="{StaticResource CardGroupBox}">
                            <StackPanel Margin="12,8,12,12">

                                <!-- Toolbar -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Style="{StaticResource StyledTextInput}" Width="220"
                                             Text="{Binding QueueFilterText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="25"/>
                                    <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Margin="8,0,0,0"
                                            Command="{Binding SelectAllQueueRowsCommand}"/>
                                    <Button Content="Clear Selection" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                            Command="{Binding ClearQueueSelectionCommand}"/>
                                    <Button Content="Refresh" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                            Command="{Binding RefreshQueueCommand}"/>
                                </StackPanel>

                                <!-- Revit group mapping: bulk-apply to ticked rows (each row can also be set in the grid) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Map ticked parameters to Revit group:" Style="{StaticResource HintText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}" Width="200"
                                              ItemsSource="{Binding RevitGroupOptions}"
                                              SelectedItem="{Binding BulkGroupOption}"
                                              DisplayMemberPath="Name"/>
                                    <Button Content="Apply to Selected" Style="{StaticResource SmallSecondaryButton}" Margin="8,0,0,0"
                                            Command="{Binding ApplyGroupToSelectedCommand}"/>
                                </StackPanel>

                                <!-- Advanced DataGrid -->
                                <DataGrid ItemsSource="{Binding QueueView}"
                                          Style="{StaticResource StandardDataGrid}"
                                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                          CellStyle="{StaticResource StandardDataGridCell}"
                                          RowStyle="{StaticResource StandardDataGridRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          MinHeight="160"
                                          shell:ShellBehaviors.MaxHeightRatio="0.4"
                                          shell:ShellBehaviors.ForwardMouseWheel="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Parameter Name" Binding="{Binding ParameterName}"
                                                             Width="1.6*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Group" Binding="{Binding ParameterGroup}"
                                                             Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}"
                                                             Width="1.4*" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Revit Group" Width="1.3*" SortMemberPath="TargetGroup.Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{StaticResource StandardComboBox}" Height="26" FontSize="12"
                                                              ItemsSource="{Binding DataContext.RevitGroupOptions,
                                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding TargetGroup, Mode=TwoWay}"
                                                              DisplayMemberPath="Name"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Binding" Binding="{Binding BindingTypeDisplay}"
                                                             Width="0.8*" IsReadOnly="True"/>

                                        <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Style="{StaticResource SmallSecondaryButton}"
                                                            Command="{Binding DataContext.RemoveQueueRowCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                </Grid>

                <!-- ═══════════ DOCKED ACTIVITY LOG ═══════════ -->
                <Border Background="{StaticResource BrushLogBg}" BorderThickness="0,1,0,0" CornerRadius="6" Margin="0,8,0,0"
                        BorderBrush="{StaticResource BrushSeparatorThin}">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsLogExpanded}" Command="{Binding ToggleLogExpandedCommand}"
                                      Background="Transparent" BorderThickness="0" Padding="16,8" Cursor="Hand"
                                      HorizontalContentAlignment="Stretch">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▾" Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Foreground="{StaticResource BrushLogTextDim}" FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="▸" Visibility="{Binding IsLogExpanded, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                               Foreground="{StaticResource BrushLogTextDim}" FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}" FontFamily="Consolas" FontSize="11"/>
                                    <Border Background="{StaticResource BrushAppleBlue}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                                            Visibility="{Binding UnreadLogCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UnreadLogCount, StringFormat='{}{0} new'}" Foreground="{StaticResource BrushTextOnDark}" FontSize="9.5" FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="docked · click to expand" Foreground="{StaticResource BrushLogTextDim}"
                                           FontFamily="Consolas" FontSize="9.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </ToggleButton>

                        <Border Padding="16,0,16,12" Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{StaticResource BrushLogBg}" CornerRadius="4" Padding="10,0">
                                    <ListBox ItemsSource="{Binding LogEntries}" MinHeight="120" shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True"
                                             Background="Transparent" BorderThickness="0"
                                             SelectionMode="Extended"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionChanged="LogListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss'}"
                                                               Foreground="{StaticResource BrushLogTextDim}" FontFamily="Consolas" FontSize="11"/>
                                                    <TextBlock Text="{Binding Level}" Margin="8,0"
                                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                               FontFamily="Consolas" FontWeight="Bold" FontSize="11"/>
                                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushLogText}"
                                                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Copy Selected" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CopySelectedLogCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Copy All" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CopyAllLogCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Export Logs (.txt)" Style="{StaticResource OutlineButton}"
                                            Command="{Binding ExportLogsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentStep, StringFormat='Step {0} of 4'}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◂ Back" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousStepCommand}" Margin="0,0,8,0"/>
                    <Button Content="Next ▸" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NextStepCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsStep4, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button Content="Run Assignment" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Height="38" Width="90" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
