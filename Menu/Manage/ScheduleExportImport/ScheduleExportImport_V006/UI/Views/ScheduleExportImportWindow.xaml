<!--
=======================================================
File: ScheduleExportImportWindow.xaml
Changes vs V005 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (navy title bar + version + Refresh,
    summary metrics card), middle (export / import actions, schedule list
    that fills and scrolls itself), fixed footer (log with Copy All /
    Copy Selected / Save / Clear, status line, Close).
  - Adds Copy Selected and a Close button; MinWidth/MinHeight = default.
  - No behaviour change — every binding/command is the V005 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.ScheduleExportImport.V006.UI.Views.ScheduleExportImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:vm="clr-namespace:Revit26_Plugin_Revised.ScheduleExportImport.V006.UI.ViewModels"
        Title="Schedule Export / Import — V006"
        Width="860" Height="800"
        MinWidth="860" MinHeight="800"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter             x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>

            <!-- Metric tile: big number coloured by Tone, label underneath -->
            <DataTemplate x:Key="SummaryCardTemplate" DataType="{x:Type vm:SummaryCard}">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0" Padding="10,8" ToolTip="{Binding Hint}">
                    <StackPanel>
                        <TextBlock x:Name="Num" Text="{Binding Value}" Style="{StaticResource MetricNumber}" FontSize="20"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabel}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Accent">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Success">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Warning">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushWarning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Danger">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushDanger}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="GridText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Style>

            <!-- Export / Import: identical shape and size, only the fill differs (green = export, red = import) -->
            <Style x:Key="ActionButtonBase" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="16,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ExportActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
                <Setter Property="Background" Value="#1E7E34"/>
            </Style>
            <Style x:Key="ImportActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
                <Setter Property="Background" Value="#C0392B"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Schedule Export / Import" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Export a schedule to Excel, edit the green columns, then import — you review every change before it is applied."
                                   Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <Button Content="↻ Refresh"
                                                Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding RefreshSchedulesCommand}"
                                                ToolTip="Reload the schedule list from the document"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="V006" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <!-- ══ Summary cards ══ -->
            <StackPanel Margin="12,10,12,8">
                <TextBlock Text="{Binding SummaryTitle}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="2,0,0,4"/>
                <ItemsControl ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource SummaryCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
            </Grid.RowDefinitions>
            <!-- ══ Actions: Export (green) and Import (red) on their own rows, same size, under the metric cards ══ -->
            <Border Grid.Row="0" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="⏳ Working…" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="Selected schedule:  " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <Run Text="{Binding SelectedSchedule.Name, Mode=OneWay, FallbackValue='tick a schedule below to export', TargetNullValue='tick a schedule below to export'}"
                                 FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                        </TextBlock>
                    </DockPanel>

                    <!-- Row 1 · Export -->
                    <Button Grid.Row="1" Grid.Column="0" Content="Export to Excel…" Style="{StaticResource ExportActionButton}"
                            Command="{Binding ExportScheduleCommand}"
                            ToolTip="Save the ticked schedule (Element ID + visible fields) as .xlsx. Green columns are editable, grey are locked."/>
                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="1 · Export the ticked schedule, then edit the green columns in Excel and save."
                                   FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="Open Exported File" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,8,0"
                                    Command="{Binding OpenExportedFileCommand}" ToolTip="Open the last exported workbook in Excel"/>
                            <CheckBox Content="Include hidden fields" IsChecked="{Binding IncludeHiddenFields, Mode=TwoWay}" VerticalAlignment="Center"
                                      FontSize="11" Margin="0,0,10,0" Foreground="{StaticResource BrushTextPrimary}"
                                      ToolTip="Also export the schedule's hidden fields, after the visible columns. Remembered for next time."/>
                            <TextBlock Text="{Binding LastExportedFile, Mode=OneWay}" FontSize="10" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushAppleBlue}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 2 · Import -->
                    <Button Grid.Row="3" Grid.Column="0" Content="Import from Excel…" Style="{StaticResource ImportActionButton}"
                            Command="{Binding ImportScheduleCommand}"
                            ToolTip="Save your edits in Excel (it can stay open), then import. A preview opens and nothing changes until you click Apply."/>
                    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="10.5"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Text="2 · Import the saved file. The schedule is picked from the file; review the preview, then Apply."/>
                </Grid>
            </Border>
            <!-- ══ Schedule list ══ -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Schedules in Document" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍 Search:" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Padding="6,4" VerticalContentAlignment="Center"
                                 ToolTip="Filter by schedule name or category"/>
                        <Button Grid.Column="2" Content="✕" Margin="6,0,0,0"
                                Style="{StaticResource SmallSecondaryButton}"
                                Command="{Binding ClearSearchCommand}" ToolTip="Clear search"/>
                    </Grid>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SchedulesView}"
                              SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              Background="{StaticResource BrushSystemBackground}"
                              BorderThickness="0" RowHeight="26"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <DataGrid.Columns>
                            <!-- Tick box mirrors the row selection; SelectionMode=Single keeps it to one schedule -->
                            <DataGridTemplateColumn Header="✔" Width="34" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Not hit-testable: the click selects the row (which ticks this box);
                                             letting the box also toggle undid the selection on the same click -->
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                                  IsHitTestVisible="False"
                                                  ToolTip="Tick to select this schedule for export / import"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Schedule Name" Binding="{Binding Name, Mode=OneWay}" Width="*" ElementStyle="{StaticResource GridText}"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName, Mode=OneWay}" Width="130" ElementStyle="{StaticResource GridText}"/>
                            <DataGridTextColumn Header="Rows / Fields" Binding="{Binding RowCountDisplay, Mode=OneWay}" Width="115" ElementStyle="{StaticResource GridText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="12,0,12,12">
            <!-- ══ Log (always dark) ══ -->
            <Border CornerRadius="6" Background="{StaticResource BrushLogBg}" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="6,6,0,0" Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}">
                                    <Run Text="Log"/>
                                    <Run Text="{Binding LogEntries.Count, Mode=OneWay}" Foreground="{StaticResource BrushLogTextDim}"/>
                                </TextBlock>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyLogCommand}" Margin="0,0,4,0" ToolTip="Copy the whole log to the clipboard"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="0,0,4,0" ToolTip="Copy the selected log lines"/>
                                <Button Content="Save…" Style="{StaticResource DarkGhostButton}" Command="{Binding SaveLogCommand}" Margin="0,0,4,0" ToolTip="Save the log as a .txt file next to the last export"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogEntries}" Height="120" SelectionMode="Extended"
                             Background="Transparent" BorderThickness="0" Padding="6,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           Text="{Binding Mode=OneWay}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="2,0,8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38" Click="CloseButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
