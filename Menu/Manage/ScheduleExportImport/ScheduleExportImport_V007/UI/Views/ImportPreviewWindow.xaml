<!--
=======================================================
File: ImportPreviewWindow.xaml  (V007, per CLAUDE.md v1.1 — ToolWindowShell)
  - Window content is a shared ToolWindowShell:
      HEADER  title bar (subtitle = previewed file), schedule-mismatch
              warning, preview summary cards
      BODY    intro hint, filter chips + search, preview grid
      FOOTER  status strip (IsBusy, indeterminate / StatusMessage), tick /
              untick / copy IDs / report, ticked count, Close · Apply
  - Preview grid: ShellBehaviors.MaxHeightRatio + ForwardMouseWheel.
  - Status-pill and warning-banner colours moved to SharedStyles brushes.
  - No behaviour change — every binding/command is the V006 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.ScheduleExportImport.V007.UI.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:vm="clr-namespace:Revit26_Plugin_Revised.ScheduleExportImport.V007.UI.ViewModels"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.ScheduleExportImport}, Path=Title, StringFormat=Import Preview — {0}}"
        Width="1040" Height="680"
        MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumToBoolConverter       x:Key="EnumToBoolConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter      x:Key="InverseBoolConverter"/>

            <DataTemplate x:Key="SummaryCardTemplate" DataType="{x:Type vm:SummaryCard}">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock x:Name="Num" Text="{Binding Value}" Style="{StaticResource MetricNumber}" FontSize="20"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabel}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Accent">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Success">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Warning">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Danger">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Style>
            <Style x:Key="OldText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            </Style>
            <Style x:Key="NewText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                <Setter Property="FontSize" Value="10.5"/>
            </Style>

            <!-- Status pill coloured by ImportChangeStatus (semantic, not accent) -->
            <DataTemplate x:Key="StatusPillTemplate">
                <Border x:Name="Pill" CornerRadius="9" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource BrushSystemSecondaryBackground}">
                    <TextBlock x:Name="Txt" Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Change">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Applied">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="NotFound">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="MissingFromFile">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Conflict">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="NotEditable">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="TypeParameter">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushPillTypeBackground}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushPillTypeText}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Import Preview"
                           Subtitle="{Binding PreviewFileName}"
                           Version="{Binding Source={x:Static svc:ToolCatalog.ScheduleExportImport}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding StatusMessage}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <StackPanel>
                <!-- Schedule-name mismatch warning -->
                <Border Background="{StaticResource BrushStatusWarnSoft}" BorderBrush="{StaticResource BrushStatusWarnBorder}" BorderThickness="1" CornerRadius="6"
                        Padding="10,6" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewWarning}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding PreviewWarning}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushStatusWarn}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding PreviewCards}" ItemTemplate="{StaticResource SummaryCardTemplate}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Only ticked rows with status 'Change' are written. Everything else is shown so you can see what will not be imported, and why."/>
                <!-- Filter chips + search -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="All">
                            <TextBlock><Run Text="All "/><Run Text="{Binding CountAll, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Changes, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="Changes">
                            <TextBlock><Run Text="Changes "/><Run Text="{Binding CountChanges, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Conflicts, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="Conflicts"
                                     ToolTip="Values changed in Revit since export, or elements borrowed by another user">
                            <TextBlock><Run Text="Changed in Revit "/><Run Text="{Binding CountConflicts, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TypeEdits, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="TypeEdits"
                                     ToolTip="Type parameter edits: each one changes every instance of the type">
                            <TextBlock><Run Text="Type edits "/><Run Text="{Binding CountTypeEdits, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NotFound, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="NotFound">
                            <TextBlock><Run Text="Not found "/><Run Text="{Binding CountNotFound, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Duplicate, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="Duplicate">
                            <TextBlock><Run Text="Duplicate IDs "/><Run Text="{Binding CountDuplicate, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MissingFromFile, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="MissingFromFile">
                            <TextBlock><Run Text="Missing "/><Run Text="{Binding CountMissing, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Skipped, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="Skipped">
                            <TextBlock><Run Text="Ignored "/><Run Text="{Binding CountSkipped, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     Visibility="{Binding HasApplied, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Applied, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="Applied">
                            <TextBlock><Run Text="Applied "/><Run Text="{Binding CountApplied, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="PreviewFilter" Style="{StaticResource ChipToggle}"
                                     Visibility="{Binding HasApplied, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding ActivePreviewFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Failed, Mode=OneWay}"
                                     Command="{Binding SetPreviewFilterCommand}" CommandParameter="Failed">
                            <TextBlock><Run Text="Failed "/><Run Text="{Binding CountFailed, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                    </WrapPanel>
                    <TextBox Grid.Column="1" Text="{Binding PreviewSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Search Element ID, parameter, values or note"/>
                    <Button Grid.Column="2" Content="✕" Margin="6,0,0,0" Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding ClearPreviewSearchCommand}" ToolTip="Clear search"/>
                </Grid>
                <Border Style="{StaticResource ContentCard}">
                    <DataGrid ItemsSource="{Binding PreviewView}"
                              MinHeight="200"
                              shell:ShellBehaviors.MaxHeightRatio="0.6"
                              shell:ShellBehaviors.ForwardMouseWheel="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              Background="{StaticResource BrushSurfaceWindow}"
                              BorderThickness="0" RowHeight="26"
                              EnableRowVirtualization="True"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="☑" Width="34" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsSelectable}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="115" SortMemberPath="Status"
                                                    CellTemplate="{StaticResource StatusPillTemplate}"/>
                            <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId, Mode=OneWay}" Width="90"
                                                IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding ElementName, Mode=OneWay}" Width="160"
                                                IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName, Mode=OneWay}" Width="150"
                                                IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Current value" Binding="{Binding OldValue, Mode=OneWay}" Width="*"
                                                IsReadOnly="True" ElementStyle="{StaticResource OldText}"/>
                            <DataGridTextColumn Header="New value" Binding="{Binding NewValue, Mode=OneWay}" Width="*"
                                                IsReadOnly="True" ElementStyle="{StaticResource NewText}"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Message, Mode=OneWay}" Width="1.4*"
                                                IsReadOnly="True" ElementStyle="{StaticResource NoteText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Tick all shown" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        Command="{Binding SelectAllVisibleCommand}" ToolTip="Tick every 'Change' row that matches the current filter and search"/>
                <Button Grid.Column="1" Content="Untick all" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        Command="{Binding ClearSelectionCommand}"/>
                <Button Grid.Column="2" Content="Copy problem IDs" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        Command="{Binding CopyNotFoundIdsCommand}" ToolTip="Copy not-found, missing and duplicate Element IDs (tab-separated, paste into Excel)"/>
                <Button Grid.Column="3" Content="Open report" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenReportCommand}"
                        Visibility="{Binding HasApplied, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0" FontSize="11"
                           Foreground="{StaticResource BrushTextSecondary}">
                    <Run Text="{Binding SelectedChangeCount, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="change(s) ticked · Ctrl+Z in Revit undoes the whole import"/>
                </TextBlock>
                <Button Grid.Column="5" Content="Close" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        Click="Close_Click"/>
                <Button Grid.Column="6" Content="Apply ▶" Style="{StaticResource PrimaryButton}" MinWidth="110"
                        Command="{Binding ApplySelectedCommand}"/>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
