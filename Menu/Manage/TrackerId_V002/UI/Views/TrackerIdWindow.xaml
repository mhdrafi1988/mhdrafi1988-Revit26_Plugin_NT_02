                                                    Command="{Binding RunHealthCheckCommand}"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="Read-only. Looks at every placed element of the categories that have Tracker_ID, in the whole model. Status checks use the status file chosen in Status."/>

                                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <RadioButton GroupName="HealthFilter" Style="{StaticResource ChipToggle}" Content="{Binding HealthAllChip}"
                                                             IsChecked="{Binding HealthFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All, Mode=OneWay}"
                                                             Command="{Binding SetHealthFilterCommand}" CommandParameter="All"/>
                                                <RadioButton GroupName="HealthFilter" Style="{StaticResource ChipToggle}" Content="{Binding HealthDuplicatesChip}"
                                                             IsChecked="{Binding HealthFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Duplicates, Mode=OneWay}"
                                                             Command="{Binding SetHealthFilterCommand}" CommandParameter="Duplicates"/>
                                                <RadioButton GroupName="HealthFilter" Style="{StaticResource ChipToggle}" Content="{Binding HealthMissingChip}"
                                                             IsChecked="{Binding HealthFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Missing, Mode=OneWay}"
                                                             Command="{Binding SetHealthFilterCommand}" CommandParameter="Missing"/>
                                                <RadioButton GroupName="HealthFilter" Style="{StaticResource ChipToggle}" Content="{Binding HealthMovedChip}"
                                                             IsChecked="{Binding HealthFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Moved, Mode=OneWay}"
                                                             Command="{Binding SetHealthFilterCommand}" CommandParameter="Moved"/>
                                                <RadioButton GroupName="HealthFilter" Style="{StaticResource ChipToggle}" Content="{Binding HealthGridChip}"
                                                             IsChecked="{Binding HealthFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Grid, Mode=OneWay}"
                                                             Command="{Binding SetHealthFilterCommand}" CommandParameter="Grid"/>
                                                <RadioButton GroupName="HealthFilter" Style="{StaticResource ChipToggle}" Content="{Binding HealthStatusChip}"
                                                             IsChecked="{Binding HealthFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Status, Mode=OneWay}"
                                                             Command="{Binding SetHealthFilterCommand}" CommandParameter="Status"/>
                                            </WrapPanel>
                                        </DockPanel>

                                        <DataGrid ItemsSource="{Binding HealthView}"
                                                  x:Name="HealthGrid"
                                                  MouseDoubleClick="ElementGrid_MouseDoubleClick"
                                                  SelectionChanged="HealthGrid_SelectionChanged"
                                                  MinHeight="200"
                                                  shell:ShellBehaviors.MaxHeightRatio="0.45"
                                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                                  RowStyle="{StaticResource HealthRowStyle}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                                                  CellStyle="{StaticResource DataGridCellStyle}"
                                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                                  Background="{StaticResource BrushSurfaceWindow}"
                                                  BorderThickness="0" RowHeight="26"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Problem" Binding="{Binding KindText, Mode=OneWay}" Width="110"
                                                                    SortMemberPath="Kind" ElementStyle="{StaticResource GridCellText}"/>
                                                <DataGridTextColumn Header="Element ID" Binding="{Binding ElementIdText, Mode=OneWay}" Width="80"
                                                                    ElementStyle="{StaticResource GridCellId}"/>
                                                <DataGridTextColumn Header="Tracker_ID" Binding="{Binding TrackerId, Mode=OneWay}" Width="190"
                                                                    ElementStyle="{StaticResource GridCellId}"/>
                                                <DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=OneWay}" Width="110"
                                                                    ElementStyle="{StaticResource GridCellText}"/>
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail, Mode=OneWay}" Width="*"
                                                                    ElementStyle="{StaticResource GridCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="{Binding HealthSummaryText}" Style="{StaticResource HintText}" Margin="0,6,0,6" TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button Content="Select shown in Revit" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                                    Command="{Binding SelectShownHealthRowsCommand}"/>
                                            <Button Content="Zoom to highlighted" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                                    Command="{Binding ZoomToHealthRowsCommand}"/>
                                            <Button Content="Export report…" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportHealthReportCommand}"/>
                                            <Button Content="Fix in Result" Style="{StaticResource SmallSecondaryButton}"
                                                    Command="{Binding FixInStep3Command}"
                                                    ToolTip="Shows the elements that need a Tracker_ID (missing, copies, duplicates, moved). Nothing is written until you click Write."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══ PAGE 2: Tracker ID naming ══ -->
                    <StackPanel Visibility="{Binding IsPage2, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                                                    <StackPanel Margin="10,8,10,10">
                                                        <TextBlock Text="Tracker ID format" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                                                        <Border Background="{StaticResource BrushSurfaceWindow}" BorderBrush="{StaticResource BrushBorderInput}"
                                                                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="FORMAT PREVIEW · FIRST ELEMENT" Style="{StaticResource MetricTileLabel}"/>
                                                                <TextBlock Text="{Binding SampleId}" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource BrushNavyPrimary}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Segment header -->
                                                        <Grid Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34"/>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="230"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Use" Style="{StaticResource HintText}"/>
                                                            <TextBlock Grid.Column="1" Text="Order" Style="{StaticResource HintText}"/>
                                                            <TextBlock Grid.Column="2" Text="Segment" Style="{StaticResource HintText}"/>
                                                            <TextBlock Grid.Column="3" Text="Source" Style="{StaticResource HintText}"/>
                                                            <TextBlock Grid.Column="4" Text="Option" Style="{StaticResource HintText}"/>
                                                            <TextBlock Grid.Column="5" Text="Sample" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Border Style="{StaticResource SeparatorLine}"/>

                                                        <ItemsControl ItemsSource="{Binding Segments}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <Grid Margin="0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="34"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="130"/>
                                                                                <ColumnDefinition Width="230"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="110"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                                                                      ToolTip="Untick to leave this segment out of the ID."/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Button Content="▲" Style="{StaticResource SmallSecondaryButton}" Padding="6,0" Margin="0,0,2,0"
                                                                                        ToolTip="Move earlier in the ID"
                                                                                        Command="{Binding DataContext.MoveSegmentUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        CommandParameter="{Binding}"/>
                                                                                <Button Content="▼" Style="{StaticResource SmallSecondaryButton}" Padding="6,0"
                                                                                        ToolTip="Move later in the ID"
                                                                                        Command="{Binding DataContext.MoveSegmentDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        CommandParameter="{Binding}"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"
                                                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                                                <TextBlock Text="{Binding Note}" Style="{StaticResource HintText}"/>
                                                                            </StackPanel>
                                                                            <ComboBox Grid.Column="3" Style="{StaticResource StandardComboBox}" Margin="0,0,10,0"
                                                                                      ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                                                                      DisplayMemberPath="Label" VerticalAlignment="Center"/>
                                                                            <Grid Grid.Column="4" VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Visibility="{Binding UsesOption, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                    <TextBlock Text="{Binding OptionLabel}" Style="{StaticResource FilterLabel}"/>
                                                                                    <TextBox Width="170" Style="{StaticResource StyledTextInput}"
                                                                                             Text="{Binding Option, UpdateSourceTrigger=PropertyChanged}"/>
                                                                                </StackPanel>
                                                                                <TextBlock Text="{Binding OptionPlaceholder}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                                                           Visibility="{Binding UsesOption, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                                            </Grid>
                                                                            <TextBlock Grid.Column="5" Text="{Binding SampleValue}" FontFamily="Consolas" FontSize="12"
                                                                                       Foreground="{StaticResource BrushAppleBlue}" HorizontalAlignment="Right"
                                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                        </Grid>
                                                                        <Border Style="{StaticResource SeparatorLine}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Separator and fallbacks -->
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <TextBlock Text="Separator" Style="{StaticResource FilterLabel}"/>
                                                            <ComboBox Width="130" Style="{StaticResource StandardComboBox}" Margin="0,0,16,0"
                                                                      ItemsSource="{Binding Separators}" SelectedItem="{Binding SelectedSeparator}" DisplayMemberPath="Label"/>
                                                            <TextBlock Text="Grid check over (m)" Style="{StaticResource FilterLabel}"/>
                                                            <TextBox Width="50" Style="{StaticResource StyledTextInput}" Margin="0,0,16,0"
                                                                     ToolTip="Elements further than this from their grid crossing are flagged for checking."
                                                                     Text="{Binding GridToleranceM, UpdateSourceTrigger=LostFocus}"/>
                                                            <TextBlock Text="No zone" Style="{StaticResource FilterLabel}"/>
                                                            <TextBox Width="50" Style="{StaticResource StyledTextInput}" Margin="0,0,16,0"
                                                                     ToolTip="Zone value when neither the zone parameter nor a scope box gives one."
                                                                     Text="{Binding NoZoneText, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Text="Missing value" Style="{StaticResource FilterLabel}"/>
                                                            <TextBox Width="50" Style="{StaticResource StyledTextInput}"
                                                                     ToolTip="Used for any other segment with nothing to show (no level, no grid, empty parameter)."
                                                                     Text="{Binding MissingText, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </WrapPanel>

                                                        <WrapPanel Margin="0,8,0,0">
                                                            <TextBlock Text="Writes  Tracker_ID (once, then kept)" Style="{StaticResource FilterLabel}" Margin="0,0,16,0"/>
                                                            <CheckBox Style="{StaticResource OptionCheck}" IsChecked="{Binding WriteLocationParameters}"
                                                                      Content="Tracker_Zone, Tracker_Level, Tracker_Grid (refreshed every run)"/>
                                                            <CheckBox Style="{StaticResource OptionCheck}" IsChecked="{Binding WriteSourceGuid}"
                                                                      Content="Tracker_SourceGuid (finds copied elements)"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                            <StackPanel Margin="10,8,10,10">
                                <TextBlock Text="Type codes" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                <TextBlock Text="A short code per type, used by the Type part of the ID. Leave blank to use the Type part's source (Type Mark, type name or family name)."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <CheckBox Content="Write the whole ID in capitals" Style="{StaticResource OptionCheck}" Margin="0,0,0,8"
                                          IsChecked="{Binding UpperCase}"/>
                                <DataGrid ItemsSource="{Binding TypeCodeRows}" Height="200"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          SelectionMode="Single" SelectionUnit="Cell" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                                          RowStyle="{StaticResource DataGridRowStyle}" CellStyle="{StaticResource DataGridCellStyle}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                          Background="{StaticResource BrushSurfaceWindow}" BorderThickness="0" RowHeight="26">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=OneWay}" Width="150" IsReadOnly="True"
                                                            ElementStyle="{StaticResource GridCellText}"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" Width="*" IsReadOnly="True"
                                                            ElementStyle="{StaticResource GridCellText}"/>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                                            ElementStyle="{StaticResource GridCellId}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Tick types on page 1 to list them here." Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ContentCard}">
                            <StackPanel Margin="10,8,10,10">
                                <TextBlock Text="Next new IDs" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding NextIds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Existing Tracker_IDs are never changed. These rules apply only to elements without an ID and to copies."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ══ Log ══ -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLog_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ClearLogCommand}"/>
                                <Button Content="Export Log" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Click="ExportLog_Click"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                 MinHeight="80"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                        <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogTextDim}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold" Width="60"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding Message, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Text="{Binding StepHint}" TextWrapping="Wrap" MaxWidth="520"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Write Tracker IDs" Style="{StaticResource PrimaryButton}" MinWidth="140" Margin="0,0,8,0"
                            Command="{Binding WriteCommand}"/>
                    <Button Content="Export" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="0,0,8,0"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
