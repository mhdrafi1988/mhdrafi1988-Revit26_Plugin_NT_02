<!--
=======================================================
File: NewParameterDialog.xaml  (Base Level to Parameter V001)
Defines a new shared instance Text parameter. Nothing is created here: the main window creates it
(in the shared parameter file and the project) when Run is pressed.
Categories (1.4.0): bind to the ticked elements' categories (default) or only to the categories
ticked in a searchable grid.
Preview: Claude/Previews/BaseLevelToParameter_V001_Window.html (section 3)
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.BaseLevelToParameter.V001.UI.Views.NewParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.BaseLevelToParameter.V001.UI.Views"
        Title="{Binding Source={x:Static svc:ToolCatalog.BaseLevelToParameter}, Path=Title, StringFormat=New Parameter — {0}}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushSurfaceWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:StatusBrushConverter x:Key="StatusBrush"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Margin="8,0,0,0"
                        IsCancel="True"/>
                <Button DockPanel.Dock="Right" Content="Create" Style="{StaticResource PrimaryButton}" MinWidth="110"
                        Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" IsDefault="True"
                        ToolTip="Set this parameter as the target. It is created when you press Run in the main window."/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <StackPanel Margin="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <DockPanel Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding NameCounter}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" Style="{StaticResource BoxedTextInput}"/>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="Kind" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Shared parameter · Instance · Text · schedulable" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Text="Shared param. file" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Command="{Binding BrowseCommand}"/>
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=LostFocus}" Style="{StaticResource BoxedTextInput}"/>
                </DockPanel>

                <TextBlock Grid.Row="3" Text="Group in file" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" IsEditable="True" ItemsSource="{Binding FileGroups}"
                          Text="{Binding FileGroup, UpdateSourceTrigger=PropertyChanged}" MaxWidth="220" HorizontalAlignment="Left" MinWidth="200"
                          Style="{StaticResource StandardComboBox}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="4" Text="Properties group" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Data" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="5" Text="Categories" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                    <RadioButton GroupName="BindTo" Content="{Binding TickedElementCategoriesLabel}" IsChecked="{Binding TickedElementCategories}" Margin="0,2"
                                 ToolTip="Bind the new parameter to the categories of the elements ticked in the main window (the default)."/>
                    <RadioButton GroupName="BindTo" Content="Only the selected categories" IsChecked="{Binding OnlySelectedCategories}" Margin="0,2"
                                 ToolTip="Bind the new parameter only to the categories ticked in the list below. Ticked elements of other categories are skipped."/>
                    <TextBlock Text="{Binding CategoriesText}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="20,2,0,0" MaxHeight="48"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Margin="20,6,0,0" Visibility="{Binding OnlySelectedCategories, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,6">
                            <CheckBox DockPanel.Dock="Right" Content="Ticked only" IsChecked="{Binding TickedCategoriesOnly}" VerticalAlignment="Center" Margin="8,0,0,0"
                                      ToolTip="Show only categories that have ticked elements in the main window."/>
                            <TextBox Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"
                                     ToolTip="Search categories by name."/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding CategoryOptionsView}" Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}" RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                                  SelectionMode="Single" HeadersVisibility="Column" Height="220"
                                  BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34" SortMemberPath="IsSelected">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Category" Width="*" Binding="{Binding Name, Mode=OneWay}"/>
                                <DataGridTextColumn Header="Ticked elements" Width="120" Binding="{Binding TickedText, Mode=OneWay}" SortMemberPath="TickedCount"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Ticked elements" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0" Command="{Binding SelectTickedCategoriesCommand}"
                                        ToolTip="Select exactly the categories of the ticked elements."/>
                                <Button Content="Select shown" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0" Command="{Binding SelectShownCategoriesCommand}"
                                        ToolTip="Tick every category the search shows."/>
                                <Button Content="Clear shown" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ClearShownCategoriesCommand}"
                                        ToolTip="Untick every category the search shows."/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedCategoriesText}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Checks}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <Border Grid.Column="1" CornerRadius="10" Padding="8,1" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{Binding Result, Converter={StaticResource StatusBrush}, ConverterParameter=Background}"
                                    BorderBrush="{Binding Result, Converter={StaticResource StatusBrush}, ConverterParameter=Border}">
                                <TextBlock Text="{Binding Result}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding Result, Converter={StaticResource StatusBrush}}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
