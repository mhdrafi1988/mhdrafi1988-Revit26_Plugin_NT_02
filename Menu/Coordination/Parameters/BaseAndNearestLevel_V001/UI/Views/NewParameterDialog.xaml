<!--
=======================================================
File: NewParameterDialog.xaml  (Base and Nearest Level V001)
Defines the new shared instance parameter for one slot. Nothing is created here: the main window
creates it, in the shared parameter file and in the project, when Write Parameters runs.
The data type is fixed by the slot (names are Text, offsets are Length) and the binding is always
Roofs, Floors and Walls, so both rows are shown but disabled.
Preview: Claude/Previews/BaseAndNearestLevel_V001_Window.html (section 3)
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.BaseAndNearestLevel.V001.UI.Views.NewParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.BaseAndNearestLevel.V001.UI.Views"
        Title="New Parameter — Base and Nearest Level"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushSurfaceWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:StatusBrushConverter x:Key="StatusBrush"/>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="New shared parameter" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="For slot" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SlotLabel}" FontWeight="SemiBold" Margin="0,0,0,8" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource StyledTextInput}" Margin="0,0,0,8"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Border Style="{StaticResource BadgePill}" Background="{StaticResource BrushSystemSecondaryBackground}" Padding="8,2">
                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" FontSize="11.5"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </Border>
                <TextBlock Text="Fixed by the slot" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Shared file" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center"/>
            <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource StyledTextInput}"
                         Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                        Command="{Binding BrowseCommand}"/>
            </Grid>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Group in file" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource StandardComboBox}" Margin="0,0,0,8"
                      IsEditable="True" HorizontalAlignment="Left" Width="200"
                      ItemsSource="{Binding FileGroups}" Text="{Binding FileGroup, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Categories" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="5" Grid.Column="1">
                <ItemsControl ItemsSource="{Binding Categories}" MaxHeight="90">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BadgePill}" Margin="0,0,6,0" Padding="8,2">
                                <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushNavyPrimary}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding CategorySummary}"/>
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Taken from the categories ticked in the window, so the parameter matches what the tool writes."/>
            </StackPanel>
        </Grid>

        <Border Margin="0,12,0,0" CornerRadius="4" Padding="10,8" BorderThickness="1"
                Background="{Binding SummaryResult, Converter={StaticResource StatusBrush}, ConverterParameter=Background}"
                BorderBrush="{Binding SummaryResult, Converter={StaticResource StatusBrush}, ConverterParameter=Border}">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{Binding SummaryResult, Converter={StaticResource StatusBrush}}"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Cancel_Click"/>
            <Button Content="Create" Style="{StaticResource PrimaryButton}" MinWidth="110"
                    IsEnabled="{Binding CanCreate}" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
