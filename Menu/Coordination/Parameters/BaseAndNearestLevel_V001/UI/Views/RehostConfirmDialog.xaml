<!--
=======================================================
File: RehostConfirmDialog.xaml  (Base and Nearest Level V001)
Asks before the re-host changes the model. Lists every element that moves (from, to, and the
elevation that does not change) and every element that is skipped, with the reason. The tick
includes shape-edited floors and roofs, which are skipped by default.
Preview: Claude/Previews/BaseAndNearestLevel_V001_Window.html (section 4)
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.BaseAndNearestLevel.V001.UI.Views.RehostConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Re-host to nearest level?"
        Width="680" MaxHeight="760" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushSurfaceWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Style="{StaticResource BadgePill}" Padding="8,2"
                    Background="{StaticResource BrushStatusWarnSoft}"
                    BorderBrush="{StaticResource BrushStatusWarnBorder}" BorderThickness="1">
                <TextBlock Text="Changes the model" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushStatusWarn}"/>
            </Border>
            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"
                       Text="One undo step puts all of it back."/>
        </StackPanel>

        <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Border Background="{StaticResource BrushSystemSecondaryBackground}" BorderBrush="{StaticResource BrushBorderDefault}"
                BorderThickness="1" CornerRadius="4" Padding="4">
            <DataGrid Style="{StaticResource StandardDataGrid}" ItemsSource="{Binding Moves}"
                      MaxHeight="240" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Family &amp; Type" Binding="{Binding FamilyAndType}" Width="*"/>
                    <DataGridTextColumn Header="From" Binding="{Binding From}" Width="130"/>
                    <DataGridTextColumn Header="To" Binding="{Binding To}" Width="130"/>
                    <DataGridTextColumn Header="Unchanged" Binding="{Binding Unchanged}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasSkips, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SkipHeadline}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderDefault}"
                    BorderThickness="1" CornerRadius="4" Padding="4">
                <DataGrid Style="{StaticResource StandardDataGrid}" ItemsSource="{Binding Skips}"
                          MaxHeight="160" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="110"/>
                        <DataGridTextColumn Header="Why" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <CheckBox Margin="0,8,0,0" IsChecked="{Binding IncludeShapeEdited}"
                      Visibility="{Binding HasShapeEditedSkips, Converter={StaticResource BoolToVis}}"
                      Content="Include shape-edited floors and roofs (off by default)"
                      ToolTip="Changing a shape-edited floor's or roof's Level can reset its point edits. Tick only if you have checked those elements."/>
        </StackPanel>

        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="After the re-host, the four parameters are read again and refreshed in the same undo step, so they never describe the old placement."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Cancel_Click"/>
            <Button Content="{Binding ActionText}" Style="{StaticResource RunButton}" MinWidth="170"
                    IsEnabled="{Binding CanRun}" Click="Run_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
