<!--
=======================================================
File: SectionRoofDetailLinesWindow.xaml  (Section Roof Detail Lines V001)
ToolWindowShell layout:
  HEADER  metric cards (sections ticked / roof types / wall types / elements / lines last run)
  BODY    left:   the sections on the sheet, with what each one shows
          middle: everything those sections show — host model and each link,
                  by category and type; roofs and walls can be ticked
          right:  what to draw, line styles, adjacency tolerance
          below:  activity log
  FOOTER  Draw Detail Lines → Close
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.SectionRoofDetailLines.V001.UI.Views.SectionRoofDetailLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.SectionRoofDetailLines.V001.UI.Converters"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="Section Roof Detail Lines"
        Height="900" Width="1380"
        MinHeight="660" MinWidth="1120"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:SectionStatusBrushConverter x:Key="StatusBrush"/>
            <local:ElementRoleChipConverter x:Key="RoleChip"/>
            <local:ElementRoleBrushConverter x:Key="RoleBrush"/>
            <local:LineStyleNameConverter x:Key="StyleName"/>
            <local:EnumMatchConverter x:Key="EnumMatch"/>

            <Style x:Key="CardBody" TargetType="StackPanel">
                <Setter Property="Margin" Value="12,0,12,10"/>
            </Style>

            <Style x:Key="MmBox" TargetType="TextBox" BasedOn="{StaticResource BoxedTextInput}">
                <Setter Property="Width" Value="64"/>
                <Setter Property="MaxLength" Value="7"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <!-- One line-style picker: shows an empty name as the view's own default. -->
            <Style x:Key="StylePicker" TargetType="ComboBox" BasedOn="{StaticResource StandardComboBox}">
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource StyleName}}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Section Roof Detail Lines"
                           Subtitle="List what the sheet's sections show — host model and links — then draw the roofs' cut profile and a line on the walls beside them"
                           Version="{Binding Source={x:Static svc:ToolCatalog.SectionRoofDetailLines}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy}"
                           IsIndeterminate="True"
                           IsCancellable="True"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Sections" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TickedSectionsText}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="ticked, of this sheet's" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Roof Types" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RoofTypesTicked}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="cut profile traced" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Wall Types" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WallTypesTicked}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="line where next to a roof" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Elements" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementCountText}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="shown in the sections read" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Lines" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LinesCreatedText}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="drawn by the last run" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Left: the sheet's sections ──────────────── -->
                <Border Grid.Column="0" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,12,0">
                            <TextBlock Text="Sections" Style="{StaticResource SectionTitle}"/>
                            <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,0"
                                    Style="{StaticResource SmallSecondaryButton}" Command="{Binding RefreshCommand}"
                                    ToolTip="Read the sheet's sections and their contents again."/>
                        </Grid>
                        <StackPanel Style="{StaticResource CardBody}">
                            <TextBlock Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis">
                                <Run Text="Sheet"/> <Run Text="{Binding SheetLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding SectionSourceNote}" Style="{StaticResource HintText}" Margin="0,2,0,8" TextWrapping="Wrap"/>

                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Untick all" Margin="6,0,0,0"
                                        Style="{StaticResource SmallSecondaryButton}" Command="{Binding UntickAllSectionsCommand}"/>
                                <Button DockPanel.Dock="Right" Content="Tick all" Margin="6,0,0,0"
                                        Style="{StaticResource SmallSecondaryButton}" Command="{Binding TickAllSectionsCommand}"
                                        ToolTip="Tick every section that can be drawn in."/>
                                <Border/>
                            </DockPanel>

                            <ListBox ItemsSource="{Binding Sections}" MinHeight="220"
                                     shell:ShellBehaviors.MaxHeightRatio="0.56"
                                     shell:ShellBehaviors.ForwardMouseWheel="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTicked}" Value="False">
                                                <Setter Property="Opacity" Value="0.65"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Top" Margin="0,2,8,0"
                                                          IsChecked="{Binding IsTicked, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanDraw}"
                                                          ToolTip="Tick to draw the lines in this section."/>
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Margin="6,0,0,0"
                                                                Background="{StaticResource BrushPillInfoBackground}">
                                                            <TextBlock Text="{Binding Chip}" FontSize="10.5"
                                                                       Foreground="{StaticResource BrushPillInfoText}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                                               TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,0"
                                                               Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}"
                                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                       Text="The number on the right is the detail number on the sheet. A section owned by someone else, or changed in central, cannot be ticked."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Middle: what the sections show ──────────── -->
                <Border Grid.Column="2" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,12,0">
                            <TextBlock Text="Elements In These Sections" Style="{StaticResource SectionTitle}"/>
                            <Button Content="List all to log" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,0"
                                    Style="{StaticResource SmallSecondaryButton}" Command="{Binding ListElementsToLogCommand}"
                                    ToolTip="Write every element the sections show to the activity log — one line each, with its section, source, category, type and id — then Copy All to take it out."/>
                        </Grid>
                        <StackPanel Style="{StaticResource CardBody}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Untick all" Margin="6,0,0,0"
                                        Style="{StaticResource SmallSecondaryButton}" Command="{Binding UntickAllTypesCommand}"/>
                                <Button DockPanel.Dock="Right" Content="Tick roofs &amp; walls" Margin="6,0,0,0"
                                        Style="{StaticResource SmallSecondaryButton}" Command="{Binding TickRoofsAndWallsCommand}"
                                        ToolTip="Tick every roof and wall type the filters show."/>
                                <Grid>
                                    <TextBox Style="{StaticResource StyledTextInput}" MaxLength="60"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                             ToolTip="Shows the rows whose source, category or type name contains this text. A ticked row that is hidden is still drawn."/>
                                    <TextBlock Text="Filter by category, family or type…" IsHitTestVisible="False" Margin="8,0,0,0"
                                               VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource BrushTextTertiary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>

                            <CheckBox Content="Show every category, not only roofs and walls" Margin="0,0,0,6"
                                      IsChecked="{Binding ShowAllCategories}"
                                      ToolTip="The tool draws lines from roofs and walls only. Every other category is listed so you can read what the section shows."/>

                            <TreeView ItemsSource="{Binding Sources}" MinHeight="300"
                                      shell:ShellBehaviors.MaxHeightRatio="0.58"
                                      shell:ShellBehaviors.ForwardMouseWheel="True"
                                      BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <!-- Type leaf: ticked only for roofs and walls. -->
                                    <Style x:Key="TypeItemStyle" TargetType="TreeViewItem">
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                    </Style>
                                    <HierarchicalDataTemplate x:Key="CategoryTemplate" ItemsSource="{Binding Types}"
                                                              ItemContainerStyle="{StaticResource TypeItemStyle}">
                                        <DockPanel Margin="0,1">
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                    Background="{Binding Role, Converter={StaticResource RoleBrush}}">
                                                <TextBlock Text="{Binding Role, Converter={StaticResource RoleChip}}" FontSize="10"
                                                           Foreground="{Binding Role, Converter={StaticResource RoleBrush}, ConverterParameter=Foreground}"/>
                                            </Border>
                                            <CheckBox IsThreeState="True" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsSelectable}"/>
                                            <TextBlock Text="{Binding CategoryName}" FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding Meta}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </DockPanel>
                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1" ToolTip="{Binding Hint}">
                                                    <CheckBox VerticalAlignment="Center" Margin="0,0,6,0"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsSelectable}"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                                    <TextBlock Text="{Binding Meta}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource BrushTextTertiary}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Categories}"
                                                              ItemTemplate="{StaticResource CategoryTemplate}">
                                        <DockPanel Margin="0,2">
                                            <CheckBox IsThreeState="True" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      ToolTip="Tick every roof and wall type of this source."/>
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Foreground="{StaticResource BrushNavyPrimary}"/>
                                            <TextBlock Text="{Binding Meta}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </DockPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="The host model is read with Revit's own view visibility, so the crop, the far clip, visibility/graphics and anything hidden by hand all count. A link is read by geometry against the same crop box instead, which Revit gives no visibility query for — so a link set to &quot;By linked view&quot; may list a little more than the section draws. Untick what you do not want."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Right: what to draw ─────────────────────── -->
                <Border Grid.Column="4" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Lines To Draw" Style="{StaticResource SectionTitle}" Margin="0,0,12,0"/>
                        <StackPanel Style="{StaticResource CardBody}">
                            <CheckBox Content="Roofs — trace the cut profile" Margin="0,0,0,2"
                                      IsChecked="{Binding DrawRoofProfile}"
                                      ToolTip="The profile the section cuts through the roof. Pick the sides below: all four is the whole profile, top, bottom, ends and any opening it passes through."/>
                            <StackPanel Margin="20,2,0,8" IsEnabled="{Binding DrawRoofProfile}">
                                <TextBlock Text="Sides to draw" Style="{StaticResource FieldLabel}"/>
                                <WrapPanel Margin="0,2,0,0">
                                    <CheckBox Content="Top" Margin="0,0,12,2" IsChecked="{Binding RoofTop}"
                                              ToolTip="The edges that face up — the roof's top surface."/>
                                    <CheckBox Content="Bottom" Margin="0,0,12,2" IsChecked="{Binding RoofBottom}"
                                              ToolTip="The edges that face down — the underside, and the soffit over an opening the section passes through."/>
                                    <CheckBox Content="Left" Margin="0,0,12,2" IsChecked="{Binding RoofLeft}"
                                              ToolTip="The edges that face left across the view — usually the cut end on that side."/>
                                    <CheckBox Content="Right" Margin="0,0,0,2" IsChecked="{Binding RoofRight}"
                                              ToolTip="The edges that face right across the view — usually the cut end on that side."/>
                                </WrapPanel>
                                <TextBlock Text="{Binding RoofSidesNote}" Style="{StaticResource HintText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="A side is read from where the roof's material lies, not from where the edge sits — so Bottom is the underside on a flat, sloped or stepped roof alike."/>
                            </StackPanel>

                            <TextBlock Text="Roof line style" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StylePicker}"
                                      ItemsSource="{Binding LineStyleNames}"
                                      SelectedItem="{Binding RoofLineStyleName}"/>

                            <CheckBox Content="Walls — line over the visible height" Margin="0,4,0,2"
                                      IsChecked="{Binding DrawWallLines}"
                                      ToolTip="A vertical line on the wall face next to a ticked roof, over the wall's whole height in the section."/>
                            <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,8" TextWrapping="Wrap"
                                       Text="Only walls whose cut profile comes within the tolerance below of a ticked roof's."/>

                            <TextBlock Text="Wall line style" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StylePicker}"
                                      ItemsSource="{Binding LineStyleNames}"
                                      SelectedItem="{Binding WallLineStyleName}"/>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="Adjacency tolerance" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitLabel}"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource MmBox}"
                                         Text="{Binding AdjacencyToleranceMm, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="How close a wall's cut profile has to come to a roof's to count as next to it. 0.1 to 1000 mm."/>
                            </DockPanel>

                            <TextBlock Text="Wall face to draw on" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel Margin="0,2,0,8" IsEnabled="{Binding DrawWallLines}">
                                <RadioButton GroupName="WallFace" Style="{StaticResource ChipToggle}" Margin="0,0,6,6"
                                             Content="Nearer the roof"
                                             IsChecked="{Binding WallFace, Converter={StaticResource EnumMatch}, ConverterParameter=NearerRoof}"
                                             ToolTip="Only the face closer to the ticked roof's cut profile. This is what the tool did in 1.0.0."/>
                                <RadioButton GroupName="WallFace" Style="{StaticResource ChipToggle}" Margin="0,0,6,6"
                                             Content="Both faces"
                                             IsChecked="{Binding WallFace, Converter={StaticResource EnumMatch}, ConverterParameter=BothFaces}"
                                             ToolTip="Every face of the wall's cut profile."/>
                                <RadioButton GroupName="WallFace" Style="{StaticResource ChipToggle}" Margin="0,0,6,6"
                                             Content="Left"
                                             IsChecked="{Binding WallFace, Converter={StaticResource EnumMatch}, ConverterParameter=LeftOnly}"
                                             ToolTip="Only the leftmost face across the view, whichever side the roof is on."/>
                                <RadioButton GroupName="WallFace" Style="{StaticResource ChipToggle}" Margin="0,0,0,6"
                                             Content="Right"
                                             IsChecked="{Binding WallFace, Converter={StaticResource EnumMatch}, ConverterParameter=RightOnly}"
                                             ToolTip="Only the rightmost face across the view, whichever side the roof is on."/>
                            </WrapPanel>

                            <CheckBox Content="Leave out lines the view already has" Margin="0,0,0,8"
                                      IsChecked="{Binding SkipExistingLines}"
                                      ToolTip="A line whose ends match one already in that view, in the same style, is not created again — so running the tool twice does not stack duplicates."/>

                            <Border Style="{StaticResource BaseCard}" Padding="10,8" Margin="0,2,0,0"
                                    Background="{StaticResource BrushBannerInfoBackground}"
                                    BorderBrush="{StaticResource BrushBannerInfoBorder}">
                                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"
                                           Text="Detail lines belong to the view they are drawn in, so the lines go into the sections themselves, not onto the sheet. The whole run is one Undo step."/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Activity log ────────────────────────────── -->
                <Border Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0" CornerRadius="8"
                        Background="{StaticResource BrushLogBg}">
                    <Grid Margin="12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogCommand}"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLogs_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0"
                                 MinHeight="90" Padding="0"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Draw Detail Lines" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding CreateCommand}"
                        ToolTip="Draw the lines in every ticked section — one Undo step for the whole run."/>
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
