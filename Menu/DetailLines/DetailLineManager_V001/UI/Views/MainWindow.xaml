<!--
=======================================================
File: MainWindow.xaml — Detail Line Manager V001
Layout (ToolWindowShell):
  HEADER  title, document, version badge
  BODY    left: filter rail (Scope · Advanced search · Show only · Find)
          right: results grid with live counts, then the action tabs
                 (Delete unused · Line thickness)
          bottom: dark log panel (full width)
  FOOTER  status strip, Close
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.DetailLineManager.V001.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.DetailLineManager}, Path=Title}"
        Height="880" Width="1260"
        MinHeight="640" MinWidth="1060"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

            <Style x:Key="RailLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Setter Property="Width" Value="76"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RailRow" TargetType="DockPanel">
                <Setter Property="Margin" Value="12,0,12,6"/>
                <Setter Property="LastChildFill" Value="True"/>
            </Style>
            <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource ChipToggle}">
                <Setter Property="Margin" Value="0,0,4,4"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="FlagText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Detail Line Manager"
                           Subtitle="{Binding DocumentTitle, StringFormat='Find, clean up and re-weight detail lines · {0}'}"
                           Version="{Binding Source={x:Static svc:ToolCatalog.DetailLineManager}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ Left filter rail ═══ -->
                <StackPanel Grid.Column="0">
                    <!-- Scope -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Scope" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="2" Margin="12,0,8,4">
                                <RadioButton GroupName="Scope" Content="Selected" Style="{StaticResource Segment}" IsChecked="{Binding ScopeSelected}"/>
                                <RadioButton GroupName="Scope" Content="Active view" Style="{StaticResource Segment}" IsChecked="{Binding ScopeActiveView}"/>
                                <RadioButton GroupName="Scope" Content="Views on sheets" Style="{StaticResource Segment}" IsChecked="{Binding ScopeViewsOnSheets}"/>
                                <RadioButton GroupName="Scope" Content="Whole project" Style="{StaticResource Segment}" IsChecked="{Binding ScopeWholeProject}"/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,10" TextWrapping="Wrap"
                                       Text="{Binding LastScopeText, StringFormat='Last search: {0}'}"/>
                        </StackPanel>
                    </Border>

                    <!-- Advanced search -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Advanced search" Style="{StaticResource SectionTitle}"/>
                            <TextBox Style="{StaticResource StyledTextInput}" Margin="12,0,12,4"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     ToolTip="Line style, view name, element ID or comment"/>
                            <CheckBox Content="Regular expression" Margin="12,2,12,2" IsChecked="{Binding UseRegex}"/>
                            <TextBlock Text="{Binding RegexError}" Foreground="{StaticResource BrushStatusWarn}" FontSize="11"
                                       Margin="12,0,12,4" TextWrapping="Wrap"/>

                            <DockPanel Margin="12,4,12,2">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding CheckAllStylesCommand}" Margin="0,0,4,0"/>
                                    <Button Content="None" Style="{StaticResource SmallSecondaryButton}" Command="{Binding UncheckAllStylesCommand}"/>
                                </StackPanel>
                                <TextBlock Text="Line styles" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border BorderBrush="{StaticResource BrushBorderInput}" BorderThickness="1" CornerRadius="4" Margin="12,0,12,8">
                                <ListBox ItemsSource="{Binding Styles}" MaxHeight="130" BorderThickness="0"
                                         shell:ShellBehaviors.ForwardMouseWheel="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding UseCount}" Style="{StaticResource HintText}" Margin="8,0,0,0"/>
                                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="4,1"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>

                            <DockPanel Style="{StaticResource RailRow}">
                                <TextBlock Text="View type" Style="{StaticResource RailLabel}"/>
                                <ComboBox Style="{StaticResource StandardComboBox}" ItemsSource="{Binding ViewTypeOptions}" SelectedItem="{Binding SelectedViewType}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource RailRow}">
                                <TextBlock Text="Weight" Style="{StaticResource RailLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Style="{StaticResource StandardComboBox}" Width="64" ItemsSource="{Binding WeightOptions}" SelectedItem="{Binding MinWeight}"/>
                                    <TextBlock Text="to" Style="{StaticResource HintText}" Margin="8,0" VerticalAlignment="Center"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}" Width="64" ItemsSource="{Binding WeightOptions}" SelectedItem="{Binding MaxWeight}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource RailRow}">
                                <TextBlock Text="Length mm" Style="{StaticResource RailLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Style="{StaticResource StyledTextInput}" Width="64" ToolTip="Minimum length (mm); empty for none"
                                             Text="{Binding MinLengthMm, TargetNullValue='', UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                                    <TextBlock Text="to" Style="{StaticResource HintText}" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource StyledTextInput}" Width="64" ToolTip="Maximum length (mm); empty for none"
                                             Text="{Binding MaxLengthMm, TargetNullValue='', UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource RailRow}">
                                <TextBlock Text="Curve" Style="{StaticResource RailLabel}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <UniformGrid Columns="2">
                                    <CheckBox Content="Line" IsChecked="{Binding IncludeLines}" Margin="0,2"/>
                                    <CheckBox Content="Arc" IsChecked="{Binding IncludeArcs}" Margin="0,2"/>
                                    <CheckBox Content="Spline" IsChecked="{Binding IncludeSplines}" Margin="0,2"/>
                                    <CheckBox Content="Ellipse" IsChecked="{Binding IncludeEllipses}" Margin="0,2"/>
                                </UniformGrid>
                            </DockPanel>
                            <DockPanel Style="{StaticResource RailRow}" Margin="12,0,12,10">
                                <TextBlock Text="Workset" Style="{StaticResource RailLabel}"/>
                                <ComboBox Style="{StaticResource StandardComboBox}" ItemsSource="{Binding WorksetOptions}" SelectedItem="{Binding SelectedWorkset}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Show only -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Show only" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding OnlyDuplicates}"/>
                                <TextBlock Text="Duplicates / overlapping" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding OnlyShort}"/>
                                <TextBlock Text="Shorter than" Margin="8,0,6,0" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource StyledTextInput}" Width="52" HorizontalContentAlignment="Right"
                                         ToolTip="Tolerance (mm) for short lines and duplicate geometry"
                                         Text="{Binding ToleranceMm, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                                <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding OnlyInGroups}"/>
                                <TextBlock Text="In groups" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding OnlyOwnedByOthers}"/>
                                <TextBlock Text="Owned by other users" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,2,12,10" TextWrapping="Wrap"
                                       Text="Duplicates are checked with the tolerance of the last Find lines."/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Find lines" Style="{StaticResource PrimaryButton}" Command="{Binding FindLinesCommand}" Margin="0,0,8,0"/>
                        <Button Content="Reset filters" Style="{StaticResource SecondaryButton}" Command="{Binding ResetFiltersCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ Right column ═══ -->
                <StackPanel Grid.Column="2">
                    <!-- Results -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <WrapPanel Margin="12,10,12,6">
                                <Border Style="{StaticResource BadgePill}" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource BadgeText}"><Run Text="{Binding FoundCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" found"/></TextBlock>
                                </Border>
                                <Border Style="{StaticResource BadgePill}" Background="{StaticResource BrushStatusInfoSoft}" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource BrushStatusInfo}"><Run Text="{Binding CheckedCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" checked"/></TextBlock>
                                </Border>
                                <Border Style="{StaticResource BadgePill}" Background="{StaticResource BrushStatusErrorSoft}" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource BrushStatusError}"><Run Text="{Binding DuplicateCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" duplicates"/></TextBlock>
                                </Border>
                                <Border Style="{StaticResource BadgePill}" Background="{StaticResource BrushStatusWarnSoft}" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource BrushStatusWarn}"><Run Text="{Binding ShortCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" short"/></TextBlock>
                                </Border>
                                <Border Style="{StaticResource BadgePill}" Background="{StaticResource BrushStatusOkSoft}">
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource BrushStatusOk}"><Run Text="{Binding UnusedStyleCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" unused styles"/></TextBlock>
                                </Border>
                            </WrapPanel>

                            <DataGrid Margin="12,0,12,0" MinHeight="220"
                                      shell:ShellBehaviors.MaxHeightRatio="0.38"
                                      shell:ShellBehaviors.ForwardMouseWheel="True"
                                      ItemsSource="{Binding RowsView}"
                                      SelectedItem="{Binding SelectedRow}"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource StandardDataGridCell}"
                                      RowStyle="{StaticResource StandardDataGridRow}"
                                      AutoGenerateColumns="False"
                                      CanUserSortColumns="True"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="30" SortMemberPath="IsChecked">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox HorizontalAlignment="Center" IsThreeState="False" ToolTip="Check / uncheck every found line"
                                                      IsChecked="{Binding DataContext.AllFoundChecked, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ID" Width="80" Binding="{Binding IdValue}" IsReadOnly="True" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="Line style" Width="1.4*" Binding="{Binding StyleName}" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Weight" Width="70" SortMemberPath="EffectiveWeight">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EffectiveWeight}"/>
                                                    <Border Background="{StaticResource BrushStatusInfoSoft}" BorderBrush="{StaticResource BrushStatusInfoBorder}"
                                                            BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="5,0,0,0"
                                                            Visibility="{Binding HasOverride, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{Binding StyleWeight}" ToolTipService.InitialShowDelay="200">
                                                        <TextBlock Text="ovr" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushStatusInfo}"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="View" Width="1.6*" Binding="{Binding ViewName}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="View type" Width="1*" Binding="{Binding ViewTypeName}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Length (mm)" Width="90" Binding="{Binding LengthMm, StringFormat=F1}" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Curve" Width="62" Binding="{Binding Curve}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Workset" Width="1*" Binding="{Binding WorksetName}" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Flags" Width="1.5*" SortMemberPath="FlagsText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FlagsText}" Style="{StaticResource FlagText}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FlagsText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Margin="12,8,12,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Select in Revit" Style="{StaticResource SecondaryButton}" Command="{Binding SelectInRevitCommand}" Margin="0,0,8,0"
                                            ToolTip="Select the checked lines (or the highlighted row) in Revit"/>
                                    <Button Content="Show element" Style="{StaticResource SecondaryButton}" Command="{Binding ShowElementCommand}"
                                            ToolTip="Zoom to the highlighted row (or the first checked line)"/>
                                </StackPanel>
                                <TextBlock Text="Click a column header to sort." Style="{StaticResource HintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Action tabs -->
                    <Border Style="{StaticResource SectionCard}">
                        <TabControl BorderThickness="0" Background="Transparent" Margin="6">
                            <!-- Delete unused -->
                            <TabItem Header="Delete unused" Padding="12,5">
                                <StackPanel Margin="6,10,6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <CheckBox Content="Unused line styles" FontWeight="SemiBold" IsChecked="{Binding DeleteUnusedStyles}"/>
                                            <TextBlock Style="{StaticResource HintText}" Margin="20,2,0,4" TextWrapping="Wrap"
                                                       Text="Styles no curve in the project uses (model, detail and sketch lines). Built-in styles are never listed."/>
                                            <Border BorderBrush="{StaticResource BrushBorderInput}" BorderThickness="1" CornerRadius="4" Margin="20,0,0,0"
                                                    IsEnabled="{Binding DeleteUnusedStyles}">
                                                <Grid>
                                                    <ListBox ItemsSource="{Binding UnusedStyles}" MaxHeight="120" MinHeight="40" BorderThickness="0"
                                                             shell:ShellBehaviors.ForwardMouseWheel="True">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock Text="No unused line styles." Margin="8,10" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UnusedStyleCount}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <CheckBox Content="Duplicate / overlapping lines" FontWeight="SemiBold" IsChecked="{Binding DeleteDuplicates}"/>
                                            <TextBlock Style="{StaticResource HintText}" Margin="20,2,0,4" TextWrapping="Wrap"
                                                       Text="Same view and the same geometry within the tolerance. One line of each set is kept."/>
                                            <StackPanel Orientation="Horizontal" Margin="20,0,0,10" IsEnabled="{Binding DeleteDuplicates}">
                                                <TextBlock Text="Keep:" Style="{StaticResource HintText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <RadioButton GroupName="Keep" Content="Oldest ID" IsChecked="{Binding KeepOldest}" Margin="0,0,12,0"/>
                                                <RadioButton GroupName="Keep" Content="Newest ID" IsChecked="{Binding KeepNewest}" Margin="0,0,12,0"/>
                                                <RadioButton GroupName="Keep" Content="Heaviest weight" IsChecked="{Binding KeepHeaviest}"/>
                                            </StackPanel>

                                            <CheckBox Content="Short lines" FontWeight="SemiBold" IsChecked="{Binding DeleteShort}"/>
                                            <TextBlock Style="{StaticResource HintText}" Margin="20,2,0,10" TextWrapping="Wrap"
                                                       Text="{Binding ToleranceMm, StringFormat='Shorter than the tolerance ({0:0.##} mm).'}"/>

                                            <CheckBox IsChecked="{Binding SkipBlocked}">
                                                <TextBlock TextWrapping="Wrap" Text="Skip lines in groups and lines owned by other users (log them)"/>
                                            </CheckBox>
                                            <TextBlock Style="{StaticResource HintText}" Margin="20,2,0,0" TextWrapping="Wrap"
                                                       Text="Lines owned by other users are always skipped; they cannot be changed until released."/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Inline confirmation -->
                                    <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="5" BorderThickness="1"
                                            Background="{StaticResource BrushStatusErrorSoft}" BorderBrush="{StaticResource BrushStatusErrorBorder}"
                                            Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelDeleteCommand}" Margin="0,0,8,0"/>
                                                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding ConfirmDeleteCommand}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" Foreground="{StaticResource BrushStatusError}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <DockPanel Margin="0,12,0,4">
                                        <Button Content="Preview (dry run)" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewDeleteCommand}"
                                                ToolTip="List what Delete all found would delete; nothing is changed"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Delete checked" Style="{StaticResource OutlineButton}" Command="{Binding DeleteCheckedCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Delete all found" Style="{StaticResource DangerButton}" Command="{Binding DeleteAllFoundCommand}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </TabItem>

                            <!-- Line thickness -->
                            <TabItem Header="Line thickness" Padding="12,5">
                                <StackPanel Margin="6,10,6,4">
                                    <UniformGrid Columns="3">
                                        <RadioButton GroupName="Mode" IsChecked="{Binding ModeAssignStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="Assign line style" FontWeight="SemiBold"/>
                                                <TextBlock Text="Set each line's style to the one you choose." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Mode" IsChecked="{Binding ModeStyleWeight}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="Change style line weight" FontWeight="SemiBold"/>
                                                <TextBlock Text="Change the projection weight of the styles these lines use." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Mode" IsChecked="{Binding ModeViewOverride}">
                                            <StackPanel>
                                                <TextBlock Text="Per-view override" FontWeight="SemiBold"/>
                                                <TextBlock Text="Override the weight in each line's own view." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding ModeAssignStyle, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Line style" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox Style="{StaticResource StandardComboBox}" Width="300" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedAssignStyle}" DisplayMemberPath="Name"/>
                                    </DockPanel>

                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsWeightPickerVisible, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Line weight" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <ListBox ItemsSource="{Binding WeightOptions}" SelectedItem="{Binding Weight}" BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Width" Value="34"/>
                                                    <Setter Property="Height" Value="30"/>
                                                    <Setter Property="Margin" Value="0,0,4,4"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bg" CornerRadius="4" BorderThickness="1"
                                                                        Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderInput}">
                                                                    <TextBlock x:Name="Txt" Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                                                                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource BrushTextOnDark}"/>
                                                                        <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </StackPanel>

                                    <CheckBox Content="Clear existing overrides instead" Margin="0,8,0,0" IsChecked="{Binding ClearOverrides}"
                                              Visibility="{Binding ModeViewOverride, Converter={StaticResource BoolToVisibility}}"/>

                                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="5" BorderThickness="1"
                                            Background="{StaticResource BrushStatusWarnSoft}" BorderBrush="{StaticResource BrushStatusWarnBorder}"
                                            Visibility="{Binding ModeStyleWeight, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding StyleWeightWarning}" TextWrapping="Wrap" Foreground="{StaticResource BrushStatusWarn}"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,4">
                                        <Button Content="Apply to checked" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyCheckedCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Apply to all found" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyAllFoundCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </StackPanel>

                <!-- ═══ Log (full width) ═══ -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,0" Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy all" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogCommand}"/>
                                <Button Content="Copy selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Command="{Binding CopySelectedLogCommand}"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 SelectionMode="Extended"
                                 SelectionChanged="LogListBox_SelectionChanged"
                                 Background="Transparent" BorderThickness="0"
                                 MinHeight="120" Padding="0"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="{StaticResource BrushLogTextDim}" FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
