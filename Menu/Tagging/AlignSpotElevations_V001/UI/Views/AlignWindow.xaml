<Window x:Class="Revit26_Plugin_Revised.AlignSpotElevations.V001.UI.Views.AlignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="560" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header" Grid.Row="0" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <GroupBox Grid.Row="1" Header="Direction" Margin="0,0,0,8" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Vertical — one column (same X)" IsChecked="{Binding IsVertical}" Margin="0,0,24,0"/>
                <RadioButton Content="Horizontal — one row (same Y)" IsChecked="{Binding IsHorizontal}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Align to" Margin="0,0,0,8" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <RadioButton Content="Average" IsChecked="{Binding IsAverage}" Margin="0,2"/>
                    <RadioButton Content="Most common (most tags on the same line)" IsChecked="{Binding IsMostCommon}" Margin="0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="18,2,0,2">
                        <TextBlock Text="Same within" VerticalAlignment="Center"/>
                        <TextBox Width="48" Margin="6,0" Text="{Binding ToleranceMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                        <TextBlock Text="mm" VerticalAlignment="Center"/>
                    </StackPanel>
                    <RadioButton Content="Median" IsChecked="{Binding IsMedian}" Margin="0,2"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <RadioButton Content="Min (left / bottom)" IsChecked="{Binding IsMin}" Margin="0,2"/>
                    <RadioButton Content="Max (right / top)" IsChecked="{Binding IsMax}" Margin="0,2"/>
                    <RadioButton Content="Reference spot:" IsChecked="{Binding IsReference}" Margin="0,2"/>
                    <ComboBox Margin="18,2,0,2" ItemsSource="{Binding Items}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Reference}" IsEnabled="{Binding IsReference}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Spot" Binding="{Binding Label}" Width="*"/>
                <DataGridTextColumn Header="Now" Binding="{Binding Before}" Width="90"/>
                <DataGridTextColumn Header="After" Binding="{Binding After}" Width="90"/>
                <DataGridTextColumn Header="Moves" Binding="{Binding Moves}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="SkippedText" DockPanel.Dock="Left" Foreground="#B45309" VerticalAlignment="Center"
                       Cursor="Hand" TextDecorations="Underline" MouseLeftButtonUp="Skipped_Click"/>
            <Button Content="Cancel" DockPanel.Dock="Right" Width="80" IsCancel="True" Margin="8,0,0,0"/>
            <Button Content="Apply" DockPanel.Dock="Right" Width="80" IsDefault="True"
                    IsEnabled="{Binding CanApply}" Click="Apply_Click"/>
        </DockPanel>
    </Grid>
</Window>
