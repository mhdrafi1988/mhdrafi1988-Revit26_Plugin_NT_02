<Window x:Class="Revit26_Plugin_Revised.AlignSpotElevations.V001.UI.Views.AlignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Revit26_Plugin_Revised.AlignSpotElevations.V001.UI.ViewModels"
        Width="640" Height="820" MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,2"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="8,4"/></Style>
        <Style x:Key="Num" TargetType="TextBox"><Setter Property="Width" Value="48"/><Setter Property="Margin" Value="6,0"/></Style>

        <!-- One optional detail line (bend points, leader ends or text) -->
        <DataTemplate DataType="{x:Type vm:LinePickViewModel}">
            <GroupBox Header="{Binding Header}">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,2">
                        <Button DockPanel.Dock="Left" Content="Pick line…" Width="80" Command="{Binding PickCommand}"
                                ToolTip="Hides this window until you click a straight detail line in the view. Esc keeps the current line."/>
                        <Button DockPanel.Dock="Right" Content="Clear" Width="56" Command="{Binding ClearCommand}"
                                Visibility="{Binding HasLine, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding LineText}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <StackPanel Visibility="{Binding HasLine, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Move:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Content="Auto" IsChecked="{Binding IsAuto}" Margin="0,2,16,2"
                                         ToolTip="Vertical or horizontal, whichever reaches the line (the shorter move when both do)."/>
                            <RadioButton Content="Vertical (X stays)" IsChecked="{Binding IsVertical}" IsEnabled="{Binding CanVertical}" Margin="0,2,16,2"/>
                            <RadioButton Content="Horizontal (Y stays)" IsChecked="{Binding IsHorizontal}" IsEnabled="{Binding CanHorizontal}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Check}" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Header}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <GroupBox Grid.Row="1" Header="Arrange">
            <StackPanel>
                <RadioButton Content="Align to a line" IsChecked="{Binding IsAlignMode}"/>
                <RadioButton Content="Distribute only (space along the column or row)" IsChecked="{Binding IsDistributeMode}"/>
                <RadioButton Content="Offset from point (same distance from each measured point)" IsChecked="{Binding IsOffsetMode}"/>
                <RadioButton Content="Align to detail lines (slide onto picked lines, vertically or horizontally)" IsChecked="{Binding IsDetailLineMode}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Move" Visibility="{Binding ShowsMoveParts, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <CheckBox Content="Text" IsChecked="{Binding MoveText}" Margin="0,2"/>
                <CheckBox Content="{Binding LeaderEndLabel}" IsChecked="{Binding MoveLeaderEnd}" Margin="0,2"/>
                <CheckBox Content="{Binding LeaderShoulderLabel}" IsChecked="{Binding MoveLeaderShoulder}" Margin="0,2"/>
                <TextBlock Text="{Binding FollowNote}" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3">
            <!-- Align to detail lines: one optional line per part -->
            <StackPanel Visibility="{Binding IsDetailLineMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Pick a detail line for the bend points, the leader end points, the text, or any mix. Every pick is optional. A part with no line stays where it is, except that the text follows its end point, as in Revit."/>
                <ContentControl Content="{Binding BendLine}"/>
                <ContentControl Content="{Binding EndLine}"/>
                <ContentControl Content="{Binding TextLine}"/>
                <GroupBox Header="Spots past the end of a line">
                    <StackPanel>
                        <RadioButton Content="Skip them (only use the line as drawn)" IsChecked="{Binding IsSkipPastEnd}"/>
                        <RadioButton Content="Treat the line as endless (extend it as far as needed)" IsChecked="{Binding IsExtendLines}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Line options: direction, target, spacing -->
            <StackPanel Visibility="{Binding UsesLine, Converter={StaticResource BoolToVis}}">
                <GroupBox Header="Direction">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Vertical — one column" IsChecked="{Binding IsVertical}" Margin="0,2,24,2"/>
                        <RadioButton Content="Horizontal — one row" IsChecked="{Binding IsHorizontal}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Line position" Visibility="{Binding IsAlignMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <RadioButton Content="Average" IsChecked="{Binding IsAverage}"/>
                            <RadioButton Content="Most common" IsChecked="{Binding IsMostCommon}"/>
                            <StackPanel Orientation="Horizontal" Margin="18,2,0,2">
                                <TextBlock Text="Same within" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource Num}" Text="{Binding ToleranceMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                                <TextBlock Text="mm" VerticalAlignment="Center"/>
                            </StackPanel>
                            <RadioButton Content="Median" IsChecked="{Binding IsMedian}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <RadioButton Content="Min (left / bottom)" IsChecked="{Binding IsMin}"/>
                            <RadioButton Content="Max (right / top)" IsChecked="{Binding IsMax}"/>
                            <RadioButton Content="Reference spot:" IsChecked="{Binding IsReference}"/>
                            <ComboBox Margin="18,2,0,2" ItemsSource="{Binding Items}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding Reference}" IsEnabled="{Binding IsReference}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Spacing along the line">
                    <StackPanel>
                        <RadioButton Content="Keep current spacing" IsChecked="{Binding IsKeepSpacing}" IsEnabled="{Binding CanKeepSpacing}"/>
                        <RadioButton Content="Even (first and last tag stay)" IsChecked="{Binding IsEvenSpacing}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Fixed gap" IsChecked="{Binding IsFixedGap}" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource Num}" Text="{Binding GapMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                     IsEnabled="{Binding IsFixedGap}"/>
                            <TextBlock Text="mm (top / left tag stays)" VerticalAlignment="Center"/>
                            <Button Content="Fit" Width="44" Margin="8,0,0,0" Command="{Binding FitGapCommand}"
                                    ToolTip="{Binding FitGapTip}" ToolTipService.ShowOnDisabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Offset options: one row per ticked part -->
            <GroupBox Header="Offset from measured point (negative = left / down)" Visibility="{Binding IsOffsetMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding MoveText, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Text" Width="80" VerticalAlignment="Center"/>
                        <TextBlock Text="Right" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding OffsetXMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                        <TextBlock Text="mm    Up" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding OffsetYMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                        <TextBlock Text="mm" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding MoveLeaderEnd, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Leader end" Width="80" VerticalAlignment="Center"/>
                        <TextBlock Text="Right" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding EndOffsetXMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                        <TextBlock Text="mm    Up" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding EndOffsetYMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                        <TextBlock Text="mm" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding MoveLeaderShoulder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Bend point" Width="80" VerticalAlignment="Center"/>
                        <TextBlock Text="Right" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding ShoulderOffsetXMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                        <TextBlock Text="mm    Up" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding ShoulderOffsetYMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                        <TextBlock Text="mm" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,6">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Warning}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <DataGrid Grid.Row="5" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stays}" Value="True">
                            <Setter Property="Foreground" Value="Gray"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Overlaps}" Value="True">
                            <Setter Property="Foreground" Value="#C0392B"/>
                            <Setter Property="ToolTip" Value="Would overlap another selected tag (estimated)"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Spot" Binding="{Binding Label}" Width="*"/>
                <DataGridTextColumn Header="Text X (mm)" Binding="{Binding MoveX}" Width="80"/>
                <DataGridTextColumn Header="Text Y (mm)" Binding="{Binding MoveY}" Width="80"/>
                <DataGridTextColumn x:Name="EndColumn" Header="End X, Y (mm)" Binding="{Binding EndMove}" Width="100"/>
                <DataGridTextColumn x:Name="BendColumn" Header="Bend X, Y (mm)" Binding="{Binding BendMove}" Width="100"/>
                <DataGridTextColumn x:Name="ResultColumn" Header="Result" Binding="{Binding Result}" Width="2*" Visibility="Collapsed"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="6" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="SkippedText" DockPanel.Dock="Left" Foreground="#B45309" VerticalAlignment="Center"
                       Cursor="Hand" TextDecorations="Underline" MouseLeftButtonUp="Skipped_Click"/>
            <Button Content="Cancel" DockPanel.Dock="Right" Width="80" IsCancel="True" Margin="8,0,0,0"/>
            <Button Content="Apply" DockPanel.Dock="Right" Width="80" IsDefault="True"
                    IsEnabled="{Binding CanApply}" Click="Apply_Click"/>
        </DockPanel>
    </Grid>
</Window>
