<!--
=======================================================
File: RoofTagWindow.xaml
Changes vs V017 (layout only, per CLAUDE.md v1.1 — ToolWindowShell):
  - Window content is a shared ToolWindowShell:
      HEADER  title bar + V018, Placed / Failed metrics
      BODY    warning banner, settings cards, Log (moved here from the
              footer); the middle's own ScrollViewer removed
      FOOTER  status strip (IsRunning / Progress / SummaryText), OK → Cancel
  - Log: ShellBehaviors.MaxHeightRatio + ForwardMouseWheel.
  - Still a modal dialog (OK / Cancel) — no behaviour change; every
    binding/command is the V017 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.RoofTag.V018.RoofTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.RoofTag.V018"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.RoofTag}, Path=Title, StringFormat='{}{0} (FaceRef)'}"
        Height="760" Width="560"
        MinHeight="760" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSurfaceWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolConverter             x:Key="InverseBoolConverter"/>
            <local:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <local:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>

            <DataTemplate x:Key="LogRowTemplate">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               FontFamily="Consolas" FontSize="10"
                               Width="58" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Level, StringFormat={}{0,-7}}"
                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                               Width="64" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Message}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               FontFamily="Consolas" FontSize="10"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Roof Tag"
                           Subtitle="FaceRef method"
                           Version="{Binding Source={x:Static svc:ToolCatalog.RoofTag}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Placed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PlacedCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- ── WARNING BANNER ──────────────────────────────────────── -->
                <Border Background="{StaticResource BrushInputBackground}" BorderBrush="{StaticResource BrushStatusWarn}" BorderThickness="1"
                        CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                    <TextBlock FontSize="10" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="FaceRef method — tags DELETE if slab shape is edited after placement. Place tags after finalizing slope."/>
                </Border>

                <!-- ── TAG MODE ─────────────────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tag Mode" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton Content="Auto" FontSize="10" Margin="0,0,14,0"
                                         IsChecked="{Binding UseManualMode, Converter={StaticResource InverseBoolConverter}}"/>
                            <RadioButton Content="Manual (pick points)" FontSize="10" IsChecked="{Binding UseManualMode}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── LEADER GEOMETRY ──────────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Leader Geometry" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushNavyPrimary}" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Angle" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Content="45°" FontSize="10" Margin="0,0,10,0" IsChecked="{Binding IsAngle45}"/>
                                <RadioButton Content="30°" FontSize="10" IsChecked="{Binding IsAngle30}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="Bend" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <RadioButton Content="Inward" FontSize="10" Margin="0,0,10,0" IsChecked="{Binding BendInward}"/>
                                <RadioButton Content="Outward" FontSize="10" IsChecked="{Binding BendOutward}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Bend" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Grid.Column="1" IsEditable="True" FontSize="10" Height="24" Padding="4,2"
                                      Background="{StaticResource BrushSurfaceCard}" Foreground="{StaticResource BrushTextPrimary}"
                                      ItemsSource="{Binding PresetOffsetValues}"
                                      Text="{Binding BendOffset, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="3" Text="End" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Grid.Column="4" IsEditable="True" FontSize="10" Height="24" Padding="4,2"
                                      Background="{StaticResource BrushSurfaceCard}" Foreground="{StaticResource BrushTextPrimary}"
                                      ItemsSource="{Binding PresetOffsetValues}"
                                      Text="{Binding EndOffset, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="5" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>

                            <CheckBox Grid.Column="7" Content="Use leader" FontSize="10" VerticalAlignment="Center"
                                      IsChecked="{Binding UseLeader}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── SPOT TAG TYPE ─────────────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Spot Tag Type" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" FontSize="10" Height="24"
                                  Background="{StaticResource BrushSurfaceCard}" Foreground="{StaticResource BrushTextPrimary}"
                                  ItemsSource="{Binding SpotTagTypes}"
                                  SelectedItem="{Binding SelectedSpotTagType}"
                                  DisplayMemberPath="Name"/>
                    </Grid>
                </Border>

                <!-- ── CLUSTER FILTER (Rule 1) ────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Cluster filter — avoid clustered tags near drains" FontSize="10"
                                  VerticalAlignment="Center" IsChecked="{Binding ClusterFilterEnabled}"/>
                        <TextBlock Grid.Column="1" Text="Radius" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <TextBox Grid.Column="2" FontSize="10" Height="24" MaxLength="10"
                                 Background="{StaticResource BrushSurfaceCard}" Foreground="{StaticResource BrushTextPrimary}"
                                 BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                 VerticalContentAlignment="Center" Padding="6,0"
                                 IsEnabled="{Binding ClusterFilterEnabled}"
                                 Text="{Binding ClusterRadius, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                </Border>

                <!-- ── INTERIOR LOOP REDUCTION (Rule 2) ───────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                    <StackPanel>
                        <CheckBox Content="Interior loop reduction — rule 2" FontSize="10" FontWeight="SemiBold"
                                  Foreground="{StaticResource BrushNavyPrimary}"
                                  Margin="0,0,0,8" IsChecked="{Binding InteriorLoopReductionEnabled}"/>
                        <Grid IsEnabled="{Binding InteriorLoopReductionEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Spacing" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" FontSize="10" Height="24" MaxLength="10"
                                     Background="{StaticResource BrushSurfaceCard}" Foreground="{StaticResource BrushTextPrimary}"
                                     BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     Text="{Binding InteriorLoopSpacing, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>

                            <TextBlock Grid.Column="4" Text="Boundary tol." FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="5" FontSize="10" Height="24" MaxLength="10"
                                     Background="{StaticResource BrushSurfaceCard}" Foreground="{StaticResource BrushTextPrimary}"
                                     BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     Text="{Binding InteriorLoopBoundaryTolerance, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="6" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Top 4 highest points per interior loop, kept only if each neighbor pair is at least the spacing value apart — otherwise only the highest point is kept."/>
                    </StackPanel>
                </Border>

                <!-- ── EXTERIOR LOOP REDUCTION (Rule 3) ───────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                    <StackPanel>
                        <CheckBox Content="Exterior loop reduction — rule 3" FontSize="10" FontWeight="SemiBold"
                                  Foreground="{StaticResource BrushNavyPrimary}"
                                  Margin="0,0,0,8" IsChecked="{Binding ExteriorLoopReductionEnabled}"/>
                        <Grid IsEnabled="{Binding ExteriorLoopReductionEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Spacing" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" FontSize="10" Height="24" MaxLength="10"
                                     Background="{StaticResource BrushSurfaceCard}" Foreground="{StaticResource BrushTextPrimary}"
                                     BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     Text="{Binding ExteriorLoopSpacing, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>

                            <TextBlock Grid.Column="4" Text="Boundary tol." FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="5" FontSize="10" Height="24" MaxLength="10"
                                     Background="{StaticResource BrushSurfaceCard}" Foreground="{StaticResource BrushTextPrimary}"
                                     BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     Text="{Binding ExteriorLoopBoundaryTolerance, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="6" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Same mechanism as rule 2, scoped to only the roof's outer boundary loop, with its own spacing and tolerance."/>
                    </StackPanel>
                </Border>

                <!-- ── LOG (moved from footer) ── -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyLogCommand}"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}" MinHeight="90" shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                           Foreground="{StaticResource BrushLogTextDim}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Level}"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Width="64"/>
                                <TextBlock Text="{Binding Message}"
                                           Foreground="{StaticResource BrushLogText}"
                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK"     Style="{StaticResource PrimaryButton}"
                        Width="80" Margin="0,0,8,0" Click="OnOK"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Width="80" Click="OnCancel"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
