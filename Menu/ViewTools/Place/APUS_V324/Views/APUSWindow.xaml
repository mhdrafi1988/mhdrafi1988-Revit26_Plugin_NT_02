<!--
=======================================================
File: APUSWindow.xaml  (V324 — ToolWindowShell, CLAUDE.md v1.1)
Changes vs V323 (layout only):
  - Hosted in Shared/Controls/ToolWindowShell.
    HEADER: title / subtitle / version + metric cards.
    BODY:   sections list (left) / layout settings (right), then the log
            (moved from the footer).
    FOOTER: shell status strip (ShowProgress, Progress.Percentage,
            StatusMessage) + current-operation line + Place / Cancel /
            Close.
  - Settings column's own ScrollViewer removed — the shell body is the
    one ScrollViewer. Sections grid and log cap their height
    (ShellBehaviors.MaxHeightRatio) and forward the mouse wheel.
  - Footer progress bar replaced by the shell's progress bar.
  - No behaviour change — every binding/command is the V323 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.APUS.V324.Views.AutoPlaceSectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.APUS.V324.Views"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.APUS.V324.Converters"
        xmlns:shared="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:viewModels="clr-namespace:Revit26_Plugin_Revised.APUS.V324.ViewModels"
        xmlns:models="clr-namespace:Revit26_Plugin_Revised.APUS.V324.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.APUS}, Path=Title}"
        Height="800" Width="960"
        MinHeight="800" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter registration: consuming window's own Resources, after
                 the merged dictionary closes — never inside the merged wrapper,
                 per suite convention. Same-project references, no ;assembly= suffix.
                 All of these must live inside THIS SAME ResourceDictionary — Window.Resources
                 accepts exactly one child element, so anything placed as a sibling of this
                 ResourceDictionary (rather than inside it) throws "'Resources' property has
                 already been set". -->
            <shared:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <shared:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <shared:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <shared:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:EnumDisplayConverter x:Key="EnumDisplayConverter"/>
            <converters:SortArrowConverter x:Key="SortArrowConverter"/>

            <!-- Row style that greys out and locks already-placed sections -->
            <Style x:Key="SectionRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                        <Setter Property="Opacity" Value="0.55"/>
                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SortableHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextOnDark}"/>
            </Style>

            <Style x:Key="MmInput" TargetType="TextBox" BasedOn="{StaticResource StyledTextInput}">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="MaxLength" Value="10"/>
                <Setter Property="TextAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Auto Place Sections"
                           Subtitle="Even-gap reading-order placement"
                           Version="{Binding Source={x:Static svc:ToolCatalog.APUS}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding ShowProgress, Mode=OneWay}"
                           Progress="{Binding Progress.Percentage, Mode=OneWay}"
                           SummaryText="{Binding StatusMessage}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="4" Margin="0,2,0,0">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Sections" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FilteredSections.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Placed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunMetrics.Placed}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunMetrics.Skipped}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunMetrics.Failed}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ========== LEFT COLUMN: SECTIONS ========== -->
                    <Border Grid.Column="0" Style="{StaticResource BaseCard}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Card header + refresh -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sections" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding RefreshCommand}"/>
                            </Grid>

                            <!-- Search + scope -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource StyledTextInput}"
                                         MaxLength="25"
                                         Text="{Binding NameSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search by name..."/>
                                <Border Grid.Column="2" Background="{StaticResource BrushSystemSecondaryBackground}"
                                        CornerRadius="5" Padding="8,3">
                                    <TextBlock Text="Whole model" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </Border>
                            </Grid>

                            <!-- All / Placed / Unplaced toggle: three plain buttons, click handlers in
                                 code-behind set PlacementFilter directly (enum binding through XAML-only
                                 RadioButtons is unreliable, so this is handled explicitly instead). -->
                            <Border Grid.Row="2" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                    CornerRadius="5" Margin="0,0,0,6" Padding="1">
                                <UniformGrid Columns="3">
                                    <Button x:Name="FilterAllButton" Content="All" Height="22" FontSize="10"
                                            Background="{StaticResource BrushNavyPrimary}" Foreground="{StaticResource BrushTextOnAccent}"
                                            BorderThickness="0" Click="FilterAll_Click"/>
                                    <Button x:Name="FilterPlacedButton" Content="Placed" Height="22" FontSize="10"
                                            Background="Transparent" Foreground="{StaticResource BrushTextPrimary}"
                                            BorderThickness="0" Click="FilterPlaced_Click"/>
                                    <Button x:Name="FilterUnplacedButton" Content="Unplaced" Height="22" FontSize="10"
                                            Background="Transparent" Foreground="{StaticResource BrushTextPrimary}"
                                            BorderThickness="0" Click="FilterUnplaced_Click"/>
                                </UniformGrid>
                            </Border>

                            <!-- Sections grid -->
                            <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Custom header row with sortable columns -->
                                    <Border Grid.Row="0" Background="{StaticResource BrushNavyPrimary}" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text=""/>

                                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Click="SortByName_Click" HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Name" Style="{StaticResource SortableHeaderText}"/>
                                                    <TextBlock Margin="3,0,0,0" Style="{StaticResource SortableHeaderText}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                                <Binding Path="SortColumn"/>
                                                                <Binding Source="{x:Static models:SectionGridSortColumn.Name}"/>
                                                                <Binding Path="SortAscending"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Click="SortBySize_Click" HorizontalContentAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Size" Style="{StaticResource SortableHeaderText}"/>
                                                    <TextBlock Margin="3,0,0,0" Style="{StaticResource SortableHeaderText}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                                <Binding Path="SortColumn"/>
                                                                <Binding Source="{x:Static models:SectionGridSortColumn.Size}"/>
                                                                <Binding Path="SortAscending"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Click="SortByPlaced_Click" HorizontalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Placed" Style="{StaticResource SortableHeaderText}"/>
                                                    <TextBlock Margin="3,0,0,0" Style="{StaticResource SortableHeaderText}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                                <Binding Path="SortColumn"/>
                                                                <Binding Source="{x:Static models:SectionGridSortColumn.Placed}"/>
                                                                <Binding Path="SortAscending"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Click="SortByDetailNumber_Click" HorizontalContentAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Det#" Style="{StaticResource SortableHeaderText}"/>
                                                    <TextBlock Margin="3,0,0,0" Style="{StaticResource SortableHeaderText}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                                <Binding Path="SortColumn"/>
                                                                <Binding Source="{x:Static models:SectionGridSortColumn.DetailNumber}"/>
                                                                <Binding Path="SortAscending"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Sections grid: capped at 50% of the window, scrolls itself beyond that -->
                                    <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.5" shell:ShellBehaviors.ForwardMouseWheel="True" MinHeight="200" Grid.Row="1" x:Name="SectionsDataGrid"
                                              ItemsSource="{Binding FilteredSections}"
                                              AutoGenerateColumns="False"
                                              HeadersVisibility="None"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                                              RowHeight="22"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              SelectionMode="Extended"
                                              RowStyle="{StaticResource SectionRowStyle}"
                                              CellStyle="{StaticResource DataGridCellStyle}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              FontSize="10"
                                              SelectionChanged="SectionsDataGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="20">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding IsPlaced, Converter={StaticResource InverseBoolConverter}}"
                                                                  HorizontalAlignment="Center"
                                                                  Click="SectionCheckBox_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Width="2*" Binding="{Binding ViewName}"/>
                                            <DataGridTextColumn Width="1.4*" Binding="{Binding SizeDisplay}"
                                                                 ElementStyle="{StaticResource FieldValue}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11"
                                                                   Text="{Binding IsPlaced, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Width="0.8*" Binding="{Binding DetailNumber}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- Select all / none / invert + counter -->
                            <Grid Grid.Row="4" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="All" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"
                                            Command="{Binding SelectAllCommand}"/>
                                    <Button Content="None" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"
                                            Command="{Binding ClearSelectionCommand}"/>
                                    <Button Content="Invert" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding InvertSelectionCommand}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                                           Foreground="{StaticResource BrushTextSecondary}">
                                    <Run Text="{Binding SelectedSectionsCount, Mode=OneWay}"/>
                                    <Run Text=" sel"/>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                        <StackPanel Grid.Column="2">

                            <!-- Margins + Gaps -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource BaseCard}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Margins (mm)" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="2" Rows="2">
                                            <StackPanel Margin="0,0,4,4">
                                                <TextBlock Text="Left" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource MmInput}" Text="{Binding LeftMarginMm}"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,4">
                                                <TextBlock Text="Right" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource MmInput}" Text="{Binding RightMarginMm}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,4,4,0">
                                                <TextBlock Text="Top" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource MmInput}" Text="{Binding TopMarginMm}"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,4,0,0">
                                                <TextBlock Text="Bottom" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource MmInput}" Text="{Binding BottomMarginMm}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource BaseCard}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Gaps (mm)" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="Horizontal (min)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource MmInput}" Text="{Binding HorizontalGapMm}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Vertical" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource MmInput}" Text="{Binding VerticalGapMm}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Reading Order card -->
                            <Border Style="{StaticResource BaseCard}" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Reading order" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="Reading direction" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Style="{StaticResource StandardComboBox}" FontSize="10" Height="24"
                                                  ItemsSource="{Binding AvailableReadingDirections}"
                                                  SelectedItem="{Binding ReadingDirection}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <UniformGrid Columns="2" Rows="2">
                                        <StackPanel Margin="0,0,4,4">
                                            <TextBlock Text="Row Y-tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource MmInput}" Text="{Binding YToleranceMm}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,4">
                                            <TextBlock Text="Within-row tiebreak" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource StandardComboBox}" FontSize="10" Height="22"
                                                      ItemsSource="{Binding AvailableRowTiebreaks}"
                                                      SelectedItem="{Binding RowTiebreak}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" FontSize="10"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,4,4,0">
                                            <TextBlock Text="Marker source" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource StandardComboBox}" FontSize="10" Height="22"
                                                      ItemsSource="{Binding AvailableMarkerSources}"
                                                      SelectedItem="{Binding MarkerSource}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" FontSize="10"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="4,4,0,0">
                                            <TextBlock Text="Sort fallback" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource StandardComboBox}" FontSize="10" Height="22"
                                                      ItemsSource="{Binding AvailableSortFallbacks}"
                                                      SelectedItem="{Binding SortFallback}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" FontSize="10"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Title block + prefix -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Title block" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}" FontSize="10" Height="26"
                                              ItemsSource="{Binding TitleBlocks}"
                                              SelectedItem="{Binding SelectedTitleBlock}"
                                              DisplayMemberPath="DisplayName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sheet prefix" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource StyledTextInput}" FontSize="10" Height="26" MaxLength="10"
                                             Text="{Binding SheetPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Number format preview -->
                            <Border Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="5"
                                    Padding="8,5" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SheetNumberFormatPreview}" FontSize="10"
                                               Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="prefix + dash + 3-digit" FontSize="9"
                                               Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Multi-sheet toggle -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <CheckBox IsChecked="{Binding PlaceToMultipleSheets}" VerticalAlignment="Center"/>
                                <TextBlock Text="Place to multiple sheets" FontSize="10" Margin="6,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                </Grid>

                <!-- LOG (moved from footer) -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                        Command="{Binding CopyLogsCommand}"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                        Click="CopySelectedLog_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True" Grid.Row="1" x:Name="LogListBox" MinHeight="110"
                                 ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Extended"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="10.5"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel>
                <!-- Current operation + percentage while placing (the bar itself is the shell's) -->
                <DockPanel Margin="0,0,0,6" LastChildFill="True"
                           Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Progress.Percentage, StringFormat={}{0:F0}%}" FontSize="9"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding Progress.CurrentOperation}" FontSize="9"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Place Sections" MinWidth="150" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding PlaceCommand}"
                                                    Visibility="{Binding ShowCancelButton, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button Content="Cancel Placement" MinWidth="150" Margin="0,0,8,0" Style="{StaticResource DangerButton}"
                                                    Command="{Binding CancelCommand}"
                                                    Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
