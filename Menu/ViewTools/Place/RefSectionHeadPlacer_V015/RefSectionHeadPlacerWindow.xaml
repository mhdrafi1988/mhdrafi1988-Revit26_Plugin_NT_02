<!--
=======================================================
File: RefSectionHeadPlacerWindow.xaml  (V015 — ToolWindowShell, CLAUDE.md v1.1)
Changes vs V014 (layout only):
  - Hosted in Shared/Controls/ToolWindowShell.
    HEADER: title / version + metric cards.
    BODY:   setup (left) / element data + mapping (right), then the
            activity log (moved from the footer).
    FOOTER: shell status strip (IsRunning, ProgressPercent,
            ProgressStatusText) + Cancel / Run / Close.
  - Both panel ScrollViewers removed — the shell body is the one
    ScrollViewer. The four grids and the log cap their height with
    ShellBehaviors.MaxHeightRatio (replacing fixed MaxHeights) and
    forward the mouse wheel.
  - Footer progress block replaced by the shell's status strip.
  - No behaviour change — every binding/command is the V014 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.RefSectionHeadPlacer.V015.UI.Views.RefSectionHeadPlacerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.RefSectionHeadPlacer}, Path=Title}"
        Height="860" Width="1180"
        MinHeight="860" MinWidth="1180"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushSurfaceWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally per convention — never inside SharedStyles.xaml -->
            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>
            <converters:InverseBoolConverter             x:Key="InverseBoolConverter"/>

            <!-- Local override: this tool's DataGrid rows/headers run smaller than the
                 SharedStyles.xaml default (12.5) to match RefSectionHeadPlacer's compact
                 sizing standard (rows 10.5 / RowHeight 28, labels 11.5, inputs 11). -->
            <Style x:Key="CompactDataGrid" TargetType="DataGrid" BasedOn="{StaticResource StandardDataGrid}">
                <Setter Property="FontSize"  Value="10.5"/>
                <Setter Property="RowHeight" Value="28"/>
            </Style>

            <Style x:Key="CompactDataGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Padding"  Value="6,6"/>
            </Style>

            <Style x:Key="CompactDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource StandardDataGridCell}">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Padding"  Value="6,3"/>
            </Style>

            <!-- Local field/label overrides at 11 / 11.5 per tool standard -->
            <Style x:Key="CompactFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Setter Property="FontSize" Value="11.5"/>
            </Style>

            <!-- V003: input padding standardized to 2,2 per Rafi's directive (was 8,4 / 8,6 inherited). -->
            <Style x:Key="CompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource StandardComboBox}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Height"   Value="28"/>
                <Setter Property="Padding"  Value="2,2"/>
            </Style>

            <!-- V010: Grid 3 mapping picker. Replaces the V008 popover — a plain
                 editable ComboBox living directly in the DataGrid cell (no
                 CellTemplate/CellEditingTemplate pair, so there is no edit-mode
                 commit-timing risk). IsEditable + IsTextSearchEnabled="False" turns
                 off WPF's native prefix-only text search so CategoryMappingRow's own
                 substring filter (SearchText/FilteredDraftingViews) drives the
                 drop-down instead. StaysOpenOnEdit keeps the drop-down open while
                 typing. MaxDropDownHeight/dropdown width are set on the ComboBox
                 instance in the template below (dropdown width 220 vs a 150px
                 column, per Rafi's confirmation) rather than here, since Width
                 on a ComboBox affects the closed box, not the popup. -->
            <Style x:Key="MappingSearchComboBox" TargetType="ComboBox" BasedOn="{StaticResource StandardComboBox}">
                <Setter Property="FontSize"              Value="11"/>
                <Setter Property="Height"                Value="24"/>
                <Setter Property="Padding"               Value="4,2"/>
                <Setter Property="IsEditable"             Value="True"/>
                <Setter Property="IsTextSearchEnabled"    Value="False"/>
                <Setter Property="StaysOpenOnEdit"        Value="True"/>
                <Setter Property="DisplayMemberPath"      Value="Name"/>
                <!-- FIX: default ComboBoxItem highlight/selected states left Foreground
                     unset, so the system highlight brush could render selected/hovered
                     dropdown text unreadable (dark-on-dark or white-on-white depending
                     on OS theme). Forced explicit Foreground on every state using only
                     SharedStyles.xaml brushes — same pattern as StandardDataGridCell's
                     IsSelected trigger. -->
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrushAppleBlueLight}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CompactTextInput" TargetType="TextBox" BasedOn="{StaticResource StyledTextInput}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding"  Value="2,2"/>
            </Style>

            <Style x:Key="CardHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
            </Style>

            <Style x:Key="CardMetaText" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
            </Style>

            <!-- Section-group label above each panel's card stack (e.g. "SETUP", "ELEMENT DATA") -->
            <Style x:Key="PanelSectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize"      Value="11"/>
                <Setter Property="FontWeight"    Value="Bold"/>
                <Setter Property="Foreground"    Value="{StaticResource BrushTextTertiary}"/>
                <Setter Property="Margin"        Value="2,0,0,4"/>
            </Style>

            <!-- Plan Type filter trigger — mirrors OutlineButton chrome but as a ToggleButton,
                 so IsChecked doubles as the popover's open/closed state (no separate command). -->
            <Style x:Key="PlanTypeFilterToggle" TargetType="ToggleButton">
                <Setter Property="FontSize"        Value="11"/>
                <Setter Property="Height"          Value="26"/>
                <Setter Property="Background"      Value="{StaticResource BrushSurfaceWindow}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5" Padding="8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="&#9662;" FontSize="8" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextTertiary}" Margin="4,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Reference Section Head Placer"
                           Version="{Binding Source={x:Static svc:ToolCatalog.RefSectionHeadPlacer}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding ProgressPercent, Mode=OneWay}"
                           SummaryText="{Binding ProgressStatusText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Elements" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ElementCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Mapped" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MappedCount}" Style="{StaticResource MetricNumberAccent}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Placed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PlacedCount}" Style="{StaticResource MetricNumberSuccess}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- TWO-PANEL BODY: setup (left) / element data + mapping (right) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" MinWidth="420"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="56*" MinWidth="480"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT PANEL — Setup / configuration ── -->
                        <StackPanel Grid.Column="0" Margin="10,10,8,10">
                            <TextBlock Text="SETUP" Style="{StaticResource PanelSectionLabel}"/>

                            <!-- Section type + Tail length — same row -->
                            <Border Style="{StaticResource SectionCard}" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Section type" Style="{StaticResource CompactFieldLabel}"
                                                   VerticalAlignment="Center" Width="90"/>
                                        <ComboBox x:Name="CmbSectionType" Style="{StaticResource CompactComboBox}"
                                                  Width="190" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding SectionTypes}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedSectionType}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tail length" Style="{StaticResource CompactFieldLabel}"
                                                   VerticalAlignment="Center" Width="90"/>
                                        <TextBox Style="{StaticResource CompactTextInput}" Width="60" MaxLength="10"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding TailLengthMmText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Linked Files — checkbox list. Every checked link is processed
                                 independently; doors/plumbing/walls from each stay in their own
                                 Grid 2 rows, never merged across links. -->
                            <GroupBox Style="{StaticResource CardGroupBox}">
                                <GroupBox.Header>
                                    <Grid Margin="0,0,12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Linked Files" Style="{StaticResource CardHeaderText}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource CardMetaText}"
                                                   Text="{Binding LinkSelectionSummary}"/>
                                    </Grid>
                                </GroupBox.Header>

                                <StackPanel Margin="12,4,12,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Select all" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding SelectAllLinksCommand}" Margin="0,0,6,0"/>
                                        <Button Content="Clear" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding ClearLinksCommand}"/>
                                    </StackPanel>

                                    <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.15" shell:ShellBehaviors.ForwardMouseWheel="True" MinHeight="80" x:Name="GridLinkedFiles" Style="{StaticResource CompactDataGrid}"
                                              ColumnHeaderStyle="{StaticResource CompactDataGridColumnHeader}"
                                              CellStyle="{StaticResource CompactDataGridCell}"
                                              ItemsSource="{Binding Links}" AutoGenerateColumns="False"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              CanUserAddRows="False" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Width="34"/>
                                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Roof type filter (popover) + Boundary buffer — ticked roof types
                                 anchor the buffer's bounding-box expansion in Grid 2; unticked
                                 roof types are excluded from Grid 2's Roofs rows too. -->
                            <Border Style="{StaticResource SectionCard}" Padding="12,10">
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Roof type" Style="{StaticResource CompactFieldLabel}"
                                                       VerticalAlignment="Center" Width="90"/>
                                            <ToggleButton x:Name="BtnRoofType" Width="110"
                                                          Style="{StaticResource PlanTypeFilterToggle}"
                                                          Content="{Binding RoofTypeSelectionSummary}"
                                                          IsChecked="{Binding IsRoofTypePopoverOpen, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Boundary buffer" Style="{StaticResource CompactFieldLabel}"
                                                       VerticalAlignment="Center" Width="90"/>
                                            <TextBox Style="{StaticResource CompactTextInput}" Width="60" MaxLength="10"
                                                     HorizontalAlignment="Left"
                                                     Text="{Binding BoundaryBufferMmText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Popover — search box + tickable roof-type list, closes on
                                         outside click via StaysOpen="False". -->
                                    <Popup PlacementTarget="{Binding ElementName=BtnRoofType}" Placement="Bottom"
                                           IsOpen="{Binding IsRoofTypePopoverOpen, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="{StaticResource BrushSurfaceCard}"
                                                BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                                                CornerRadius="8" Padding="8" Width="200">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBox Style="{StaticResource CompactTextInput}" MaxLength="25"
                                                         Text="{Binding RoofTypeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Type to search…" Margin="0,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding RoofTypeOptions}" MaxHeight="140">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      FontSize="11" Margin="2,3"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border BorderBrush="{StaticResource BrushSeparatorThin}"
                                                        BorderThickness="0,1,0,0" Margin="0,6,0,4"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="All" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding SelectAllRoofTypesCommand}"/>
                                                    <Button Content="None" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding ClearRoofTypesCommand}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>

                            <!-- ── 1 · Plan views ── -->
                            <GroupBox Style="{StaticResource CardGroupBox}">
                                <GroupBox.Header>
                                    <Grid Margin="0,0,12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="1 · Plan Views" Style="{StaticResource CardHeaderText}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource CardMetaText}"
                                                   Text="{Binding PlanViewSelectionSummary}"/>
                                    </Grid>
                                </GroupBox.Header>

                                <StackPanel Margin="12,4,12,10">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource CompactTextInput}" MaxLength="10"
                                                 Text="{Binding PlanViewFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Filter views…"/>
                                        <ToggleButton x:Name="BtnPlanType" Grid.Column="1" Width="94"
                                                      Style="{StaticResource PlanTypeFilterToggle}"
                                                      Content="{Binding PlanTypeSelectionSummary}"
                                                      IsChecked="{Binding IsPlanTypePopoverOpen, Mode=TwoWay}"
                                                      Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" Content="Select all" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding SelectAllPlanViewsCommand}" Margin="6,0,0,0"/>
                                        <Button Grid.Column="3" Content="Clear" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding ClearPlanViewsCommand}" Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- Plan Type filter popover — anchored under BtnPlanType, closes on
                                         outside click via StaysOpen="False". -->
                                    <Popup PlacementTarget="{Binding ElementName=BtnPlanType}" Placement="Bottom"
                                           IsOpen="{Binding IsPlanTypePopoverOpen, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="{StaticResource BrushSurfaceCard}"
                                                BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                                                CornerRadius="8" Padding="8" Width="200">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBox Style="{StaticResource CompactTextInput}" MaxLength="25"
                                                         Text="{Binding PlanTypeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Type to search…" Margin="0,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding PlanTypeOptions}" MaxHeight="140">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      FontSize="11" Margin="2,3"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border BorderBrush="{StaticResource BrushSeparatorThin}"
                                                        BorderThickness="0,1,0,0" Margin="0,6,0,4"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="All" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding SelectAllPlanTypesCommand}"/>
                                                    <Button Content="None" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding ClearPlanTypesCommand}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <!-- V011: CanUserSortColumns enables WPF's native column-header
                                         sort glyph (no custom converter/style needed — SharedStyles-only,
                                         per convention). IsSelected (checkbox) intentionally left
                                         unsortable — sorting a checkbox column has no useful order. -->
                                    <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.25" shell:ShellBehaviors.ForwardMouseWheel="True" MinHeight="120" x:Name="GridPlanViews" Style="{StaticResource CompactDataGrid}"
                                              ColumnHeaderStyle="{StaticResource CompactDataGridColumnHeader}"
                                              CellStyle="{StaticResource CompactDataGridCell}"
                                              ItemsSource="{Binding PlanViews}" AutoGenerateColumns="False"
                                              CanUserSortColumns="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              CanUserAddRows="False" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Width="34" CanUserSort="False"/>
                                            <DataGridTextColumn Header="View Name" Binding="{Binding ViewName}" Width="*" SortMemberPath="ViewName"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding ViewType}" Width="80" SortMemberPath="ViewType"/>
                                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="56" SortMemberPath="Level"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                    <!-- ── Vertical divider between panels ── -->
                    <Border Grid.Column="1" Width="1" Background="{StaticResource BrushSeparator}"/>

                    <!-- ── RIGHT PANEL — Element data / mapping / run output ── -->
                        <StackPanel Grid.Column="2" Margin="8,10,10,10">
                            <TextBlock Text="ELEMENT DATA" Style="{StaticResource PanelSectionLabel}"/>

                            <!-- ── 2 · Element categories & types ── -->
                            <GroupBox Style="{StaticResource CardGroupBox}">
                                <GroupBox.Header>
                                    <Grid Margin="0,0,12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="2 · Element Categories &amp; Types" Style="{StaticResource CardHeaderText}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource CardMetaText}" Text="{Binding ElementScopeSummary}"/>
                                    </Grid>
                                </GroupBox.Header>

                                <StackPanel Margin="12,4,12,10">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource CompactTextInput}" MaxLength="10"
                                                 Text="{Binding ElementTypeFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Filter types…"/>
                                        <Button Grid.Column="1" Content="Select all" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding SelectAllElementTypesCommand}" Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding ClearElementTypesCommand}" Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- V011: CanUserSortColumns enables WPF's native sort-arrow glyph. -->
                                    <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.25" shell:ShellBehaviors.ForwardMouseWheel="True" MinHeight="120" x:Name="GridElementTypes" Style="{StaticResource CompactDataGrid}"
                                              ColumnHeaderStyle="{StaticResource CompactDataGridColumnHeader}"
                                              CellStyle="{StaticResource CompactDataGridCell}"
                                              ItemsSource="{Binding ElementTypes}" AutoGenerateColumns="False"
                                              CanUserSortColumns="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              CanUserAddRows="False" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Width="34" CanUserSort="False"/>
                                            <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="70" SortMemberPath="SourceLabel"/>
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" SortMemberPath="Category"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="*" SortMemberPath="TypeName"/>
                                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="46" SortMemberPath="Count">
                                                <DataGridTextColumn.HeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <!-- ── 3 · Category → drafting view mapping ── -->
                            <GroupBox Style="{StaticResource CardGroupBox}">
                                <GroupBox.Header>
                                    <Grid Margin="0,0,12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="3 · Map Type → Drafting View" Style="{StaticResource CardHeaderText}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource CardMetaText}" Text="from selected types"/>
                                    </Grid>
                                </GroupBox.Header>

                                <!-- Rows auto-populate from the types checked in Grid 2 (one per type),
                                     so drain vs wash basin can each target a different drafting view. -->
                                <StackPanel Margin="12,4,12,10">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource CompactTextInput}" MaxLength="10"
                                                 Text="{Binding CategoryMappingFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Filter mappings…"/>
                                        <Button Grid.Column="1" Content="Select all" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding SelectAllMappingsCommand}" Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding ClearMappingsCommand}" Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- V010 (confirmed, Rafi): the V008 popover (button + Popup) is
                                         REMOVED. Drafting View picker is now a plain editable, searchable
                                         ComboBox living directly in the grid cell — one click/keystroke,
                                         no Popup indirection, no logical-tree lookup needed in code-behind.
                                         Text binds to CategoryMappingRow.SearchText (live substring filter,
                                         not WPF's native prefix-only text search — IsTextSearchEnabled is
                                         off on purpose); ItemsSource is the row's own FilteredDraftingViews,
                                         narrowed as SearchText changes. A pick fires SelectionChanged in
                                         code-behind (MappingCombo_SelectionChanged), which calls
                                         row.SelectDraftingView(...) and the drop-down closes natively.
                                         Un-mapping a row is NOT supported here (confirmed, Rafi) — untick
                                         the row's IsSelected checkbox to exclude it from Run instead.
                                         Dropdown width is 220 (wider than the 150px column) so long
                                         drafting-view names aren't clipped, set via MaxDropDownWidth. -->
                                    <!-- V011: CanUserSortColumns enables WPF's native sort-arrow glyph.
                                         The Drafting View column is a DataGridTemplateColumn (ComboBox
                                         cell), which has no Binding to infer a sort key from — its
                                         SortMemberPath points at MappedDraftingViewDisplay so unmapped
                                         rows ("— pick —") and mapped rows both sort sensibly by name. -->
                                    <!-- V012: MaxHeight raised 220 -> 420 (confirmed, Rafi) so roughly
                                         10 rows (28px RowHeight + header) are visible before scrolling,
                                         up from ~6-7. V015: cap is now 45% of the window height
                                         (ShellBehaviors.MaxHeightRatio); the shell body scrolls. -->
                                    <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.45" shell:ShellBehaviors.ForwardMouseWheel="True" MinHeight="200" x:Name="GridMapping" Style="{StaticResource CompactDataGrid}"
                                              ColumnHeaderStyle="{StaticResource CompactDataGridColumnHeader}"
                                              CellStyle="{StaticResource CompactDataGridCell}"
                                              ItemsSource="{Binding CategoryMappings}" AutoGenerateColumns="False"
                                              CanUserSortColumns="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Standard"
                                              CanUserAddRows="False" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Width="34" CanUserSort="False"/>
                                            <DataGridTextColumn Header="File · Category · Type" Binding="{Binding DisplayLabel}" Width="*" SortMemberPath="DisplayLabel"/>
                                            <DataGridTemplateColumn Header="Drafting View" Width="150" SortMemberPath="MappedDraftingViewDisplay">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- FIX (V010 review): a separate SelectedItem binding here
                                                             was removed. On an IsEditable="True" ComboBox, SelectedItem
                                                             changes also push into Text — with FilteredDraftingViews
                                                             mutating on every keystroke (ApplyFilter), that caused
                                                             WPF to re-run selection sync against the new collection
                                                             and fight the Text/SearchText binding (caret jumps while
                                                             typing). Not needed anyway: MappingCombo_SelectionChanged
                                                             reads the control's SelectedItem directly on pick, and
                                                             display when not typing is already driven by SearchText
                                                             (seeded from the current pick in the ctor / SelectDraftingView). -->
                                                        <!-- V012: four behavior fixes, same visual (confirmed, Rafi) —
                                                             TextBoxBase.TextChanged (bubbled from the editable part)
                                                             auto-opens the drop-down on typing; DropDownOpened shows
                                                             the full list + re-highlights the pick; DropDownClosed +
                                                             LostKeyboardFocus revert stray typed text to the pick.
                                                             See code-behind MappingCombo_* handlers. -->
                                                        <ComboBox Style="{StaticResource MappingSearchComboBox}"
                                                                  ItemsSource="{Binding FilteredDraftingViews}"
                                                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                  MaxDropDownHeight="180" Width="150"
                                                                  HorizontalAlignment="Stretch" Margin="2"
                                                                  SelectionChanged="MappingCombo_SelectionChanged"
                                                                  TextBoxBase.TextChanged="MappingCombo_TextChanged"
                                                                  DropDownOpened="MappingCombo_DropDownOpened"
                                                                  DropDownClosed="MappingCombo_Dismissed"
                                                                  LostKeyboardFocus="MappingCombo_LostKeyboardFocus"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                        </StackPanel>
                </Grid>

                <!-- ACTIVITY LOG (moved from footer) -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                                            Command="{Binding CopyAllLogsCommand}" Margin="0,0,4,0"/>
                                                    <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}"
                                                            Click="OnCopySelectedLogsClick" Margin="0,0,4,0"/>
                                                    <Button Content="Export .txt" Style="{StaticResource DarkGhostButton}"
                                                            Command="{Binding ExportLogsCommand}" Margin="0,0,4,0"/>
                                                    <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                                            Command="{Binding ClearLogsCommand}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True" Grid.Row="1" x:Name="GridLog" ItemsSource="{Binding LogEntries}"
                                                              Background="Transparent" BorderThickness="0"
                                                              MinHeight="110" AutoGenerateColumns="False"
                                                              HeadersVisibility="None" GridLinesVisibility="None"
                                                              RowBackground="Transparent" IsReadOnly="True"
                                                              SelectionMode="Extended" CanUserAddRows="False"
                                                              VirtualizingPanel.IsVirtualizing="True"
                                                              ScrollViewer.CanContentScroll="True"
                                                              IsTextSearchEnabled="False" Margin="0">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Binding="{Binding Time, StringFormat='HH:mm:ss'}" Width="55"
                                                                                 FontSize="10.5" Foreground="{StaticResource BrushLogTextDim}"/>
                                                            <DataGridTextColumn Binding="{Binding Message}" Width="*"
                                                                                 FontSize="10.5">
                                                                <DataGridTextColumn.ElementStyle>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                                                    </Style>
                                                                </DataGridTextColumn.ElementStyle>
                                                            </DataGridTextColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <!-- V011: disabled permanently (not just visually) — Execute() runs
                     synchronously on Revit's API thread for the whole run, so the WPF
                     window is frozen and this can never be clicked while IsRunning is
                     true anyway. IsEnabled bound straight to False rather than to
                     IsRunning so the state is honest instead of implying a live control.
                     Tooltip explains why; command/plumbing kept for a future async engine. -->
                <Button Content="Cancel" Style="{StaticResource OutlineButton}"
                        Foreground="{StaticResource BrushStatusError}" BorderBrush="{StaticResource BrushStatusError}"
                        Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        IsEnabled="False"
                        ToolTip="Cancel isn't available yet — the run executes on Revit's own thread, which freezes this window until it finishes."
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Run" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
