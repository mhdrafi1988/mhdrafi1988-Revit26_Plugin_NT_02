<!--
=======================================================
File: CalloutCOPWindow.xaml  (V021 — ToolWindowShell, CLAUDE.md v1.1)
Changes vs V020 (layout only):
  - Hosted in Shared/Controls/ToolWindowShell.
    HEADER: title / subtitle / version + summary metric cards.
    BODY:   configuration card + view grid, then the log (moved from the
            footer).
    FOOTER: shell status strip (IsRunning, indeterminate; ProgressText)
            + run-disabled reason, Place → Close.
  - View grid and log cap their height (ShellBehaviors.MaxHeightRatio)
    and forward the mouse wheel. The drafting-view combo popup keeps its
    ScrollViewer (a Popup is a separate window).
  - Placed-pill colours → SharedStyles brushes.
  - No behaviour change — every binding/command is the V020 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.CalloutCOP.V021.Views.CalloutCOPWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.CalloutCOP.V021.Views"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static svc:ToolCatalog.CalloutCOP}, Path=Title}"
        Height="900"
        Width="1080"
        MinHeight="900"
        MinWidth="1080"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>

            <!-- ═══════════════════════════════════════════════════════
                 Rich dropdown row template - used ONLY inside the popup's
                 ItemsPresenter (see DraftingViewComboBox style below).
                 Name | Detail # | Sheet, three aligned columns.
            ═══════════════════════════════════════════════════════ -->
            <DataTemplate x:Key="DraftingViewDropdownRowTemplate">
                <Grid Margin="6,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                               FontSize="10.5" Foreground="{StaticResource BrushTextPrimary}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding DetailNumbers}"
                               FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="4,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding SheetNumbers}"
                               FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                               TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                </Grid>
            </DataTemplate>

            <!-- ═══════════════════════════════════════════════════════
                 DraftingViewComboBox - shared ComboBox style for ALL 6
                 drafting-view combos (bulk-fill x3 + per-row grid x3).

                 Standard WPF pattern for "plain closed box, rich open
                 dropdown": ComboBox.ItemTemplate would apply to BOTH the
                 closed selection box and the open popup (they are not
                 independently templatable via DisplayMemberPath/
                 ItemTemplate alone). This ControlTemplate instead splits
                 them explicitly:
                   - The closed box is a ContentPresenter bound to
                     SelectedItem.Name only (plain text, no rich columns).
                   - The Popup's ItemsPresenter uses the ComboBox's
                     ItemTemplate (set to DraftingViewDropdownRowTemplate
                     below), which only ever renders for items inside the
                     open dropdown list.
                 Local to this window per shared-styles convention -
                 SharedStyles.xaml is left untouched.
            ═══════════════════════════════════════════════════════ -->
            <Style x:Key="DraftingViewComboBox" TargetType="ComboBox">
                <Setter Property="ItemTemplate" Value="{StaticResource DraftingViewDropdownRowTemplate}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Background" Value="{StaticResource BrushSurfaceWindow}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <!-- V018: enables DraftingViewSearchBehavior, which wires the
                     PART_SearchBox / PART_ResultCount named elements below
                     into a per-instance filtered CollectionView (search box +
                     live "Showing X/Y" counter over the existing rich
                     Name | Detail # | Sheet row template). -->
                <Setter Property="local:DraftingViewSearchBehavior.IsEnabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Closed box: PLAIN NAME ONLY, per spec -->
                                                    <!-- FIX: this TextBlock lives inside ToggleButton.Template
                                                         (nested), so TemplatedParent here resolved to the
                                                         ToggleButton - which has no SelectedItem property.
                                                         The binding silently failed and always showed blank,
                                                         even after a real selection was made. AncestorType=
                                                         ComboBox walks up to the actual ComboBox instead. -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                               FontSize="10" Foreground="{StaticResource BrushTextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Margin="6,0,4,0"/>
                                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource BrushTextTertiary}"
                                                          StrokeThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- V018: MinWidth 260 so the search box / rich row columns never
                                     get squeezed by narrow hosts (the 3 per-row grid columns are
                                     ~130px). Popup still opens left-aligned under the closed box;
                                     WPF's own on-screen placement adjuster (Popup default behavior)
                                     shifts it left automatically if it would overflow the window's
                                     right edge, so no manual Placement logic is needed here. -->
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="None" StaysOpen="False">
                                    <Border Background="{StaticResource BrushSurfaceCard}"
                                            BorderBrush="{StaticResource BrushBorderDefault}"
                                            BorderThickness="1" CornerRadius="6"
                                            MinWidth="260"
                                            MaxHeight="300">
                                        <StackPanel>
                                            <Border Padding="8,6" BorderThickness="0,0,0,1"
                                                    BorderBrush="{StaticResource BrushSeparatorThin}">
                                                <StackPanel>
                                                    <TextBox x:Name="PART_SearchBox"
                                                             Style="{StaticResource StyledTextInput}"
                                                             Height="24"/>
                                                    <!-- V018: teaches the "detail/sheet" structured search
                                                         (e.g. "12/A-201") alongside plain free-text search. -->
                                                    <TextBlock Text="Search by name, or type detail/sheet e.g. 12/A-201"
                                                               Style="{StaticResource HintText}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushSeparatorThin}">
                                                <TextBlock x:Name="PART_ResultCount"
                                                           FontSize="9" Foreground="{StaticResource BrushTextTertiary}"
                                                           Padding="8,3"/>
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220" Margin="2">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Callout COP"
                           Subtitle="Reference callout placement - per-view mapping"
                           Version="{Binding Source={x:Static svc:ToolCatalog.CalloutCOP}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding ProgressText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Selected" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>

                <!-- V018: new card - sum of filled Left/Center/Right slots across
                     selected rows, i.e. what a run would attempt right now. -->
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Expected Placements" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ExpectedPlacementCount}" Style="{StaticResource MetricNumberAccent}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Already Placed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PlacedCount}" Style="{StaticResource MetricNumberAccent}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Placed This Run" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunSuccessCount}" Style="{StaticResource MetricNumberSuccess}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="8" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failed This Run" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunFailedCount}" Style="{StaticResource MetricNumberDanger}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="10" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Skipped (No Views)" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunSkippedCount}" Style="{StaticResource MetricNumberWarning}"/>
                    </StackPanel>
                </Border>

            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="200"/>
                    </Grid.RowDefinitions>

                    <!-- CONFIG CARD -->
                    <Border Grid.Row="0" Style="{StaticResource ContentCard}" Padding="12">
                        <StackPanel>

                            <!-- Bulk-fill toolbar -->
                            <TextBlock Text="Bulk-fill (applies to all checked rows)"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,0,0,6"/>
                            <!-- V019: bulk-fill controls sized up 50% (24->36 height,
                                 10->15 font, widths scaled to match) so the row reads
                                 as the primary action on this card. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <ComboBox ItemsSource="{Binding DraftingViews}"
                                          SelectedItem="{Binding BulkFillLeftView}"
                                          Style="{StaticResource DraftingViewComboBox}"
                                          Width="225" Height="36" FontSize="15" Margin="0,0,9,0"/>
                                <ComboBox ItemsSource="{Binding DraftingViews}"
                                          SelectedItem="{Binding BulkFillCenterView}"
                                          Style="{StaticResource DraftingViewComboBox}"
                                          Width="225" Height="36" FontSize="15" Margin="0,0,9,0"/>
                                <ComboBox ItemsSource="{Binding DraftingViews}"
                                          SelectedItem="{Binding BulkFillRightView}"
                                          Style="{StaticResource DraftingViewComboBox}"
                                          Width="225" Height="36" FontSize="15" Margin="0,0,15,0"/>
                                <Button Content="Apply to checked"
                                        Command="{Binding ApplyBulkFillCommand}"
                                        Style="{StaticResource AccentButton}"
                                        Height="36" Width="195" FontSize="15"/>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,9"/>

                            <!-- V019: sheet filter, callout size, and the show/hide
                                 checkboxes collapsed onto a single row per Rafi. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="Sheet filter" FontSize="10"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <!-- Sheet filter button + popup (multi-select, OR-match) -->
                                <Grid Width="150" Margin="0,0,14,0">
                                    <Button x:Name="SheetFilterButton"
                                            Content="{Binding SheetFilterSummaryText}"
                                            Command="{Binding OpenSheetFilterPopupCommand}"
                                            Style="{StaticResource OutlineButton}"
                                            Height="26" HorizontalContentAlignment="Left"
                                            Padding="8,0"/>

                                    <Popup IsOpen="{Binding IsSheetFilterPopupOpen, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=SheetFilterButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="None">
                                        <Border Background="{StaticResource BrushSurfaceCard}"
                                                BorderBrush="{StaticResource BrushBorderDefault}"
                                                BorderThickness="1" CornerRadius="8" Width="260">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="3" BlurRadius="12" Opacity="0.2"/>
                                            </Border.Effect>
                                            <StackPanel>

                                                <!-- Search -->
                                                <!-- NOTE: StyledTextInput has no built-in watermark/placeholder
                                                     support, so a small label is used above the box instead
                                                     of attempting a Tag-based placeholder trick. -->
                                                <Border BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,0,0,1" Padding="8">
                                                    <StackPanel>
                                                        <TextBlock Text="Search sheet number" FontSize="9.5"
                                                                   Foreground="{StaticResource BrushTextTertiary}"
                                                                   Margin="2,0,0,3"/>
                                                        <TextBox Text="{Binding SheetFilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource StyledTextInput}"
                                                                 MaxLength="25" Height="24"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Checklist -->
                                                <ItemsControl ItemsSource="{Binding SheetFilterItemsView}" MaxHeight="220">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          Padding="6,5" Margin="4,0">
                                                                    <TextBlock Text="{Binding DisplayText}" FontSize="10.5"/>
                                                                    <CheckBox.Style>
                                                                        <Style TargetType="CheckBox">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAllRow}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </CheckBox.Style>
                                                                </CheckBox>
                                                                <Border BorderThickness="0,0,0,1"
                                                                        BorderBrush="{StaticResource BrushSeparatorThin}"
                                                                        Margin="4,2"
                                                                        Visibility="{Binding IsAllRow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Footer -->
                                                <Border BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,1,0,0"
                                                        Background="{StaticResource BrushSystemSecondaryBackground}">
                                                    <Grid Margin="6,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Button Content="Select all"
                                                                    Command="{Binding SheetFilterSelectAllCommand}"
                                                                    Style="{StaticResource SmallSecondaryButton}"
                                                                    Margin="0,0,6,0"/>
                                                            <Button Content="Clear"
                                                                    Command="{Binding SheetFilterClearCommand}"
                                                                    Style="{StaticResource SmallSecondaryButton}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Close"
                                                                Command="{Binding CloseSheetFilterPopupCommand}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Height="26" Padding="10,0"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <TextBlock Text="Callout size (mm)" FontSize="10"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding CalloutSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="10" FontSize="10" Width="60" Height="26"
                                         VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,8,0"/>
                                <TextBlock Text="suggested from view scale" FontSize="10"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSizeAutoSuggested, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="Reset to suggested"
                                        Command="{Binding ResetSizeToSuggestedCommand}"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Padding="9,0" FontSize="10" Margin="0,0,16,0"/>

                                <CheckBox Content="Show placed" IsChecked="{Binding ShowPlaced}"
                                          FontSize="10" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Show unplaced" IsChecked="{Binding ShowUnplaced}"
                                          FontSize="10" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Show sections" IsChecked="{Binding ShowSections}"
                                          FontSize="10" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Show elevations" IsChecked="{Binding ShowElevations}"
                                          FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                    <!-- VIEW GRID CARD -->
                    <Border Grid.Row="1" Style="{StaticResource ContentCard}">
                        <DockPanel LastChildFill="True">
                            <!-- V019: selection actions and quick filter on a single
                                 toolbar row per Rafi. "Group by" was replaced with
                                 the "Filter by" row below, which actually narrows
                                 the grid instead of just grouping it. -->
                            <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Select all"
                                            Command="{Binding SelectAllCommand}"
                                            Style="{StaticResource SmallSecondaryButton}"
                                            Margin="0,0,6,0" Padding="9,0" FontSize="9.5"/>
                                    <Button Content="Select none"
                                            Command="{Binding SelectNoneCommand}"
                                            Style="{StaticResource SmallSecondaryButton}"
                                            Margin="0,0,6,0" Padding="9,0" FontSize="9.5"/>
                                    <Button Content="Inverse selection"
                                            Command="{Binding InverseSelectionCommand}"
                                            Style="{StaticResource SmallSecondaryButton}"
                                            Padding="9,0" FontSize="9.5" Margin="0,0,14,0"/>
                                </StackPanel>
                                <!-- V019: search box widened 180->360 (2x) per Rafi. -->
                                <TextBox Grid.Column="1"
                                          Text="{Binding ViewGridSearchText, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource StyledTextInput}"
                                          Height="24" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="2" Text="Scoped to visible/filtered rows"
                                           FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- V019: "Filter by" - was "Group by" (grouped rows but
                                 didn't actually filter them). Renamed and rewired to
                                 apply as a real filter: pick a parameter, the typable
                                 value dropdown fills with that parameter's distinct
                                 values, pick a value to narrow the grid. Both reset
                                 to blank every time the window opens. -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,10,8">
                                <TextBlock Text="Filter by" FontSize="10"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding FilterParameterOptions}"
                                          SelectedItem="{Binding SelectedFilterParameter}"
                                          FontSize="10" Height="24" Width="140" Margin="0,0,14,0"/>

                                <!-- V019: label + value combo stay visible always, but
                                     grey out (IsEnabled=False) until a parameter is
                                     picked, rather than appearing/disappearing. -->
                                <TextBlock Text="Value" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFilterParameter}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox ItemsSource="{Binding FilterParameterValuesView}"
                                          Text="{Binding FilterValueSearchText, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedItem="{Binding SelectedFilterValue, Mode=TwoWay}"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          FontSize="10" Height="24" Width="220" Margin="0,0,10,0">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFilterParameter}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>

                                <Button Content="Clear filter"
                                        Command="{Binding ClearParameterFilterCommand}"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Padding="9,0" FontSize="9.5"/>
                            </StackPanel>

                        <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.45" shell:ShellBehaviors.ForwardMouseWheel="True" MinHeight="200" ItemsSource="{Binding ViewsCollection}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">

                            <DataGrid.Columns>

                                <DataGridCheckBoxColumn Header="&#10003;"
                                                         Binding="{Binding IsSelected, Mode=TwoWay}"
                                                         CanUserSort="False"
                                                         Width="34"/>

                                <DataGridTextColumn Header="View name"
                                                     Binding="{Binding Name}"
                                                     Width="*"/>

                                <DataGridTextColumn Header="Type"
                                                     Binding="{Binding ViewType}"
                                                     Width="90"/>

                                <DataGridTextColumn Header="Sheets"
                                                     Binding="{Binding SheetNumbers}"
                                                     Width="110"/>

                                <!-- LEFT -->
                                <DataGridTemplateColumn Width="130" SortMemberPath="LeftView.Name">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="Left" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextOnDark}"/>
                                            <TextBlock Text="-50mm" FontSize="9"
                                                       Foreground="{StaticResource BrushAppleBlueLight}"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.DraftingViews,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding LeftView, Mode=TwoWay}"
                                                      Style="{StaticResource DraftingViewComboBox}"
                                                      Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CENTER -->
                                <DataGridTemplateColumn Width="130" SortMemberPath="CenterView.Name">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="Center" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextOnDark}"/>
                                            <TextBlock Text="0mm" FontSize="9"
                                                       Foreground="{StaticResource BrushAppleBlueLight}"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.DraftingViews,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding CenterView, Mode=TwoWay}"
                                                      Style="{StaticResource DraftingViewComboBox}"
                                                      Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- RIGHT -->
                                <DataGridTemplateColumn Width="130" SortMemberPath="RightView.Name">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="Right" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextOnDark}"/>
                                            <TextBlock Text="+50mm" FontSize="9"
                                                       Foreground="{StaticResource BrushAppleBlueLight}"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.DraftingViews,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding RightView, Mode=TwoWay}"
                                                      Style="{StaticResource DraftingViewComboBox}"
                                                      Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Placed" Width="80" IsReadOnly="True" SortMemberPath="IsPlaced">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="9.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Unplaced"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                    <Setter Property="Text" Value="Placed"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- LOG PANEL (moved from footer) -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="10" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}"
                                CornerRadius="10,10,0,0" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Log" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy All"
                                            Command="{Binding CopyAllLogsCommand}"
                                            Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"/>
                                    <Button Content="Copy Selected"
                                            Click="CopySelectedLogs_Click"
                                            Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"/>
                                    <Button Content="Clear"
                                            Command="{Binding ClearLogsCommand}"
                                            Style="{StaticResource DarkGhostButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True" x:Name="LogListBox" Grid.Row="1" MinHeight="120"
                                 ItemsSource="{Binding Logs}"
                                 SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="10,4">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:HH:mm:ss}  {1,-7}  {2}">
                                                <Binding Path="Time"/>
                                                <Binding Path="Level"/>
                                                <Binding Path="Message"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <DockPanel>
                <!-- V018: reason shown once Run disables permanently after a
                     successful run this session. -->
                <TextBlock Text="{Binding RunDisabledReason}"
                           FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           DockPanel.Dock="Right"
                           Visibility="{Binding HasPlacedThisSession, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button Content="Close" Style="{StaticResource OutlineButton}"
                        Width="90" Height="38" DockPanel.Dock="Right" Click="CloseButton_Click"/>
                <Button Content="Place Reference Callouts"
                        Command="{Binding PlaceCalloutsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="220" Margin="0,0,8,0" DockPanel.Dock="Right"/>
            </DockPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
