<!--
=======================================================
File: RoofEdgeElementSectionsWindow.xaml
Changes vs V002 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (new title bar + version, selection
    summary metrics), middle (roofs / linked elements / parameters /
    naming steps scroll; planned sections grid fills its row and scrolls
    itself — no outer ScrollViewer), fixed footer (always-visible log with
    Copy All / Copy Selected / Clear, last-run summary, Run → Close).
  - MinWidth/MinHeight = default size.
  - No behaviour change — every binding/command is the V002 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.RoofEdgeElementSections.V003.RoofEdgeElementSectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.RoofEdgeElementSections.V003"
        Title="Roof Edge Element Sections — V003"
        Width="1020" Height="960" MinWidth="1020" MinHeight="960"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BrushSystemBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <local:StatusToEnabledConverter x:Key="StatusToEnabledConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Roof Edge Element Sections" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Sections where linked elements meet the selected roof edges" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V003" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <!-- SELECTION SUMMARY (compact, single row) -->
            <Border Style="{StaticResource ContentCard}" Margin="0,10,0,8">
                <Grid Margin="12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Selection Summary" FontSize="11.5" FontWeight="Bold"
                               Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>

                    <Border Grid.Column="2" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Roofs " FontSize="10" Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalRoofsCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Elements " FontSize="10" Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DetectedElementCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Suggested " FontSize="10" Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SuggestedSectionCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushAppleBlue}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Created " FontSize="10" Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FinallyCreatedCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="10" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Skipped " FontSize="10" Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SkippedCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180"/>
                <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. ROOFS -->
                    <Expander Header="1. Roofs" IsExpanded="True" Margin="0,0,0,8"
                              Background="{StaticResource BrushCardBackground}"
                              BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                        <StackPanel Margin="12,6,12,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Pick Roofs" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                        Command="{Binding PickRoofsCommand}"
                                        ToolTip="Interactively pick one or more roof elements in the model. The window hides while picking."/>
                                <Button Content="Clear Roofs" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ClearRoofsCommand}"
                                        ToolTip="Remove every picked roof from the list below."/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedRoofs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:SelectedRoofItem}">
                                        <Border BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,1,0,0" Padding="6,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12.5" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Remove" Style="{StaticResource SmallSecondaryButton}"
                                                        Command="{Binding RemoveCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No roofs picked yet." Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Expander>

                    <!-- 2. LINKED ELEMENTS -->
                    <Expander Header="2. Linked Elements" IsExpanded="True" Margin="0,0,0,8"
                              Background="{StaticResource BrushCardBackground}"
                              BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                        <StackPanel Margin="0,4,0,4">
                            <TextBlock Text="Linked Models" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushNavyPrimary}" Margin="14,6,14,2"/>
                            <ItemsControl ItemsSource="{Binding LinkedModels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:LinkedModelItem}">
                                        <Border BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,1,0,0" Padding="14,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsLoaded}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DocumentTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,0,0">
                                                        <Run Text="Instance: "/><Run Text="{Binding InstanceName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource BadgePill}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                                <Setter Property="Text" Value="Unloaded"/>
                                                                <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                                                        <Setter Property="Text" Value="Loaded"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="Elements to Match" IsExpanded="False" Margin="14,10,14,4"
                                      Background="{StaticResource BrushSystemSecondaryBackground}"
                                      BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1">
                                <StackPanel Margin="8,6,8,8">
                                    <Grid Margin="0,4,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Search" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource BoxedTextInput}"
                                                     Text="{Binding ElementSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Search by category, family, type, or link name."/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Category Filter" Style="{StaticResource FieldLabel}"/>
                                            <ToggleButton x:Name="CategoryFilterToggle" Height="32"
                                                          IsChecked="{Binding IsCategoryFilterOpen, Mode=TwoWay}"
                                                          ToolTip="Filter the grid below to one or more categories.">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{StaticResource BrushInputBackground}"
                                                                BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                                                CornerRadius="6" Padding="8,0" Cursor="Hand">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding CategoryFilterSummaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <Path Grid.Column="1" Data="M 0 0 L 4 5 L 8 0" Stroke="{StaticResource BrushTextSecondary}"
                                                                      StrokeThickness="1.4" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <Popup PlacementTarget="{Binding ElementName=CategoryFilterToggle}"
                                                   IsOpen="{Binding IsCategoryFilterOpen, Mode=TwoWay}"
                                                   StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
                                                <Border Background="{StaticResource BrushCardBackground}"
                                                        BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1"
                                                        CornerRadius="8" Width="240" Padding="8">
                                                    <Border.Effect>
                                                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.22" Color="#14283F"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBox Style="{StaticResource BoxedTextInput}" Margin="0,0,0,6"
                                                                 Text="{Binding CategoryFilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Type to narrow this category list."/>

                                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl ItemsSource="{Binding CategoryFilterOptionsView}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:CategoryFilterOption}">
                                                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding CategoryName}"
                                                                                  FontSize="12.5" Padding="4,3" Margin="0,1,0,0"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>

                                                        <Button Content="Clear Filter" Style="{StaticResource SmallSecondaryButton}"
                                                                Margin="0,6,0,0" HorizontalAlignment="Left"
                                                                Command="{Binding ClearCategoryFilterCommand}"
                                                                ToolTip="Uncheck every category (shows all categories again)."/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button Content="Check All" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                                    Command="{Binding CheckAllVisibleCommand}"
                                                    ToolTip="Check every type currently visible (after search/filter)."/>
                                            <Button Content="Uncheck All" Style="{StaticResource SmallSecondaryButton}"
                                                    Command="{Binding UncheckAllVisibleCommand}"
                                                    ToolTip="Uncheck every type currently visible (after search/filter)."/>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid Height="230"
                                              ItemsSource="{Binding ElementRowsView}"
                                              Style="{StaticResource StandardDataGrid}"
                                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                              CellStyle="{StaticResource StandardDataGridCell}"
                                              RowStyle="{StaticResource StandardDataGridRow}"
                                              AutoGenerateColumns="False"
                                              CanUserSortColumns="True"
                                              EnableRowVirtualization="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="36" SortMemberPath="Source.IsChecked" CanUserSort="False">
                                                <DataGridTemplateColumn.Header>
                                                    <TextBlock Text="" ToolTip="Include this type's instances as candidates for edge matching."/>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Source.IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                                  PreviewMouseLeftButtonDown="CheckBox_PreviewMouseLeftButtonDown"
                                                                  ToolTip="Include this type's instances as candidates for edge matching."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding CategoryName}" SortMemberPath="CategoryName">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Category" ToolTip="Click to sort by category."/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding FamilyName}" SortMemberPath="FamilyName">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Family" ToolTip="Click to sort by family."/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="1.4*" IsReadOnly="True" Binding="{Binding TypeName}" SortMemberPath="TypeName">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Type" ToolTip="Click to sort by type name."/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="70" IsReadOnly="True" Binding="{Binding InstanceCount}" SortMemberPath="InstanceCount">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Size" ToolTip="Number of placed instances of this type in the linked model. Click to sort by size."/>
                                                </DataGridTextColumn.Header>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="1.2*" IsReadOnly="True" Binding="{Binding LinkDisplayName}" SortMemberPath="LinkDisplayName">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Link" ToolTip="Which linked model this type comes from. Click to sort by link."/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <!-- SECTION PARAMETERS -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Section Parameters" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,4,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How close a linked element must be to a roof edge to 'count' as near that side.">
                                        <Run Text="Edge Proximity Tolerance (mm)"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                             Text="{Binding EdgeProximityToleranceMm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How close a linked element must be to a roof edge to 'count' as near that side."/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How close two same-category matched elements must be (along the edge) to collapse into one section.">
                                        <Run Text="Same-Side Dedup Tolerance (mm)"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                             Text="{Binding SameSideDedupToleranceMm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How close two same-category matched elements must be (along the edge) to collapse into one section."/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How far below the roof edge's own elevation the crop reaches.">
                                        <Run Text="Below Roof (mm)"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                             Text="{Binding BelowRoofMm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How far below the roof edge's own elevation the crop reaches."/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How far above the roof edge's own elevation the crop reaches.">
                                        <Run Text="Above Roof (mm)"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                             Text="{Binding AboveRoofMm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How far above the roof edge's own elevation the crop reaches."/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="12,4,12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How much of the roof edge's length (along the edge) is captured in the section.">
                                        <Run Text="Far Clip (mm)"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                             Text="{Binding FarClipMm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How much of the roof edge's length (along the edge) is captured in the section."/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How far the crop extends OUTWARD from the roof edge, away from the roof.">
                                        <Run Text="Margin Outward (mm)"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                             Text="{Binding MarginOutwardMm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How far the crop extends OUTWARD from the roof edge, away from the roof."/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How far the crop extends INWARD from the roof edge, into the roof.">
                                        <Run Text="Length Inside Roof (mm)"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                             Text="{Binding LengthInsideRoofMm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How far the crop extends INWARD from the roof edge, into the roof."/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="View Template" Style="{StaticResource FieldLabel}" ToolTip="Optional view template applied to created section views."/>
                                    <ComboBox Style="{StaticResource StandardComboBox}"
                                              ItemsSource="{Binding ViewTemplateNames}"
                                              SelectedItem="{Binding SelectedViewTemplateName}"
                                              ToolTip="Optional view template applied to created section views."/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="12,4,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Open Views After Creation" Style="{StaticResource FieldLabel}" ToolTip="Controls whether created views open automatically, ask first, or stay closed."/>
                                    <ComboBox Style="{StaticResource StandardComboBox}"
                                              SelectedValue="{Binding OpenViewsMode}" SelectedValuePath="Tag"
                                              ToolTip="Controls whether created views open automatically, ask first, or stay closed.">
                                        <ComboBoxItem Content="Ask Me" Tag="AskMe"/>
                                        <ComboBoxItem Content="Open All" Tag="OpenAll"/>
                                        <ComboBoxItem Content="Don't Open" Tag="DontOpen"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="All fields editable — defaults shown are starting suggestions, not fixed values."
                                       Style="{StaticResource HintText}" Margin="12,0,12,10"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION NAMING PATTERN -->
                    <Expander Header="Section Naming Pattern" IsExpanded="True" Margin="0,0,0,8"
                              Background="{StaticResource BrushCardBackground}"
                              BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Click a token to include/exclude it. Order below = order in the built name."
                                       Style="{StaticResource HintText}" Margin="12,0,12,6"/>

                            <Grid Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ItemsControl Grid.Column="0" ItemsSource="{Binding NamingTokenChips}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,8,4" Padding="10,6" Cursor="Hand"
                                                    Command="{Binding DataContext.ToggleNamingTokenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding DisplayLabel, StringFormat='Click to include/exclude {0} in the section name.'}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="ChipBg" CornerRadius="8" Padding="10,6">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border x:Name="OrderBadge" CornerRadius="8" Width="16" Height="16" Margin="0,0,6,0">
                                                                                <TextBlock Text="{Binding Order}" FontSize="9" FontWeight="Bold"
                                                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <TextBlock x:Name="ChipText" Text="{Binding DisplayLabel}" FontSize="12" FontWeight="SemiBold"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                            <Setter TargetName="ChipBg" Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                                                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource BrushTextOnDark}"/>
                                                                            <Setter TargetName="OrderBadge" Property="Background" Value="#33FFFFFF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                            <Setter TargetName="ChipBg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                                            <Setter TargetName="ChipBg" Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                                                                            <Setter TargetName="ChipBg" Property="BorderThickness" Value="1"/>
                                                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                                            <Setter TargetName="OrderBadge" Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            ToolTip="Character placed between each enabled naming token in the built section view name.">
                                    <TextBlock Text="Separator" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}" Width="140"
                                              SelectedValue="{Binding NamingSeparator}" SelectedValuePath="Tag"
                                              ToolTip="Character placed between each enabled naming token in the built section view name.">
                                        <ComboBoxItem Content="_ (underscore)" Tag="_"/>
                                        <ComboBoxItem Content="- (hyphen)" Tag="-"/>
                                        <ComboBoxItem Content="  (space)" Tag=" "/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Margin="12,0,12,10" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="LIVE PREVIEW" FontSize="10" Foreground="{StaticResource BrushLogTextDim}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding NamingPreviewText}" FontFamily="Consolas" FontSize="12.5"
                                               Foreground="{StaticResource BrushLogSuccess}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- PLANNED SECTIONS TABLE — grid fills its row and scrolls itself -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Planned Sections" Style="{StaticResource SectionTitle}"/>
                    <Grid Grid.Row="1" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="12,6,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                        Command="{Binding SelectAllCommand}"
                                        ToolTip="Check every eligible row (Ready status) so it will be created on Run."/>
                                <Button Content="Clear" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                        Command="{Binding ClearAllCommand}"
                                        ToolTip="Uncheck every row so nothing is created on Run."/>
                                <Button Content="Refresh" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="Re-scan picked roofs and checked elements and rebuild the plan below."/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" Margin="12,0,12,0" Height="230"
                                  ItemsSource="{Binding PlannedSections}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  CanUserAddRows="False">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="" ToolTip="Include this row when Run is clicked. Disabled for Cluster-Capped rows."/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding Status, Converter={StaticResource StatusToEnabledConverter}}"
                                                      PreviewMouseLeftButtonDown="CheckBox_PreviewMouseLeftButtonDown"
                                                      ToolTip="Include this row when Run is clicked."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding RoofDisplayName}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Roof" ToolTip="The source roof element this planned section belongs to."/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="80" IsReadOnly="True" Binding="{Binding Direction}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Direction" ToolTip="Which side of the roof this edge is on (N/S/E/W of the current view), not compass North."/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="120" IsReadOnly="True" Binding="{Binding MatchedCategoryName}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Category" ToolTip="Category of the matched linked-element cluster."/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="70" IsReadOnly="True" Binding="{Binding MatchedElementCount}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Count" ToolTip="Number of linked elements collapsed into this cluster."/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="2*" IsReadOnly="True" Binding="{Binding SectionViewName}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Section View Name" ToolTip="The name the created section view will have, built from the Section Naming Pattern above."/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="140" IsReadOnly="True" Binding="{Binding StatusText}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Status" ToolTip="Ready = will be created. Capped = extra cluster beyond the 2-per-side cap, never created."/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="{Binding LogEntries.Count, StringFormat='Log ({0} entries)'}" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                    Command="{Binding CopyAllLogsCommand}"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                    Command="{Binding CopySelectedLogsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=LogListBox}"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                    Command="{Binding ClearLogsCommand}"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogListBox" Height="110" Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding LogEntries}" SelectionMode="Extended"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource BrushLogTextDim}" FontFamily="Consolas" FontSize="11" Width="60"/>
                                    <TextBlock Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Width="60"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushLogText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <!-- FOOTER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding LastRunSummary, StringFormat='Last run: {0}'}" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource RunButton}" Width="130" Margin="0,0,8,0"
                            Command="{Binding RunCommand}"
                            ToolTip="Create a section view for every checked row in the Planned Sections table above.">
                        <Button.Content>
                            <TextBlock Text="{Binding SuggestedSectionCount, StringFormat='Run ({0})'}"/>
                        </Button.Content>
                    </Button>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Click="CloseButton_Click"
                            ToolTip="Close this window without creating any sections."/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
