<!--
=======================================================
File: RoofViewFocusWindow.xaml
Changes vs V003 (layout only, per CLAUDE.md v1.1 — ToolWindowShell):
  - Window content is a shared ToolWindowShell:
      HEADER  title bar + V004 badge, metrics card
      BODY    Target, Crop Margins, Log (moved here from the footer);
              the middle's ScrollViewer and the Roofs list's own
              ScrollViewer (MaxHeight 88) removed — the body scrolls
      FOOTER  status strip (IsBusy, indeterminate / SummaryText — was the
              green line under the log), Reset left, Run → Close right
  - Log: ShellBehaviors.MaxHeightRatio + ForwardMouseWheel.
  - No behaviour change — every binding/command is the V003 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.RoofViewFocus.V004.UI.Views.RoofViewFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.RoofViewFocus}, Path=Title}"
        Width="600" Height="780"
        MinWidth="600" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters: instantiated locally, never in the shared dictionary -->
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Roof View Focus"
                           Subtitle="Crop the plan view to the selected roofs"
                           Version="{Binding Source={x:Static svc:ToolCatalog.RoofViewFocus}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="4" Margin="-3,0,-3,8">
                <Border Style="{StaticResource MetricCard}" Margin="3,0" Padding="10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="Roofs Selected"/>
                        <Grid Height="28">
                            <TextBlock Style="{StaticResource MetricNumberAccent}" VerticalAlignment="Center"
                                       Text="{Binding RoofCountText, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MetricUnit}" Text="in selection"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="3,0" Padding="10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="Bounding Box"/>
                        <Grid Height="28">
                            <TextBlock Style="{StaticResource MetricNumber}" FontSize="14" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding BoundingBoxText, Mode=OneWay}"
                                       ToolTip="{Binding BoundingBoxText, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MetricUnit}" Text="W × H (mm)"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="3,0" Padding="10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="Margin Applied"/>
                        <Grid Height="28">
                            <TextBlock Style="{StaticResource MetricNumber}" VerticalAlignment="Center"
                                       Text="{Binding MarginText, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MetricUnit}" Text="mm total"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="3,0" Padding="10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="View"/>
                        <Grid Height="28">
                            <TextBlock Style="{StaticResource MetricNumber}" FontSize="14" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding ViewName, Mode=OneWay}"
                                       ToolTip="{Binding ViewName, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MetricUnit}" Text="{Binding ViewStatusText, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Target"/>
                        <Grid Margin="12,0,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,4" Text="Active View"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" FontSize="12.5" Margin="0,3"
                                       TextTrimming="CharacterEllipsis" Text="{Binding ViewDisplay, Mode=OneWay}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,4" Text="Scope Box"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" FontSize="12.5" Margin="0,3"
                                       TextTrimming="CharacterEllipsis" Text="{Binding ScopeBoxText, Mode=OneWay}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,4" Text="Roofs"/>
                            <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Roofs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" FontSize="12.5"
                                                       Foreground="{StaticResource BrushAppleBlue}" Text="{Binding Id, Mode=OneWay}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Description, Mode=OneWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Crop Margins"/>
                        <Grid Margin="12,0,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,3" Text="View Crop Margin"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxedTextInput}" Margin="0,3"
                                     MaxLength="10" TextAlignment="Right" Padding="6,2"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                     Text="{Binding ViewMarginText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource UnitLabel}" Margin="6,0,0,0" Text="mm"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,3" Text="Annotation Crop Margin"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource BoxedTextInput}" Margin="0,3"
                                     MaxLength="10" TextAlignment="Right" Padding="6,2"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                     Text="{Binding AnnotationMarginText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource UnitLabel}" Margin="6,0,0,0" Text="mm"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,3" Text="Default Offset"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldValue}" FontSize="12.5"
                                       HorizontalAlignment="Right" Margin="0,3" Text="{Binding DefaultOffsetText, Mode=OneWay}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,2"
                                   Text="Total margin = entered margin + default offset. Annotation offsets are in Revit paper units (view scale is not applied)."/>
                        <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,8"
                                   Foreground="{StaticResource BrushStatusError}"
                                   Text="Enter a number of 0 or more (mm)."
                                   Visibility="{Binding HasInputError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Log (moved from footer; its summary line is now the shell status strip) -->
                <Border Margin="0,8,0,0" CornerRadius="10" Background="{StaticResource BrushLogBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="10,6">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Log" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Content="Copy All"
                                            Command="{Binding CopyAllCommand}"/>
                                    <Button Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Content="Copy Selected"
                                            Command="{Binding CopySelectedCommand}"
                                            CommandParameter="{Binding SelectedItems, ElementName=LogList}"/>
                                    <Button Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Content="Export"
                                            Command="{Binding ExportLogCommand}"/>
                                    <Button Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Content="Clear"
                                            Command="{Binding ClearLogCommand}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox Grid.Row="1" x:Name="LogList" MinHeight="120" ItemsSource="{Binding Log}"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 SelectionMode="Extended" Margin="4"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11.5"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{StaticResource BrushLogTextDim}"
                                                   Text="{Binding Time, StringFormat=HH:mm:ss, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}, Mode=OneWay}"
                                                   Text="{Binding Level, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="2" TextWrapping="Wrap" Foreground="{StaticResource BrushLogText}"
                                                   Text="{Binding Message, Mode=OneWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Button Style="{StaticResource OutlineButton}" Content="Reset" Height="38" MinWidth="88"
                        HorizontalAlignment="Left" Command="{Binding ResetCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Content="Run" MinWidth="96" Margin="0,0,8,0"
                            Command="{Binding RunCommand}"/>
                    <Button Style="{StaticResource OutlineButton}" Content="Close" Height="38" MinWidth="88"
                            IsCancel="True" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
