<!--
=======================================================
File: IsolatedSectionWindow.xaml  (Isolated Section V001 — ToolWindowShell)
  HEADER  metric tiles: elements / largest side / looking at / section box
  BODY    Selection (list + pick buttons), Alignment (side, camera, plan preview),
          View (isolation, type, template, look, margins, name), Log
  FOOTER  hint, Reset, Create 3D View, Close
  DataContext: IsolatedSectionViewModel. Everything above the log is disabled while Revit runs a job.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.IsolatedSection.V001.UI.Views.IsolatedSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="Isolated Section"
        Width="760" Height="900"
        MinWidth="700" MinHeight="760"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally per suite convention -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter      x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter  x:Key="LogLevelToColorConverter"/>

            <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,10,4"/>
            </Style>

            <Style x:Key="FormCombo" TargetType="ComboBox" BasedOn="{StaticResource StandardComboBox}">
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="DisplayMemberPath" Value="Label"/>
            </Style>

            <Style x:Key="MarginBox" TargetType="TextBox" BasedOn="{StaticResource BoxedTextInput}">
                <Setter Property="Width" Value="70"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="MaxLength" Value="9"/>
            </Style>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLargest}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Isolated Section"
                           Subtitle="3D view of the selected elements, boxed and turned to face their largest side"
                           Version="{Binding Source={x:Static svc:ToolCatalog.IsolatedSection}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricTileInfo}" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="ELEMENTS" Style="{StaticResource MetricTileLabelInfo}"/>
                        <TextBlock Text="{Binding ElementCountText}" Style="{StaticResource MetricTileNumberInfo}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileSuccess}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="LARGEST SIDE  L × H mm" Style="{StaticResource MetricTileLabelSuccess}"/>
                        <TextBlock Text="{Binding LargestSideText}" Style="{StaticResource MetricTileNumberSuccess}"
                                   FontSize="16" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileInfo}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="LOOKING AT" Style="{StaticResource MetricTileLabelInfo}"/>
                        <TextBlock Text="{Binding LookingAtText}" Style="{StaticResource MetricTileNumberInfo}"
                                   FontSize="16" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileWarning}" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="BOX  W × H × D mm" Style="{StaticResource MetricTileLabelWarning}"/>
                        <TextBlock Text="{Binding BoxText}" Style="{StaticResource MetricTileNumberWarning}"
                                   FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding BoxText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <StackPanel IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}">

                    <!-- ══ Selection ══ -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Selection"/>
                            <DataGrid Style="{StaticResource StandardDataGrid}" Margin="12,0,12,6" MinHeight="90"
                                      ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      shell:ShellBehaviors.MaxHeightRatio="0.3"
                                      shell:ShellBehaviors.ForwardMouseWheel="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Id" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CellText}" FontFamily="Consolas" Text="{Binding Id}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Element" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CellText}" Text="{Binding Description}" ToolTip="{Binding Description}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Model" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CellText}" Text="{Binding Source}" ToolTip="{Binding Source}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="L × W × H (mm)" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CellText}" Text="{Binding SizeText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="12,0,12,4">
                                <Button Style="{StaticResource SecondaryButton}" Content="Pick elements…" Margin="0,0,6,4" Padding="12,0"
                                        Command="{Binding PickElementsCommand}" ToolTip="Pick model elements in the host model"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Pick in link…" Margin="0,0,6,4" Padding="12,0"
                                        Command="{Binding PickLinkedCommand}" ToolTip="Pick elements inside linked Revit models"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Pick face…" Margin="0,0,6,4" Padding="12,0"
                                        Command="{Binding PickFaceCommand}" ToolTip="Pick the face the view should look at"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Remove" Margin="0,0,6,4" Padding="12,0"
                                        Command="{Binding RemoveSelectedCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Clear" Margin="0,0,6,4" Padding="12,0"
                                        Command="{Binding ClearElementsCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,8" TextWrapping="Wrap"
                                       Text="Bold row: the element with the largest side (length × height). With several elements, one view holds them all, parallel to that side."/>
                        </StackPanel>
                    </Border>

                    <!-- ══ Alignment ══ -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Alignment"/>
                            <Grid Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Look at"/>
                                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding SideOptions}"
                                              SelectedItem="{Binding SelectedSide}"/>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Camera"/>
                                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding CameraOptions}"
                                              SelectedItem="{Binding SelectedCamera}"/>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="{Binding AlignmentText}"/>
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                                        CornerRadius="6" Background="{StaticResource BrushSurfaceCard}" Padding="4">
                                    <Grid>
                                        <Canvas Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" ClipToBounds="True">
                                            <Path Data="{Binding PreviewBox}" Stroke="{StaticResource BrushTextTertiary}"
                                                  StrokeThickness="1" StrokeDashArray="4 3"/>
                                            <Path Data="{Binding PreviewElements}" Fill="{StaticResource BrushTileInfoBackground}"
                                                  Stroke="{StaticResource BrushNavyPrimary}" StrokeThickness="1.2"/>
                                            <Path Data="{Binding PreviewSide}" Stroke="{StaticResource BrushWarning}" StrokeThickness="4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Path Data="{Binding PreviewArrow}" Stroke="{StaticResource BrushWarning}"
                                                  Fill="{StaticResource BrushWarning}" StrokeThickness="2"/>
                                        </Canvas>
                                        <TextBlock Text="N ↑" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══ View ══ -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="View"/>
                            <Grid Margin="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}" Text="Isolation"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormCombo}"
                                          ItemsSource="{Binding IsolationOptions}" SelectedItem="{Binding SelectedIsolation}"/>

                                <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="3D view type"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormCombo}" DisplayMemberPath="Name"
                                          ItemsSource="{Binding ViewTypes}" SelectedItem="{Binding SelectedViewType}"/>

                                <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="View template"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormCombo}" DisplayMemberPath="Name"
                                          ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"/>

                                <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Detail level"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormCombo}"
                                          ItemsSource="{Binding DetailOptions}" SelectedItem="{Binding SelectedDetail}"
                                          IsEnabled="{Binding TemplateControlsLook, Converter={StaticResource InverseBoolConverter}}"/>

                                <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Visual style"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormCombo}"
                                          ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle}"
                                          IsEnabled="{Binding TemplateControlsLook, Converter={StaticResource InverseBoolConverter}}"/>

                                <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Box margins (mm)"/>
                                <WrapPanel Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="sides"/>
                                    <TextBox Style="{StaticResource MarginBox}" Text="{Binding SideMarginText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource FormLabel}" Margin="14,4,10,4" Text="top / bottom"/>
                                    <TextBox Style="{StaticResource MarginBox}" Text="{Binding TopBottomMarginText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource FormLabel}" Margin="14,4,10,4" Text="front / back"/>
                                    <TextBox Style="{StaticResource MarginBox}" Text="{Binding DepthMarginText, UpdateSourceTrigger=PropertyChanged}"/>
                                </WrapPanel>

                                <TextBlock Grid.Row="6" Style="{StaticResource FormLabel}" Text="View name"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource BoxedTextInput}" Margin="0,3" Padding="6,2"
                                         Text="{Binding NamePattern, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Tokens: {Category} {Id} {Count} {Side} {Date}"/>

                                <CheckBox Grid.Row="7" Grid.Column="1" Margin="0,6,0,0" Content="Open the new view and zoom to fit"
                                          IsChecked="{Binding OpenView}" Foreground="{StaticResource BrushTextPrimary}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,2,12,2" TextWrapping="Wrap"
                                       Text="Name tokens: {Category} {Id} {Count} {Side} {Date}. A number is added when the name is taken. With a view template, it sets detail level and visual style."/>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,8"
                                       Foreground="{StaticResource BrushStatusError}"
                                       Text="Margins must be numbers from 0 to 100 000 mm."
                                       Visibility="{Binding HasInputError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══ Log ══ -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLog_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ClearLogCommand}"/>
                                <Button Content="Export Log" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Click="ExportLog_Click"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                 MinHeight="80"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                        <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogTextDim}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold" Width="60"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding Message, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Reset" Style="{StaticResource OutlineButton}" Width="80" Height="38"
                        Command="{Binding ResetCommand}"/>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="One Undo step in Revit removes the view." TextWrapping="Wrap" MaxWidth="260"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Create 3D View" Style="{StaticResource PrimaryButton}" MinWidth="140" Margin="0,0,8,0"
                            Command="{Binding CreateCommand}"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38"
                            IsCancel="True" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
