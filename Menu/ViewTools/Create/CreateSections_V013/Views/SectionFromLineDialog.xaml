<!--
=======================================================
File: SectionFromLineDialog.xaml  (V013 — ToolWindowShell, CLAUDE.md v1.1)
Changes vs V012 (layout only):
  - Hosted in Shared/Controls/ToolWindowShell.
    HEADER: title / version + metric cards.
    BODY:   settings (left) / Sections To Create grid (right), then the
            Live Log (moved from the footer; still open by default).
            View Crop stays collapsed by default.
    FOOTER: shell status strip (IsRunning, indeterminate) + Create / Close.
  - Left pane's own ScrollViewer removed — the shell body is the one
    ScrollViewer. Grid and log cap their height
    (ShellBehaviors.MaxHeightRatio) and forward the mouse wheel.
  - Status-pill backgrounds → SharedStyles BrushSoft*Background.
  - No behaviour change — every binding/command is the V012 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.CreateSections.V013.Views.SectionFromLineDialog.SectionFromLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static svc:ToolCatalog.CreateSections}, Path=Title}"
        Width="1000"
        Height="760"
        MinWidth="1000"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSurfaceWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Load shared styles from the embedded resource (Build Action = Resource) -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- V009: no converters needed in this dialog — IsEnabled bindings
                 (e.g. Crop Region Visible enabled when CropBoxActive) bind
                 directly to bool properties, which WPF handles natively
                 without a converter. Removed BoolToVisibilityConverter /
                 InverseBoolToVisibilityConverter declarations that were
                 present but never actually bound to anywhere in this file. -->

        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Create Sections From Detail Lines"
                           Version="{Binding Source={x:Static svc:ToolCatalog.CreateSections}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="8,8" Margin="0,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- V009: SelectedCount now reflects checked grid rows, set by the orchestrator at Start() -->
                        <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Selected" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Padding="8,8" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CreatedCount}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Created" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="8,8" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}" Padding="8,8" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Failed" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}" Padding="8,8" Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding RenamedCount}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Renamed" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- ===== TWO-PANE SPLIT: settings left / preview grid right ===== -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============ LEFT PANE: SETTINGS (scrolls with the shell body) ============ -->
                    <StackPanel Grid.Column="0" Orientation="Vertical">

                        <!-- Section Setup: Type / Template / Prefix, 3-across -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,0,2">
                                <TextBlock Text="Section Setup" Style="{StaticResource SectionTitle}" Margin="10,7,10,3"/>
                                <Grid Margin="10,0,10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock Text="Section Type" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Revit section view family type used for all sections created in this run."/>
                                        <ComboBox Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding SectionTypes}"
                                                  SelectedItem="{Binding SelectedSectionType}"
                                                  DisplayMemberPath="Name"
                                                  ToolTip="Revit section view family type used for all sections created in this run."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4">
                                        <TextBlock Text="View Template" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Optional view template applied to each created section for consistent graphics/visibility overrides."/>
                                        <ComboBox Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding ViewTemplates}"
                                                  SelectedItem="{Binding SelectedTemplate}"
                                                  DisplayMemberPath="Name"
                                                  ToolTip="Optional view template applied to each created section for consistent graphics/visibility overrides."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Section Prefix" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Text prepended to every generated section name, e.g. Level1_SEC_483920."/>
                                        <TextBox Style="{StaticResource BoxedTextInput}"
                                                  Text="{Binding SectionPrefix}"
                                                  MaxLength="25"
                                                  ToolTip="Text prepended to every generated section name, e.g. Level1_SEC_483920."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Host Source: 2x2 checkbox grid -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Host Source" Style="{StaticResource SectionTitle}" Margin="10,7,10,3"/>
                                <Grid Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="Floor (Host)"
                                              IsChecked="{Binding SearchFloorHost}" Margin="0,0,0,4"
                                              ToolTip="Search for floors in the current (host) model as the section anchor."/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Roof (Host)"
                                              IsChecked="{Binding SearchRoofHost}" Margin="0,0,0,4"
                                              ToolTip="Search for roofs in the current (host) model as the section anchor."/>
                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Floor (Linked)"
                                              IsChecked="{Binding SearchFloorLinked}"
                                              ToolTip="Search for floors in linked models as the section anchor."/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Roof (Linked)"
                                              IsChecked="{Binding SearchRoofLinked}"
                                              ToolTip="Search for roofs in linked models as the section anchor."/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="10,4,10,0"
                                           Text="Only checked categories are searched. Nearest qualifying element (below the line, or the line passing through it) is used."/>
                            </StackPanel>
                        </Border>

                        <!-- Geometry Settings: 2 per row, 3 rows -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Geometry Settings" Style="{StaticResource SectionTitle}" Margin="10,7,10,3"/>
                                <Grid Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock Text="Far Clip (mm)" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Distance from the section line to the far clip plane. Controls how much depth is visible beyond the cut line."/>
                                        <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding FarClipMm}" MaxLength="10"
                                                  ToolTip="Distance from the section line to the far clip plane. Controls how much depth is visible beyond the cut line."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4">
                                        <TextBlock Text="Search Threshold (mm)" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Max vertical search distance to find a host Floor/Roof below or through the detail line. Also used as fallback height span if no host is found and fallback is enabled."/>
                                        <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding SearchThresholdMm}" MaxLength="10"
                                                  ToolTip="Max vertical search distance to find a host Floor/Roof below or through the detail line. Also used as fallback height span if no host is found and fallback is enabled."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock Text="Top Padding (mm)" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Extra vertical space added above the highest detected element, expanding the section crop upward."/>
                                        <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding TopPaddingMm}" MaxLength="10"
                                                  ToolTip="Extra vertical space added above the highest detected element, expanding the section crop upward."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,4">
                                        <TextBlock Text="Bottom Padding (mm)" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Extra vertical space added below the lowest detected element, expanding the section crop downward."/>
                                        <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding BottomPaddingMm}" MaxLength="10"
                                                  ToolTip="Extra vertical space added below the lowest detected element, expanding the section crop downward."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Bottom Offset (mm)" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Shifts the entire section crop vertically up/down from the detected host elevation, without changing its height."/>
                                        <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding BottomOffsetMm}" MaxLength="10"
                                                  ToolTip="Shifts the entire section crop vertically up/down from the detected host elevation, without changing its height."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="View Scale (1:x)" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Drawing scale applied to each created section view, e.g. 50 = 1:50."/>
                                        <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding ViewScale}" MaxLength="10"
                                                  ToolTip="Drawing scale applied to each created section view, e.g. 50 = 1:50."/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SeparatorLine}" Margin="10,7,10,7"/>

                                <CheckBox Content="Use Search Threshold if no host found"
                                          IsChecked="{Binding UseThresholdFallback}"
                                          Margin="10,0,10,4"
                                          ToolTip="If no qualifying Floor/Roof is found, still create the section centered on the line's own elevation using Search Threshold (mm) as the height span, instead of skipping it."/>
                                <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                                        BorderBrush="{StaticResource BrushSeparator}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="10,0,10,0"
                                        Padding="8,6">
                                    <TextBlock Style="{StaticResource HintText}" Margin="0" TextWrapping="Wrap">
                                        If no qualifying element is found in the checked categories above, the section
                                        is still created — centered on the line's own elevation, using the
                                        Search Threshold (mm) value as the height span, instead of skipping the line.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ===== VIEW CROP (V009 — new, accordion, collapsed by default) ===== -->
                        <Border Background="{StaticResource BrushSurfaceCard}"
                                BorderBrush="{StaticResource BrushBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="10,7" Cursor="Hand"
                                        MouseLeftButtonUp="ViewCropHeader_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ViewCropChevron" Text="▶" Foreground="{StaticResource BrushTextTertiary}"
                                                       FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="View Crop" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="ViewCropBody" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,6">

                                    <Grid Margin="10,0,10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Content="Crop Box Active"
                                                  IsChecked="{Binding CropBoxActive}"
                                                  ToolTip="Enables the section view's crop box. When off, Crop Region Visible and Annotation Crop Active are ignored — Revit requires an active crop box for both."/>
                                        <CheckBox Grid.Column="1" Content="Crop Region Visible"
                                                  IsChecked="{Binding CropRegionVisible}"
                                                  IsEnabled="{Binding CropBoxActive}"
                                                  ToolTip="Shows the crop region boundary/handles in the view. Does not affect what geometry is visible, only whether the crop outline is drawn."/>
                                        <CheckBox Grid.Column="2" Content="Annotation Crop Active"
                                                  IsChecked="{Binding AnnotationCropActive}"
                                                  IsEnabled="{Binding CropBoxActive}"
                                                  ToolTip="Enables a separate crop boundary for tags, dimensions, and other annotations, independent from the model geometry crop."/>
                                    </Grid>

                                    <Border Style="{StaticResource SeparatorLine}" Margin="10,0,10,7"/>

                                    <Grid Margin="10,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                            <TextBlock Text="Top Offset (mm)" Style="{StaticResource FieldLabel}"
                                                       ToolTip="Expands the annotation crop outward from the model crop's top edge. Must be ≥ 0 — Revit does not support negative annotation crop offsets."/>
                                            <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding TopAnnotationOffsetMm}" MaxLength="10"
                                                      IsEnabled="{Binding AnnotationCropActive}"
                                                      ToolTip="Expands the annotation crop outward from the model crop's top edge. Must be ≥ 0 — Revit does not support negative annotation crop offsets."/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4">
                                            <TextBlock Text="Bottom Offset (mm)" Style="{StaticResource FieldLabel}"
                                                       ToolTip="Expands the annotation crop outward from the model crop's bottom edge. Must be ≥ 0 — Revit does not support negative annotation crop offsets."/>
                                            <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding BottomAnnotationOffsetMm}" MaxLength="10"
                                                      IsEnabled="{Binding AnnotationCropActive}"
                                                      ToolTip="Expands the annotation crop outward from the model crop's bottom edge. Must be ≥ 0 — Revit does not support negative annotation crop offsets."/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Text="Left Offset (mm)" Style="{StaticResource FieldLabel}"
                                                       ToolTip="Expands the annotation crop outward from the model crop's left edge. Must be ≥ 0 — Revit does not support negative annotation crop offsets."/>
                                            <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding LeftAnnotationOffsetMm}" MaxLength="10"
                                                      IsEnabled="{Binding AnnotationCropActive}"
                                                      ToolTip="Expands the annotation crop outward from the model crop's left edge. Must be ≥ 0 — Revit does not support negative annotation crop offsets."/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="Right Offset (mm)" Style="{StaticResource FieldLabel}"
                                                       ToolTip="Expands the annotation crop outward from the model crop's right edge. Must be ≥ 0 — Revit does not support negative annotation crop offsets."/>
                                            <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding RightAnnotationOffsetMm}" MaxLength="10"
                                                      IsEnabled="{Binding AnnotationCropActive}"
                                                      ToolTip="Expands the annotation crop outward from the model crop's right edge. Must be ≥ 0 — Revit does not support negative annotation crop offsets."/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource HintText}" Margin="10,6,10,0" TextWrapping="Wrap"
                                               Text="Offsets are ≥ 0 only — Revit expands the annotation crop outward from the model crop, it cannot shrink inward. Fields disabled unless Annotation Crop Active is checked. Crop Region Visible / Annotation Crop Active disabled when Crop Box Active is off."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Post Creation Options — both checkboxes same row -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Post Creation Options" Style="{StaticResource SectionTitle}" Margin="10,7,10,3"/>
                                <Grid Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="Open sections after creation"
                                              IsChecked="{Binding OpenAllAfterCreate}"
                                              ToolTip="Automatically open each newly created section view in Revit once the run completes."/>
                                    <CheckBox Grid.Column="1" Content="Delete source detail lines"
                                              IsChecked="{Binding DeleteLinesAfterCreate}"
                                              ToolTip="Delete the original detail lines used to generate sections, after successful creation."/>
                                </Grid>

                                <Border Style="{StaticResource SeparatorLine}" Margin="10,7,10,7"/>

                                <!-- V010 fix: log export folder — no dialog opens automatically on Create
                                     anymore. Blank = silently uses the default folder under My Documents
                                     (shown via watermark-style placeholder text below). Browse sets a
                                     custom folder, persisted to settings.json. -->
                                <StackPanel Margin="10,0,10,0">
                                    <TextBlock Text="Log Save Folder" Style="{StaticResource FieldLabel}"
                                               ToolTip="Folder the run log is auto-saved to on completion. Leave blank to use the default folder under My Documents."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource BoxedTextInput}"
                                                 Text="{Binding LogSaveFolder, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 ToolTip="Folder the run log is auto-saved to on completion. Leave blank to use the default folder under My Documents."/>
                                        <Button Grid.Column="2" Content="Browse…" Style="{StaticResource OutlineButton}" Width="80"
                                                Command="{Binding BrowseLogFolderCommand}"
                                                ToolTip="Choose a custom folder for saved logs."/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                               Text="Blank = default folder under My Documents\Revit26_Plugin\CreateSectionsFromDetailLines\Logs. No dialog opens automatically."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ============ RIGHT PANE: SECTIONS TO CREATE GRID (V009 — new) ============ -->
                    <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0">
                        <Grid Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Sections To Create" Style="{StaticResource SectionTitle}" Margin="10,7,10,3"/>

                            <!-- Toolbar: filter + Select All/Clear/Refresh -->
                            <Grid Grid.Row="1" Margin="10,0,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding PreviewFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="25"
                                         ToolTip="Filter rows by section name, level, or host type."/>
                                <Button Grid.Column="2" Content="Select All" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding SelectAllPreviewRowsCommand}"
                                        ToolTip="Check all rows matching the current filter."/>
                                <Button Grid.Column="4" Content="Clear" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ClearAllPreviewRowsCommand}"
                                        ToolTip="Uncheck all rows matching the current filter."/>
                                <Button Grid.Column="6" Content="Refresh" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding RefreshPreviewCommand}"
                                        ToolTip="Re-scan the selected detail lines and re-resolve host/name for each row — use after changing Host Source or Geometry Settings."/>
                            </Grid>

                            <!-- Grid — RowHeight trimmed from shared 30px default to 26px for compactness -->
                            <DataGrid Grid.Row="2" MinHeight="220" shell:ShellBehaviors.MaxHeightRatio="0.5" shell:ShellBehaviors.ForwardMouseWheel="True"
                                      Margin="10,0,10,6"
                                      RowHeight="26"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource StandardDataGridCell}"
                                      RowStyle="{StaticResource StandardDataGridRow}"
                                      ItemsSource="{Binding PreviewRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="False"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="34" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          PreviewMouseLeftButtonDown="PreviewRowCheckBox_PreviewMouseLeftButtonDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="0.8*"/>
                                    <DataGridTextColumn Header="Section Name" Binding="{Binding SectionName, Mode=OneWay}" Width="1.7*"/>
                                    <DataGridTextColumn Header="Host Type" Binding="{Binding HostTypeDisplay, Mode=OneWay}" Width="1.2*"/>

                                    <DataGridTemplateColumn Header="Status" Width="1.1*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="NoHostFound">
                                                                    <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="DuplicateName">
                                                                    <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="NoHostFound">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="DuplicateName">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="3" Style="{StaticResource HintText}" Margin="10,0,10,0" TextWrapping="Wrap"
                                       Text="Preview reflects current settings on the left. Section Name follows the live naming pattern (Level_Prefix_ElementId). Click Refresh after changing filters. Unchecked rows are skipped on Create."/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== LIVE LOG (accordion, open by default; moved from footer) ===== -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0"
                                Padding="10,6" Cursor="Hand"
                                MouseLeftButtonUp="LogHeader_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LogChevron" Text="▼" Foreground="{StaticResource BrushLogTextDim}"
                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Live Log" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                            Click="CopyAll_Click"/>
                                    <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                            Click="CopySelected_Click"/>
                                    <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                            Click="Clear_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="LogListBox"
                                 Grid.Row="1"
                                 MinHeight="110"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Extended"
                                 ItemsSource="{Binding LiveLog}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource BrushLogText}"
                                               FontFamily="Consolas"
                                               FontSize="11.5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel>
                <!-- ===== BUTTONS ===== -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="130"
                            Margin="0,0,8,0"
                            Command="{Binding CreateCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="Create (Running…)"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                        <Setter Property="Content" Value="Create"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="85" Height="38"
                            Command="{Binding CancelDialogCommand}"/>
                </StackPanel>
                <TextBlock Text="Metric cards reset to 0 at the start of each Create run"
                           Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
