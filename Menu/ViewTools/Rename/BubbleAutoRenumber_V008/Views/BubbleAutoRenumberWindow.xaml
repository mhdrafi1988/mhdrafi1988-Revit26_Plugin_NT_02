<!--
=======================================================
File: BubbleAutoRenumberWindow.xaml
Changes vs V007 (layout only, per CLAUDE.md v1.1 — ToolWindowShell):
  - Window content is a shared ToolWindowShell:
      HEADER  title bar + V008, metrics card
      BODY    sheet + options card, sections grid, Log (moved here from
              the footer)
      FOOTER  status strip (IsRunning / Progress / SummaryText),
              Renumber → Close
  - Sections grid and log TextBox: ShellBehaviors.MaxHeightRatio +
    ForwardMouseWheel.
  - No behaviour change — every binding/command is the V007 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.BubbleAutoRenumber.V008.Views.SectionAutoRenumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.BubbleAutoRenumber}, Path=Title}"
        Width="520" Height="720"
        MinWidth="520" MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Section Auto Renumber"
                           Subtitle="Renumber section bubbles on a sheet, top-left to bottom-right"
                           Version="{Binding Source={x:Static svc:ToolCatalog.BubbleAutoRenumber}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Total" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Success" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SuccessCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Sections On Sheet" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SectionRows.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- ── Sheet + Options card ──────────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>

                        <TextBlock Text="Sheet" Style="{StaticResource SectionTitle}"/>

                        <!-- Sheet picker -->
                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Select Sheet" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <ComboBox ItemsSource="{Binding Sheets}"
                                      SelectedItem="{Binding SelectedSheet}"
                                      DisplayMemberPath="SheetNumber"
                                      MinWidth="180"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <!-- Starting number -->
                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Starting Number" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <TextBox Text="{Binding StartingNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}"
                                     Width="80"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <!-- Threshold -->
                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Vertical Threshold" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <TextBox Text="{Binding VerticalThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}"
                                     Width="80"/>
                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Sections On Sheet" Style="{StaticResource SectionTitle}"/>
                              <DataGrid Grid.Row="1" ItemsSource="{Binding SectionRows}"
                                        MinHeight="140"
                                        shell:ShellBehaviors.MaxHeightRatio="0.4"
                                        shell:ShellBehaviors.ForwardMouseWheel="True"
                                        AutoGenerateColumns="False"
                                        IsReadOnly="True"
                                        HeadersVisibility="Column"
                                        GridLinesVisibility="Horizontal"
                                        HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                                        CanUserSortColumns="False"
                                        CanUserResizeRows="False"
                                        CanUserResizeColumns="False"
                                        SelectionMode="Single"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                        ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                        RowStyle="{StaticResource DataGridRowStyle}"
                                        CellStyle="{StaticResource DataGridCellStyle}"
                                        AlternationCount="2"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Margin="0">

                                  <DataGrid.Columns>

                                      <DataGridTextColumn Header="Current #"
                                                          Binding="{Binding CurrentNumber}"
                                                          Width="90">
                                          <DataGridTextColumn.ElementStyle>
                                              <Style TargetType="TextBlock">
                                                  <Setter Property="Padding"           Value="8,5"/>
                                                  <Setter Property="FontSize"          Value="11"/>
                                                  <Setter Property="FontWeight"        Value="Medium"/>
                                                  <Setter Property="Foreground"        Value="{StaticResource BrushTextSecondary}"/>
                                                  <Setter Property="VerticalAlignment" Value="Center"/>
                                              </Style>
                                          </DataGridTextColumn.ElementStyle>
                                      </DataGridTextColumn>

                                      <DataGridTextColumn Header="View Name"
                                                          Binding="{Binding ViewName}"
                                                          Width="*">
                                          <DataGridTextColumn.ElementStyle>
                                              <Style TargetType="TextBlock">
                                                  <Setter Property="Padding"           Value="8,5"/>
                                                  <Setter Property="FontSize"          Value="11"/>
                                                  <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
                                                  <Setter Property="VerticalAlignment" Value="Center"/>
                                                  <Style.Triggers>
                                                      <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                          <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                      </DataTrigger>
                                                  </Style.Triggers>
                                              </Style>
                                          </DataGridTextColumn.ElementStyle>
                                      </DataGridTextColumn>

                                  </DataGrid.Columns>
                              </DataGrid>
                    </Grid>
                </Border>

                <!-- Log (moved from footer) -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click" Margin="0,0,6,0"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="LogBox"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" MinHeight="110"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 Foreground="{StaticResource BrushLogText}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Renumber"
                        Command="{Binding RunCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="120" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Click="CloseButton_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
