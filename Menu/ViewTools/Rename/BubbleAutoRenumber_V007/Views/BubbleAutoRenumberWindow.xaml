<!--
=======================================================
File: BubbleAutoRenumberWindow.xaml
Changes vs V006 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (title bar + version, metrics card —
    always visible, was hidden until the first run), middle (sheet and
    options, sections grid that scrolls itself), fixed footer (log with
    Copy All / Copy Selected, Renumber → Close).
  - Resizable (MinWidth/MinHeight = default size) instead of NoResize +
    SizeToContent. Log is a read-only TextBox so lines can be selected.
  - No behaviour change — every binding/command is the V006 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.BubbleAutoRenumber.V007.Views.SectionAutoRenumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Section Auto Renumber — V007"
        Width="520" Height="720"
        MinWidth="520" MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12" Background="{StaticResource BrushSystemSecondaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Section Auto Renumber" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Renumber section bubbles on a sheet, top-left to bottom-right" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V007" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Total" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Success" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SuccessCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Sections On Sheet" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SectionRows.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <!-- ── Sheet + Options card ──────────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>

                        <TextBlock Text="Sheet" Style="{StaticResource SectionTitle}"/>

                        <!-- Sheet picker -->
                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Select Sheet" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <ComboBox ItemsSource="{Binding Sheets}"
                                      SelectedItem="{Binding SelectedSheet}"
                                      DisplayMemberPath="SheetNumber"
                                      MinWidth="180"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <!-- Starting number -->
                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Starting Number" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <TextBox Text="{Binding StartingNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}"
                                     Width="80"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <!-- Threshold -->
                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Vertical Threshold" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <TextBox Text="{Binding VerticalThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}"
                                     Width="80"/>
                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ContentCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Sections On Sheet" Style="{StaticResource SectionTitle}"/>
                          <DataGrid Grid.Row="1" ItemsSource="{Binding SectionRows}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    HeadersVisibility="Column"
                                    GridLinesVisibility="Horizontal"
                                    HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                                    CanUserSortColumns="False"
                                    CanUserResizeRows="False"
                                    CanUserResizeColumns="False"
                                    SelectionMode="Single"
                                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                    ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource DataGridRowStyle}"
                                    CellStyle="{StaticResource DataGridCellStyle}"
                                    AlternationCount="2"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Margin="0">

                              <DataGrid.Columns>

                                  <DataGridTextColumn Header="Current #"
                                                      Binding="{Binding CurrentNumber}"
                                                      Width="90">
                                      <DataGridTextColumn.ElementStyle>
                                          <Style TargetType="TextBlock">
                                              <Setter Property="Padding"           Value="8,5"/>
                                              <Setter Property="FontSize"          Value="11"/>
                                              <Setter Property="FontWeight"        Value="Medium"/>
                                              <Setter Property="Foreground"        Value="{StaticResource BrushTextSecondary}"/>
                                              <Setter Property="VerticalAlignment" Value="Center"/>
                                          </Style>
                                      </DataGridTextColumn.ElementStyle>
                                  </DataGridTextColumn>

                                  <DataGridTextColumn Header="View Name"
                                                      Binding="{Binding ViewName}"
                                                      Width="*">
                                      <DataGridTextColumn.ElementStyle>
                                          <Style TargetType="TextBlock">
                                              <Setter Property="Padding"           Value="8,5"/>
                                              <Setter Property="FontSize"          Value="11"/>
                                              <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
                                              <Setter Property="VerticalAlignment" Value="Center"/>
                                              <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                      <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                  </DataTrigger>
                                              </Style.Triggers>
                                          </Style>
                                      </DataGridTextColumn.ElementStyle>
                                  </DataGridTextColumn>

                              </DataGrid.Columns>
                          </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click" Margin="0,0,6,0"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogBox"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap" Height="110"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             Foreground="{StaticResource BrushLogText}"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Renumber"
                        Command="{Binding RunCommand}"
                        Style="{StaticResource RunButton}"
                        Width="120" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
