<!--
=======================================================
File: SectionAutoRenamerWindow.xaml
Changes vs V024 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (navy title bar + version, status
    badges, metrics card), middle (filter bar, rename panel, selection
    toolbar, sections grid that scrolls itself), fixed footer (log with
    Copy All / Copy Selected, Reset left, Commit → Close right).
  - Adds a Close button; MinWidth/MinHeight = default size.
  - Inline badge/metric colours replaced by SharedStyles styles/brushes.
  - No behaviour change — every binding/command/handler is the V024 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.SectionAutoRenamer.V025.Views.SectionsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:viewModels="clr-namespace:Revit26_Plugin_Revised.SectionAutoRenamer.V025.ViewModels"
        Title="Section Auto Renamer — V025"
        Height="880" Width="1100"
        MinHeight="880" MinWidth="1100"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Shared converters — registered here on the Window, never in SharedStyles,
                per project convention.
            -->
            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:InverseBoolConverter             x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Section Auto Renamer" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Prefix, find/replace and standardize section view names" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V025" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <StackPanel Margin="12,8,12,0">
                <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgePill}" Margin="0,0,6,0"
                            Background="{StaticResource BrushInputBackground}" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1"
                            Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Dry run on" Style="{StaticResource BadgeText}" Foreground="{StaticResource BrushTextPrimary}"/>
                    </Border>
                    <Border Style="{StaticResource BadgePill}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Sections.Count, Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource BadgeText}" Text=" sections loaded"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BadgePill}" Margin="0,0,6,0">
                        <CheckBox Content="Standardize Names"
                                  IsChecked="{Binding StandardizeEnabled}"
                                  Foreground="{StaticResource BrushNavyPrimary}" FontSize="11"
                                  VerticalAlignment="Center"/>
                    </Border>
                </WrapPanel>
                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Total" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Selected" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Duplicates" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding DuplicateCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="To Rename" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding ToRenameCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Filter bar        -->
                <RowDefinition Height="Auto"/>  <!-- Rename panel      -->
                <RowDefinition Height="Auto"/>  <!-- Selection toolbar -->
                <RowDefinition Height="*" MinHeight="160"/>  <!-- DataGrid -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BrushSystemSecondaryBackground}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="12,7">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="Sheet" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="140" Margin="0,0,12,0" FontSize="12"
                              ItemsSource="{Binding SheetFilters}"
                              SelectedItem="{Binding SelectedSheetFilter}"/>

                    <Border Width="0.5" Height="18" Background="{StaticResource BrushCardBorder}"
                            Margin="0,0,12,0"/>

                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="120" Margin="0,0,12,0"
                             Style="{StaticResource StyledTextInput}"
                             Text="{Binding SheetSearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Width="0.5" Height="18" Background="{StaticResource BrushCardBorder}"
                            Margin="0,0,12,0"/>

                    <TextBlock Text="Dup. fix" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="155" Margin="0,0,12,0" FontSize="12"
                              ItemsSource="{Binding DuplicateFixStrategies}"
                              SelectedItem="{Binding DuplicateStrategy}"/>

                    <Border Width="0.5" Height="18" Background="{StaticResource BrushCardBorder}"
                            Margin="0,0,12,0"/>

                    <CheckBox Content="Dry run"
                              IsChecked="{Binding IsDryRun}"
                              VerticalAlignment="Center"/>
                </WrapPanel>
            </Border>
                 Row A: Prefix/Postfix | Find/Replace | Options (3 cols)
                 Row B: Standardize (full-width row)
            ═══════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushSystemSecondaryBackground}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="0,0,0,1">
                <StackPanel>

                    <!-- Row A: 3 equal columns -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: Prefix / Postfix -->
                        <StackPanel Grid.Column="0" Margin="12,0,12,8">
                            <TextBlock Text="PREFIX / POSTFIX"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Border Height="0.5" Background="{StaticResource BrushCardBorder}" Margin="0,4"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Postfix" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding Postfix, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Border Height="0.5" Background="{StaticResource BrushCardBorder}" Margin="0,4"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Separator" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" FontSize="12"
                                          ItemsSource="{x:Static viewModels:SectionsListViewModel.SeparatorOptions}"
                                          SelectedItem="{Binding Separator}"
                                          ToolTip="Character inserted between prefix/postfix and the name"/>
                            </Grid>
                        </StackPanel>

                        <!-- Separator 1 -->
                        <Border Grid.Column="1" Background="{StaticResource BrushCardBorder}"/>

                        <!-- Col 2: Find / Replace -->
                        <StackPanel Grid.Column="2" Margin="12,0,12,8">
                            <TextBlock Text="FIND / REPLACE"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Find" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Replace" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Separator 2 -->
                        <Border Grid.Column="3" Background="{StaticResource BrushCardBorder}"/>

                        <!-- Col 4: Options -->
                        <StackPanel Grid.Column="4" Margin="12,0,12,8">
                            <TextBlock Text="OPTIONS"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,0,0,5"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <CheckBox Content="Serial" Margin="0,0,8,0"
                                          IsChecked="{Binding AddSerial}" VerticalAlignment="Center"/>
                                <TextBox Width="48" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding SerialFormat, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding AddSerial}" Margin="0,0,8,0"/>
                                <CheckBox Content="Detail no."
                                          IsChecked="{Binding IncludeDetailNumber}" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Set selected" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding CommonEditName, UpdateSourceTrigger=LostFocus}"
                                         KeyDown="SetSelectedTextBox_KeyDown"
                                         ToolTip="Overwrites EditableName for all selected rows — applies on Enter or when you leave the field"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Row B: Standardize — full width, below Prefix/Postfix + Find/Replace -->
                    <Border BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <StackPanel IsEnabled="{Binding StandardizeEnabled}">
                            <TextBlock Text="STANDARDIZE"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushSuccess}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Case" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="130" Margin="0,0,16,0" FontSize="12"
                                          ItemsSource="{Binding StandardizeCaseOptions}"
                                          SelectedItem="{Binding StandardizeCase}"/>
                                <CheckBox Content="Clean whitespace/punctuation"
                                          IsChecked="{Binding CleanWhitespacePunctuation}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSystemBackground}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="12,5">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="Select all"  Margin="0,0,5,0"
                                Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                        <Button Content="Select none" Margin="0,0,5,0"
                                Command="{Binding SelectNoneCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                        <Button Content="Invert"      Margin="0,0,5,0"
                                Command="{Binding InvertSelectionCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                        <Button Content="Reset selected names" Margin="0,0,5,0"
                                Command="{Binding ResetSelectedNamesCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                        <Button Content="Truncate last number" Margin="0,0,5,0"
                                Command="{Binding TruncateLastNumberCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                        <Button Content="Truncate last text"
                                Command="{Binding TruncateLastTextCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                    </StackPanel>

                    <!-- Keyboard hints -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="↑↓ navigate"     FontSize="10" Margin="0,0,10,0"
                                   Foreground="{StaticResource BrushTextTertiary}"/>
                        <TextBlock Text="Space toggle"    FontSize="10" Margin="0,0,10,0"
                                   Foreground="{StaticResource BrushTextTertiary}"/>
                        <TextBlock Text="Shift+Click range" FontSize="10" Margin="0,0,10,0"
                                   Foreground="{StaticResource BrushTextTertiary}"/>
                        <TextBlock Text="Ctrl+Click multi"  FontSize="10"
                                   Foreground="{StaticResource BrushTextTertiary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataGrid Grid.Row="3"
                      x:Name="SectionsGrid"
                      ItemsSource="{Binding SectionsView}"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                      AlternatingRowBackground="{StaticResource BrushSystemSecondaryBackground}"
                      AlternationCount="2"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      Background="{StaticResource BrushSystemBackground}"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <!-- Checkbox column -->
                    <DataGridTemplateColumn Width="34" CanUserSort="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          Checked="HeaderCheckBox_Checked"
                                          Unchecked="HeaderCheckBox_Unchecked"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="0,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Original name -->
                    <DataGridTextColumn Header="Original name"
                                        Binding="{Binding OriginalName}"
                                        IsReadOnly="True"
                                        Width="*"/>

                    <!-- Edit name -->
                    <DataGridTextColumn Header="Edit name"
                                        Binding="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="False"
                                        Width="*">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background"      Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
                                <Setter Property="BorderBrush"     Value="{StaticResource BrushAppleBlue}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding"         Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Preview + dup badge -->
                    <DataGridTemplateColumn Header="Preview" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding PreviewName}"
                                            VerticalAlignment="Center"/>
                                    <Border Margin="5,0,0,0" CornerRadius="8"
                                            Background="{StaticResource BrushInputBackground}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="0.5"
                                            Padding="5,1"
                                            Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisibilityConverter}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="dup" FontSize="10" Foreground="{StaticResource BrushDanger}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Sheet number -->
                    <DataGridTextColumn Header="Sheet no."
                                        Binding="{Binding SheetNumber}"
                                        IsReadOnly="True"
                                        Width="90"/>

                    <!-- Pin indicator -->
                    <DataGridTemplateColumn Header="" Width="36" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="📌" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="12,8,12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click" Margin="0,0,6,0"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogList" Height="100" SelectionMode="Extended"
                             ItemsSource="{Binding Logs}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Ellipse DockPanel.Dock="Left"
                                             Width="6" Height="6" Margin="0,0,7,0"
                                             Fill="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="11"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                               TextWrapping="NoWrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Background="{StaticResource BrushSystemBackground}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="12,7">
                <DockPanel>
                    <Button DockPanel.Dock="Left"
                                            Command="{Binding ResetSelectedNamesCommand}"
                                            Style="{StaticResource SmallSecondaryButton}">
                                        <Button.Foreground>
                                            <SolidColorBrush Color="{StaticResource ColorDanger}"/>
                                        </Button.Foreground>
                                        <TextBlock Text="↺  Reset all names"
                                                   Foreground="{StaticResource BrushDanger}"/>
                                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="10" Margin="0,0,10,0" Padding="9,3" VerticalAlignment="Center"
                                Background="{StaticResource BrushInputBackground}" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1"
                                Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="11" Foreground="{StaticResource BrushTextPrimary}"
                                       Text="Dry run — no changes will be saved"/>
                        </Border>
                        <Button Style="{StaticResource RunButton}" Margin="0,0,8,0">
                                                <Button.Command>
                                                    <Binding Path="CommitRenameCommand"/>
                                                </Button.Command>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Commit selected (" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SelectedCount}" VerticalAlignment="Center"/>
                                                    <TextBlock Text=")" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                        <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38" Click="CloseButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
