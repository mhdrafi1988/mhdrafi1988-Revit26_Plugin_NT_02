<!--
=======================================================
File: BubbleAutoRenumberWindow.xaml   (class name now matches the file —
      V008's BubbleAutoRenumberWindow.xaml declared SectionAutoRenumberWindow)

Changes vs V008:
  - View-type filter card (Sections / Drafting / Detail / Elevations, plus
    "Any view with a detail number") — NEW.
  - Grid gains New # and a Type pill, and is a live preview of the plan that
    will run, not just the numbers already in the model.
  - Log is the shared LogEntries list (dark, collapsed by default per the
    2026-10-04 convention) instead of a flat TextBox of LogText; Copy All /
    Copy Selected / Clear / Copy report are ViewModel commands, so the
    code-behind no longer carries click handlers.
  - Footer status strip now actually moves: IsRunning / Progress / SummaryText
    are set by the ViewModel.
  - Primary action uses RunButton (the red main-action style) per the
    2026-10-04 convention; V008 used PrimaryButton.
  - MinHeight 720 → 620 so the window fits 1366x768 at 150% scaling.
  - No inline colours: every brush is a SharedStyles token (Transparent aside).
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.BubbleAutoRenumber.V009.UI.Views.BubbleAutoRenumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="{Binding Source={x:Static svc:ToolCatalog.BubbleAutoRenumberV009}, Path=Title}"
        Width="660" Height="780"
        MinWidth="560" MinHeight="620"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter instances belong in the consuming window, never in
                 SharedStyles.xaml, and the xmlns carries no ";assembly=" part —
                 see the convention header in Shared/Converters.cs. -->
            <converters:LogLevelToColorConverter     x:Key="LogLevelToColorConverter"/>
            <converters:InverseBoolConverter         x:Key="InverseBoolConverter"/>
            <converters:ViewTypeGroupToBrushConverter x:Key="ViewTypeGroupToBrushConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Bubble Auto Renumber"
                           Subtitle="Renumber detail bubbles on a sheet, top-left to bottom-right"
                           Version="{Binding Source={x:Static svc:ToolCatalog.BubbleAutoRenumberV009}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="5" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="On Sheet" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding OnSheetCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="To Renumber" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TargetCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Renumbered" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RenumberedCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>

                <!-- ── Sheet + options ─────────────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel>

                        <TextBlock Text="Sheet" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Select Sheet" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <ComboBox ItemsSource="{Binding Sheets}"
                                      SelectedItem="{Binding SelectedSheet}"
                                      DisplayMemberPath="SheetNumber"
                                      Style="{StaticResource StandardComboBox}"
                                      MinWidth="140"/>
                            <TextBlock Text="{Binding SelectedSheetName}"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       MaxWidth="240"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Starting Number" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <TextBox Text="{Binding StartingNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}"
                                     Width="80"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <TextBlock Text="Vertical Threshold" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Width="130"/>
                            <TextBox Text="{Binding VerticalThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}"
                                     Width="80"/>
                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                            <TextBlock Text="how far two bubbles' bottom edges may differ and still count as one row"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       MaxWidth="260"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <!-- ── View types (NEW in V009) ─────────────────────── -->
                        <TextBlock Text="View Types" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal"
                                    IsEnabled="{Binding AnyNumberedView, Converter={StaticResource InverseBoolConverter}}">
                            <CheckBox Content="Sections" IsChecked="{Binding IncludeSections}"
                                      Foreground="{StaticResource BrushTextPrimary}" FontSize="11.5"
                                      VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox Content="Drafting views" IsChecked="{Binding IncludeDrafting}"
                                      Foreground="{StaticResource BrushTextPrimary}" FontSize="11.5"
                                      VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox Content="Detail views" IsChecked="{Binding IncludeDetail}"
                                      Foreground="{StaticResource BrushTextPrimary}" FontSize="11.5"
                                      VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox Content="Elevations" IsChecked="{Binding IncludeElevations}"
                                      Foreground="{StaticResource BrushTextPrimary}" FontSize="11.5"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldRow}" Orientation="Horizontal">
                            <CheckBox Content="Any view with a detail number"
                                      IsChecked="{Binding AnyNumberedView}"
                                      Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="ignores the filter above — includes plans, 3D views and legends"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       MaxWidth="280"/>
                        </StackPanel>

                        <TextBlock Text="{Binding ValidationMessage}" Margin="12,2,12,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValidationMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>
                </Border>

                <!-- ── Preview ─────────────────────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Preview — in renumbering order"
                                       Style="{StaticResource SectionTitle}"/>
                            <Border Grid.Column="1" Style="{StaticResource BadgePill}" Margin="0,8,12,0">
                                <TextBlock Style="{StaticResource BadgeText}">
                                    <Run Text="{Binding InScopeCount, Mode=OneWay}"/><Run Text=" in scope"/>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}"
                                  MinHeight="150"
                                  shell:ShellBehaviors.MaxHeightRatio="0.4"
                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                                  CanUserSortColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserResizeColumns="False"
                                  SelectionMode="Single"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  AlternationCount="2"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Margin="0">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Current #"
                                                    Binding="{Binding CurrentNumber}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding"           Value="8,5"/>
                                            <Setter Property="FontSize"          Value="11"/>
                                            <Setter Property="Foreground"        Value="{StaticResource BrushTextSecondary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="New #"
                                                    Binding="{Binding NewNumber}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding"           Value="8,5"/>
                                            <Setter Property="FontSize"          Value="11"/>
                                            <Setter Property="FontWeight"        Value="SemiBold"/>
                                            <Setter Property="Foreground"        Value="{StaticResource BrushAppleBlue}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Type pill, coloured by the shared palette in
                                     ViewTypeGroupToBrushConverter (matched on name). -->
                                <DataGridTemplateColumn Header="Type" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgePill}"
                                                    Margin="6,3"
                                                    Padding="7,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding PillGroup, Converter={StaticResource ViewTypeGroupToBrushConverter}}">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           Style="{StaticResource BadgeText}"
                                                           FontSize="10"
                                                           Foreground="{Binding PillGroup, Converter={StaticResource ViewTypeGroupToBrushConverter}, ConverterParameter=Foreground}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="View Name"
                                                    Binding="{Binding ViewName}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding"           Value="8,5"/>
                                            <Setter Property="FontSize"          Value="11"/>
                                            <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                    <Setter Property="ToolTip"    Value="{Binding SkipReason}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ── Log — shared LogEntries, dark, collapsed by default ── -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}">
                                <TextBlock Text="Log" Foreground="{StaticResource BrushLogText}"
                                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding CopyAllLogCommand}" Margin="0,0,6,0"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding CopySelectedLogCommand}" Margin="0,0,6,0"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="1" x:Name="LogList"
                                 ItemsSource="{Binding LogEntries}"
                                 SelectionChanged="LogList_SelectionChanged"
                                 Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}"
                                 MinHeight="110"
                                 shell:ShellBehaviors.MaxHeightRatio="0.25"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding"    Value="0,1"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- LogEntry.ToString() already formats as
                                         "HH:mm:ss  Level  Message" — don't reformat it. -->
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Copy report"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding CopyReportCommand}"
                        IsEnabled="{Binding HasReport}"
                        VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Renumber"
                            Command="{Binding RenumberCommand}"
                            Style="{StaticResource RunButton}"
                            Width="120" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
