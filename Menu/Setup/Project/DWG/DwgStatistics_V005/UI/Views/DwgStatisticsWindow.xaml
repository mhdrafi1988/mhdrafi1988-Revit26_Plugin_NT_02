<!--
=======================================================
File: DwgStatisticsWindow.xaml  (DWG Statistics V005 — ToolWindowShell)
  HEADER  metric cards: DWG files / links / imports / instances / views / sheets / not loaded / with issues
  BODY    toolbar card (search, Tick All, Clear, Refresh · quick-filter chips · cleanup actions),
          V002: Views tab has a tick column + Tick All / Clear / Open Ticked Views,
          V005: Rules & history row (far-from-origin km, max layers, CAD worksets, shared history),
                Move to Workset, Max km column, Layers tab (hide/unhide ticked layers in ticked views),
                hidden/overridden layer columns, distance + workset columns,
          V004: progress % + Cancel Scan (footer), Changed tile/chip/column + "Changes since last scan"
                card, open options (max views, close others, open sheet, zoom), Hide / Unhide / Delete
                in Ticked Views, Hidden column, remembered detail tab,
          file grid (one row per DWG file, issue badges), detail card (Views / Instances tabs of the
          selected file), log
  FOOTER  tick hint (left) · Export to Excel, Close (right)

  Resource keys are the ones DWG Manager V003 already uses from Shared/SharedStyles.xaml, plus
  BrushSoftWarningBackground (CHANGELOG, CreateSections V013). No inline colours.
  Do NOT set RowDetailsVisibilityMode on the grids (see DWG Manager V003's note).
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.DwgStatistics.V005.UI.Views.DwgStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.DwgStatistics}, Path=Title}"
        Width="1160" Height="820"
        MinWidth="1040" MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally per suite convention -->
            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>
            <converters:EnumToBoolConverter              x:Key="EnumToBoolConverter"/>

            <Style x:Key="RightHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="GridCellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="GridMutedText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            </Style>

            <Style x:Key="GridNumberText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!-- Small red button (Purge) -->
            <Style x:Key="SmallDangerButton" TargetType="Button" BasedOn="{StaticResource SmallSecondaryButton}">
                <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushStatusError}"/>
            </Style>

            <!-- Quick-filter chip (one-way checked state + command, per UI_UX_PATTERNS) -->
            <Style x:Key="FilterChip" TargetType="RadioButton">
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="{StaticResource BrushSystemTertiaryBackground}"
                                    BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                                    CornerRadius="11" Padding="10,3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Link / Import pill -->
            <Style x:Key="KindPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8,1"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLinked}" Value="False">
                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="KindPillText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLinked}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Link status text: red when not loaded -->
            <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Issue badge, coloured by severity -->
            <Style x:Key="IssueBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Margin" Value="0,1,4,1"/>
                <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SeverityName}" Value="Warning">
                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeverityName}" Value="Danger">
                        <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="IssueBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SeverityName}" Value="Warning">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeverityName}" Value="Danger">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Element-ID chip (same look as DWG Manager V003) -->
            <Style x:Key="IdChip" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{StaticResource BrushStatusInfoSoft}"
                                    BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                                    CornerRadius="4" Padding="7,1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- V004: "New" / "Changed" pill -->
            <Style x:Key="ChangePill" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8,1"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Shared look for the grids -->
            <Style x:Key="StatsGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="IsReadOnly" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushSeparatorThin}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}"/>
                <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
                <Setter Property="Background" Value="{StaticResource BrushSurfaceWindow}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="DWG Statistics"
                           Subtitle="Instances, views, sheets and health of every CAD link and import"
                           Version="{Binding Source={x:Static svc:ToolCatalog.DwgStatistics}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="{Binding IsProgressIndeterminate}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="9" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="DWG Files" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalFiles}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Links" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding LinkCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Imports" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ImportCount}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Instances" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalInstances}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8"
                        ToolTip="Distinct views that own or draw at least one CAD instance">
                    <StackPanel>
                        <TextBlock Text="Views" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ViewsUsed}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8"
                        ToolTip="Distinct sheets that show CAD (through a placed view, or directly)">
                    <StackPanel>
                        <TextBlock Text="Sheets" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SheetsUsed}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Not Loaded" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding NotLoadedCount}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8"
                        ToolTip="Files with a warning or broken status (imported, unused, duplicate, shows in 3D, not loaded)">
                    <StackPanel>
                        <TextBlock Text="With Issues" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding IssueFileCount}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8"
                        ToolTip="V004: DWG files new or changed since the scan of the previous session">
                    <StackPanel>
                        <TextBlock Text="Changed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ChangedCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>

                <!-- ══ Toolbar ══ -->
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Search + tick + refresh -->
                        <Grid Margin="10,8,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Search" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}" MaxLength="40"
                                     ToolTip="Shows only files whose name, kind, status, path or issues contain every word typed."
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Tick All" Style="{StaticResource SmallSecondaryButton}"
                                    Margin="10,0,0,0" Command="{Binding TickAllCommand}"
                                    ToolTip="Tick every file that passes the filter and search."/>
                            <Button Grid.Column="3" Content="Clear Ticks" Style="{StaticResource SmallSecondaryButton}"
                                    Margin="6,0,0,0" Command="{Binding ClearTicksCommand}"
                                    ToolTip="Untick every file that passes the filter and search."/>
                            <Button Grid.Column="4" Content="Refresh" Style="{StaticResource SmallSecondaryButton}"
                                    Margin="6,0,0,0" Command="{Binding RefreshCommand}"
                                    ToolTip="Scan the model and every view again. Ticks and the selected file are kept."/>
                        </Grid>

                        <!-- Quick-filter chips -->
                        <WrapPanel Margin="10,4,10,4">
                            <RadioButton GroupName="DwgQuickFilter" Style="{StaticResource FilterChip}"
                                         Content="{Binding AllChipText}"
                                         IsChecked="{Binding ActiveQuickFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All, Mode=OneWay}"
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="All"/>
                            <RadioButton GroupName="DwgQuickFilter" Style="{StaticResource FilterChip}"
                                         Content="{Binding LinksChipText}"
                                         IsChecked="{Binding ActiveQuickFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Links, Mode=OneWay}"
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Links"/>
                            <RadioButton GroupName="DwgQuickFilter" Style="{StaticResource FilterChip}"
                                         Content="{Binding ImportsChipText}"
                                         IsChecked="{Binding ActiveQuickFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Imports, Mode=OneWay}"
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Imports"/>
                            <RadioButton GroupName="DwgQuickFilter" Style="{StaticResource FilterChip}"
                                         Content="{Binding NotLoadedChipText}"
                                         IsChecked="{Binding ActiveQuickFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NotLoaded, Mode=OneWay}"
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="NotLoaded"/>
                            <RadioButton GroupName="DwgQuickFilter" Style="{StaticResource FilterChip}"
                                         Content="{Binding UnusedChipText}"
                                         IsChecked="{Binding ActiveQuickFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Unused, Mode=OneWay}"
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Unused"/>
                            <RadioButton GroupName="DwgQuickFilter" Style="{StaticResource FilterChip}"
                                         Content="{Binding IssuesChipText}"
                                         IsChecked="{Binding ActiveQuickFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Issues, Mode=OneWay}"
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Issues"/>
                            <RadioButton GroupName="DwgQuickFilter" Style="{StaticResource FilterChip}"
                                         Content="{Binding ChangedChipText}"
                                         IsChecked="{Binding ActiveQuickFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Changed, Mode=OneWay}"
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Changed"/>
                        </WrapPanel>

                        <!-- Cleanup actions on ticked files -->
                        <DockPanel Margin="10,4,10,4" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Ticked files" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Left" Content="{Binding PinAllLabel}" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding PinAllCommand}"
                                    ToolTip="Pin every unpinned instance of the ticked files (asks first)."/>
                            <Button DockPanel.Dock="Left" Content="{Binding ReloadLabel}" Style="{StaticResource SmallSecondaryButton}"
                                    Margin="6,0,0,0" Command="{Binding ReloadLinksCommand}"
                                    ToolTip="Reload the ticked CAD links from their saved paths (imports are skipped)."/>
                            <Button DockPanel.Dock="Left" Content="{Binding PurgeLabel}" Style="{StaticResource SmallDangerButton}"
                                    Margin="6,0,0,0" Command="{Binding PurgeUnusedCommand}"
                                    ToolTip="Delete the ticked CAD types that have no instance (asks first)."/>
                            <!-- V005: Move to Workset (workshared models only) -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="14,0,0,0"
                                        Visibility="{Binding IsWorkshared, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Workset" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="150" VerticalAlignment="Center"
                                          ItemsSource="{Binding Worksets}" SelectedItem="{Binding SelectedWorkset, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          ToolTip="Target workset for Move"/>
                                <Button Content="{Binding MoveToWorksetLabel}" Style="{StaticResource SmallSecondaryButton}"
                                        Margin="6,0,0,0" Command="{Binding MoveToWorksetCommand}"
                                        ToolTip="Move the model-placed instances of the ticked files onto this workset (asks first). 'Current view only' instances follow their view's workset."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding ScanInfo}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                        </DockPanel>

                        <!-- V005: rules behind the health checks, and where the history is kept (remembered) -->
                        <Expander Margin="10,2,10,6" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Rules &amp; history" Style="{StaticResource FieldLabel}"
                                           ToolTip="Limits for the far-from-origin, layer-count and workset checks, and the shared history option. Changes apply at once to the current results."/>
                            </Expander.Header>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="Far from origin over" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="56" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding FarFromOriginKm, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Flag DWGs whose geometry reaches farther than this from the internal origin."/>
                                <TextBlock Text="km" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,18,0"/>
                                <TextBlock Text="Many layers over" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="56" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding MaxLayers, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Flag DWGs with more layers than this."/>
                                <TextBlock Text="CAD worksets contain" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                                <TextBox Width="130" Style="{StaticResource StyledTextInput}" MaxLength="80"
                                         Text="{Binding CadWorksetPattern, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Semicolon-separated; a workset whose name contains any of these counts as a CAD workset. Empty = rule off."/>
                                <CheckBox Content="Shared history next to the project file" VerticalAlignment="Center" FontSize="11"
                                          Margin="18,0,0,0" Foreground="{StaticResource BrushTextSecondary}"
                                          IsChecked="{Binding SharedHistory}"
                                          ToolTip="Keep the scan history in a _DwgStatistics folder next to the project (central model) so the whole team compares against the same last scan. Applies from the next window opening. Cloud / server models keep it on this computer."/>
                            </WrapPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ══ File grid ══ -->
                <Border Style="{StaticResource ContentCard}">
                    <DataGrid x:Name="FilesGrid"
                              Style="{StaticResource StatsGrid}"
                              ItemsSource="{Binding FilesView}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              MinHeight="180"
                              shell:ShellBehaviors.MaxHeightRatio="0.42"
                              shell:ShellBehaviors.ForwardMouseWheel="True">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="☑" Width="34" CanUserSort="False"
                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsTicked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="DWG File" Width="2*" SortMemberPath="FileName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName, Mode=OneWay}" ToolTip="{Binding FileToolTip}"
                                                   Style="{StaticResource GridCellText}" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Kind" Width="62" SortMemberPath="Kind"
                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource KindPill}">
                                            <TextBlock Text="{Binding Kind, Mode=OneWay}" Style="{StaticResource KindPillText}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="80" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status, Mode=OneWay}" Style="{StaticResource StatusText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- V004: new / changed since the last scan -->
                            <DataGridTemplateColumn Header="Since Last" Width="74" SortMemberPath="ChangeTag"
                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChangePill}" ToolTip="{Binding ChangeDetail}"
                                                Visibility="{Binding HasChange, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ChangeTag, Mode=OneWay}" FontSize="10"
                                                       Foreground="{StaticResource BrushAppleBlue}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Instances" Width="66" SortMemberPath="InstanceCount"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InstanceCount, Mode=OneWay}" Style="{StaticResource GridNumberText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="View-spec." Width="68" SortMemberPath="ViewSpecificCount"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ViewSpecificCount, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                   ToolTip="Instances placed 'Current view only'"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Model" Width="54" SortMemberPath="ModelCount"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModelCount, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                   ToolTip="Instances placed in the model (can show in every view)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Placed in" Width="64" SortMemberPath="PlacedViewCount"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlacedViewCount, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                   ToolTip="Views that own a 'Current view only' instance"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Views" Width="54" SortMemberPath="VisibleViewCount"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VisibleViewCount, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                   ToolTip="All views that draw this DWG (placed there, or visible from the model)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Sheets" Width="54" SortMemberPath="SheetCount"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SheetCount, Mode=OneWay}" Style="{StaticResource GridNumberText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Pinned" Width="58" SortMemberPath="UnpinnedCount"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PinnedText, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                   FontWeight="Normal" ToolTip="Pinned / total instances"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Layers" Width="54" SortMemberPath="LayerCount"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LayerCount, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                   FontWeight="Normal"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- V005: farthest geometry from the internal origin -->
                            <DataGridTemplateColumn Header="Max km" Width="60" SortMemberPath="MaxDistanceKm"
                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MaxDistanceText, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                   FontWeight="Normal"
                                                   ToolTip="Farthest point of the DWG geometry from Revit's internal origin (km)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Issues" Width="1.6*" SortMemberPath="IssueCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Issues}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource IssueBadge}" ToolTip="{Binding ToolTip}">
                                                        <TextBlock Text="{Binding Text}" Style="{StaticResource IssueBadgeText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ══ V004: changes since the last scan ══ -->
                <Border Style="{StaticResource ContentCard}" Margin="0,8,0,0" Padding="10,6">
                    <Expander IsExpanded="{Binding ChangesExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ChangesHeader}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource BrushNavyPrimary}"/>
                                <TextBlock Text="{Binding BaselineText}" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Expander.Header>
                        <DataGrid Style="{StaticResource StatsGrid}"
                                  ItemsSource="{Binding Changes}"
                                  Margin="0,6,0,0"
                                  shell:ShellBehaviors.MaxHeightRatio="0.2"
                                  shell:ShellBehaviors.ForwardMouseWheel="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Change" Binding="{Binding Change, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="DWG File" Binding="{Binding FileName, Mode=OneWay}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail, Mode=OneWay}" Width="3*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </Border>

                <!-- ══ Detail of the selected file ══ -->
                <Border Style="{StaticResource ContentCard}" Margin="0,8,0,0" Padding="10,8">
                    <Grid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Click a DWG file above to see the views it is placed in / visible in, and each of its instances."
                                   Visibility="{Binding HasSelectedFile, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <StackPanel DataContext="{Binding SelectedFile}"
                                    Visibility="{Binding DataContext.HasSelectedFile, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="12.5"
                                       Foreground="{StaticResource BrushNavyPrimary}" ToolTip="{Binding FileToolTip}"/>
                            <TextBlock Text="{Binding DetailSummary}" Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Margin="0,2,0,6"/>

                            <TabControl Background="{StaticResource BrushSurfaceWindow}" BorderBrush="{StaticResource BrushBorderDefault}"
                                        SelectedIndex="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">

                                <!-- Views -->
                                <TabItem Header="{Binding ViewsTabHeader}">
                                  <StackPanel>
                                    <!-- V002/V004: tick views, then Open / Hide / Unhide / Delete -->
                                    <StackPanel Margin="4,6,4,6">
                                        <!-- Row 1: tick + open -->
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Left" Content="Tick All" Style="{StaticResource SmallSecondaryButton}"
                                                    Command="{Binding DataContext.TickAllViewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Tick every view in this list."/>
                                            <Button DockPanel.Dock="Left" Content="Clear" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ClearViewTicksCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Untick every view in this list."/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                                    Content="{Binding DataContext.OpenTickedViewsLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    MinWidth="190" Height="28" Padding="12,0"
                                                    Command="{Binding DataContext.OpenTickedViewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Open every ticked view in Revit, using the options below. The last one opened becomes the active view."/>
                                            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,12,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding DataContext.ViewTickHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DockPanel>

                                        <!-- Row 2: open options (remembered) -->
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="Open up to" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Width="56" VerticalAlignment="Center"
                                                      ItemsSource="{Binding DataContext.MaxOpenViewsOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding DataContext.MaxOpenViews, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                      ToolTip="Most views Open Ticked Views opens at once"/>
                                            <TextBlock Text="views" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,16,0"/>
                                            <CheckBox Content="Zoom to the DWG in each view" VerticalAlignment="Center" FontSize="11" Margin="0,0,14,0"
                                                      Foreground="{StaticResource BrushTextSecondary}"
                                                      IsChecked="{Binding DataContext.ZoomToDwg, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ToolTip="After opening each view, select this DWG's instances there and zoom to them."/>
                                            <CheckBox Content="Open the sheet instead" VerticalAlignment="Center" FontSize="11" Margin="0,0,14,0"
                                                      Foreground="{StaticResource BrushTextSecondary}"
                                                      IsChecked="{Binding DataContext.OpenSheetInstead, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ToolTip="For a view placed on a sheet, open that sheet (first one) instead of the view."/>
                                            <CheckBox Content="Close other open views" VerticalAlignment="Center" FontSize="11"
                                                      Foreground="{StaticResource BrushTextSecondary}"
                                                      IsChecked="{Binding DataContext.CloseOtherViews, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ToolTip="After opening, close every other open view so only the ticked ones remain (asks first)."/>
                                        </WrapPanel>

                                        <!-- Row 3: hide / unhide / delete in ticked views -->
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="{Binding DataContext.HideLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Command="{Binding DataContext.HideInTickedViewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Hide this DWG in the ticked views that draw it (Hide in View → Elements). One undo step."/>
                                            <Button Content="{Binding DataContext.UnhideLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.UnhideInTickedViewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Unhide this DWG in the ticked views where it is hidden ('Hidden here' rows). One undo step."/>
                                            <Button Content="{Binding DataContext.DeleteLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource SmallDangerButton}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteInTickedViewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Delete this DWG's 'Current view only' instances in the ticked views (asks first). Model-placed instances are never deleted here."/>
                                            <CheckBox Content="Purge type if nothing is left" VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"
                                                      Foreground="{StaticResource BrushTextSecondary}"
                                                      IsChecked="{Binding DataContext.PurgeAfterDelete, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ToolTip="After Delete in Ticked, also remove the CAD type if no instance of it is left anywhere."/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <DataGrid Style="{StaticResource StatsGrid}"
                                              ItemsSource="{Binding ViewRows}"
                                              MinHeight="120"
                                              shell:ShellBehaviors.MaxHeightRatio="0.3"
                                              shell:ShellBehaviors.ForwardMouseWheel="True">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="☑" Width="34" CanUserSort="False"
                                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsTicked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip="Tick to include this view in Open Ticked Views"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="View" Width="2*" SortMemberPath="ViewName">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ViewName, Mode=OneWay}" ToolTip="{Binding ViewName}"
                                                                   Style="{StaticResource GridCellText}" Margin="4,0,0,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="View Type" Width="110" SortMemberPath="ViewType">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ViewType, Mode=OneWay}" Style="{StaticResource GridMutedText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Relation" Width="130" SortMemberPath="Relation">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Relation, Mode=OneWay}" Style="{StaticResource GridMutedText}"
                                                                   ToolTip="Placed here = 'Current view only' instance owned by this view. Visible (model) = a model instance this view draws. Hidden here = hidden in this view by element."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Placed" Width="58" SortMemberPath="PlacedInstances"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding PlacedInstances, Mode=OneWay}" Style="{StaticResource GridNumberText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Visible" Width="58" SortMemberPath="VisibleInstances"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding VisibleInstances, Mode=OneWay}" Style="{StaticResource GridNumberText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Hidden" Width="58" SortMemberPath="HiddenInstances"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding HiddenInstances, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                                   ToolTip="Instances hidden in this view by Hide in View → Elements"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Hid. Layers" Width="70" SortMemberPath="HiddenLayers"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding HiddenLayers, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                                   ToolTip="V005: layers of this DWG hidden in this view (Visibility/Graphics)"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Ovr. Layers" Width="70" SortMemberPath="OverriddenLayers"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding OverriddenLayers, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                                   ToolTip="V005: layers of this DWG with graphic overrides in this view"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Sheets" Width="1*" SortMemberPath="Sheets">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Sheets, Mode=OneWay}" ToolTip="{Binding Sheets}"
                                                                   Style="{StaticResource GridMutedText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="" Width="70" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Open" Style="{StaticResource SmallSecondaryButton}" Height="22"
                                                                HorizontalAlignment="Center"
                                                                Command="{Binding DataContext.OpenViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Usage}"
                                                                ToolTip="Open just this view in Revit"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                  </StackPanel>
                                </TabItem>

                                <!-- Instances -->
                                <TabItem Header="{Binding InstancesTabHeader}">
                                    <DataGrid Style="{StaticResource StatsGrid}"
                                              ItemsSource="{Binding Instances}"
                                              MinHeight="120"
                                              shell:ShellBehaviors.MaxHeightRatio="0.3"
                                              shell:ShellBehaviors.ForwardMouseWheel="True">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Element ID" Width="96" SortMemberPath="Id">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Id}" ContentStringFormat="#{0}" Style="{StaticResource IdChip}"
                                                                Margin="4,0,0,0"
                                                                Command="{Binding DataContext.ZoomInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Select this instance and zoom to it (opens a view that shows it if needed)"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Placement" Width="96" SortMemberPath="Placement">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Placement, Mode=OneWay}" Style="{StaticResource GridCellText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Owner View" Width="2*" SortMemberPath="OwnerViewName">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding OwnerViewName, Mode=OneWay}" ToolTip="{Binding OwnerViewName}"
                                                                   Style="{StaticResource GridMutedText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Views" Width="54" SortMemberPath="VisibleViewCount"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding VisibleViewCount, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                                   ToolTip="Views that draw this instance"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Pinned" Width="58" SortMemberPath="Pinned"
                                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding PinnedText, Mode=OneWay}" Style="{StaticResource GridCellText}"
                                                                   HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Workset" Width="1*" SortMemberPath="Workset">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Workset, Mode=OneWay}" Style="{StaticResource GridMutedText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Level" Width="1*" SortMemberPath="Level">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Level, Mode=OneWay}" Style="{StaticResource GridMutedText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Created By" Width="1*" SortMemberPath="CreatedBy">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding CreatedBy, Mode=OneWay}" Style="{StaticResource GridMutedText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Dist. km" Width="64" SortMemberPath="DistanceKm"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DistanceText, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                                   FontWeight="Normal" ToolTip="Farthest point from the internal origin (km)"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="CAD WS" Width="58" SortMemberPath="WorksetOkText"
                                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding WorksetOkText, Mode=OneWay}" Style="{StaticResource GridCellText}"
                                                                   HorizontalAlignment="Center"
                                                                   ToolTip="Is the instance on a CAD workset (per the rule)?"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <!-- V005: Layers -->
                                <TabItem Header="{Binding LayersTabHeader}">
                                  <StackPanel>
                                    <DockPanel Margin="4,6,4,6" LastChildFill="True">
                                        <Button DockPanel.Dock="Left" Content="Tick All" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding DataContext.TickAllLayersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Tick every layer in this list."/>
                                        <Button DockPanel.Dock="Left" Content="Clear" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                Command="{Binding DataContext.ClearLayerTicksCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Untick every layer."/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                Content="{Binding DataContext.UnhideLayersLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.UnhideLayersInTickedViewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Show the ticked layers again in the views ticked in the Views tab. One undo step."/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallSecondaryButton}"
                                                Content="{Binding DataContext.HideLayersLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.HideLayersInTickedViewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Hide the ticked layers in the views ticked in the Views tab (Visibility/Graphics → Imported Categories). One undo step."/>
                                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,12,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DataContext.LayerTickHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DockPanel>
                                    <DataGrid Style="{StaticResource StatsGrid}"
                                              ItemsSource="{Binding LayerRows}"
                                              MinHeight="120"
                                              shell:ShellBehaviors.MaxHeightRatio="0.3"
                                              shell:ShellBehaviors.ForwardMouseWheel="True">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="☑" Width="34" CanUserSort="False"
                                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsTicked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Layer" Width="2*" SortMemberPath="Name">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" ToolTip="{Binding Name}"
                                                                   Style="{StaticResource GridCellText}" Margin="4,0,0,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Hidden in" Width="70" SortMemberPath="HiddenInViews"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding HiddenInViews, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                                   ToolTip="Views (showing this DWG) where the layer is hidden"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Overridden in" Width="90" SortMemberPath="OverriddenInViews"
                                                                    HeaderStyle="{StaticResource RightHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding OverriddenInViews, Mode=OneWay}" Style="{StaticResource GridNumberText}"
                                                                   ToolTip="Views where the layer has graphic overrides"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Hidden in (views)" Width="3*" SortMemberPath="HiddenViewNames">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding HiddenViewNames, Mode=OneWay}" ToolTip="{Binding HiddenViewNames}"
                                                                   Style="{StaticResource GridMutedText}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                  </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ Log ══ -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLog_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                 MinHeight="80"
                                 shell:ShellBehaviors.MaxHeightRatio="0.18"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                        <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogTextDim}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold" Width="60"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding Message, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <!-- V004: visible only while the deep scan runs -->
                    <Button Content="Cancel Scan" Style="{StaticResource DangerButton}" MinWidth="110" Margin="0,0,10,0"
                            Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Stop after the current batch of views; the previous results stay on screen."/>
                    <TextBlock Text="{Binding ScanProgressText}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontWeight="SemiBold"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding TickHint}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                               Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Export to Excel" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExportCommand}" MinWidth="150" Margin="0,0,8,0"
                            ToolTip="Save Summary, Views, Instances and Scan Info sheets to an .xlsx file (all files, not only the filtered ones)."/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
