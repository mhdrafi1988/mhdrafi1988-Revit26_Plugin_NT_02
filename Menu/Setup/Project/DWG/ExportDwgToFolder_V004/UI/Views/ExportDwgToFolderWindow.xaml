<!--
=======================================================
File: ExportDwgToFolderWindow.xaml  (Export DWG to Folder v4.0.0, build V003)
ToolWindowShell layout:
  HEADER  metric tiles (scanned / linked / imported / ready / issues / selected)
  BODY    output folder · scan scope + Scan · export options
          scanned-DWG grid (Source → View type groups, filter, tick per row/group, sort) · log
  FOOTER  status line, Scanning / Loading list / Exporting bars, Reset · Export (n) → Close
Nothing is scanned when the window opens; scope boxes and grid rows start unticked.
V002: each DWG is exported by isolating just that one CAD instance in its host view (not the
whole view's content); a group header's checkbox ticks/unticks every row in that group; after a
successful export the user is asked whether to delete the successfully-exported CAD instances
from the model — a mixed Link+Import batch gets Imports-only / Links-only / All choices, and the
"After export: Ask / Always / Never" chips (remembered) can silence the prompt entirely.
V003: version bump of V002 (new folder + namespace); no behaviour change.

V004 (behaviour change — new folder + namespace):
  · Export Options gains a DWG export setup combo (ExportDWGSettings.ListNames),
    "Preserve layer properties" (PropOverrides = ByLayer), "Copy original file
    for links", "Use shared coordinates", a run-manifest toggle and an
    output-name pattern.
  · Name and Output File carry a rich hover tooltip with the full destination
    path, the source, host view, sheet, layer count and element ID.
  · New Layers column — "1" means the DWG was flattened on import.
  · New footer "Check" button: a dry run that writes nothing.
  · New "Last export" card: reopen the review, open the output folder.
  · The post-export delete prompt is now PostExportReviewWindow, with a per-row
    Keep / Delete / Convert to import / Replace with link to exported file.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.ExportDwgToFolder.V004.UI.Views.ExportDwgToFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:vm="clr-namespace:Revit26_Plugin_Revised.ExportDwgToFolder.V004.UI.ViewModels"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="{Binding Source={x:Static svc:ToolCatalog.ExportDwgToFolder}, Path=Title}"
        Width="920" Height="840"
        MinWidth="920" MinHeight="840"
        MaxWidth="1196" MaxHeight="1092"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter      x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter  x:Key="LogLevelToColorConverter"/>
            <converters:EnumToBoolConverter       x:Key="EnumToBoolConverter"/>
            <vm:GroupTickStateConverter           x:Key="GroupTickStateConverter"/>

            <!-- ── V004: full-path hover tooltip ─────────────────────────────
                 The grid clips long names, so Name and Output File both carry
                 this. It is the window's first multi-line tooltip; every colour
                 is a SharedStyles brush (CLAUDE.md forbids inline colours).
                 ShowDuration is long enough to actually read a UNC path.

                 It is a DataTemplate, NOT a Style setter holding a Border: a
                 complex value in a Style setter is one instance shared by every
                 element using that style, and WPF throws "Specified element is
                 already the logical child of another element" as soon as a
                 second cell tries to show it. Declared per cell inside the
                 column's DataTemplate, each row gets its own instance.
            ──────────────────────────────────────────────────────────────── -->
            <DataTemplate x:Key="PathTooltipTemplate" DataType="{x:Type vm:DwgRowViewModel}">
                        <Border Background="{DynamicResource BrushSurfaceCard}"
                                BorderBrush="{DynamicResource BrushNavyLight}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" MaxWidth="560">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="OUTPUT"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,3"
                                           Text="{Binding OutputFileName}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="SAVES TO"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,3"
                                           Text="{Binding DestinationPath}" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="SOURCE"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,3"
                                           Text="{Binding SourceDescription}" TextWrapping="Wrap"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="HOST VIEW"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,3"
                                           Text="{Binding HostView}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyText}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="SHEET"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,3"
                                           Text="{Binding Sheet}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyText}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="LAYERS"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,3"
                                           Text="{Binding LayerText}"
                                           Style="{StaticResource BodyText}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="ELEMENT ID"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           Text="{Binding ElementIdValue}"
                                           FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Grid>
                        </Border>
            </DataTemplate>

            <!-- Metric tile template -->
            <DataTemplate x:Key="SummaryCardTemplate" DataType="{x:Type vm:SummaryCard}">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0" Padding="10,8" ToolTip="{Binding Hint}">
                    <StackPanel>
                        <TextBlock x:Name="Num" Text="{Binding Value}" Style="{StaticResource MetricNumber}" FontSize="20"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabel}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Accent">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Success">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Warning">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Danger">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Footer progress bar: label · bar · count · % -->
            <DataTemplate x:Key="PhaseTemplate" DataType="{x:Type vm:PhaseProgress}">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource BrushTextDisabled}"/>
                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                    <ProgressBar x:Name="Bar" Grid.Column="1" Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding Percent, Mode=OneWay}"
                                 Foreground="{StaticResource BrushTextDisabled}"
                                 Background="{StaticResource BrushSeparatorThin}"
                                 BorderThickness="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock x:Name="Pct" Grid.Column="3" Text="{Binding PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushTextTertiary}"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Running">
                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource BrushAppleBlue}"/>
                        <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                        <Setter TargetName="Pct" Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource BrushStatusOk}"/>
                        <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                        <Setter TargetName="Pct" Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Warning">
                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource BrushStatusWarn}"/>
                        <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                        <Setter TargetName="Pct" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="ScopeLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="68"/>
            </Style>

            <Style x:Key="ScopeCheck" TargetType="CheckBox">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,14,0"/>
            </Style>

            <!-- Grid header variants -->
            <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>
            <Style x:Key="RightCellText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <!-- Expand / collapse arrow for group headers -->
            <Style x:Key="GroupArrowToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock x:Name="Glyph" Text="&#x25BE;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushNavyPrimary}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#x25B8;"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Group level 1: Source (Link / Import). The rows' ItemsPresenter is a direct child of the
                 template (no Expander) so WPF attaches the rows to the grid before building them. -->
            <GroupStyle x:Key="SourceGroupStyle">
                <GroupStyle.Panel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </GroupStyle.Panel>
                <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GroupItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Padding="4,3" Background="{StaticResource BrushSystemTertiaryBackground}"
                                                BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton x:Name="ExpandToggle" Tag="GroupToggle" Style="{StaticResource GroupArrowToggle}" IsChecked="True"
                                                              Loaded="GroupToggle_Loaded" Checked="GroupToggle_Changed" Unchecked="GroupToggle_Changed"
                                                              ToolTip="Collapse or expand this group"/>
                                                <CheckBox x:Name="GroupTick" Tag="GroupTick" IsThreeState="True" Focusable="False" VerticalAlignment="Center"
                                                          Margin="6,0,2,0" Click="GroupTick_Click"
                                                          IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBoolConverter}}"
                                                          ToolTip="Tick or untick every row in this group">
                                                    <CheckBox.IsChecked>
                                                        <MultiBinding Converter="{StaticResource GroupTickStateConverter}" Mode="OneWay">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedCount" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        </MultiBinding>
                                                    </CheckBox.IsChecked>
                                                </CheckBox>
                                                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat=({0})}" Margin="6,0,0,0" FontSize="11.5"
                                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsPresenter x:Name="GroupRows" Grid.Row="1"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="ExpandToggle" Property="IsChecked" Value="False">
                                            <Setter TargetName="GroupRows" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GroupStyle.ContainerStyle>
            </GroupStyle>

            <!-- Group level 2: View type (Plan / Section / Drafting / No Views) -->
            <GroupStyle x:Key="ViewGroupStyle">
                <GroupStyle.Panel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </GroupStyle.Panel>
                <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GroupItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Padding="22,2,4,2" Background="{StaticResource BrushSystemSecondaryBackground}"
                                                BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,1,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton x:Name="ExpandToggle" Tag="GroupToggle" Style="{StaticResource GroupArrowToggle}" IsChecked="True"
                                                              Loaded="GroupToggle_Loaded" Checked="GroupToggle_Changed" Unchecked="GroupToggle_Changed"
                                                              ToolTip="Collapse or expand this group"/>
                                                <CheckBox x:Name="GroupTick" Tag="GroupTick" IsThreeState="True" Focusable="False" VerticalAlignment="Center"
                                                          Margin="6,0,2,0" Click="GroupTick_Click"
                                                          IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBoolConverter}}"
                                                          ToolTip="Tick or untick every row in this group">
                                                    <CheckBox.IsChecked>
                                                        <MultiBinding Converter="{StaticResource GroupTickStateConverter}" Mode="OneWay">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedCount" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        </MultiBinding>
                                                    </CheckBox.IsChecked>
                                                </CheckBox>
                                                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{StaticResource BrushNavyLight}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat=({0})}" Margin="6,0,0,0" FontSize="11.5"
                                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsPresenter x:Name="GroupRows" Grid.Row="1"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="ExpandToggle" Property="IsChecked" Value="False">
                                            <Setter TargetName="GroupRows" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GroupStyle.ContainerStyle>
            </GroupStyle>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Export DWG to Folder"
                           Subtitle="Choose a scan scope, scan, tick the CAD links / imports you want, then export them to a folder. Each is isolated and exported from its own view; you'll be asked whether to delete the exported instances from the model afterward."
                           Version="{Binding Source={x:Static svc:ToolCatalog.ExportDwgToFolder}, Path=Version, StringFormat=v{0}}"
                           SummaryText="{Binding StatusMessage}">

        <!-- ═══ HEADER — metrics ═══════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <ItemsControl ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource SummaryCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═══════════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>

                <!-- ── Output folder ── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Output Folder" Style="{StaticResource SectionTitle}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseOutputFolderCommand}"
                                    Margin="8,0,0,0" Width="80" Height="28"/>
                            <TextBox Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Padding="8,4" VerticalContentAlignment="Center"
                                     FontFamily="Consolas" FontSize="11"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                     ToolTip="Folder where the link / import subfolders are created"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ── Scan scope + export options ── -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Scan scope -->
                    <Border Grid.Column="0" Style="{StaticResource ContentCard}">
                        <StackPanel Margin="12,10"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="⌕  Scan"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ScanCommand}"
                                        Height="28" MinWidth="86"
                                        ToolTip="Scan the document for DWGs in the ticked scope (tick at least one source and one view type)"/>
                                <TextBlock Text="Scan Scope" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock Text="Source" Style="{StaticResource ScopeLabel}"/>
                                <CheckBox Content="🔗 Linked" IsChecked="{Binding ScanLinked, Mode=TwoWay}" Style="{StaticResource ScopeCheck}"/>
                                <CheckBox Content="📥 Imported" IsChecked="{Binding ScanImported, Mode=TwoWay}" Style="{StaticResource ScopeCheck}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="View type" Style="{StaticResource ScopeLabel}"/>
                                <CheckBox Content="Plan" IsChecked="{Binding ScanPlan, Mode=TwoWay}" Style="{StaticResource ScopeCheck}"/>
                                <CheckBox Content="Section" IsChecked="{Binding ScanSection, Mode=TwoWay}" Style="{StaticResource ScopeCheck}"/>
                                <CheckBox Content="Drafting" IsChecked="{Binding ScanDrafting, Mode=TwoWay}" Style="{StaticResource ScopeCheck}"/>
                                <CheckBox Content="No Views" IsChecked="{Binding ScanNoViews, Mode=TwoWay}" Style="{StaticResource ScopeCheck}"/>
                            </StackPanel>
                            <TextBlock Text="Nothing is scanned until you click Scan. All boxes start unticked."
                                       Margin="0,7,0,0" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Export options -->
                    <Border Grid.Column="2" Style="{StaticResource ContentCard}">
                        <StackPanel Margin="12,10"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                            <TextBlock Text="Export Options" Style="{StaticResource SectionTitle}"/>

                            <!-- V004: DWG export setup. The list is filled on every scan from
                                 ExportDWGSettings.ListNames(doc); picking one routes the export
                                 through DWGExportOptions.GetPredefinedOptions, which carries that
                                 setup's layer, linetype and pattern tables across. -->
                            <TextBlock Text="DWG export setup" Style="{StaticResource FieldLabel}" Margin="0,2,0,3"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Height="28"
                                      ItemsSource="{Binding ExportSetups}"
                                      SelectedItem="{Binding SelectedExportSetup, Mode=TwoWay}"
                                      ToolTip="Layer, linetype and hatch tables come from this setup. A setup deleted from the model since the last run falls back to Revit defaults with a warning in the log."/>

                            <!-- V004: the layer-structure decision. Revit's PropOverrideMode has
                                 three modes and they are not shades of one setting — see the
                                 tooltips. One-way chip binding + command, per UI_UX_PATTERNS. -->
                            <TextBlock Text="Layer properties" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="LayerProps" Style="{StaticResource ChipToggle}"
                                             Content="Layers 1:1" Margin="0,0,4,0"
                                             IsChecked="{Binding LayerPropertyMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=LayersOnly, Mode=OneWay}"
                                             Command="{Binding SetLayerPropertyModeCommand}" CommandParameter="LayersOnly"
                                             ToolTip="PropOverrides = ByLayer. Everything BYLAYER with no overrides — the output's layer set matches the source file one for one, and Revit view overrides on the CAD are dropped. Default, and normally what you want when exporting CAD back out."/>
                                <RadioButton GroupName="LayerProps" Style="{StaticResource ChipToggle}"
                                             Content="Layers + override layers" Margin="0,0,4,0"
                                             IsChecked="{Binding LayerPropertyMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=LayersPlusOverrideLayers, Mode=OneWay}"
                                             Command="{Binding SetLayerPropertyModeCommand}" CommandParameter="LayersPlusOverrideLayers"
                                             ToolTip="PropOverrides = NewLayer. Everything BYLAYER, and each Revit override becomes its own new layer — keeps what the view looks like, at the cost of layers that were not in the source file."/>
                                <RadioButton GroupName="LayerProps" Style="{StaticResource ChipToggle}"
                                             Content="Fidelity first"
                                             IsChecked="{Binding LayerPropertyMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FidelityFirst, Mode=OneWay}"
                                             Command="{Binding SetLayerPropertyModeCommand}" CommandParameter="FidelityFirst"
                                             ToolTip="PropOverrides = ByEntity. Revit's own default, and what V002/V003 exported with: category properties BYLAYER but overrides stamped onto each entity, so overridden geometry stops following its layer."/>
                            </StackPanel>

                            <UniformGrid Columns="2" Rows="3" Margin="0,8,0,0">
                                <CheckBox Content="Copy original file for links" IsChecked="{Binding CopyOriginalForLinks, Mode=TwoWay}"
                                          Style="{StaticResource ScopeCheck}" Margin="0,0,0,6"
                                          ToolTip="A link whose source file resolves is copied rather than re-exported — byte-for-byte identical, so the layer structure is exactly the source's. Turn off to re-export every link through its host view (V003 behaviour)."/>
                                <CheckBox Content="Subfolders by view type" IsChecked="{Binding SubfoldersByViewType, Mode=TwoWay}"
                                          Style="{StaticResource ScopeCheck}" Margin="0,0,8,6"
                                          ToolTip="link|import \ plan|section|drafting|no_views \ file.dwg"/>
                                <CheckBox Content="Sidecar .txt per DWG" IsChecked="{Binding GenerateSidecar, Mode=TwoWay}"
                                          Style="{StaticResource ScopeCheck}" Margin="0,0,0,6"
                                          ToolTip="View Name · Sheet · Element ID · Symbol Name"/>
                                <CheckBox Content="Overwrite existing" IsChecked="{Binding Overwrite, Mode=TwoWay}"
                                          Style="{StaticResource ScopeCheck}" Margin="0,0,8,0"
                                          ToolTip="When off, files that already exist are skipped"/>
                                <CheckBox Content="Use shared coordinates" IsChecked="{Binding UseSharedCoords, Mode=TwoWay}"
                                          Style="{StaticResource ScopeCheck}" Margin="0,0,0,6"
                                          ToolTip="Export about the shared coordinate origin instead of the project origin"/>
                                <CheckBox Content="Run manifest CSV" IsChecked="{Binding WriteManifest, Mode=TwoWay}"
                                          Style="{StaticResource ScopeCheck}" Margin="0,0,8,0"
                                          ToolTip="One _export-manifest_*.csv per run at the output root: name, element ID, source path, destination, route, status and reason for every row. What you attach for a consultant, or open to chase the rows that didn't come out."/>
                            </UniformGrid>

                            <!-- V004: output-name pattern. Applied at scan time, so the grid's
                                 Output File column shows what the export will actually write. -->
                            <TextBlock Text="Output name pattern" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="120"
                                     Text="{Binding NameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Re-scan to apply. An empty pattern, or one whose tokens are all empty, falls back to the CAD type name."/>
                            <TextBlock Text="{Binding NameTokenHint}" Margin="0,3,0,0" FontSize="10"
                                       FontFamily="Consolas" Foreground="{StaticResource BrushTextTertiary}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Folder: link | import \ plan | section | drafting | no_views \ file.dwg"
                                       Margin="0,7,0,0" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="After export" Style="{StaticResource ScopeLabel}" ToolTip="Whether to offer deleting successfully-exported rows from the model"/>
                                <RadioButton GroupName="DeleteAfterExport" Style="{StaticResource ChipToggle}"
                                             Content="Ask" Margin="0,0,4,0"
                                             IsChecked="{Binding DeleteAfterExportMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Ask, Mode=OneWay}"
                                             Command="{Binding SetDeleteAfterExportModeCommand}" CommandParameter="Ask"
                                             ToolTip="Ask every time a run exports at least one row (default)"/>
                                <RadioButton GroupName="DeleteAfterExport" Style="{StaticResource ChipToggle}"
                                             Content="Always" Margin="0,0,4,0"
                                             IsChecked="{Binding DeleteAfterExportMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Always, Mode=OneWay}"
                                             Command="{Binding SetDeleteAfterExportModeCommand}" CommandParameter="Always"
                                             ToolTip="Delete every successfully-exported row without asking"/>
                                <RadioButton GroupName="DeleteAfterExport" Style="{StaticResource ChipToggle}"
                                             Content="Never" Margin="0,0,0,0"
                                             IsChecked="{Binding DeleteAfterExportMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Never, Mode=OneWay}"
                                             Command="{Binding SetDeleteAfterExportModeCommand}" CommandParameter="Never"
                                             ToolTip="Never offer to delete; exported rows are always left in the model"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Scanned DWG grid ── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                    <StackPanel Margin="12,10,12,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock Text="Scanned DWG Instances" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GridSummaryText}" Margin="8,0,0,0" FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Toolbar: filter · Select All · Select None · Collapse All · Refresh -->
                        <DockPanel Margin="0,0,0,6"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                            <Button DockPanel.Dock="Right" Content="↻ Refresh" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding ScanCommand}" Margin="6,0,0,0"
                                    ToolTip="Re-scan with the ticked scope (clears the ticks)"/>
                            <Button x:Name="CollapseAllButton" DockPanel.Dock="Right" Content="⊟ Collapse All"
                                    Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                    Click="CollapseAll_Click" ToolTip="Collapse or expand every group"/>
                            <Button DockPanel.Dock="Right" Content="☐ Select None" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SelectNoneShownCommand}" Margin="6,0,0,0"
                                    ToolTip="Untick every row shown by the filter"/>
                            <Button DockPanel.Dock="Right" Content="☑ Select All" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SelectAllShownCommand}" Margin="6,0,0,0"
                                    ToolTip="Tick every row shown by the filter"/>
                            <Grid>
                                <TextBox x:Name="FilterBox" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="25" Height="26" Padding="22,3,6,3" VerticalContentAlignment="Center" FontSize="11.5"
                                         ToolTip="Filter by name, view, sheet, file, element ID or status (every word must match)"/>
                                <TextBlock Text="🔍" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Foreground="{StaticResource BrushTextTertiary}"/>
                                <TextBlock Text="Filter by name, view, sheet…" Margin="24,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Foreground="{StaticResource BrushTextTertiary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>

                        <DataGrid x:Name="RowsGrid" MinHeight="180"
                                  shell:ShellBehaviors.MaxHeightRatio="0.42"
                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                  ItemsSource="{Binding RowsView}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="True" CanUserReorderColumns="False"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  Sorting="RowsGrid_Sorting"
                                  PreviewKeyDown="RowsGrid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <!-- Tick -->
                                <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False"
                                                        HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox IsThreeState="True" Focusable="False" HorizontalAlignment="Center"
                                                  IsChecked="{Binding DataContext.ShownTickState, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBoolConverter}}"
                                                  Click="HeaderTick_Click"
                                                  ToolTip="Tick or untick every row shown by the filter"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBoolConverter}}"
                                                      PreviewMouseLeftButtonDown="RowTick_PreviewMouseLeftButtonDown"
                                                      ToolTip="Tick to export this DWG"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTipService.InitialShowDelay="350">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding}"
                                                             ContentTemplate="{StaticResource PathTooltipTemplate}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Source pill -->
                                <DataGridTemplateColumn Header="Source" Width="72" SortMemberPath="SourceOrder">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="7,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{StaticResource BrushStatusInfoSoft}">
                                                <TextBlock x:Name="Pill" Text="{Binding SourceGroup}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushStatusInfo}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SourceGroup}" Value="Import">
                                                    <Setter TargetName="Pill" Property="Foreground" Value="{StaticResource BrushPillTypeText}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="View Type" Width="80" SortMemberPath="ViewOrder" Binding="{Binding ViewGroup}"/>

                                <!-- V004: layers the instance brings into the model. "1" means the
                                     DWG was already flattened when it came in, which is the real
                                     cause when an export comes out on a single layer. -->
                                <DataGridTemplateColumn Header="Layers" Width="62" SortMemberPath="LayerCount"
                                                        HeaderStyle="{StaticResource RightHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="LayerCell" Text="{Binding LayerText}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       ToolTip="Layer subcategories this CAD instance brings into the model. 1 means it was already flattened on import — no export setting can bring its layers back. ? means the count could not be read."/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding LayersSuspicious}" Value="True">
                                                    <Setter TargetName="LayerCell" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                                                    <Setter TargetName="LayerCell" Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Host View" Width="1.5*" SortMemberPath="HostView" Binding="{Binding HostView}"/>
                                <DataGridTextColumn Header="Sheet" Width="1.4*" SortMemberPath="Sheet" Binding="{Binding Sheet}"/>
                                <DataGridTemplateColumn Header="Output File" Width="1.7*"
                                                        SortMemberPath="OutputFileName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OutputFileName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTipService.InitialShowDelay="350">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding}"
                                                             ContentTemplate="{StaticResource PathTooltipTemplate}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Element ID" Width="88" SortMemberPath="ElementIdValue"
                                                    Binding="{Binding ElementIdValue}"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    ElementStyle="{StaticResource RightCellText}"/>

                                <!-- Status -->
                                <DataGridTemplateColumn Header="Status" Width="1.4*" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       ToolTip="{Binding StatusNote}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Exported">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Issue">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Exporting">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Deleted">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Converted">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushPillTypeText}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Relinked">
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Click a column header to sort (inside the groups). Space ticks the highlighted rows. The checkbox on a group header ticks/unticks every row in that group."
                                   Margin="0,5,0,0" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ── Last export (V004) ──
                     Keeps the exported-file list, its five-file Open and the per-row actions
                     reachable after the review dialog has been dismissed. Hidden until a run has
                     written at least one DWG. -->
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8"
                        Visibility="{Binding HasLastExport, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="True" Margin="12,10">
                        <Button DockPanel.Dock="Right" Content="Open output folder"
                                Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                Command="{Binding OpenOutputFolderCommand}"
                                ToolTip="Open the output folder in Explorer"/>
                        <Button DockPanel.Dock="Right" Content="Review / open files…"
                                Style="{StaticResource SmallSecondaryButton}"
                                Command="{Binding ReviewLastExportCommand}"
                                ToolTip="Reopen the review over the last run — per-row Keep / Delete / Convert / Re-link, and open up to 5 of the exported files"/>
                        <StackPanel>
                            <TextBlock Text="LAST EXPORT" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding LastExportSummary}" Style="{StaticResource StatusText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── Log ── -->
                <Border CornerRadius="6" Background="{StaticResource BrushLogBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="6,6,0,0" Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushLogText}">
                                    <Run Text="Log"/>
                                    <Run Text="{Binding LogEntries.Count, Mode=OneWay}"
                                         Foreground="{StaticResource BrushLogTextDim}"/>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy All"
                                            Style="{StaticResource DarkGhostButton}"
                                            Command="{Binding CopyLogCommand}"
                                            Margin="0,0,4,0"
                                            ToolTip="Copy all log entries to the clipboard"/>
                                    <Button Content="Copy Selected"
                                            Style="{StaticResource DarkGhostButton}"
                                            Click="CopySelectedLog_Click"
                                            ToolTip="Copy selected log entries to the clipboard"/>
                                    <Button Content="Export Log"
                                            Style="{StaticResource DarkGhostButton}"
                                            Margin="6,0,0,0"
                                            Click="ExportLog_Click"
                                            ToolTip="Save the log to a .txt file"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="LogList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding LogEntries}"
                                 MinHeight="120"
                                 shell:ShellBehaviors.MaxHeightRatio="0.25"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0" Padding="6,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                               Text="{Binding Mode=OneWay}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER — progress bars + buttons ═══════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel>
                <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderDefault}"
                        BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding Phases}" ItemTemplate="{StaticResource PhaseTemplate}"/>
                </Border>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Reset"
                            Style="{StaticResource OutlineButton}"
                            Command="{Binding ResetCommand}"
                            Width="80" Height="38"
                            ToolTip="Untick the scope, clear the list and the progress bars"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- V004: dry run. Reports what an export would do, writes nothing. -->
                        <Button Content="Check"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding CheckCommand}"
                                Width="80" Height="38" Margin="0,0,8,0"
                                ToolTip="Dry run — report what would be written, skipped or fail, with each full destination path. Writes nothing."/>
                        <Button Content="{Binding ExportButtonText}"
                                Style="{StaticResource RunButton}"
                                Command="{Binding ExportCommand}"
                                MinWidth="110" Height="38" Margin="0,0,8,0"
                                ToolTip="Export the ticked DWGs to the output folder"/>
                        <Button Content="Close"
                                Style="{StaticResource OutlineButton}"
                                Width="80" Height="38"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>

    </shell:ToolWindowShell>
</Window>
