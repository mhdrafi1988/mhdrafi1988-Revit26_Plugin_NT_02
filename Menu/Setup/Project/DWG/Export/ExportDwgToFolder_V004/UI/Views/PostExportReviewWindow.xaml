<!--
═══════════════════════════════════════════════════════════════════════════════
File: PostExportReviewWindow.xaml  (Export DWG to Folder v4.0.0, build V004)

NEW in V004. The post-export review: one row per successfully-exported CAD
instance, each with its own Keep / Delete from model / Convert to import action,
plus an Open tick capped at five files.

Replaces V002/V003's three-command-link Revit TaskDialog, which could only
offer "all imports", "all links" or "everything".

This window is MODAL (ShowDialog) — deliberately. CLAUDE.md's convention of
modeless Show() is about *tool* windows; this is a confirmation dialog hanging
off one, and the export run is finished before it appears.

Styling: Shared/SharedStyles.xaml only — no inline colours (CLAUDE.md).
Layout: shell header (metric tiles) / body (grid) / footer (Apply, Open).
═══════════════════════════════════════════════════════════════════════════════
-->
<Window x:Class="Revit26_Plugin_Revised.ExportDwgToFolder.V004.UI.Views.PostExportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:vm="clr-namespace:Revit26_Plugin_Revised.ExportDwgToFolder.V004.UI.ViewModels"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="Review exported CAD"
        Width="1000" Height="640"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters are instantiated in the consuming window, never in
                 SharedStyles.xaml (see Shared/Converters.cs's own header).

                 NOTE on the xmlns declarations above: none of them carry
                 ";assembly=Revit26_Plugin_Revised", matching ExportDwgToFolderWindow.xaml.
                 UI_UX_PATTERNS.md documents the assembly-qualified form, but the
                 windows that actually build in this repo do not use it — and
                 naming this project's own assembly sends the file to
                 MarkupCompilePass1, before the temporary assembly exists, so
                 every in-project type in the file fails with "does not exist in
                 the namespace" (ToolWindowShell, ShellBehaviors, ToolCatalog and
                 the converters alike). Leave these unqualified. -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <Style x:Key="RightHeader" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource StandardDataGridColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource StandardDataGridColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="RightCellText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>

            <!-- The same rich path tooltip the main grid uses.
                 It is a DataTemplate, not a Style setter holding a Border: a
                 complex value in a Style setter is ONE instance shared by every
                 element using that style, and WPF throws "Specified element is
                 already the logical child of another element" as soon as a
                 second cell tries to show it. Declared per cell inside a
                 DataTemplate, each row gets its own. -->
            <DataTemplate x:Key="PathTooltipTemplate" DataType="{x:Type vm:PostExportRowViewModel}">
                        <Border Background="{DynamicResource BrushSurfaceCard}"
                                BorderBrush="{DynamicResource BrushNavyLight}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8"
                                MaxWidth="560">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Output"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                           Text="{Binding OutputFileName}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyText}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Saved to"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                           Text="{Binding DestinationPath}" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Source"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                           Text="{Binding SourceDescription}" TextWrapping="Wrap"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Host view"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                           Text="{Binding HostView}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyText}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Element ID"
                                           Style="{StaticResource MetricTileLabel}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding ElementIdValue}"
                                           FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Grid>
                        </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Review exported CAD"
                           Subtitle="{Binding HeaderText}"
                           Version="{Binding Source={x:Static svc:ToolCatalog.ExportDwgToFolder}, Path=Version, StringFormat=v{0}}"
                           SummaryText="{Binding ApplyNote}">

        <!-- ═══ HEADER — action tiles ═══════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Rows="1">
                <Border Style="{StaticResource MetricTileInfo}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="EXPORTED" Style="{StaticResource MetricTileLabelInfo}"/>
                        <TextBlock Text="{Binding ExportedCount}" Style="{StaticResource MetricTileNumberInfo}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileDanger}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="DELETE" Style="{StaticResource MetricTileLabelDanger}"/>
                        <TextBlock Text="{Binding DeleteCount}" Style="{StaticResource MetricTileNumberDanger}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileWarning}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="CONVERT TO IMPORT" Style="{StaticResource MetricTileLabelWarning}"/>
                        <TextBlock Text="{Binding ConvertCount}" Style="{StaticResource MetricTileNumberWarning}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileInfo}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="RE-LINK TO EXPORT" Style="{StaticResource MetricTileLabelInfo}"/>
                        <TextBlock Text="{Binding RelinkCount}" Style="{StaticResource MetricTileNumberInfo}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileSuccess}">
                    <StackPanel>
                        <TextBlock Text="KEEP" Style="{StaticResource MetricTileLabelSuccess}"/>
                        <TextBlock Text="{Binding KeepCount}" Style="{StaticResource MetricTileNumberSuccess}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY — the review grid ══════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="12,10,12,0">
                            <TextBlock DockPanel.Dock="Left" Text="EXPORTED FILES"
                                       Style="{StaticResource SectionTitle}" Margin="0,0,10,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OpenCountText}"
                                       Style="{StaticResource StatusText}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel LastChildFill="False" Margin="12,4,12,8">
                            <Button DockPanel.Dock="Left" Content="All → Keep" Margin="0,0,6,0"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SetAllKeepCommand}"
                                    ToolTip="Leave every exported CAD instance in the model"/>
                            <Button DockPanel.Dock="Left" Content="All → Delete" Margin="0,0,6,0"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SetAllDeleteCommand}"
                                    ToolTip="Delete every exported CAD instance from the model"/>
                            <Button DockPanel.Dock="Left" Content="All → Convert (links only)" Margin="0,0,6,0"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SetAllConvertCommand}"
                                    ToolTip="Replace every exported link with an import of the same file. Rows that cannot be converted keep their current action."/>
                            <Button DockPanel.Dock="Left" Content="All → Link to exported"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SetAllRelinkCommand}"
                                    ToolTip="Replace every row with a CAD link to the DWG just exported for it. For an import this shrinks the model and leaves the CAD editable outside Revit."/>
                            <Button DockPanel.Dock="Right" Content="Open output folder"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding OpenOutputFolderCommand}"/>
                        </DockPanel>

                        <DataGrid x:Name="ReviewGrid" Margin="12,0,12,0" MinHeight="180"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  shell:ShellBehaviors.MaxHeightRatio="0.45"
                                  shell:ShellBehaviors.ForwardMouseWheel="True">
                            <DataGrid.Columns>

                                <!-- Open tick — the five-file cap is enforced in the ViewModel,
                                     which reverts a sixth tick rather than truncating later. -->
                                <DataGridTemplateColumn Header="Open" Width="48" CanUserSort="False"
                                                        HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsOpenSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Open this DWG after applying (up to 5 files)"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTipService.InitialShowDelay="350">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding}"
                                                             ContentTemplate="{StaticResource PathTooltipTemplate}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Source" Width="72" SortMemberPath="SourceGroup">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgePill}"
                                                    Background="{DynamicResource BrushStatusInfoSoft}"
                                                    Padding="7,2" HorizontalAlignment="Left">
                                                <TextBlock x:Name="Pill" Text="{Binding SourceGroup}"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushStatusInfo}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SourceGroup}" Value="Import">
                                                    <Setter TargetName="Pill" Property="Foreground"
                                                            Value="{DynamicResource BrushPillTypeText}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Host View" Width="1.3*" Binding="{Binding HostView}"/>

                                <DataGridTemplateColumn Header="Output File" Width="1.7*"
                                                        SortMemberPath="OutputFileName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OutputFileName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTipService.InitialShowDelay="350">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding}"
                                                             ContentTemplate="{StaticResource PathTooltipTemplate}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Element ID" Width="88"
                                                    Binding="{Binding ElementIdValue}"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    ElementStyle="{StaticResource RightCellText}"/>

                                <!-- Action. Convert is simply absent from Choices on a row that
                                     cannot be converted; the tooltip says why. -->
                                <DataGridTemplateColumn Header="Action" Width="218" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource StandardComboBox}"
                                                      Height="26" Margin="0,1"
                                                      ItemsSource="{Binding Choices}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                      ToolTip="{Binding ActionHint}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Result" Width="1.6*" SortMemberPath="ResultText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ResultText}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           ToolTip="{Binding ResultText}"/>
                                                <Button Content="Show" Margin="6,0,0,0"
                                                        Style="{StaticResource SmallSecondaryButton}"
                                                        Command="{Binding DataContext.ShowInFolderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Show this file in Explorer"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- The refused-sixth-tick note. -->
                        <Border Margin="12,8,12,0" Padding="9,6" CornerRadius="7"
                                Background="{DynamicResource BrushStatusWarnSoft}"
                                BorderBrush="{DynamicResource BrushStatusWarnBorder}"
                                BorderThickness="1"
                                Visibility="{Binding ShowOpenLimitNote, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource BrushStatusWarn}"
                                       Text="Open is limited to 5 files at a time — untick one first. Every exported file stays listed."/>
                        </Border>

                        <Border Margin="12,8,12,12" Padding="9,6" CornerRadius="7"
                                Background="{DynamicResource BrushStatusWarnSoft}"
                                BorderBrush="{DynamicResource BrushStatusWarnBorder}"
                                BorderThickness="1">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource BrushStatusWarn}"
                                       Text="Both conversions delete the instance and recreate it — Revit has no API for Manage Links' Import button. Per-view graphic and layer overrides do not carry over, anything dimensioned to the CAD will stop that one row, and the element ID changes; each is named in the log. Replace with link to exported file is the safer direction, since that DWG was written from this instance and lands in the right place. Everything applied here is one undo step."/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ══════════════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Skip all"
                        Style="{StaticResource OutlineButton}"
                        Command="{Binding SkipAllCommand}"
                        ToolTip="Leave every exported CAD instance in the model and close"/>
                <Button DockPanel.Dock="Right" Content="Close"
                        Style="{StaticResource OutlineButton}" Margin="6,0,0,0"
                        Click="CloseButton_Click"/>
                <Button DockPanel.Dock="Right" Content="{Binding OpenButtonText}"
                        Style="{StaticResource OutlineButton}" Margin="6,0,0,0"
                        Command="{Binding OpenSelectedFilesCommand}"/>
                <Button DockPanel.Dock="Right" Content="Apply to model"
                        Style="{StaticResource RunButton}"
                        Command="{Binding ApplyCommand}"/>
            </DockPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
