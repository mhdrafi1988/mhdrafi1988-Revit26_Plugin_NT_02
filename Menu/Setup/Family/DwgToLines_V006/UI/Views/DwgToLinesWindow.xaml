<!--
=======================================================
File: DwgToLinesWindow.xaml
Location: UI/Views/
Changes vs V005 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three zones: fixed top (title bar + version pill, metrics card with
    CAD imports found / log entries), scrolling middle (CAD picker,
    Placement Mode, Spline Handling, Extrusion-ready), fixed footer
    (always-visible activity log with Copy All / Copy Selected / Export,
    Convert DWG → Close).
  - Was: log in a collapsed Expander, Close before Convert.
  - No behaviour change — every binding/command is the V005 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.DwgToLines.V006.UI.Views.DwgToLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.DwgToLines.V006.Infrastructure.Helpers"
        Title="DWG to Lines — V006"
        Width="560" Height="640"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:BooleanToEnumConverter x:Key="BoolToEnum"/>
            <shared:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemSecondaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════ TOP ══════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DWG to Lines" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Convert CAD import to Symbolic / Model lines (Family Editor)" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V006" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="2" Margin="14,12,14,0">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="CAD Imports" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding AvailableCads.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Log Entries" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding LogEntries.Count}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ══════════════ MIDDLE ══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,8">
            <StackPanel>
                <!-- ── CAD import picker ── -->
                <StackPanel>
                    <TextBlock Text="CAD Import" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBox}" Height="32"
                              ItemsSource="{Binding AvailableCads}"
                              SelectedItem="{Binding SelectedCad, Mode=TwoWay}"/>
                </StackPanel>
                <!-- ── Placement mode ── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,10,0,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="Placement Mode" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Symbolic Only" Margin="0,0,18,0"
                                         IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=SymbolicOnly}"/>
                            <RadioButton Content="Model Only" Margin="0,0,18,0"
                                         IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=ModelOnly}"/>
                            <RadioButton Content="Symbolic + Model"
                                         IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=SymbolicAndModel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- ── Spline handling ── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,8,0,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="Spline Handling" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Preserve Splines" Margin="0,0,18,0"
                                         IsChecked="{Binding SplineHandlingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Preserve}"/>
                            <RadioButton Content="Tessellate"
                                         IsChecked="{Binding SplineHandlingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Tessellate}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- ── Extrusion-ready mode ── -->
                <CheckBox Margin="0,10,0,0"
                          Content="Extrusion-ready mode (snap endpoints, detect loops)"
                          IsChecked="{Binding ExtrusionReadyMode}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════ FOOTER ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel>
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                                <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}" FontSize="11.5" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding CopyAllLogsCommand}" ToolTip="Copy the whole log to the clipboard"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding CopySelectedLogsCommand}" ToolTip="Copy the selected log lines"/>
                                <Button Content="Export" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ExportLogCommand}" ToolTip="Save the log to a .txt file"/>
                            </StackPanel>
                        </Grid>
                        <Grid Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1">
                            <ListBox x:Name="LogList"
                                     ItemsSource="{Binding LogEntries}"
                                     SelectionMode="Extended"
                                     SelectionChanged="LogList_SelectionChanged"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Padding="0"
                                     Height="110">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0,1"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                       Foreground="{StaticResource BrushLogTextDim}"
                                                       FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                                       FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Convert DWG" Style="{StaticResource RunButton}" Width="130" Margin="0,0,8,0"
                                Command="{Binding ConvertCommand}"/>
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" Width="90"
                                Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
