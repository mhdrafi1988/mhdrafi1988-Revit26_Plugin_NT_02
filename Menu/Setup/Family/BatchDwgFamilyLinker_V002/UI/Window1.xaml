<!--
=======================================================
File: Window1.xaml (BatchLinkWindow)
UI standard v4.0 (layout only, no behaviour change):
  - Window content is the shared ToolWindowShell:
      HEADER  title / subtitle / version (ToolCatalog) + metric tiles
      BODY    folder inputs + placement mode card, live log (moved here
              from the footer)
      FOOTER  status strip (progress %) · batch progress bar ·
              Start Batch → Close
  - x:Names (LogToggle, LiveLogBox) and handlers unchanged.
Previous: three-zone layout on SharedStyles (vs the "_WOrking" build).
=======================================================
-->
<Window x:Class="BatchDwgFamilyLinker.V002.UI.BatchLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        Title="{Binding Source={x:Static svc:ToolCatalog.BatchDwgFamilyLinker}, Path=Title}"
        Height="650" Width="950"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushSurfaceWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Batch DWG → Revit Family Linker"
                           Subtitle="Link AutoCAD files into multiple Revit families safely"
                           Version="{Binding Source={x:Static svc:ToolCatalog.BatchDwgFamilyLinker}, Path=Version, StringFormat=v{0}}"
                           SummaryText="{Binding ProgressPercentText}">

        <!-- ═══ HEADER ═══ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Total Families" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalFamilies}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Processed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ProcessedCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failures" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═══ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Border Style="{StaticResource ContentCard}" Padding="12" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Revit Family Folder" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse" Width="90" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseFamilyFolderCommand}"/>
                            <TextBox Text="{Binding FamilyFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BoxedTextInput}"
                                     ToolTip="Paste or type full folder path"
                                     VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                        </DockPanel>

                        <TextBlock Text="AutoCAD DWG Folder" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse" Width="90" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseDwgFolderCommand}"/>
                            <TextBox Text="{Binding DwgFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BoxedTextInput}"
                                     ToolTip="Paste or type full folder path"
                                     VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                        </DockPanel>

                        <TextBlock Text="DWG Placement Mode" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Origin to Origin" IsChecked="{Binding IsOriginToOrigin}" Margin="0,4,20,4"/>
                            <RadioButton Content="Center to Center" IsChecked="{Binding IsCenterToCenter}" Margin="0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Live log -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                                <TextBlock Text="Live Processing Log" Foreground="{StaticResource BrushLogText}"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LiveLogBox" Text="{Binding LiveLog}" Height="120"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource BrushLogText}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Batch progress (the VM has no running flag, so it stays visible) -->
                <ProgressBar Height="6" Minimum="0" Maximum="{Binding TotalFamilies}" Value="{Binding ProcessedCount}"
                             Foreground="{StaticResource BrushAppleBlue}" Background="{StaticResource BrushSeparatorThin}"
                             BorderThickness="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Start Batch" Style="{StaticResource RunButton}" Margin="0,0,8,0"
                            Command="{Binding StartBatchCommand}" IsEnabled="{Binding CanStart}"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
