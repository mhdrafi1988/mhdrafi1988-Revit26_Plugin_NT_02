<!--
=======================================================
File: DwgToLinesWindow.xaml
Location: UI/Views/
Changes vs V006 (layout only, per CLAUDE.md v1.1 — ToolWindowShell):
  - Window content is a shared ToolWindowShell:
      HEADER  title bar + V007, metrics card
      BODY    CAD picker, Placement Mode, Spline Handling, Extrusion-ready,
              Activity Log (moved here from the footer); the middle's own
              ScrollViewer removed
      FOOTER  status strip (IsRunning / Progress / SummaryText),
              Convert DWG → Close
  - Log: ShellBehaviors.MaxHeightRatio + ForwardMouseWheel.
  - No behaviour change — every binding/command is the V006 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.DwgToLines.V007.UI.Views.DwgToLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:shared="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.DwgToLines.V007.Infrastructure.Helpers"
        Title="{Binding Source={x:Static svc:ToolCatalog.DwgToLines}, Path=Title}"
        Width="560" Height="640"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:BooleanToEnumConverter x:Key="BoolToEnum"/>
            <shared:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="DWG to Lines"
                           Subtitle="Convert CAD import to Symbolic / Model lines (Family Editor)"
                           Version="{Binding Source={x:Static svc:ToolCatalog.DwgToLines}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="CAD Imports" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding AvailableCads.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Log Entries" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding LogEntries.Count}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- ── CAD import picker ── -->
                <StackPanel>
                    <TextBlock Text="CAD Import" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBox}" Height="32"
                              ItemsSource="{Binding AvailableCads}"
                              SelectedItem="{Binding SelectedCad, Mode=TwoWay}"/>
                </StackPanel>
                <!-- ── Placement mode ── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,10,0,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="Placement Mode" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Symbolic Only" Margin="0,0,18,0"
                                         IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=SymbolicOnly}"/>
                            <RadioButton Content="Model Only" Margin="0,0,18,0"
                                         IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=ModelOnly}"/>
                            <RadioButton Content="Symbolic + Model"
                                         IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=SymbolicAndModel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- ── Spline handling ── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,8,0,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="Spline Handling" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Preserve Splines" Margin="0,0,18,0"
                                         IsChecked="{Binding SplineHandlingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Preserve}"/>
                            <RadioButton Content="Tessellate"
                                         IsChecked="{Binding SplineHandlingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Tessellate}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- ── Extrusion-ready mode ── -->
                <CheckBox Margin="0,10,0,0"
                          Content="Extrusion-ready mode (snap endpoints, detect loops)"
                          IsChecked="{Binding ExtrusionReadyMode}"/>

                <!-- ── Activity Log (moved from footer) ── -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding CopyAllLogsCommand}" ToolTip="Copy the whole log to the clipboard"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding CopySelectedLogsCommand}" ToolTip="Copy the selected log lines"/>
                                <Button Content="Export" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ExportLogCommand}" ToolTip="Save the log to a .txt file"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="LogList"
                                     ItemsSource="{Binding LogEntries}"
                                     SelectionMode="Extended"
                                     SelectionChanged="LogList_SelectionChanged"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Padding="0"
                                     MinHeight="110"
                                     shell:ShellBehaviors.MaxHeightRatio="0.2"
                                     shell:ShellBehaviors.ForwardMouseWheel="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0,1"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                       Foreground="{StaticResource BrushLogTextDim}"
                                                       FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                                       FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Convert DWG" Style="{StaticResource PrimaryButton}" Width="130" Margin="0,0,8,0"
                        Command="{Binding ConvertCommand}"/>
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Width="90"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
