<!--
=======================================================
File: AutoSlopeByDrainWindow.xaml  (V013, ToolWindowShell — CLAUDE.md v1.1)
Layout follows AutoSlopeByPoint V032, adapted to several roofs:
  HEADER  state / roofs / plan-view badges + 6 tiles (MetricTile styles):
          Drains selected (of detected) · Processed · Skipped · Highest ·
          Longest · Run time (start → end)
  BODY    left:   "Every run" card (slope · max path distance) + three option
                  sections, closed by default, each header showing its values
                  and a "Custom" tag: Path & curves · Circle markers · Export
          right:  two stacked expanders. "Detected drains" (open): roof tabs
                  (status pill per tab) with the drains grid. Below it, results for
                  the selected roof (closed by default): Longest 10
                  (PathLength_m · SlopePercent · ElevCalc_mm) / Skipped
          below:  Processing log (closed by default, LogHeaderToggle)
  FOOTER  shell status strip; Open export folder left; Cancel · Run · Close right
Rules followed: no ScrollViewer in tool content (grids/log use ShellBehaviors),
no inline colours, root brush via DynamicResource, converters declared here.
Changes vs V012: window 1280×820 (min 1100×640; V012's minimum height of
960 did not fit a 1366×768 screen); X/Y in metres; Run available after a run.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.MultiRoofSlopeByDrain.V013.UI.Views.AutoSlopeByDrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.MultiRoofSlopeByDrain.V013.UI.Views"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static svc:ToolCatalog.MultiRoofSlopeByDrainV013}, Path=Title}"
        Width="1280" Height="820"
        MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSurfaceWindow}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters: declared here, never in SharedStyles.xaml -->
            <shared:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
            <shared:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <shared:LogLevelToColorConverter         x:Key="LogLevelToColor"/>
            <shared:EnumToBoolConverter              x:Key="EnumToBool"/>
            <local:NonEmptyToVisibilityConverter     x:Key="NonEmptyToVisibility"/>
            <local:ColorNameToBrushConverter         x:Key="ColorNameToBrush"/>

            <!-- ── Text helpers ───────────────────────────────────── -->
            <Style x:Key="FieldError" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NonEmptyToVisibility}}"/>
            </Style>
            <Style x:Key="CalcHint" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                <Setter Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="SectionHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SectionSummaryText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,6,0"/>
            </Style>
            <Style x:Key="OptionsTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                <Setter Property="Margin" Value="2,2,0,6"/>
            </Style>
            <Style x:Key="ToggleLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <!-- "Custom" tag on a section header -->
            <Style x:Key="CustomTag" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="CustomTagText" TargetType="TextBlock">
                <Setter Property="Text" Value="Custom"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
            </Style>

            <!-- Small text button ("Reset to defaults") -->
            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <!-- ── Badges ─────────────────────────────────────────── -->
            <Style x:Key="StateBadge" TargetType="Border" BasedOn="{StaticResource BadgePill}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Running">
                        <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                        <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Cancelled">
                        <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StateBadgeText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Running">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Cancelled">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ViewBadge" TargetType="Border" BasedOn="{StaticResource BadgePill}">
                <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushStatusWarnBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlanView}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ViewBadgeText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                <Setter Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlanView}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="WarnLine" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushStatusWarnBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,3"/>
            </Style>

            <!-- Roof tab status pill (DataContext = RoofTabViewModel) -->
            <Style x:Key="TabPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="Done">
                        <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="Running">
                        <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="RolledBack">
                        <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="Failed">
                        <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="NoDrains">
                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="Skipped">
                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TabPillText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="Done">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="Running">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="RolledBack">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="Failed">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="NoDrains">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DisplayStatus}" Value="Skipped">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- ── Option section (card expander, closed by default) ── -->
            <Style x:Key="CardExpander" TargetType="Expander">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0" Padding="12,9" Cursor="Hand"
                                              HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="▾" FontSize="12"
                                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                                    </DockPanel>
                                </ToggleButton>
                                <StackPanel x:Name="BodyHost" Visibility="Collapsed">
                                    <Border Style="{StaticResource SeparatorLine}" Margin="0"/>
                                    <ContentPresenter/>
                                </StackPanel>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="BodyHost" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Chevron" Property="Text" Value="▴"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Colour combo item: swatch + name -->
            <DataTemplate x:Key="ColorItemTemplate">
                <StackPanel Orientation="Horizontal">
                    <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0"
                            BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                            Background="{Binding Converter={StaticResource ColorNameToBrush}}"/>
                    <TextBlock Text="{Binding}"/>
                </StackPanel>
            </DataTemplate>

            <!-- ── Detected-drains grid: group header with All / None (from V010) ── -->
            <Style x:Key="DrainGroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Expander x:Name="PART_DrainGroupExpander" Margin="0,2,0,0"
                                      Loaded="DrainGroupExpander_Loaded"
                                      Expanded="DrainGroupExpander_ExpandedOrCollapsed"
                                      Collapsed="DrainGroupExpander_ExpandedOrCollapsed">
                                <Expander.Header>
                                    <DockPanel LastChildFill="False" Background="{StaticResource BrushSystemTertiaryBackground}" MinWidth="360">
                                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="4,3">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text="("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                                            <Button Content="All" Style="{StaticResource SmallSecondaryButton}" Height="22" Margin="0,0,3,0"
                                                    Command="{Binding DataContext.SelectAllInGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Name}"/>
                                            <Button Content="None" Style="{StaticResource SmallSecondaryButton}" Height="22"
                                                    Command="{Binding DataContext.SelectNoneInGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Name}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <ItemsPresenter/>
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Results grid: Excel-like (mirrors the "Vertex Data" sheet) ── -->
            <Style x:Key="ResultsCell" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="Padding" Value="4,0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ResultsRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTop}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CalcHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
            </Style>
            <Style x:Key="NumText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RowNumText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ResultsGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushSeparator}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BrushSeparator}"/>
                <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowHeight" Value="24"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
                <Setter Property="CellStyle" Value="{StaticResource ResultsCell}"/>
                <Setter Property="RowStyle" Value="{StaticResource ResultsRow}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="{Binding ToolTitle}"
                           Subtitle="{Binding SubtitleText}"
                           Version="{Binding VersionText}"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding Progress}"
                           IsIndeterminate="{Binding IsIndeterminate}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource StateBadge}" Margin="0,0,6,4">
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource StateBadgeText}"/>
                    </Border>
                    <Border Style="{StaticResource BadgePill}" Margin="0,0,6,4">
                        <TextBlock Text="{Binding RoofsBadgeText}" Style="{StaticResource BadgeText}"/>
                    </Border>
                    <Border Style="{StaticResource ViewBadge}" Margin="0,0,6,4">
                        <TextBlock Text="{Binding ViewBadgeText}" Style="{StaticResource ViewBadgeText}"/>
                    </Border>
                </WrapPanel>

                <UniformGrid Columns="6" Rows="1" Margin="0,0,0,6">
                    <Border Style="{StaticResource MetricTileInfo}" Margin="0,0,3,0">
                        <StackPanel>
                            <TextBlock Text="DRAINS SELECTED" Style="{StaticResource MetricTileLabelInfo}"/>
                            <TextBlock Text="{Binding AllSelectedDrainsCount}" Style="{StaticResource MetricTileNumberInfo}"/>
                            <TextBlock Text="{Binding DrainsSubText}" Style="{StaticResource HintText}" Margin="0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileSuccess}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="PROCESSED" Style="{StaticResource MetricTileLabelSuccess}"/>
                            <TextBlock Text="{Binding ProcessedText}" Style="{StaticResource MetricTileNumberSuccess}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileWarning}" Margin="3,0"
                            ToolTip="Points left at 0: no path to a drain, or a path longer than the max path distance. Drain points are not counted.">
                        <StackPanel>
                            <TextBlock Text="SKIPPED" Style="{StaticResource MetricTileLabelWarning}"/>
                            <TextBlock Text="{Binding SkippedText}" Style="{StaticResource MetricTileNumberWarning}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileInfo}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="HIGHEST ELEVATION" Style="{StaticResource MetricTileLabelInfo}"/>
                            <TextBlock Text="{Binding HighestText}" Style="{StaticResource MetricTileNumberInfo}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileInfo}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="LONGEST PATH" Style="{StaticResource MetricTileLabelInfo}"/>
                            <TextBlock Text="{Binding LongestPathText}" Style="{StaticResource MetricTileNumberInfo}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource BrushSurfaceCard}" Margin="3,0,0,0">
                        <StackPanel>
                            <TextBlock Text="RUN TIME" Style="{StaticResource MetricTileLabel}"/>
                            <TextBlock Text="{Binding RunTimeText}" Style="{StaticResource MetricTileNumber}"/>
                            <TextBlock Text="{Binding RunTimeSubText}" Style="{StaticResource HintText}" Margin="0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: inputs (locked while running) ── -->
                    <StackPanel Grid.Column="0" IsEnabled="{Binding IsInputEnabled}">

                        <!-- Every run -->
                        <Border Style="{StaticResource ContentCard}">
                            <StackPanel Margin="12,0,12,10">
                                <TextBlock Text="Every run · all roofs" Style="{StaticResource SectionTitle}" Margin="0,10,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Slope (%)" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding SlopeOptions}" IsEditable="True" IsTextSearchEnabled="False"
                                                  Text="{Binding SlopeText, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Pick a preset or type any value between 0.1 and 10 %."/>
                                        <TextBlock Text="{Binding SlopeHint}" Style="{StaticResource CalcHint}"/>
                                        <TextBlock Text="{Binding SlopeError}" Style="{StaticResource FieldError}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Max path distance (m)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource BorderlessTextInput}" MaxLength="8"
                                                 Text="{Binding MaxPathText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="A point whose total path to its nearest selected drain is longer than this stays at 0."/>
                                        <TextBlock Text="Longer paths stay at 0." Style="{StaticResource HintText}"/>
                                        <TextBlock Text="{Binding MaxPathError}" Style="{StaticResource FieldError}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource WarnLine}" Margin="0,10,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushStatusWarn}"
                                               Text="⚠ Run first resets every shape point on each roof to 0. Picking roofs no longer changes them, so closing without running leaves them as they were. Ctrl+Z undoes the whole run in one step."/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="OPTIONS · SET ONCE, KEPT BETWEEN SESSIONS" Style="{StaticResource OptionsTitle}"/>

                        <!-- Path & curves -->
                        <Border Style="{StaticResource ContentCard}">
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding PathOptionsExpanded}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Path &amp; curves" Style="{StaticResource SectionHeaderText}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PathOptionsSummary}" Style="{StaticResource SectionSummaryText}"
                                                   ToolTip="{Binding PathOptionsSummary}"/>
                                        <Border Grid.Column="2" Style="{StaticResource CustomTag}"
                                                Visibility="{Binding IsPathOptionsCustom, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CustomTagText}"/>
                                        </Border>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="12,8,12,10">
                                    <TextBlock Text="Max edge distance (m)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}" Width="90" HorizontalAlignment="Left" MaxLength="8"
                                             Text="{Binding MaxEdgeText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{Binding MaxEdgeError}" Style="{StaticResource FieldError}"/>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Points further apart than this are never linked directly. Shorter is faster on large roofs."/>

                                    <TextBlock Text="Path samples per edge" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}" Width="90" HorizontalAlignment="Left" MaxLength="3"
                                             Text="{Binding PathSamplesText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{Binding PathSamplesError}" Style="{StaticResource FieldError}"/>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Points checked along each link to make sure it stays on the roof. 5–20 is typical."/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Insert points where edges meet arcs" Style="{StaticResource ToggleLabel}"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource AppleToggleButton}" Margin="8,0,0,0"
                                                      IsChecked="{Binding InsertCurveIntersectionPoints}"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Path lengths follow a curved boundary or opening instead of its chord."/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Read heights back from the model after the run" Style="{StaticResource ToggleLabel}"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource AppleToggleButton}" Margin="8,0,0,0"
                                                      IsChecked="{Binding VerifyElevationsAfterCommit}"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Adds ElevModel / ElevDiff to the Excel workbook and warns in the log when Revit adjusted a point."/>

                                    <Button Content="Reset to defaults" Style="{StaticResource LinkButton}" Command="{Binding ResetPathOptionsCommand}"/>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Circle markers -->
                        <Border Style="{StaticResource ContentCard}">
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding MarkersExpanded}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Circle markers" Style="{StaticResource SectionHeaderText}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MarkersSummary}" Style="{StaticResource SectionSummaryText}"
                                                   ToolTip="{Binding MarkersSummary}"/>
                                        <Border Grid.Column="2" Style="{StaticResource CustomTag}"
                                                Visibility="{Binding IsMarkersCustom, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CustomTagText}"/>
                                        </Border>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="12,8,12,10">
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                               Text="Placed in the active view when it is a plan view; skipped with a warning otherwise."/>

                                    <!-- Drains -->
                                    <CheckBox IsChecked="{Binding DrainMarkerGroup.IsEnabled}">
                                        <TextBlock Text="Drains" Style="{StaticResource FieldValue}" FontWeight="SemiBold" FontSize="12.5"/>
                                    </CheckBox>
                                    <TextBlock Text="A circle on each selected drain opening." Style="{StaticResource HintText}" Margin="22,1,0,4"/>
                                    <Grid Margin="22,0,0,8" IsEnabled="{Binding DrainMarkerGroup.IsEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Line style" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding LineStyleOptions}" SelectedValuePath="Id" DisplayMemberPath="Name"
                                                      SelectedValue="{Binding DrainMarkerGroup.LineStyleId}" SelectionChanged="LineStyleCombo_SelectionChanged" Padding="3,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Colour" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding ColorPalette}" SelectedItem="{Binding DrainMarkerGroup.ColorName}"
                                                      ItemTemplate="{StaticResource ColorItemTemplate}" Padding="3,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Radius" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource BorderlessTextInput}" MaxLength="6"
                                                     Text="{Binding DrainMarkerGroup.RadiusMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,8"/>

                                    <!-- Highest point -->
                                    <CheckBox IsChecked="{Binding HighestPointMarkerGroup.IsEnabled}">
                                        <TextBlock Text="Highest point" Style="{StaticResource FieldValue}" FontWeight="SemiBold" FontSize="12.5"/>
                                    </CheckBox>
                                    <TextBlock Text="A circle on every point tied at the highest calculated elevation." Style="{StaticResource HintText}" Margin="22,1,0,4"/>
                                    <Grid Margin="22,0,0,4" IsEnabled="{Binding HighestPointMarkerGroup.IsEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Line style" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding LineStyleOptions}" SelectedValuePath="Id" DisplayMemberPath="Name"
                                                      SelectedValue="{Binding HighestPointMarkerGroup.LineStyleId}" SelectionChanged="LineStyleCombo_SelectionChanged" Padding="3,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Colour" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding ColorPalette}" SelectedItem="{Binding HighestPointMarkerGroup.ColorName}"
                                                      ItemTemplate="{StaticResource ColorItemTemplate}" Padding="3,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Radius" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource BorderlessTextInput}" MaxLength="6"
                                                     Text="{Binding HighestPointMarkerGroup.RadiusMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Margin="22,2,0,8" IsEnabled="{Binding HighestPointMarkerGroup.IsEnabled}"
                                              IsChecked="{Binding HighestPointMarkerGroup.ShowOffsetText}">
                                        <TextBlock Text="Add an “Offset: X mm” text note with a leader" Style="{StaticResource FieldValue}" FontSize="12"/>
                                    </CheckBox>

                                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,8"/>

                                    <!-- Allowed offset -->
                                    <CheckBox IsChecked="{Binding AllowedOffsetMarkerGroup.IsEnabled}">
                                        <TextBlock Text="Allowed offset" Style="{StaticResource FieldValue}" FontWeight="SemiBold" FontSize="12.5"/>
                                    </CheckBox>
                                    <TextBlock Text="A circle on every point at or above the threshold, except points already marked highest."
                                               Style="{StaticResource HintText}" Margin="22,1,0,4"/>
                                    <Grid Margin="22,0,0,4" IsEnabled="{Binding AllowedOffsetMarkerGroup.IsEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Line style" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding LineStyleOptions}" SelectedValuePath="Id" DisplayMemberPath="Name"
                                                      SelectedValue="{Binding AllowedOffsetMarkerGroup.LineStyleId}" SelectionChanged="LineStyleCombo_SelectionChanged" Padding="3,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Colour" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding ColorPalette}" SelectedItem="{Binding AllowedOffsetMarkerGroup.ColorName}"
                                                      ItemTemplate="{StaticResource ColorItemTemplate}" Padding="3,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Radius" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource BorderlessTextInput}" MaxLength="6"
                                                     Text="{Binding AllowedOffsetMarkerGroup.RadiusMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="22,2,0,0" IsEnabled="{Binding AllowedOffsetMarkerGroup.IsEnabled}">
                                        <TextBlock Text="Offset ≥" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Style="{StaticResource BorderlessTextInput}" Width="70" MaxLength="7"
                                                 Text="{Binding AllowedOffsetThresholdText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding MarkersError}" Style="{StaticResource FieldError}" Margin="0,6,0,0"/>
                                    <Button Content="Reset to defaults" Style="{StaticResource LinkButton}" Command="{Binding ResetMarkersCommand}"/>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Export & parameters -->
                        <Border Style="{StaticResource ContentCard}">
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding ExportExpanded}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Export &amp; parameters" Style="{StaticResource SectionHeaderText}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ExportSummary}" Style="{StaticResource SectionSummaryText}"
                                                   ToolTip="{Binding ExportFolderPath}"/>
                                        <Border Grid.Column="2" Style="{StaticResource CustomTag}"
                                                Visibility="{Binding IsExportCustom, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CustomTagText}"/>
                                        </Border>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="12,8,12,10">
                                    <TextBlock Text="Excel workbook for each roof, saved to" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource BorderlessTextInput}" IsReadOnly="True"
                                                 Text="{Binding ExportFolderPath, Mode=OneWay}" Foreground="{StaticResource BrushAppleBlue}"
                                                 ToolTip="{Binding ExportFolderPath}"/>
                                        <Button Grid.Column="2" Content="Browse…" Style="{StaticResource OutlineButton}"
                                                Command="{Binding BrowseFolderCommand}"/>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Also write a combined summary when several roofs run" Style="{StaticResource ToggleLabel}"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource AppleToggleButton}" Margin="8,0,0,0"
                                                      IsChecked="{Binding WriteCombinedSummary}"/>
                                    </Grid>
                                    <CheckBox Margin="0,8,0,0" IsChecked="{Binding AskToOpenAfterExport}">
                                        <TextBlock Text="Ask to open the export folder after a run" Style="{StaticResource FieldValue}" FontSize="12"/>
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                               Text="Each roof also gets its AutoSlope_* parameters (slope, distances, drains, highest point, status, tool version) when the roof type has them."/>
                                    <Button Content="Reset to defaults" Style="{StaticResource LinkButton}" Command="{Binding ResetExportCommand}"/>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>

                    <!-- ── RIGHT: two stacked sections. Detected drains (open) above Longest 10 / Skipped (closed) ── -->
                    <StackPanel Grid.Column="2">

                    <!-- Area 1: roof tabs with the detected-drains grid -->
                    <Border Style="{StaticResource ContentCard}">
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Detected drains" Style="{StaticResource SectionHeaderText}"/>
                    </Expander.Header>
                    <TabControl VerticalAlignment="Top"
                                ItemsSource="{Binding RoofTabs}"
                                SelectedItem="{Binding SelectedRoofTab}"
                                Padding="0" Background="Transparent"
                                BorderThickness="1" BorderBrush="{StaticResource BrushSeparator}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TabHeader}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource TabPill}">
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource TabPillText}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Detected drains" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    IsEnabled="{Binding DataContext.IsInputEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ComboBox ItemsSource="{Binding SizeFilters}" SelectedItem="{Binding SelectedSizeFilter}"
                                                      Width="120" Height="26" Padding="3,2" Margin="0,0,6,0" FontSize="11.5"/>
                                            <Button Content="Select all" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,3,0"/>
                                            <Button Content="None" Command="{Binding SelectNoneCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,3,0"/>
                                            <Button Content="Invert" Command="{Binding InvertSelectionCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding FilteredDrainsView}"
                                              IsEnabled="{Binding DataContext.IsInputEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                              MinHeight="180"
                                              shell:ShellBehaviors.MaxHeightRatio="0.45"
                                              shell:ShellBehaviors.ForwardMouseWheel="True"
                                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True"
                                              EnableRowVirtualization="False"
                                              Style="{StaticResource StandardDataGrid}"
                                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                              CellStyle="{StaticResource StandardDataGridCell}"
                                              RowStyle="{StaticResource StandardDataGridRow}"
                                              RowHeight="26" FontSize="11.5">
                                        <DataGrid.GroupStyle>
                                            <GroupStyle ContainerStyle="{StaticResource DrainGroupHeaderStyle}"/>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="✓" Width="28" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  PreviewMouseLeftButtonDown="DrainCheckBox_PreviewMouseLeftButtonDown"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Shape" Binding="{Binding ShapeType}" SortMemberPath="ShapeType" Width="70"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeCategory}" SortMemberPath="SizeSortKey" Width="*"/>
                                            <DataGridTextColumn Header="⌀ (mm)" Binding="{Binding Diameter, StringFormat={}{0:F0}}" SortMemberPath="Diameter" Width="56"
                                                                ElementStyle="{StaticResource NumText}"/>
                                            <DataGridTextColumn Header="X (m)" Binding="{Binding CenterXm, StringFormat={}{0:F2}}" SortMemberPath="CenterXm" Width="62"
                                                                ElementStyle="{StaticResource NumText}"/>
                                            <DataGridTextColumn Header="Y (m)" Binding="{Binding CenterYm, StringFormat={}{0:F2}}" SortMemberPath="CenterYm" Width="62"
                                                                ElementStyle="{StaticResource NumText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Selection note: warning look when nothing is checked -->
                                    <Border Margin="0,6,0,0" Padding="7,3" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNoDrainsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectionNote}" Style="{StaticResource HintText}" Margin="0"/>
                                    </Border>

                                    <!-- Per-roof banner: shown once this roof has a status from a run -->
                                    <Border Margin="0,6,0,0" Padding="8,5" CornerRadius="6"
                                            Background="{StaticResource BrushSystemSecondaryBackground}"
                                            Visibility="{Binding HasRunResult, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding BannerText}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimingDisplay}" FontSize="10.5" Margin="8,0,0,0"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    </Expander>
                    </Border>

                    <!-- Area 2: results for the selected roof (closed by default) -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,8,0,0">
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding ResultsTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushNavyPrimary}"/>
                            <Run Text="{Binding ResultsForText, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"/>
                        </TextBlock>
                    </Expander.Header>
                        <StackPanel Margin="12,8,12,10">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton GroupName="ResultsTab" Style="{StaticResource ChipToggle}" Content="Longest 10"
                                                 IsChecked="{Binding ActiveResultsTab, Converter={StaticResource EnumToBool}, ConverterParameter=Longest, Mode=OneWay}"
                                                 Command="{Binding SetResultsTabCommand}" CommandParameter="Longest"/>
                                    <RadioButton GroupName="ResultsTab" Style="{StaticResource ChipToggle}" Content="{Binding SkippedTabText}" Margin="0"
                                                 IsChecked="{Binding ActiveResultsTab, Converter={StaticResource EnumToBool}, ConverterParameter=Skipped, Mode=OneWay}"
                                                 Command="{Binding SetResultsTabCommand}" CommandParameter="Skipped"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <!-- Longest 10: path length, slope and calculated elevation only -->
                                <DataGrid Style="{StaticResource ResultsGrid}" ItemsSource="{Binding SelectedRoofTab.LongestRows}"
                                          SelectionChanged="ResultsGrid_SelectionChanged"
                                          Visibility="{Binding IsLongestTab, Converter={StaticResource BoolToVisibility}}"
                                          MinHeight="120"
                                          shell:ShellBehaviors.MaxHeightRatio="0.45"
                                          shell:ShellBehaviors.ForwardMouseWheel="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="28" ElementStyle="{StaticResource RowNumText}"/>
                                        <DataGridTextColumn Header="PathLength_m" Binding="{Binding PathLengthText}" Width="*" ElementStyle="{StaticResource NumText}"/>
                                        <DataGridTextColumn Header="SlopePercent" Binding="{Binding SlopePercentText}" Width="*" ElementStyle="{StaticResource NumText}"/>
                                        <DataGridTextColumn Header="ElevCalc_mm" Binding="{Binding ElevCalcText}" Width="*"
                                                            HeaderStyle="{StaticResource CalcHeader}" ElementStyle="{StaticResource NumText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Skipped points -->
                                <DataGrid Style="{StaticResource ResultsGrid}" ItemsSource="{Binding SelectedRoofTab.SkippedRows}"
                                          SelectionChanged="ResultsGrid_SelectionChanged"
                                          Visibility="{Binding IsSkippedTab, Converter={StaticResource BoolToVisibility}}"
                                          MinHeight="120"
                                          shell:ShellBehaviors.MaxHeightRatio="0.45"
                                          shell:ShellBehaviors.ForwardMouseWheel="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="28" ElementStyle="{StaticResource RowNumText}"/>
                                        <DataGridTextColumn Header="VertexIndex" Binding="{Binding VertexIndex}" Width="Auto" ElementStyle="{StaticResource NumText}"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="PathLength_m" Binding="{Binding PathLengthText}" Width="Auto" ElementStyle="{StaticResource NumText}"/>
                                        <DataGridTextColumn Header="Suggested fix" Binding="{Binding Fix}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Empty state over the grid body -->
                                <TextBlock Text="{Binding ResultsEmptyText}" Style="{StaticResource HintText}" FontSize="11.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,48,12,0" TextAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ShowResultsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ResultsHint}" Style="{StaticResource HintText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy rows" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                            Command="{Binding CopyResultRowsCommand}"
                                            ToolTip="Copy the selected rows (or the whole table) as columns you can paste into Excel."/>
                                    <Button Content="Zoom to" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding ZoomToRowsCommand}"
                                            ToolTip="Select the roof and zoom the active view to the selected points."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>
                    </Border>
                    </StackPanel>
                </Grid>

                <!-- Processing log: always dark, closed by default -->
                <Border Grid.Row="1" Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Processing log" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}"/>
                                    <TextBlock Text="{Binding LogSummaryText}" FontSize="10.5" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource BrushLogTextDim}"/>
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                            Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVisibility}}">
                                    <RadioButton GroupName="LogFilter" Style="{StaticResource ChipToggle}" Content="All"
                                                 IsChecked="{Binding ActiveLogFilter, Converter={StaticResource EnumToBool}, ConverterParameter=All, Mode=OneWay}"
                                                 Command="{Binding SetLogFilterCommand}" CommandParameter="All"/>
                                    <RadioButton GroupName="LogFilter" Style="{StaticResource ChipToggle}"
                                                 IsChecked="{Binding ActiveLogFilter, Converter={StaticResource EnumToBool}, ConverterParameter=Warnings, Mode=OneWay}"
                                                 Command="{Binding SetLogFilterCommand}" CommandParameter="Warnings">
                                        <TextBlock>
                                            <Run Text="Warnings"/>
                                            <Run Text="{Binding WarningCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </RadioButton>
                                    <RadioButton GroupName="LogFilter" Style="{StaticResource ChipToggle}"
                                                 IsChecked="{Binding ActiveLogFilter, Converter={StaticResource EnumToBool}, ConverterParameter=Errors, Mode=OneWay}"
                                                 Command="{Binding SetLogFilterCommand}" CommandParameter="Errors">
                                        <TextBlock>
                                            <Run Text="Errors"/>
                                            <Run Text="{Binding ErrorCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </RadioButton>
                                </StackPanel>
                                <Button Content="Copy all" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogCommand}" Margin="0,0,6,0"/>
                                <Button Content="Copy selected" Style="{StaticResource DarkGhostButton}" Command="{Binding CopySelectedLogCommand}" Margin="0,0,6,0"/>
                                <Button Content="Save log…" Style="{StaticResource DarkGhostButton}" Command="{Binding SaveLogCommand}" Margin="0,0,6,0"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Closed: latest line only -->
                        <TextBlock Text="{Binding LatestLogText}" Margin="17,4,0,0" FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="10.5" Foreground="{StaticResource BrushLogTextDim}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource InverseBoolToVisibility}}"/>

                        <!-- Open: full list -->
                        <ListBox x:Name="LogListBox" Margin="0,6,0,0"
                                 ItemsSource="{Binding LogView}"
                                 SelectionMode="Extended"
                                 SelectionChanged="LogListBox_SelectionChanged"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5"
                                 MinHeight="110"
                                 shell:ShellBehaviors.MaxHeightRatio="0.25"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}" TextWrapping="Wrap">
                                        <Run Text="{Binding Time, Mode=OneWay, StringFormat=[HH:mm:ss]}"/>
                                        <Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Open export folder" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Command="{Binding OpenExportFolderCommand}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="80" Margin="0,0,8,0"
                            Command="{Binding CancelRunCommand}"
                            Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Stop the run (Esc). Roofs already finished stay applied; the roof in progress is rolled back; later roofs do not start."/>
                    <Button Content="{Binding RunButtonText}" Style="{StaticResource RunButton}" MinWidth="150" Margin="0,0,8,0"
                            Command="{Binding RunCommand}"
                            ToolTip="Reset each roof's shape points and apply the slope towards its checked drains."/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
