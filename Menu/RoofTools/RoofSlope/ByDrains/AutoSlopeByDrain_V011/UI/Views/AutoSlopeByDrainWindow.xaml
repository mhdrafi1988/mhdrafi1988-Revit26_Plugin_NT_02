<!--
=======================================================
File: AutoSlopeByDrainWindow.xaml
Changes vs V010 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (navy title bar + version + roof
    summary, all 8 metrics), middle (settings left in a ScrollViewer ·
    per-roof drain tabs right, grids scroll themselves), fixed footer
    (run progress, no-drains hint, always-visible processing log with
    Copy All / Copy Selected / Clear, status, Cancel · Run → Close).
  - Adds a Close button; right pane now grows with the window.
  - No behaviour change — every binding/command is the V010 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.MultiRoofSlopeByDrain.V011.UI.Views.AutoSlopeByDrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        mc:Ignorable="d"
        Title="AutoSlope By Drain — V011"
        Width="1000"
        Height="960"
        MinWidth="1000"
        MinHeight="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated here only — never inside SharedStyles.xaml -->
            <shared:LogLevelToColorConverter x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!-- Small "i" info-dot style, used to carry the explanatory hint text
                 as a ToolTip instead of an always-visible HintText paragraph. -->
            <Style x:Key="InfoDot" TargetType="Border">
                <Setter Property="Width" Value="13"/>
                <Setter Property="Height" Value="13"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                <Setter Property="Cursor" Value="Help"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>
            <Style x:Key="InfoDotText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- NEW (V010): thin ProgressBar for the Run progress strip — defined
                 LOCALLY (not in SharedStyles.xaml, which has no ProgressBar style
                 today) so this stays scoped to this window only. Deliberately keeps
                 WPF's DEFAULT ControlTemplate (only Height/Foreground/Background are
                 restyled) rather than a custom one — the default template's built-in
                 PART_Track/PART_Indicator sizing is what correctly handles both
                 determinate width and the indeterminate animation; a hand-rolled
                 template risks silently breaking one or the other. -->
            <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- Collapsible card section (Circle Markers): the whole header row is
                 the toggle, with a chevron on the right; body is hidden until
                 expanded. Lives inside a ContentCard Border so it keeps the card
                 look when closed. -->
            <Style x:Key="CardExpander" TargetType="Expander">
                <Setter Property="IsExpanded" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0"
                                              Padding="10,7" Cursor="Hand"
                                              HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="▾"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                                    </DockPanel>
                                </ToggleButton>
                                <StackPanel x:Name="BodyHost" Visibility="Collapsed">
                                    <Border Style="{StaticResource SeparatorLine}" Margin="10,0,10,4"/>
                                    <ContentPresenter/>
                                </StackPanel>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="BodyHost" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Chevron" Property="Text" Value="▴"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small pill shown in a collapsed section header for each enabled marker group. -->
            <Style x:Key="SummaryChip" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="5,0"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SummaryChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            </Style>

            <!-- Group header style for the Detected Drains grid (Circle/Rectangle/Other) —
                 shows the group name + count and a per-group All/None pair. -->
            <!-- Expander wrapping ItemsPresenter — the actual grouped rows render
                 INSIDE Expander.Content, not as a sibling of the header. A prior
                 version of this template rendered only the header Border/DockPanel
                 with no ItemsPresenter at all, so grouped rows had nowhere to draw
                 (header showed, body stayed blank). Pattern matches the working
                 GroupHeaderStyle in InnerLoopDivider_V010's window. -->
            <Style x:Key="DrainGroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <!-- NEW (V010), per Rafi's confirmed group-expand decision:
                                 IsExpanded is no longer hardcoded True for every group.
                                 It's set in code-behind (Loaded) from this roof tab's
                                 GroupExpandedOverride dictionary, falling back to "this
                                 is the first group in the current view" when the user
                                 hasn't manually toggled it — see
                                 AutoSlopeByDrainWindow.xaml.cs DrainGroupExpander_*. -->
                            <Expander x:Name="PART_DrainGroupExpander" Margin="0,2,0,0"
                                      Loaded="DrainGroupExpander_Loaded"
                                      Expanded="DrainGroupExpander_ExpandedOrCollapsed"
                                      Collapsed="DrainGroupExpander_ExpandedOrCollapsed">
                                <Expander.Header>
                                    <DockPanel LastChildFill="False"
                                               Background="{StaticResource BrushSystemTertiaryBackground}"
                                               MinWidth="480">
                                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="10.5"
                                                   VerticalAlignment="Center" Margin="4,3">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                                            <Button Content="All" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,3,0"
                                                    Command="{Binding DataContext.SelectAllInGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Name}"/>
                                            <Button Content="None" Style="{StaticResource SmallSecondaryButton}"
                                                    Command="{Binding DataContext.SelectNoneInGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Name}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <ItemsPresenter/>
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AutoSlope By Drain" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="{Binding RoofSelectionSummary}" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V011" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <!-- Row 0: all 8 metrics in ONE 4x2 grid (was two separate 4-col rows) -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,2.5,0" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Longest Path" Style="{StaticResource MetricLabel}" FontSize="9.5"/>
                        <TextBlock Text="{Binding LongestPathDisplay}" Style="{StaticResource MetricNumberAccent}" FontSize="19"/>
                        <TextBlock Text="Meters" Style="{StaticResource MetricUnit}" FontSize="9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}" Margin="2.5,0,2.5,0" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Max Offset" Style="{StaticResource MetricLabel}" FontSize="9.5"/>
                        <TextBlock Text="{Binding HighestElevationDisplay}" Style="{StaticResource MetricNumber}" FontSize="19"/>
                        <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}" FontSize="9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCard}" Margin="2.5,0,2.5,0" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Drains Selected" Style="{StaticResource MetricLabel}" FontSize="9.5"/>
                        <TextBlock Text="{Binding AllSelectedDrainsCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="19"/>
                        <TextBlock Text="of Detected" Style="{StaticResource MetricUnit}" FontSize="9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricCard}" Margin="2.5,0,0,0" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Slope" Style="{StaticResource MetricLabel}" FontSize="9.5"/>
                        <TextBlock Text="{Binding SlopeInput}" Style="{StaticResource MetricNumber}" FontSize="19"/>
                        <TextBlock Text="Percent" Style="{StaticResource MetricUnit}" FontSize="9"/>
                    </StackPanel>
                </Border>

                <!-- NEW (V010), per Rafi's confirmed timing decision: shows the
                     batch's total duration ("36 s") with its Started/Finished wall-
                     clock range as a 2-line caption, replacing the old raw-seconds +
                     "Seconds" unit. Both are "N/A"/"—" before the run finishes. -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,2.5,0" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Run Duration" Style="{StaticResource MetricLabel}" FontSize="9.5"/>
                        <TextBlock Text="{Binding RunDurationDisplay}" Style="{StaticResource MetricNumberSuccess}" FontSize="19"/>
                        <TextBlock Text="{Binding RunTimeRangeDisplay}" Style="{StaticResource MetricUnit}" FontSize="8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricCard}" Margin="2.5,0,2.5,0" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Total Detected" Style="{StaticResource MetricLabel}" FontSize="9.5"/>
                        <TextBlock Text="{Binding TotalDetectedCount, FallbackValue=0}" Style="{StaticResource MetricNumberAccent}" FontSize="19"/>
                        <TextBlock Text="Drains" Style="{StaticResource MetricUnit}" FontSize="9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricCard}" Margin="2.5,0,2.5,0" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Selected Count" Style="{StaticResource MetricLabel}" FontSize="9.5"/>
                        <TextBlock Text="{Binding SelectedCount, FallbackValue=0}" Style="{StaticResource MetricNumber}" FontSize="19"/>
                        <TextBlock Text="Drains" Style="{StaticResource MetricUnit}" FontSize="9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource MetricCard}" Margin="2.5,0,0,0" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Arcs Calculated" Style="{StaticResource MetricLabel}" FontSize="9.5"/>
                        <TextBlock Text="{Binding ArcsCalculated, FallbackValue=0}" Style="{StaticResource MetricNumberWarning}" FontSize="19"/>
                        <TextBlock Text="Boundary Arcs" Style="{StaticResource MetricUnit}" FontSize="9"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ═══ MIDDLE — settings (scroll) · drain tabs ═════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Slope Section — all 3 fields kept, hints moved to info-dot tooltips -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Text="Slope" Style="{StaticResource SectionTitle}" Margin="10,7,10,3"/>

                            <StackPanel Margin="10,3">
                                <TextBlock Text="Percentage" Style="{StaticResource FieldLabel}" FontSize="10.5"/>
                                <ComboBox ItemsSource="{Binding SlopeOptions}"
                                          Text="{Binding SlopeInput}"
                                          IsEditable="True"
                                          Style="{StaticResource StandardComboBox}"/>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <StackPanel Margin="10,3">
                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Max Edge Distance" Style="{StaticResource FieldLabel}" FontSize="10.5"/>
                                    <Border Style="{StaticResource InfoDot}"
                                            ToolTip="Two vertices farther apart than this are never linked as graph neighbors. Keeps the pathfinding graph sparse and fast.">
                                        <TextBlock Text="i" Style="{StaticResource InfoDotText}"/>
                                    </Border>
                                </DockPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="m" Style="{StaticResource UnitLabel}" DockPanel.Dock="Right"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             MaxLength="10"
                                             Text="{Binding ConnectionThresholdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <StackPanel Margin="10,3">
                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Max Path Distance" Style="{StaticResource FieldLabel}" FontSize="10.5"/>
                                    <Border Style="{StaticResource InfoDot}"
                                            ToolTip="A vertex whose total path to its nearest selected drain exceeds this is skipped (no elevation change applied), even if every edge on the path was individually valid.">
                                        <TextBlock Text="i" Style="{StaticResource InfoDotText}"/>
                                    </Border>
                                </DockPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="m" Style="{StaticResource UnitLabel}" DockPanel.Dock="Right"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             MaxLength="10"
                                             Text="{Binding ThresholdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <StackPanel Margin="10,3,10,7">
                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Path Samples" Style="{StaticResource FieldLabel}" FontSize="10.5"/>
                                    <Border Style="{StaticResource InfoDot}"
                                            ToolTip="Points sampled along each candidate edge to confirm it lies on the roof face. Min 2, recommended 5-20.">
                                        <TextBlock Text="i" Style="{StaticResource InfoDotText}"/>
                                    </Border>
                                </DockPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="/edge" Style="{StaticResource UnitLabel}" DockPanel.Dock="Right"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             MaxLength="10"
                                             Text="{Binding PathSampleCountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Options Section — Curve Handling + Verification MERGED into one card -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Text="Options" Style="{StaticResource SectionTitle}" Margin="10,7,10,3"/>

                            <DockPanel Margin="10,5" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Insert curve intersections" Style="{StaticResource FieldValue}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource InfoDot}"
                                            ToolTip="Adds real vertices where a roof edge crosses a boundary/opening arc, for accurate distance on curved edges.">
                                        <TextBlock Text="i" Style="{StaticResource InfoDotText}"/>
                                    </Border>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource AppleToggleButton}"
                                              IsChecked="{Binding InsertCurveIntersectionPoints}"
                                              DockPanel.Dock="Right"/>
                            </DockPanel>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <DockPanel Margin="10,5,10,9" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Verify after commit" Style="{StaticResource FieldValue}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource InfoDot}"
                                            ToolTip="Re-reads vertices from the model after commit to detect any silent adjustment Revit made vs. the calculated value. Off by default; adds a re-read pass.">
                                        <TextBlock Text="i" Style="{StaticResource InfoDotText}"/>
                                    </Border>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource AppleToggleButton}"
                                              IsChecked="{Binding VerifyElevationsAfterCommit}"
                                              DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Circle Markers Section — Drain / Highest Point / Allowed Offset, ported
                         from AutoSlopeByPoint. Collapsed by default; the header shows a chip
                         for each enabled group (or "Off") so the state is visible while closed. -->
                    <Border Style="{StaticResource ContentCard}">
                        <Expander Style="{StaticResource CardExpander}">
                            <Expander.Header>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Circle Markers" Style="{StaticResource SectionTitle}" Margin="0"
                                               VerticalAlignment="Center"
                                               ToolTip="Placed in the active plan view when Run completes. Skipped with a warning if the active view is not a plan view."/>
                                    <Border Style="{StaticResource SummaryChip}"
                                            Visibility="{Binding DrainMarkerGroup.IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Drains" Style="{StaticResource SummaryChipText}"/>
                                    </Border>
                                    <Border Style="{StaticResource SummaryChip}"
                                            Visibility="{Binding HighestPointMarkerGroup.IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Highest Pt" Style="{StaticResource SummaryChipText}"/>
                                    </Border>
                                    <Border Style="{StaticResource SummaryChip}"
                                            Visibility="{Binding AllowedOffsetMarkerGroup.IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource SummaryChipText}">
                                            <Run Text="Offset ≥"/>
                                            <Run Text="{Binding AllowedOffsetThresholdMm, Mode=OneWay, StringFormat={}{0:0.#}}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="Off" Margin="6,0,0,0" FontSize="9.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DrainMarkerGroup.IsEnabled}" Value="False"/>
                                                            <Condition Binding="{Binding HighestPointMarkerGroup.IsEnabled}" Value="False"/>
                                                            <Condition Binding="{Binding AllowedOffsetMarkerGroup.IsEnabled}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </WrapPanel>
                            </Expander.Header>
                        <StackPanel>
                            <!-- Group 1: Drain -->
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding DrainMarkerGroup.IsEnabled}" VerticalAlignment="Center"/>
                                <TextBlock Text="Place Circles on Drains" Style="{StaticResource FieldValue}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <Grid Margin="10,4,10,6" IsEnabled="{Binding DrainMarkerGroup.IsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.7*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Line Style" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <ComboBox ItemsSource="{Binding LineStyleOptions}"
                                              SelectedValue="{Binding DrainMarkerGroup.LineStyleId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource StandardComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Color" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <ComboBox ItemsSource="{Binding ColorPalette}"
                                              SelectedItem="{Binding DrainMarkerGroup.ColorName, Mode=TwoWay}"
                                              Style="{StaticResource StandardComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             Text="{Binding DrainMarkerGroup.RadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <!-- Group 2: Highest Point -->
                            <StackPanel Orientation="Horizontal" Margin="10,4,10,0" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding HighestPointMarkerGroup.IsEnabled}" VerticalAlignment="Center"/>
                                <TextBlock Text="Highest Point" Style="{StaticResource FieldValue}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <Grid Margin="10,4,10,9" IsEnabled="{Binding HighestPointMarkerGroup.IsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.7*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Line Style" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <ComboBox ItemsSource="{Binding LineStyleOptions}"
                                              SelectedValue="{Binding HighestPointMarkerGroup.LineStyleId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource StandardComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Color" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <ComboBox ItemsSource="{Binding ColorPalette}"
                                              SelectedItem="{Binding HighestPointMarkerGroup.ColorName, Mode=TwoWay}"
                                              Style="{StaticResource StandardComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             Text="{Binding HighestPointMarkerGroup.RadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,4" VerticalAlignment="Center"
                                        IsEnabled="{Binding HighestPointMarkerGroup.IsEnabled}">
                                <CheckBox IsChecked="{Binding HighestPointMarkerGroup.ShowOffsetText}" VerticalAlignment="Center"/>
                                <TextBlock Text="Show offset text label" Style="{StaticResource FieldValue}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                           ToolTip="Places a red &quot;Offset: X mm&quot; text note with a leader next to the Highest Point circle."/>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <!-- Group 3: Allowed Offset -->
                            <StackPanel Orientation="Horizontal" Margin="10,4,10,0" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding AllowedOffsetMarkerGroup.IsEnabled}" VerticalAlignment="Center"/>
                                <TextBlock Text="Allowed Offset (Visual Clamping Offset)" Style="{StaticResource FieldValue}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                           ToolTip="Circles processed vertices with offset &#8805; threshold. Excludes vertices already marked Highest Point."/>
                            </StackPanel>
                            <Grid Margin="10,4,10,4" IsEnabled="{Binding AllowedOffsetMarkerGroup.IsEnabled}"
                                  Visibility="{Binding AllowedOffsetMarkerGroup.IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Threshold (mm)" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             Text="{Binding AllowedOffsetThresholdMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="10,4,10,9" IsEnabled="{Binding AllowedOffsetMarkerGroup.IsEnabled}"
                                  Visibility="{Binding AllowedOffsetMarkerGroup.IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.7*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Line Style" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <ComboBox ItemsSource="{Binding LineStyleOptions}"
                                              SelectedValue="{Binding AllowedOffsetMarkerGroup.LineStyleId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource StandardComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Color" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <ComboBox ItemsSource="{Binding ColorPalette}"
                                              SelectedItem="{Binding AllowedOffsetMarkerGroup.ColorName, Mode=TwoWay}"
                                              Style="{StaticResource StandardComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}" FontSize="9.5"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             Text="{Binding AllowedOffsetMarkerGroup.RadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Export Section -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <DockPanel Margin="10,7,10,3" LastChildFill="False">
                                <TextBlock Text="Export" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Border Style="{StaticResource InfoDot}"
                                        ToolTip="Exports an Excel workbook (Vertex Data + Run Summary sheets) after every run.">
                                    <TextBlock Text="i" Style="{StaticResource InfoDotText}"/>
                                </Border>
                            </DockPanel>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <StackPanel Margin="10,3,10,7">
                                <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" FontSize="10.5"/>
                                <DockPanel LastChildFill="True">
                                    <Button Content="Browse"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="6,0,0,0"
                                            Command="{Binding BrowseFolderCommand}"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             Text="{Binding ExportFolderPath, Mode=TwoWay}"
                                             IsReadOnly="True"
                                             FontSize="11"
                                             Foreground="{StaticResource BrushAppleBlue}"/>
                                </DockPanel>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <DockPanel Margin="10,5,10,9" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Combined summary (multi-roof)" Style="{StaticResource FieldValue}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource InfoDot}"
                                            ToolTip="When more than one roof is run together, also writes one extra workbook comparing every roof's result (longest path, highest elevation, drain count) — in addition to each roof's own Excel file.">
                                        <TextBlock Text="i" Style="{StaticResource InfoDotText}"/>
                                    </Border>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource AppleToggleButton}"
                                              IsChecked="{Binding WriteCombinedSummary}"
                                              DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Open Export Folder Button -->
                    <Button Content="Open Export Folder"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenExportFolderCommand}"
                            Margin="0,0,0,7"/>

                    <DockPanel Margin="10,4,10,7" LastChildFill="False">
                        <TextBlock Text="Vertices are reset to zero at drains; slope is applied outward from there."
                                   Style="{StaticResource HintText}"
                                   FontSize="9.5"
                                   Margin="0"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BrushSeparator}"/>

            <!-- Row 2: NEW (V008) — one TabItem per roof. Each tab carries its own
                 RoofTabViewModel as DataContext, so the size filter, select
                 all/none/invert buttons, and the DataGrid below all bind
                 directly to that roof's own drains, independent of every
                 other tab. -->
            <TabControl Grid.Column="2"
                        ItemsSource="{Binding RoofTabs}"
                        SelectedItem="{Binding SelectedRoofTab}"
                        Margin="0" Padding="0"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BrushSeparator}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TabHeader}" FontSize="10.5" Padding="2,0"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Detected Drains grid header (filter + select all/none/invert), per roof -->
                            <Border Grid.Row="0" Style="{StaticResource ContentCard}" Margin="0">
                                <Grid Margin="10,6,10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Detected Drains" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" FontSize="11"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ComboBox ItemsSource="{Binding SizeFilters}"
                                                  SelectedItem="{Binding SelectedSizeFilter}"
                                                  Width="118"
                                                  Style="{StaticResource StandardComboBox}"
                                                  Margin="0,0,6,0"/>
                                        <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,3,0"/>
                                        <Button Content="Select None" Command="{Binding SelectNoneCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,3,0"/>
                                        <Button Content="Invert" Command="{Binding InvertSelectionCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Detected Drains DataGrid — sortable, filterable via this roof's own FilteredDrainsView -->
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding FilteredDrainsView}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserSortColumns="True"
                                      EnableRowVirtualization="False"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource StandardDataGridCell}"
                                      RowStyle="{StaticResource StandardDataGridRow}"
                                      FontSize="11">
                                <DataGrid.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource DrainGroupHeaderStyle}"/>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="✓" Width="28" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          PreviewMouseLeftButtonDown="DrainCheckBox_PreviewMouseLeftButtonDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Shape"  Binding="{Binding ShapeType}"    SortMemberPath="ShapeType"    Width="68"/>
                                    <DataGridTextColumn Header="Size"   Binding="{Binding SizeCategory}" SortMemberPath="SizeCategory" Width="88"/>
                                    <DataGridTextColumn Header="W"      Binding="{Binding Width,  StringFormat={}{0:F0}}" SortMemberPath="Width"  Width="45">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="H"      Binding="{Binding Height, StringFormat={}{0:F0}}" SortMemberPath="Height" Width="45">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="⌀ (mm)" Binding="{Binding Diameter, StringFormat={}{0:F0}}" SortMemberPath="Diameter" Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="ToolTip" Value="Diameter (Circle rows only)"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="R (mm)" Binding="{Binding Radius, StringFormat={}{0:F0}}" SortMemberPath="Radius" Width="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="ToolTip" Value="Radius (Circle rows only)"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="X" Binding="{Binding CenterPoint.X, StringFormat={}{0:F0}}" Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Y" Binding="{Binding CenterPoint.Y, StringFormat={}{0:F0}}" Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Per-roof result banner — only shown once this roof has actually run -->
                            <Border Grid.Row="3"
                                    Padding="8,5"
                                    Margin="0,4,0,0"
                                    Background="{StaticResource BrushSystemTertiaryBackground}"
                                    Visibility="{Binding HasRunResult, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding LastRunStatus}" FontSize="10.5" FontWeight="SemiBold"/>
                                        <TextBlock DockPanel.Dock="Right" FontSize="10" HorizontalAlignment="Right"
                                                   Visibility="{Binding LastRunSucceeded, Converter={StaticResource BoolToVisibility}}">
                                            <Run Text="Longest path"/>
                                            <Run Text="{Binding LongestPath_m, StringFormat={}{0:F2}, Mode=OneWay}"/>
                                            <Run Text="m · Max offset"/>
                                            <Run Text="{Binding HighestElevation_mm, StringFormat={}{0:F0}, Mode=OneWay}"/>
                                            <Run Text="mm"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <!-- NEW (V010), per Rafi's confirmed timing decision: shown
                                         for every run this roof had — success, failure, or
                                         cancellation — since AutoSlopeDrainEngine now stamps
                                         StartTime/EndTime/RunDuration_sec on all three. -->
                                    <TextBlock Text="{Binding TimingDisplay}"
                                               FontSize="9.5"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <!-- NEW (V010), per Rafi's confirmed progress-bar decision: one
                 continuous bar spanning the whole batch, weighted by each roof's
                 vertex count, with the current phase (and, in a multi-roof batch,
                 which roof) as a label above it. Visible only while a run is in
                 progress. -->
            <StackPanel Margin="0,0,0,7" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="0,0,0,3" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                               FontSize="10"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressIsIndeterminate}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ProgressPhaseText}"
                               FontSize="10"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource ThinProgressBar}"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate}"/>
            </StackPanel>
            <!-- Inline hint shown only when Run is disabled specifically because
                 0 drains are selected — not a silent disable. -->
            <TextBlock Text="Select at least one drain to run."
                       Foreground="{StaticResource BrushWarning}"
                       FontSize="10.5"
                       Margin="4,0,4,7"
                       TextWrapping="Wrap"
                       Visibility="{Binding ShowNoDrainsSelectedHint, Converter={StaticResource BoolToVisibility}}"/>
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="{Binding LogEntries.Count, StringFormat='Processing Log ({0})'}"
                                       Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Command="{Binding CopyAllLogsCommand}" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"/>
                            <Button Content="Copy Selected" Click="CopySelectedLogs_Click" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"/>
                            <Button Content="Clear" Command="{Binding ClearLogCommand}" Style="{StaticResource DarkGhostButton}"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogListBox" Height="110"
                             ItemsSource="{Binding LogEntries}"
                             SelectionMode="Extended"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="9.5">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="3,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                           TextWrapping="Wrap">
                                    <Run Text="{Binding Time, Mode=OneWay, StringFormat=[HH:mm:ss]}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Message, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource StatusRow}" Margin="2,0" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusDot}"/>
                                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" FontSize="11"/>
                                    </StackPanel>
                <Grid Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0">
                                        <!-- NEW (V010): Cancel sits next to Run, enabled only while a run
                                             is in progress (see CanCancelRun). -->
                                        <Button Content="Cancel"
                                                Command="{Binding CancelRunCommand}"
                                                ToolTip="Stop the run. Roof(s) already completed stay applied; the roof in progress rolls back (it hasn't written anything yet); remaining roofs are not started."
                                                Style="{StaticResource SecondaryButton}"
                                                Height="32"
                                                Width="70"
                                                Margin="0,0,6,0"/>
                                        <Button Command="{Binding RunAutoSlopeCommand}"
                                                ToolTip="Calculate and apply slope to the selected drains"
                                                Height="32"
                                                Width="150">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RunButton}">
                                                    <Setter Property="Content" Value="Run AutoSlope"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Processing...">
                                                            <Setter Property="Content" Value="⏳ Processing..."/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Completed">
                                                            <Setter Property="Content" Value="✓ Complete"/>
                                                            <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                        <!-- NEW (V010): Cancelled does NOT disable Run — the
                                                             Command's own CanExecute (!IsComplete, unaffected
                                                             by Cancelled) already allows an immediate retry. -->
                                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Cancelled">
                                                            <Setter Property="Content" Value="Cancelled — Run Again"/>
                                                            <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Close"
                                Style="{StaticResource OutlineButton}"
                                Click="CloseButton_Click"
                                Height="32"
                                Width="90"
                                Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
