<Window
    x:Class="Revit26_Plugin_Revised.CreaserAdv.V010.Views.CreaserAdvWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
    Title="Revit26 – Creaser Advanced V010"
    Width="480"
    Height="680"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Declared here directly — avoids MC3074 designer resolution issues
                with assembly= references. Uses the same shared class from
                Revit26_Plugin_Revised.Shared.Models that all other tools use.
            -->
            <models:LogLevelToColorConverter    x:Key="LogLevelToColor"/>
            <models:BoolToVisibilityConverter   x:Key="BoolToVisibility"/>

            <DataTemplate x:Key="LogEntryTemplate">
                <TextBlock
                    Text="{Binding}"
                    Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                    FontFamily="Consolas"
                    FontSize="11"
                    TextWrapping="NoWrap"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0 · Detail item card ════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource BaseCard}" Padding="8,6" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock
                    Text="Detail item"
                    Style="{StaticResource FieldLabel}"
                    Margin="0,0,0,3"/>
                <ComboBox
                    Height="22"
                    FontSize="11"
                    ItemsSource="{Binding DetailSymbols}"
                    SelectedItem="{Binding SelectedDetailSymbol}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11">
                                <Run Text="{Binding FamilyName, Mode=OneWay}"/>
                                <Run Text=" : "/>
                                <Run Text="{Binding Name}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ═══ Row 1 · Filters card ═════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource BaseCard}" Padding="8,6" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock
                    Text="Filters"
                    Style="{StaticResource SectionTitle}"
                    Margin="0,0,0,4"/>

                <CheckBox
                    Content="Include boundary lines"
                    IsChecked="{Binding IncludeBoundaryLines}"
                    Foreground="{StaticResource BrushTextPrimary}"
                    Margin="0,0,0,6"
                    VerticalContentAlignment="Center"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Grid.Column="0"
                        Content="Drop lines less than minimum"
                        IsChecked="{Binding EnableMinimumLength}"
                        Foreground="{StaticResource BrushTextPrimary}"
                        VerticalContentAlignment="Center"/>
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource StyledTextInput}"
                        Text="{Binding MinimumLengthMm}"
                        MaxLength="10"
                        Width="56"
                        HorizontalContentAlignment="Right"
                        Margin="6,0,0,0"/>
                    <TextBlock
                        Grid.Column="2"
                        Text="mm"
                        Style="{StaticResource UnitLabel}"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Grid.Column="0"
                        Content="Drain grouping radius"
                        IsChecked="{Binding EnableDrainGrouping}"
                        Foreground="{StaticResource BrushTextPrimary}"
                        VerticalContentAlignment="Center"/>
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource StyledTextInput}"
                        Text="{Binding DrainGroupingRadiusMm}"
                        MaxLength="10"
                        Width="56"
                        HorizontalContentAlignment="Right"
                        Margin="6,0,0,0"/>
                    <TextBlock
                        Grid.Column="2"
                        Text="mm"
                        Style="{StaticResource UnitLabel}"/>
                </Grid>

                <CheckBox
                    Content="Filter by Dijkstra path validity"
                    IsChecked="{Binding EnableDijkstraPathFilter}"
                    Foreground="{StaticResource BrushTextPrimary}"
                    Margin="0,0,0,4"
                    VerticalContentAlignment="Center"/>

                <TextBlock
                    Text="Horizontal-crease filter always runs, no toggle needed."
                    Style="{StaticResource HintText}"
                    Margin="0"/>
            </StackPanel>
        </Border>

        <!-- ═══ Row 2 · Minimum Slope card ══════════════════════════════════ -->
        <Border
            Grid.Row="2"
            Style="{StaticResource BaseCard}"
            Padding="8,6"
            Margin="0,0,0,8"
            IsEnabled="{Binding EnableDijkstraPathFilter}">
            <StackPanel>
                <TextBlock
                    Text="Minimum Slope"
                    Style="{StaticResource SectionTitle}"
                    Margin="0,0,0,4"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Grid.Column="0"
                        Content="Enforce minimum slope"
                        IsChecked="{Binding EnableMinimumSlope}"
                        Foreground="{StaticResource BrushTextPrimary}"
                        VerticalContentAlignment="Center"/>
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource StyledTextInput}"
                        Text="{Binding MinimumSlopePercent}"
                        MaxLength="10"
                        Width="56"
                        HorizontalContentAlignment="Right"
                        Margin="6,0,0,0"/>
                    <TextBlock
                        Grid.Column="2"
                        Text="%"
                        Style="{StaticResource UnitLabel}"/>
                </Grid>

                <TextBlock
                    Text="Edges below this slope are rejected before path-finding."
                    Style="{StaticResource HintText}"
                    Margin="0"/>
            </StackPanel>
        </Border>

        <!-- ═══ Row 3 · Action buttons ══════════════════════════════════════ -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Margin="0,0,0,8">
            <Button
                Content="Run"
                Width="90"
                Margin="0,0,10,0"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding RunCommand}"/>
            <Button
                Content="Clear log"
                Width="90"
                Style="{StaticResource OutlineButton}"
                Command="{Binding ClearLogCommand}"/>
        </StackPanel>

        <!-- ═══ Row 4 · Run summary bar (hidden until first Run) ════════════ -->
        <Border
            Grid.Row="4"
            Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}"
            Background="{StaticResource BrushNavyPrimary}"
            CornerRadius="6"
            Padding="10,8"
            Margin="0,0,0,8">
            <UniformGrid Rows="2" Columns="3">

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding Summary.CreasesFound}"
                        Style="{StaticResource MetricNumber}"
                        Foreground="{StaticResource BrushTextOnDark}"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="creases found"
                        Style="{StaticResource MetricUnit}"
                        Foreground="{StaticResource BrushLogTextDim}"
                        HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding Summary.BoundaryFound}"
                        Style="{StaticResource MetricNumber}"
                        Foreground="{StaticResource BrushTextOnDark}"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="boundary found"
                        Style="{StaticResource MetricUnit}"
                        Foreground="{StaticResource BrushLogTextDim}"
                        HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding Summary.Created}"
                        Style="{StaticResource MetricNumberSuccess}"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="created"
                        Style="{StaticResource MetricUnit}"
                        Foreground="{StaticResource BrushLogTextDim}"
                        HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding Summary.Failed}"
                        Style="{StaticResource MetricNumberDanger}"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="failed"
                        Style="{StaticResource MetricUnit}"
                        Foreground="{StaticResource BrushLogTextDim}"
                        HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding Summary.RidgePoints}"
                        Style="{StaticResource MetricNumber}"
                        Foreground="{StaticResource BrushTextOnDark}"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="ridge points"
                        Style="{StaticResource MetricUnit}"
                        Foreground="{StaticResource BrushLogTextDim}"
                        HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding Summary.DisconnectedPoints}"
                        Style="{StaticResource MetricNumber}"
                        Foreground="{StaticResource BrushTextOnDark}"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="disconnected"
                        Style="{StaticResource MetricUnit}"
                        Foreground="{StaticResource BrushLogTextDim}"
                        HorizontalAlignment="Center"/>
                </StackPanel>

            </UniformGrid>
        </Border>

        <!-- ═══ Row 5 · Log panel ═══════════════════════════════════════════ -->
        <Border
            Grid.Row="5"
            Background="{StaticResource BrushLogBg}"
            CornerRadius="8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Log title bar -->
                <Border
                    Grid.Row="0"
                    Background="{StaticResource BrushLogTitleBar}"
                    CornerRadius="5"
                    Padding="8,5"
                    Margin="0,0,0,6">
                    <TextBlock
                        Text="Log"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushLogText}"/>
                </Border>

                <!-- Colour-coded log list -->
                <ListBox
                    x:Name="LogList"
                    Grid.Row="1"
                    ItemsSource="{Binding VisibleLogEntries}"
                    ItemTemplate="{StaticResource LogEntryTemplate}"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    MinHeight="120"/>

                <!-- Log footer: detail toggle · open file · copy -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Grid.Column="0"
                        Content="Show detail"
                        IsChecked="{Binding ShowDetailLog}"
                        Foreground="{StaticResource BrushLogText}"
                        VerticalContentAlignment="Center"/>
                    <Button
                        Grid.Column="1"
                        Content="Open log file"
                        Width="90"
                        Margin="0,0,6,0"
                        Style="{StaticResource DarkGhostButton}"
                        Command="{Binding OpenLogFileCommand}"/>
                    <Button
                        Grid.Column="2"
                        Content="Copy log"
                        Width="80"
                        Style="{StaticResource DarkGhostButton}"
                        Command="{Binding CopyLogCommand}"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
