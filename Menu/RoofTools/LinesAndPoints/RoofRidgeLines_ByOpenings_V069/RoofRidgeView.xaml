<!--
=======================================================
File: RoofRidgeView.xaml
Changes vs V068 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (navy title bar + version, metrics
    card), middle (left: roof selection + algorithm settings, scrolls;
    right: drainage seeds + validation grid that scrolls itself), fixed
    footer (pipeline log with Copy All / Copy Selected, progress +
    status, Generate Ridges → Close).
  - Validation Log / Pipeline Log tabs split: validation grid stays in
    the middle, pipeline log moves to the footer log panel.
  - Adds a Close button; MinWidth/MinHeight = default size.
  - No behaviour change — every binding/command is the V068 one.
=======================================================
-->
<mah:MetroWindow
    x:Class="Revit26_Plugin_Revised.RoofRidgeLines.V069.Views.RoofRidgeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:conv="clr-namespace:Revit26_Plugin_Revised.RoofRidgeLines.V069.Converters"
    xmlns:shared="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
    mc:Ignorable="d"
    Title="Ridge By Openings — V069"
    TitleCharacterCasing="Normal"
    Width="1080" Height="860" MinWidth="1080" MinHeight="860"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="{DynamicResource BrushSystemBackground}">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolConverter        x:Key="InverseBool"/>
            <shared:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:ZeroToVisibilityConverter   x:Key="ZeroToVis"/>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Voronoi Ridge Generation" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Select inner loops as drainage seeds to compute ridges." Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToolVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Selected Seeds" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalCalculatedPoints}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Added" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalAddedPoints}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalFailedPoints}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Openings Selected" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedOpeningsCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: inputs (scrolls) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource AppIdentityCard}" Margin="0,0,0,16" Padding="12">
                        <StackPanel>
                            <TextBlock Text="1. Base Roof Selection" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="4" Padding="8,8">
                                    <TextBlock Text="{Binding RoofDescription}" Style="{StaticResource FieldValue}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="Pick Roof" Command="{Binding SelectRoofCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Width="90"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppIdentityCard}" Margin="0,0,0,16" Padding="14">
                        <StackPanel>
                            <TextBlock Text="3. Algorithm Configuration" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Proximity Distance (mm)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource BoxedTextInput}" Text="{Binding ProximityDistanceMm, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" HorizontalContentAlignment="Right" FontSize="11" Padding="8,3"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Validation Tolerance (mm)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource BoxedTextInput}" Text="{Binding ValidationToleranceMm, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" HorizontalContentAlignment="Right" FontSize="11" Padding="8,3"/>
                            </Grid>

                            <CheckBox Content="Add Detail Lines" IsChecked="{Binding AddDetailLines}" FontSize="12" Margin="0,10,0,6"/>
                            <CheckBox Content="Add Shape Points" IsChecked="{Binding AddShapePoints}" FontSize="12" Margin="0,0,0,0"/>

                            <TextBlock Text="Detail Line Style" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
                            <TextBox Text="{Binding LineStyleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}"
                                     FontSize="10" Height="28" Padding="8,5"
                                     IsEnabled="{Binding AddDetailLines}"
                                     Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding LineStyleView}"
                                     SelectedItem="{Binding SelectedLineStyleName}"
                                     IsEnabled="{Binding AddDetailLines}"
                                     FontSize="10"
                                     MaxHeight="104"
                                     BorderBrush="{StaticResource BrushCardBorder}"
                                     BorderThickness="1">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: seeds + validation results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ContentCard}" Margin="0,0,0,16" Padding="12,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2. Drainage Seeds (Inner Loops)" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <Border Grid.Column="1" Style="{StaticResource BadgePill}">
                                <TextBlock Style="{StaticResource BadgeText}">
                                    <Run Text="{Binding SelectedOpeningsCount, Mode=OneWay}"/><Run Text=" selected"/>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- ── Circles ── -->
                                <Expander IsExpanded="True" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <Grid Width="330">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Circles" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                                                <Run Text="("/><Run Text="{Binding CircleSelectedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding CircleTotalCount, Mode=OneWay}"/><Run Text=" selected)"/>
                                            </TextBlock>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="All"  Command="{Binding SelectAllCirclesCommand}"  Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                                                <Button Content="None" Command="{Binding SelectNoneCirclesCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding CircleOpenings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,5" Margin="0,1" CornerRadius="4"
                                                            Background="{StaticResource BrushSystemSecondaryBackground}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayDimensions}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DisplayBBoxWidth}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No circular openings"
                                                   FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource BrushTextTertiary}"
                                                   Margin="4,4,0,2"
                                                   Visibility="{Binding CircleTotalCount, Converter={StaticResource ZeroToVis}}"/>
                                    </StackPanel>
                                </Expander>

                                <!-- ── Rectangles ── -->
                                <Expander IsExpanded="False" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <Grid Width="330">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Rectangles" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                                                <Run Text="("/><Run Text="{Binding RectangleSelectedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding RectangleTotalCount, Mode=OneWay}"/><Run Text=" selected)"/>
                                            </TextBlock>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="All"  Command="{Binding SelectAllRectanglesCommand}"  Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                                                <Button Content="None" Command="{Binding SelectNoneRectanglesCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding RectangleOpenings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,5" Margin="0,1" CornerRadius="4"
                                                            Background="{StaticResource BrushSystemSecondaryBackground}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayDimensions}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DisplayBBoxWidth}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No rectangular openings"
                                                   FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource BrushTextTertiary}"
                                                   Margin="4,4,0,2"
                                                   Visibility="{Binding RectangleTotalCount, Converter={StaticResource ZeroToVis}}"/>
                                    </StackPanel>
                                </Expander>

                                <!-- ── Others ── -->
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Width="330">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Others" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                                                <Run Text="("/><Run Text="{Binding OtherSelectedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding OtherTotalCount, Mode=OneWay}"/><Run Text=" selected)"/>
                                            </TextBlock>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="All"  Command="{Binding SelectAllOthersCommand}"  Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                                                <Button Content="None" Command="{Binding SelectNoneOthersCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding OtherOpenings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,5" Margin="0,1" CornerRadius="4"
                                                            Background="{StaticResource BrushSystemSecondaryBackground}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayDimensions}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DisplayBBoxWidth}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No other openings"
                                                   FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource BrushTextTertiary}"
                                                   Margin="4,4,0,2"
                                                   Visibility="{Binding OtherTotalCount, Converter={StaticResource ZeroToVis}}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Margin="4,8,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushNavyPrimary}">
                            <Run Text="Selected: "/><Run Text="{Binding SelectedOpeningsCount, Mode=OneWay}"/><Run Text=" opening(s) as seeds"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ContentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,6" VerticalAlignment="Center">
                            <TextBlock Text="Validation Results" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold">
                                <Run Text="PASS: "/><Run Text="{Binding PassCount}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="16,0,0,0" Foreground="{StaticResource BrushDanger}" FontWeight="SemiBold">
                                <Run Text="FAIL: "/><Run Text="{Binding FailCount}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="16,0,0,0" Foreground="{StaticResource BrushNavyPrimary}" Opacity="0.8">
                                <Run Text="{Binding GroupCountDisplay, StringFormat='Groups: {0}'}"/>
                            </TextBlock>
                        </StackPanel>
                        <DataGrid Grid.Row="1" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Style="{StaticResource StandardDataGrid}" ItemsSource="{Binding ValidationLog}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single" FontSize="10.5" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pt #" Binding="{Binding PointIndex}" Width="50"/>
                                <DataGridTextColumn Header="X (ft)" Binding="{Binding X, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Y (ft)" Binding="{Binding Y, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Max &#916; (ft)" Binding="{Binding MaxDeviation, StringFormat=F5}" Width="90"/>
                                <DataGridTextColumn Header="Tol (ft)" Binding="{Binding Tolerance, StringFormat=F5}" Width="80"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Passed}" Width="65"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Passed}" Value="False">
                                            <Setter Property="Background" Value="#FFF2F2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                            <Setter Property="Background" Value="#F2FBF4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Pipeline Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyLogCommand}" Margin="0,0,6,0"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" x:Name="PipelineLogBox" Grid.Row="1" Height="120" Text="{Binding PipelineLogText, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas, Monaco, Courier New" FontSize="10.5"
                             Foreground="{StaticResource BrushLogText}" Background="{StaticResource BrushLogBg}"
                             Padding="0" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FieldLabel}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
                    <TextBlock Text="{Binding VersionDetails}" Style="{StaticResource FieldLabel}" FontSize="10" Opacity="0.6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="200" VerticalAlignment="Center" Margin="12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ProgressDetail}" FontSize="11" Foreground="{StaticResource BrushWarning}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,0" Foreground="{StaticResource BrushNavyPrimary}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Generate Ridges" Command="{Binding RunCommand}" Style="{StaticResource RunButton}" Width="160" Height="36" FontSize="13" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Height="36" Width="90" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
