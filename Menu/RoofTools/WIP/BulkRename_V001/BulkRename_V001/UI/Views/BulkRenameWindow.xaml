<!--
=======================================================
File: BulkRenameWindow.xaml  (Bulk Rename V001 — ToolWindowShell)
  HEADER  metric cards: items / ticked / to rename / problems
  BODY    what-to-rename + filter card, rules card (find/replace, prefix/suffix, tidy, numbering),
          selection row, names grid, log
  FOOTER  Apply, Close
  DataContext: BulkRenameViewModel. The grid, filter and counters bind through Table
  (RenameTableViewModel); the rules card sets its DataContext to Rules (RenameRulesViewModel).
  Everything above the log is disabled while Revit runs a job.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.BulkRename.V001.UI.Views.BulkRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="Bulk Rename"
        Width="960" Height="800"
        MinWidth="960" MinHeight="800"
        ResizeMode="CanResizeWithGrip"
        MaxWidth="1248" MaxHeight="1040"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally per suite convention -->
            <converters:InverseBoolConverter     x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>

            <!-- Dims rows that cannot be renamed (built-in, owned by another user) -->
            <Style x:Key="BulkRenameRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter Property="Opacity" Value="0.55"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A locked row's new name cannot be edited -->
            <Style x:Key="NewNameCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BulkStatusText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                        <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Invalid">
                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Locked">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BulkStatusDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource BrushTextDisabled}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                        <Setter Property="Fill" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Invalid">
                        <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                        <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GridCellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="RuleCheckBox" TargetType="CheckBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Bulk Rename"
                           Subtitle="Rename many line styles, line patterns, arrowheads or fill patterns at once"
                           Version="V001"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Items" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Table.TotalCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Ticked" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Table.TickedCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="To rename" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Table.ChangeCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Problems" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Table.ProblemCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>

                <!-- Disabled while Revit runs a job (loading or renaming) -->
                <StackPanel IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}">

                    <!-- ══ What to rename + filter ══ -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="10,8,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="What to rename"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource StandardComboBox}" FontSize="12"
                                          ItemsSource="{Binding Sources}"
                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="Filter"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <TextBox Grid.Column="3" Style="{StaticResource StyledTextInput}"
                                         ToolTip="Shows only rows whose current name contains this text. The rules act on visible rows only."
                                         Text="{Binding Table.FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="4" Content="Reload" Style="{StaticResource SmallSecondaryButton}"
                                        Margin="10,0,0,0" Command="{Binding ReloadCommand}"
                                        ToolTip="List the items again from the model. Discards names you have not applied."/>
                            </Grid>
                            <TextBlock Text="{Binding SourceDescription}" Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Margin="10,0,10,8"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ Rules (DataContext: Rules) ══ -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8" DataContext="{Binding Rules}">
                        <StackPanel>

                            <!-- Find & Replace -->
                            <Grid Margin="10,8,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Find" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="2" Text="Replace with" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="3" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Match case" Style="{StaticResource RuleCheckBox}"
                                              IsChecked="{Binding MatchCase}"/>
                                    <CheckBox Content="Regex" Style="{StaticResource RuleCheckBox}"
                                              IsChecked="{Binding UseRegex}"
                                              ToolTip="Treat the find text as a regular expression. The replacement can use $1, $2 for groups."/>
                                </StackPanel>
                                <Button Grid.Column="5" Content="Apply" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ApplyFindReplaceCommand}"/>
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <!-- Prefix / Suffix -->
                            <Grid Margin="10,6,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Prefix" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="Add" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding AddPrefixCommand}" Margin="0,0,4,0"/>
                                <Button Grid.Column="3" Content="Remove" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding RemovePrefixCommand}"/>
                                <Border Grid.Column="4" Width="1" Background="{StaticResource BrushSeparator}"
                                        Margin="0,2" VerticalAlignment="Stretch"/>
                                <TextBlock Grid.Column="5" Text="Suffix" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <TextBox Grid.Column="6" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <Button Grid.Column="7" Content="Add" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding AddSuffixCommand}" Margin="0,0,4,0"/>
                                <Button Grid.Column="8" Content="Remove" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding RemoveSuffixCommand}"/>
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <!-- Tidy: spaces and case -->
                            <StackPanel Orientation="Horizontal" Margin="10,6,10,6">
                                <TextBlock Text="Tidy" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="56"/>
                                <Button Content="Clean spaces" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding CleanSpacesCommand}" Margin="0,0,4,0"
                                        ToolTip="Trim the name and turn every run of spaces into one space."/>
                                <Button Content="Spaces → _" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding SpacesToUnderscoresCommand}" Margin="0,0,16,0"/>
                                <Button Content="UPPER" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding UpperCaseCommand}" Margin="0,0,4,0"/>
                                <Button Content="lower" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding LowerCaseCommand}" Margin="0,0,4,0"/>
                                <Button Content="Title Case" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding TitleCaseCommand}"/>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <!-- Numbering -->
                            <Grid Margin="10,6,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Number" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding NumberPattern, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding NumberingHint}"/>
                                <TextBlock Grid.Column="2" Text="Start" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="10,0,6,0"/>
                                <TextBox Grid.Column="3" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding NumberStart, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="4" Text="Step" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="10,0,6,0"/>
                                <TextBox Grid.Column="5" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding NumberStep, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="6" Text="Digits" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="10,0,6,0"/>
                                <TextBox Grid.Column="7" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding NumberDigits, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="8" Content="Apply" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ApplyNumberingCommand}" Margin="10,0,10,0"/>
                                <TextBlock Grid.Column="9" Text="{Binding NumberingHint}" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══ Selection row ══ -->
                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                            <Button Content="Select None" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SelectNoneCommand}" Margin="0,0,6,0"/>
                            <Button Content="Revert names" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding RevertNamesCommand}"
                                    ToolTip="Put every visible row's new name back to its current name."/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                   Text="Rules act on ticked rows that match the filter. Edit a New Name cell to set one by hand."/>
                    </DockPanel>

                    <!-- ══ Names grid ══ -->
                    <Border Style="{StaticResource ContentCard}">
                        <DataGrid ItemsSource="{Binding Table.RowsView}"
                                  MinHeight="180"
                                  shell:ShellBehaviors.MaxHeightRatio="0.5"
                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                                  AlternationCount="2"
                                  RowStyle="{StaticResource BulkRenameRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  Background="{StaticResource BrushSystemBackground}"
                                  BorderThickness="0"
                                  RowHeight="28"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>

                                <!-- Ticked -->
                                <DataGridTemplateColumn Header="☑" Width="36" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      PreviewMouseLeftButtonDown="CheckBoxCell_PreviewMouseLeftButtonDown"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Current name (read-only) -->
                                <DataGridTextColumn Header="Current Name"
                                                    Binding="{Binding CurrentName, Mode=OneWay}"
                                                    Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <!-- New name (editable) -->
                                <DataGridTextColumn Header="New Name"
                                                    Binding="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    Width="*"
                                                    CellStyle="{StaticResource NewNameCellStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Details: Drafting / Model for fill patterns, arrow style for arrowheads, Built-in / Custom for line styles -->
                                <DataGridTextColumn Header="Details"
                                                    Binding="{Binding Details, Mode=OneWay}"
                                                    Width="100" IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Used By"
                                                    Binding="{Binding UsedBy, Mode=OneWay}"
                                                    Width="80" IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <!-- Status -->
                                <DataGridTemplateColumn Header="Status" Width="96" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        ToolTip="{Binding StatusMessage}">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                                         Style="{StaticResource BulkStatusDot}"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource BulkStatusText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <!-- ══ Log ══ -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLog_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ClearLogCommand}"/>
                                <Button Content="Export Log" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Click="ExportLog_Click"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                 MinHeight="90"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                        <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogTextDim}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold" Width="60"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding Message, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource BrushLogText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Text="Apply renames every 'Ready' row in one step. Ctrl+Z in Revit undoes it."/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Apply" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyCommand}" MinWidth="90" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
