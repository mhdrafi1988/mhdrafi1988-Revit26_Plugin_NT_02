<!--
=======================================================
File: MainWindow.xaml
Changes vs V003 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (title bar + version + metrics card),
    middle (selection card + point-mapping grid that fills and scrolls
    itself — no outer ScrollViewer), fixed footer (log with Copy All /
    Copy Selected / Export, summary, Reset left, Apply → Close right).
  - Header/log inline colours replaced by SharedStyles brushes.
  - MinWidth/MinHeight = default size.
  - No behaviour change — every binding/command is the V003 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.RoofPointElevationSync.V004.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.RoofPointElevationSync.V004"
        Title="Roof Point Elevation Sync — V004"
        Width="1000" Height="800" MinWidth="1000" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle (grid scrolls itself) -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Roof Point Elevation Sync" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Match shape points between two roofs and lower the higher one" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V004" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Matched Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MatchedCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="To Apply" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ToApplyCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="Excluded" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ExcludedCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Max Δ Elevation (mm)" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MaxDeltaMm, StringFormat={}{0:F0}}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <!-- Selection card -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Selection" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Roof A" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RoofAName}" Width="220" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Content="Pick..." Command="{Binding PickRoofACommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Roof B" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RoofBName}" Width="220" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Content="Pick..." Command="{Binding PickRoofBCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="XY Tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding XyToleranceMm, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="10" Width="100" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>
                            <Button Content="Find Matching Points" Command="{Binding FindMatchingPointsCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="Tolerance applies to horizontal (XY) distance only; elevation values are compared exactly, not tolerance-matched."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mapping grid card -->
            <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Point Mapping" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="220" Style="{StaticResource BoxedTextInput}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Filter points..."/>
                        <Button Content="Select All" Command="{Binding SelectAllVisibleCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0"/>
                        <Button Content="Clear Selection" Command="{Binding ClearSelectionVisibleCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding MatchRowsView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              SelectionMode="Extended"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsThreeState="True"
                                                  IsChecked="{Binding DataContext.HeaderAllIncluded, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  ToolTip="Select / clear all (excluding equal-elevation pairs)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsEqual, Converter={StaticResource InverseBooleanConverter}}"
                                                  PreviewMouseLeftButtonDown="ChkBox_PreventRowSelect"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Point ID" Binding="{Binding PointId}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat={}{0:N0}}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat={}{0:N0}}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Roof A Elev." Binding="{Binding ElevationA, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Roof B Elev." Binding="{Binding ElevationB, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Target (Lower)" Binding="{Binding TargetLabel}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="New Elev." Binding="{Binding NewElevation, StringFormat={}{0:N0}}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="Pairs with equal elevation are auto-excluded (checkbox disabled, no target)."/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Export Logs (.txt)" Style="{StaticResource DarkGhostButton}" Command="{Binding ExportLogsCommand}" Margin="0,0,6,0"/>
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogCommand}"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Command="{Binding CopySelectedLogCommand}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding LogEntries}" Height="100"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                       Foreground="{StaticResource BrushLogTextDim}"
                                       FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{StaticResource BrushLogText}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}"/>
                <TextBlock Grid.Column="1" Text="{Binding SummaryText}" VerticalAlignment="Center" FontSize="11.5" Margin="12,0"
                           Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource RunButton}" Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
