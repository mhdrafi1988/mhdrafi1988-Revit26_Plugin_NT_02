<!--
=======================================================
File: RoofComparisonWindow.xaml
Location: UI/Views/
Changes vs V001 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (new title bar + version, metrics
    card — the lone avg-diff card folded into the first metrics row),
    scrollable middle (tolerances + marker settings), fixed footer
    (log with Copy All / Copy Selected / Clear, status, then
    Recalculate · Place Markers → Close right-aligned).
  - Inline named metric colours replaced by SharedStyles metric styles.
  - MinWidth/MinHeight = default size.
  - No behaviour change — every binding/command is the V001 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.RoofPointComparison.V002.UI.Views.RoofComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        mc:Ignorable="d"
        Title="Compare Roofs — V002"
        Width="1000"
        Height="820"
        MinWidth="1000"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <shared:LogLevelToColorConverter x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Scrollable middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Compare Roofs" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Shape-point position and elevation comparison between Roof A and Roof B" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V002" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
                    <UniformGrid Columns="5" Rows="1" Margin="0,0,0,6">
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Total Points — A / B" Style="{StaticResource MetricLabel}"/>
                                <TextBlock FontSize="18" Style="{StaticResource MetricNumberAccent}">
                                    <Run Text="{Binding Metrics.TotalPointsA, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.TotalPointsB, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Shape points" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Differences Found" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding Metrics.DifferencesCount, Mode=OneWay}" FontSize="18" Style="{StaticResource MetricNumberDanger}"/>
                                <TextBlock Text="Missing + Mismatched" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Matched Points" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding Metrics.MatchedCount, Mode=OneWay}" FontSize="18" Style="{StaticResource MetricNumberSuccess}"/>
                                <TextBlock Text="Same position &amp; elevation" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Match Percentage" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding Metrics.MatchPercentage, StringFormat=F1, Mode=OneWay}" FontSize="18" Style="{StaticResource MetricNumberWarning}"/>
                                <TextBlock Text="Percent" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Avg Elev. Diff (Matched, B − A)" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Metrics.AverageElevationDiffMatched_mm, StringFormat=F2, Mode=OneWay}" FontSize="18" Style="{StaticResource MetricNumberAccent}"/>
                        <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

                    <UniformGrid Columns="5" Rows="1" Margin="0,0,0,8">
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Highest Elevation A / B" Style="{StaticResource MetricLabel}"/>
                                <TextBlock FontSize="18" Style="{StaticResource MetricNumberAccent}">
                                    <Run Text="{Binding Metrics.HighestElevationA_mm, StringFormat=F0, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.HighestElevationB_mm, StringFormat=F0, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Lowest Elevation A / B" Style="{StaticResource MetricLabel}"/>
                                <TextBlock FontSize="18" Style="{StaticResource MetricNumberAccent}">
                                    <Run Text="{Binding Metrics.LowestElevationA_mm, StringFormat=F0, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.LowestElevationB_mm, StringFormat=F0, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Average Elevation A / B" Style="{StaticResource MetricLabel}"/>
                                <TextBlock FontSize="18" Style="{StaticResource MetricNumberAccent}">
                                    <Run Text="{Binding Metrics.AverageElevationA_mm, StringFormat=F0, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.AverageElevationB_mm, StringFormat=F0, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Elevation Range A / B" Style="{StaticResource MetricLabel}"/>
                                <TextBlock FontSize="18" Style="{StaticResource MetricNumberWarning}">
                                    <Run Text="{Binding Metrics.ElevationRangeA_mm, StringFormat=F0, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.ElevationRangeB_mm, StringFormat=F0, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="3,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Std Dev A / B" Style="{StaticResource MetricLabel}"/>
                                <TextBlock FontSize="18" Style="{StaticResource MetricNumberAccent}">
                                    <Run Text="{Binding Metrics.StdDevElevationA_mm, StringFormat=F1, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.StdDevElevationB_mm, StringFormat=F1, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
        </StackPanel>

        <!-- ═══ SCROLLABLE MIDDLE ═══════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource ContentCard}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Comparison Tolerances" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="4,0,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Position Tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding PositionToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Elevation Tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding ElevationToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SeparatorLine}" Margin="4,0,4,8"/>

                    <TextBlock Text="Visual Markers" Style="{StaticResource SectionTitle}"
                               ToolTip="Placed in the active plan view when 'Place Markers' is run. Skipped with a warning if the active view is not a plan view."/>

                    <!-- Missing Point marker -->
                    <TextBlock Text="Missing Point" Style="{StaticResource FieldValue}" FontWeight="SemiBold" Margin="4,4,4,0"/>
                    <Grid Margin="4,4,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ColorPalette}"
                                      SelectedItem="{Binding MissingMarkerGroup.ColorName, Mode=TwoWay}"
                                      Padding="2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding MissingMarkerGroup.RadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10" Padding="2"/>
                        </StackPanel>
                    </Grid>

                    <!-- Mismatched Elevation marker -->
                    <TextBlock Text="Mismatched Elevation" Style="{StaticResource FieldValue}" FontWeight="SemiBold" Margin="4,0,4,0"/>
                    <Grid Margin="4,4,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ColorPalette}"
                                      SelectedItem="{Binding MismatchMarkerGroup.ColorName, Mode=TwoWay}"
                                      Padding="2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding MismatchMarkerGroup.RadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10" Padding="2"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Processing Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding LogEntries}" Height="110"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                       Foreground="{StaticResource BrushLogTextDim}"
                                       FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource FieldValue}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Recalculate" Command="{Binding RecalculateCommand}"
                            Style="{StaticResource OutlineButton}" Height="32" Width="120" Margin="0,0,8,0"/>
                    <Button Content="Place Markers" Command="{Binding PlaceMarkersCommand}"
                            Style="{StaticResource RunButton}" Height="32" Width="130" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="CloseButton_Click"
                            Style="{StaticResource OutlineButton}" Height="32" Width="90"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
