<!--
=======================================================
File: CombinedRoofToolsWindow.xaml  (V003 — ToolWindowShell, CLAUDE.md v1.1)
Location: UI/Views/
Hosts 5 existing roof tools (Inner Loop Divider, Inner Loops And
Perpendicular, Outer Curve Divider, Auto Slope By Drain, Creaser Adv) as
tabs, all working against one shared picked roof.

Changes vs V002 (layout only):
  - Hosted in Shared/Controls/ToolWindowShell.
    HEADER: title / subtitle / version + Working Roof card, Change Roof.
    BODY:   tool tabs in pipeline order (each tab keeps its own log and
            actions, inside the body).
    FOOTER: shell status strip (IsBusy, indeterminate; Run All status)
            + Run All / Close.
  - Tab views: own ScrollViewers removed; grids and logs cap their height
    (ShellBehaviors.MaxHeightRatio) and forward the mouse wheel; Inner
    Loop Divider's inline group-header colours → SharedStyles brushes.
  - No behaviour change — every binding/command is the V002 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.CombinedRoofTools.V003.UI.Views.CombinedRoofToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:tabs="clr-namespace:Revit26_Plugin_Revised.CombinedRoofTools.V003.UI.Views.Tabs"
        xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.CombinedRoofTools}, Path=Title}"
        Width="1200" Height="880"
        MinWidth="1200" MinHeight="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSystemSecondaryBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:InverseBoolConverter             x:Key="InverseBool"/>

            <!-- Slim top-strip tab style, consistent with the suite's navy/blue palette. -->
            <Style x:Key="CombinedTabItem" TargetType="TabItem">
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                    BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                    Background="Transparent">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Placeholder shown in a tab when its tool can't handle the picked roof. -->
            <Style x:Key="UnavailablePanel" TargetType="StackPanel">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MaxWidth" Value="420"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Combined Roof Tools"
                           Subtitle="Inner Loops · Perpendicular · Outer Curve · Auto Slope By Drain · Creaser — one shared roof"
                           Version="{Binding Source={x:Static svc:ToolCatalog.CombinedRoofTools}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy, Mode=OneWay}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding RunAllStatusMessage}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Working Roof" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Style="{StaticResource FieldValue}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding RoofLabel}"
                                   Visibility="{Binding IsRunningAll, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBlock Style="{StaticResource FieldValue}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding RunAllStatusMessage}"
                                   Visibility="{Binding IsRunningAll, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Content="Change Roof…"
                        Style="{StaticResource SecondaryButton}"
                        Width="140" Height="34" VerticalAlignment="Center"
                        Command="{Binding ChangeRoofCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Border Style="{StaticResource ContentCard}" Padding="0" Margin="0">
                <TabControl Background="Transparent" BorderThickness="0" Padding="12"
                            SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">

                    <TabItem Header="Inner Loop Divider" Style="{StaticResource CombinedTabItem}">
                        <Grid>
                            <tabs:InnerLoopDividerTabView DataContext="{Binding InnerLoopDividerVm}"
                                                           Visibility="{Binding IsInnerLoopDividerAvailable, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Style="{StaticResource UnavailablePanel}"
                                        Visibility="{Binding IsInnerLoopDividerAvailable, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Unavailable for this roof" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding InnerLoopDividerUnavailableReason}" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Inner Loops + Perpendicular" Style="{StaticResource CombinedTabItem}">
                        <Grid>
                            <tabs:InnerLoopsAndPerpendicularTabView DataContext="{Binding InnerLoopsAndPerpendicularVm}"
                                                                     Visibility="{Binding IsInnerLoopsAndPerpendicularAvailable, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Style="{StaticResource UnavailablePanel}"
                                        Visibility="{Binding IsInnerLoopsAndPerpendicularAvailable, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Unavailable for this roof" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding InnerLoopsAndPerpendicularUnavailableReason}" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Outer Curve Divider" Style="{StaticResource CombinedTabItem}">
                        <Grid>
                            <tabs:OuterCurveDividerTabView DataContext="{Binding OuterCurveDividerVm}"
                                                            Visibility="{Binding IsOuterCurveDividerAvailable, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Style="{StaticResource UnavailablePanel}"
                                        Visibility="{Binding IsOuterCurveDividerAvailable, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Unavailable for this roof" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding OuterCurveDividerUnavailableReason}" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Auto Slope By Drain" Style="{StaticResource CombinedTabItem}">
                        <Grid>
                            <tabs:AutoSlopeByDrainTabView DataContext="{Binding AutoSlopeByDrainVm}"
                                                           Visibility="{Binding IsAutoSlopeByDrainAvailable, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Style="{StaticResource UnavailablePanel}"
                                        Visibility="{Binding IsAutoSlopeByDrainAvailable, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Unavailable for this roof" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AutoSlopeByDrainUnavailableReason}" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Creaser Adv" Style="{StaticResource CombinedTabItem}">
                        <Grid>
                            <tabs:CreaserAdvTabView DataContext="{Binding CreaserAdvVm}"
                                                     Visibility="{Binding IsCreaserAdvAvailable, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Style="{StaticResource UnavailablePanel}"
                                        Visibility="{Binding IsCreaserAdvAvailable, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Unavailable for this roof" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CreaserAdvUnavailableReason}" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                        Width="140" Height="34" Margin="0,0,8,0"
                        Command="{Binding RunAllCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Run All ▶"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunningAll}" Value="True">
                                    <Setter Property="Content" Value="⏳ Running…"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="100" Height="36"
                        IsCancel="True" Click="CloseButton_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
