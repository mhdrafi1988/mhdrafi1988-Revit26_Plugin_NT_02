<!--
=======================================================
File: InnerLoopsAndPerpendicularTabView.xaml
Location: CombinedRoofTools_V002/UI/Views/Tabs/
Embeddable UserControl version of InnerLoopsAndPerpendicularWindow.xaml (InnerLoopsAndPerpendicular_V006),
hosted as a tab inside the Combined Roof Tools window. Same three-zone
layout as that window (metrics top, inputs + grids middle, log + actions
bottom) minus its title bar and Close button — the host window provides
both. DataContext is supplied externally; bindings unchanged.
=======================================================
-->
<UserControl x:Class="Revit26_Plugin_Revised.CombinedRoofTools.V002.UI.Views.Tabs.InnerLoopsAndPerpendicularTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:LogLevelToColorConverter         x:Key="LogLevelToColor"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>

            <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Expander Margin="0">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="IsExpanded" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="Circular">
                                                <Setter Property="IsExpanded" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Expander.Header>
                                    <Grid Background="{StaticResource BrushSystemTertiaryBackground}" Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushNavyPrimary}"
                                                   VerticalAlignment="Center" Margin="10,0,10,0"/>
                                        <Border Grid.Column="1" Background="{StaticResource BrushCardBackground}"
                                                CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCount}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushNavyPrimary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Content="Select All"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" Margin="0,0,6,0" FontSize="10.5"
                                                    Click="SelectGroupButton_Click" Tag="{Binding Name}"/>
                                            <Button Content="Select None"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" FontSize="10.5"
                                                    Click="ClearGroupButton_Click" Tag="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsPresenter/>
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle (grids scroll themselves) -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <UniformGrid Columns="3" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Selected Shapes" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedShapeCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Perpendicular Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PerpendicularPointCount}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Log Entries" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Log.Count}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>               <!-- Toolbar                -->
                <RowDefinition Height="*" MinHeight="160"/>  <!-- Shapes data grid/empty -->
                <RowDefinition Height="Auto"/>               <!-- Tolerance + Generate   -->
                <RowDefinition Height="*" MinHeight="140"/>  <!-- Perpendicular points   -->
            </Grid.RowDefinitions>

            <!-- ─── TOOLBAR ─── -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                <Button Content="Clear" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,6,0"/>
                <Button Content="Re-analyze" Style="{StaticResource SmallSecondaryButton}" Command="{Binding AnalyzeCommand}"/>
            </StackPanel>

            <!-- ─── SHAPES DATA GRID (all types — Circular / Rectangular / Other) ── -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}"
                    Visibility="{Binding HasLoops, Converter={StaticResource BoolToVisibility}}">
                <DataGrid ItemsSource="{Binding LoopsView}"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                          CellStyle="{StaticResource StandardDataGridCell}"
                          RowStyle="{StaticResource StandardDataGridRow}">
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}">
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Index"
                                            Binding="{Binding Index}"
                                            IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding LoopType}"
                                            IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Shape"
                                            Binding="{Binding LoopShapeType}"
                                            IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="Perimeter (mm)"
                                            Binding="{Binding PerimeterMm, StringFormat={}{0:N0}}"
                                            IsReadOnly="True" Width="140"/>
                        <DataGridCheckBoxColumn Header="Selected"
                                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ─── EMPTY STATE (shapes) ────────────────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}"
                    Visibility="{Binding HasLoops, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                    <TextBlock Text="No inner shapes detected"
                               Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="The selected roof has no inner boundary loops to process."
                               Style="{StaticResource HintText}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ─── TOLERANCE + GENERATE ───────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="0,8,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Tolerance (mm)"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource BorderlessTextInput}"
                             Text="{Binding ToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="6"
                             Width="80" Height="30" FontSize="13"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="Used to gather adjacent SlabShapeVertices when resolving the lowest elevation for each new point. Only rectangular (4-side) selections produce candidates."
                               Style="{StaticResource HintText}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <Button Grid.Column="3" Content="Generate Perpendicular Points"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding GeneratePerpendicularPointsCommand}"/>
                </Grid>
            </Border>

            <!-- ─── PERPENDICULAR POINTS DATA GRID ─────────────────────────── -->
            <Border Grid.Row="3" Style="{StaticResource ContentCard}"
                    Visibility="{Binding HasPerpendicularPoints, Converter={StaticResource BoolToVisibility}}">
                <DataGrid ItemsSource="{Binding PerpendicularPoints}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                          CellStyle="{StaticResource StandardDataGridCell}"
                          RowStyle="{StaticResource StandardDataGridRow}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Use"
                                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                Width="50"/>
                        <DataGridTextColumn Header="Shape #" Binding="{Binding ShapeIndex}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="Side" Binding="{Binding Side}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Candidates" Binding="{Binding CandidateCount}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="Selected Point (m)" Binding="{Binding PointDisplay}" IsReadOnly="True" Width="160"/>
                        <DataGridTextColumn Header="Distance (mm)" Binding="{Binding DistanceMm, StringFormat={}{0:N1}}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="Elevation (mm)" Binding="{Binding ElevationMm, StringFormat={}{0:N0}}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ─── EMPTY STATE (perpendicular points) ─────────────────────── -->
            <Border Grid.Row="3" Style="{StaticResource ContentCard}"
                    Visibility="{Binding HasPerpendicularPoints, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                    <TextBlock Text="No perpendicular points generated yet"
                               Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select shapes above and click 'Generate Perpendicular Points'."
                               Style="{StaticResource HintText}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Log}" Height="100"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                       Foreground="{StaticResource BrushLogTextDim}"
                                       FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Level}"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Width="64"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{StaticResource BrushLogText}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply Perpendicular Points"
                        Style="{StaticResource RunButton}"
                        Width="210" Margin="0,0,10,0"
                        Command="{Binding ApplyPerpendicularCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
