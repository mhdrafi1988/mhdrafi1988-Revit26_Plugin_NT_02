<!--
=======================================================
File: InnerLoopDividerTabView.xaml
Location: CombinedRoofTools_V002/UI/Views/Tabs/
Embeddable UserControl version of InnerLoopDividerWindow.xaml (InnerLoopDivider_V010),
hosted as a tab inside the Combined Roof Tools window. Same three-zone
layout as that window (metrics top, inputs + grids middle, log + actions
bottom) minus its title bar and Close button — the host window provides
both. DataContext is supplied externally; bindings unchanged.
=======================================================
-->
<UserControl x:Class="Revit26_Plugin_Revised.CombinedRoofTools.V002.UI.Views.Tabs.InnerLoopDividerTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:LogLevelToColorConverter         x:Key="LogLevelToColor"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>

            <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Expander Margin="0">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="IsExpanded" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="Circular">
                                                <Setter Property="IsExpanded" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Expander.Header>
                                    <Grid Background="#DCE6F2" Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E3A5F"
                                                   VerticalAlignment="Center" Margin="10,0,10,0"/>
                                        <Border Grid.Column="1" Background="#FFFFFF"
                                                CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCount}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#1E3A5F"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Content="Select All"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" Margin="0,0,6,0" FontSize="10.5"
                                                    Click="SelectGroupButton_Click" Tag="{Binding Name}"/>
                                            <Button Content="Select None"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" FontSize="10.5"
                                                    Click="ClearGroupButton_Click" Tag="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsPresenter/>
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle (grid scrolls itself) -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">

            <!-- ─── SUMMARY CARDS ───────────────────────────────────────────── -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Selected Shapes" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedShapeCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Division Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding QueuedPointCount}" Style="{StaticResource MetricNumberAccent}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Total Openings" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalOpeningsCount}" Style="{StaticResource MetricNumberSuccess}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Global division row -->
                <RowDefinition Height="Auto"/>  <!-- Toolbar             -->
                <RowDefinition Height="*"/>     <!-- Data grid / empty   -->
            </Grid.RowDefinitions>

            <!-- ─── GLOBAL DIVISION CONTROL ────────────────────────────────── -->
            <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Set all loops to"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource BorderlessTextInput}"
                             Text="{Binding GlobalDivisionPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="3"
                             Width="70" Height="30" FontSize="13"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="Applies this value to every loop instantly. Individual rows remain editable independently."
                               Style="{StaticResource HintText}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>
                </Grid>
            </Border>

            <!-- ─── TOOLBAR ─── -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button Content="Select All"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding SelectAllCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Clear"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding ClearSelectionCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Re-analyze"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding AnalyzeCommand}"/>
            </StackPanel>

            <!-- ─── DATA GRID ───────────────────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource ContentCard}"
                    Visibility="{Binding HasLoops, Converter={StaticResource BoolToVisibility}}">
                <DataGrid ItemsSource="{Binding LoopsView}"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                          CellStyle="{StaticResource StandardDataGridCell}"
                          RowStyle="{StaticResource StandardDataGridRow}">
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}">
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Index"
                                            Binding="{Binding Index}"
                                            IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding LoopType}"
                                            IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Shape"
                                            Binding="{Binding LoopShapeType}"
                                            IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="Perimeter (mm)"
                                            Binding="{Binding PerimeterMm, StringFormat={}{0:N0}}"
                                            IsReadOnly="True" Width="130"/>
                        <DataGridCheckBoxColumn Header="Selected"
                                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80"/>
                        <!-- Per-row editable division points -->
                        <DataGridTemplateColumn Header="Div. Points" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             Text="{Binding RecommendedPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="3"
                                             Width="70" HorizontalAlignment="Left"
                                             HorizontalContentAlignment="Center"
                                             Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Segment Length (m)"
                                            Binding="{Binding DividedLengthMeters}"
                                            IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ─── EMPTY STATE ─────────────────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource ContentCard}"
                    Visibility="{Binding HasLoops, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                    <TextBlock Text="No inner loops detected"
                               Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="The selected roof has no inner boundary loops to divide."
                               Style="{StaticResource HintText}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click" Margin="0,0,6,0"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="0,0,6,0"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" x:Name="LogList" ItemsSource="{Binding Log}" Height="100"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                               Foreground="{StaticResource BrushLogTextDim}"
                                               FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Level}"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                               FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                                               Width="64"/>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{StaticResource BrushLogText}"
                                               FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply Division Points"
                        Style="{StaticResource RunButton}"
                        Width="200" Margin="0,0,10,0"
                        Command="{Binding ApplyDivisionCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
