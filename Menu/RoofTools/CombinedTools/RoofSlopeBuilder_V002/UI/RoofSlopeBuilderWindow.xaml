<Window x:Class="Revit26_Plugin_Revised.RoofSlopeBuilder.V002.UI.RoofSlopeBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roof Slope Builder"
        Width="940" Height="640" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Width" Value="160"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="20,2,0,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnFindRidges" Content="Find ridges only" Width="120" Height="26" Margin="0,0,8,0" Click="BtnFindRidges_Click"
                            ToolTip="Draw the ridge lines and points in the active plan view without changing the roofs"/>
                    <Button x:Name="BtnApply" Content="Apply" Width="100" Height="26" IsDefault="True" Click="BtnApply_Click"/>
                    <Button Content="Cancel" Width="80" Height="26" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
                <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" Foreground="#444"/>
            </DockPanel>
        </Border>

        <!-- roofs -->
        <Border DockPanel.Dock="Left" Width="250" BorderBrush="#CCC" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Selected roofs" FontWeight="SemiBold" Margin="10,8,10,4"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,10,6">
                    <Button Content="All" Width="50" Click="BtnAllRoofs_Click"/>
                    <Button Content="None" Width="50" Margin="6,0,0,0" Click="BtnNoRoofs_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="Gray" Margin="10,6"
                           Text="Settings apply to every ticked roof. Each roof gets its own drains and ridges."/>
                <Border x:Name="BdrNotice" Visibility="Collapsed" DockPanel.Dock="Bottom" Margin="10,6,10,0" Padding="6,4" Background="#FDF1E1" BorderBrush="#E8B66B" BorderThickness="1">
                    <TextBlock x:Name="TxtNotice" TextWrapping="Wrap" Foreground="#7A4A00" FontSize="11"/>
                </Border>
                <ListBox x:Name="LstRoofs" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Use, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Info}" Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" Foreground="#9A5B00" FontSize="11"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- tabs -->
        <TabControl Margin="8">

            <!-- 1 POINTS -->
            <TabItem Header="1 - Points">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <GroupBox Header="Boundary loops">
                            <StackPanel>
                                <CheckBox Content="Outer loop (always)" IsChecked="True" IsEnabled="False"/>
                                <CheckBox x:Name="ChkInner" Content="Inner loops / openings" IsChecked="True" FontWeight="SemiBold"/>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource Lbl}" Text="Min opening area"/>
                                    <TextBox x:Name="TxtInnerArea" Text="0.05"/>
                                    <TextBlock Style="{StaticResource Unit}" Text="m2 - smaller openings are ignored"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Perpendicular points">
                            <StackPanel>
                                <CheckBox x:Name="ChkPerp" Content="Add perpendicular points from each drain" IsChecked="True" FontWeight="SemiBold"/>
                                <StackPanel Margin="20,0,0,0">
                                    <CheckBox x:Name="ChkPerpEdge" Content="onto boundary edges" IsChecked="True"/>
                                    <CheckBox x:Name="ChkPerpRidge" Content="onto ridges between drains" IsChecked="True"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Ridges between drains (roofs with 2 or more drains)">
                            <StackPanel>
                                <CheckBox x:Name="ChkRidge" Content="Add ridge points between selected drains" IsChecked="True" FontWeight="SemiBold"/>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource Lbl}" Text="Ridge type"/>
                                    <ComboBox x:Name="CmbRidgeMode" SelectedIndex="0" Width="330" SelectionChanged="RidgeMode_Changed">
                                        <ComboBoxItem Content="Watershed ridge - level deck, falls to each drain"/>
                                        <ComboBoxItem Content="Saddle (diamond cricket) - drains on a valley line"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource Lbl}" Text="Point spacing along ridge"/>
                                    <TextBox x:Name="TxtRidgeSpacing" Text="1500"/>
                                    <TextBlock Style="{StaticResource Unit}" Text="mm"/>
                                </StackPanel>
                                <StackPanel x:Name="PnlSaddle" Visibility="Collapsed">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource Lbl}" Text="Saddle width"/>
                                        <ComboBox x:Name="CmbSaddleRatio" SelectedIndex="1">
                                            <ComboBoxItem Content="1/4 of drain spacing" Tag="0.25"/>
                                            <ComboBoxItem Content="1/3 of drain spacing" Tag="0.333333"/>
                                            <ComboBoxItem Content="1/2 of drain spacing" Tag="0.5"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource Lbl}" Text="Saddle slope"/>
                                        <TextBox x:Name="TxtSaddleFactor" Text="2"/>
                                        <TextBlock Style="{StaticResource Unit}" Text="x field slope (rule of thumb: 2)"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource Lbl}" Text="Max drain spacing"/>
                                        <TextBox x:Name="TxtMaxSpacing" Text="24000"/>
                                        <TextBlock Style="{StaticResource Unit}" Text="mm - drains farther apart get no saddle"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox x:Name="ChkSplit" Content="Add split lines along ridges" IsChecked="True" Margin="20,4,0,4"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2 CURVES -->
            <TabItem Header="2 - Curves">
                <StackPanel Margin="8">
                    <GroupBox Header="Points on curved edges">
                        <StackPanel>
                            <CheckBox x:Name="ChkCurve" Content="Add points along arcs / splines" IsChecked="True" FontWeight="SemiBold"/>
                            <StackPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Lbl}" Text="Points per large curve"/>
                                <TextBox x:Name="TxtCurveCount" Text="4"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Lbl}" Text="Large curve is longer than"/>
                                <TextBox x:Name="TxtCurveBig" Text="2000"/>
                                <TextBlock Style="{StaticResource Unit}" Text="mm"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkCurveMid" Content="Small curves get a midpoint" IsChecked="True" Margin="20,4,0,4"/>
                            <StackPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Lbl}" Text="Minimum gap" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtCurveGap" Text="300"/>
                                <TextBlock Style="{StaticResource Unit}" Text="mm between points on a curve"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Lbl}" Text="If the gap cannot be met"/>
                                <ComboBox x:Name="CmbGapMode" SelectedIndex="0">
                                    <ComboBoxItem Content="Reduce point count (keep gap)"/>
                                    <ComboBoxItem Content="Keep count (ignore gap)"/>
                                    <ComboBoxItem Content="Skip the curve and warn"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- 3 DRAINS & SLOPE -->
            <TabItem Header="3 - Drains &amp; Slope">
                <DockPanel Margin="8">
                    <GroupBox DockPanel.Dock="Bottom" Header="Slope by drain">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lbl}" Text="Slope"/>
                                <TextBox x:Name="TxtSlope" Text="1.5" TextChanged="Slope_Changed"/>
                                <ComboBox x:Name="CmbSlopeUnit" SelectedIndex="0" MinWidth="80" SelectionChanged="Slope_Changed">
                                    <ComboBoxItem Content="%"/>
                                    <ComboBoxItem Content="1 : n"/>
                                    <ComboBoxItem Content="mm/m"/>
                                </ComboBox>
                                <TextBlock x:Name="TxtSlopeInfo" Style="{StaticResource Unit}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lbl}" Text="Minimum finished fall  1 :"/>
                                <TextBox x:Name="TxtMinFall" Text="80"/>
                                <TextBlock Style="{StaticResource Unit}" Text="warn when flatter"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lbl}" Text="Max height"/>
                                <TextBox x:Name="TxtMaxHeight" Text="300"/>
                                <TextBlock Style="{StaticResource Unit}" Text="mm - warn when exceeded"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Drains (openings in the roof)">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <CheckBox x:Name="ChkLowest" Content="Select lowest-size openings by default" IsChecked="True" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Lbl}" Text="Max drain opening size"/>
                                    <TextBox x:Name="TxtDrainMax" Text="0.25"/>
                                    <TextBlock Style="{StaticResource Unit}" Text="m2 - larger = hatch / skylight"/>
                                    <Button Content="Re-detect" Width="80" Margin="12,0,0,0" Click="BtnRedetect_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <DataGrid x:Name="GridDrains" Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      SelectionMode="Single" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Drain" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" Margin="0"
                                                          IsChecked="{Binding Use, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Roof" Binding="{Binding Roof}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="Opening" Binding="{Binding Opening}" IsReadOnly="True" Width="90"/>
                                    <DataGridTextColumn Header="Size (m2)" Binding="{Binding Size}" IsReadOnly="True" Width="80"/>
                                    <DataGridTextColumn Header="Centre X, Y (m)" Binding="{Binding Position}" IsReadOnly="True" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </DockPanel>
            </TabItem>

            <!-- 4 OPTIONS -->
            <TabItem Header="4 - Options">
                <StackPanel Margin="8">
                    <GroupBox Header="Before running">
                        <StackPanel>
                            <CheckBox x:Name="ChkReset" Content="Reset existing shape-edit points on each roof first" IsChecked="True"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lbl}" Text="Never place points closer than"/>
                                <TextBox x:Name="TxtMerge" Text="100"/>
                                <TextBlock Style="{StaticResource Unit}" Text="mm"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lbl}" Text="Round point heights to"/>
                                <TextBox x:Name="TxtRound" Text="1"/>
                                <TextBlock Style="{StaticResource Unit}" Text="mm (0 = no rounding)"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray"
                               Text="Each roof runs in its own transaction: a roof that fails is rolled back and reported, the others are kept. One Undo removes the whole run. Your options are remembered for next time."/>
                </StackPanel>
            </TabItem>

            <!-- 5 RIDGES (V002) -->
            <TabItem Header="5 - Ridges">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Border x:Name="BdrNotPlan" Visibility="Collapsed" Margin="0,0,0,10" Padding="6,4" Background="#FDF1E1" BorderBrush="#E8B66B" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap" Foreground="#7A4A00"
                                       Text="The active view is not a plan view. Ridges can only be drawn in a plan view: open one and run the tool again. Apply still slopes the roofs."/>
                        </Border>
                        <GroupBox Header="Ridge lines (between drains: watershed lines, or saddle crests)">
                            <StackPanel>
                                <CheckBox x:Name="ChkDrawRidges" Content="Draw ridge lines in the active plan view" FontWeight="SemiBold"/>
                                <StackPanel Margin="20,2,0,0" IsEnabled="{Binding IsChecked, ElementName=ChkDrawRidges}">
                                    <RadioButton x:Name="RbDetailLine" GroupName="LineKind" Content="Detail line" Margin="0,4"/>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource Lbl}" Text="Line style"/>
                                        <ComboBox x:Name="CmbLineStyle" IsEnabled="{Binding IsChecked, ElementName=RbDetailLine}"/>
                                    </StackPanel>
                                    <RadioButton x:Name="RbFamily" GroupName="LineKind" Content="Line-based detail family" Margin="0,4"/>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource Lbl}" Text="Family type"/>
                                        <ComboBox x:Name="CmbFamilyType" MinWidth="300" IsEnabled="{Binding IsChecked, ElementName=RbFamily}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtNoFamilies" Visibility="Collapsed" Margin="20,0,0,4" Foreground="Gray" TextWrapping="Wrap"
                                               Text="No line-based detail families are loaded in this model."/>
                                    <TextBlock Margin="20,2,0,0" Foreground="Gray" TextWrapping="Wrap"
                                               Text="If a family cannot be placed, that ridge is drawn as a detail line in the line style above instead. The report says how many."/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Ridge points">
                            <StackPanel>
                                <CheckBox x:Name="ChkMarkPoints" Content="Mark ridge points with detail circles" FontWeight="SemiBold"/>
                                <StackPanel Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=ChkMarkPoints}">
                                    <TextBlock Style="{StaticResource Lbl}" Text="Circle diameter"/>
                                    <TextBox x:Name="TxtPointDia" Text="150"/>
                                    <TextBlock Style="{StaticResource Unit}" Text="mm - same line style as the ridge lines"/>
                                </StackPanel>
                                <TextBlock Margin="20,2,0,0" Foreground="Gray" TextWrapping="Wrap"
                                           Text="Ridge points: the ends and meeting points of the ridges, and points along them at the ridge point spacing (tab 1)."/>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                                   Text="Apply slopes the roofs and draws the ridges in the same step (one Undo). Find ridges only draws them and leaves the roofs as they are."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
