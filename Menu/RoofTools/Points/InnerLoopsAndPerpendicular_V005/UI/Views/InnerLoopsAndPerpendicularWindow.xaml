<!--
=======================================================
File: InnerLoopsAndPerpendicularWindow.xaml
Location: UI/Views/
Renamed from PerpendicularPointWindow (V003) for consistency with the
tool's own name.

Changes vs V003 (same treatment as InnerLoopDivider V009 — approved
mockup applies to this tool too):
  - mah:MetroWindow root -> plain Window. Drops MahApps-only chrome
    attributes and the 3 MahApps.Metro merged resource dictionaries —
    this window's cards/grid/log already used SharedStyles.xaml for
    everything else, so nothing else in the layout changes.
  - The mah:NumericUpDown spinner (Tolerance mm) -> plain numeric
    TextBox using BorderlessTextInput, matching the numeric-field
    convention used elsewhere in the suite.
  - MinWidth/MinHeight now locked to the default Width/Height (window
    could previously be resized below its own default size).
  - IsCancel="True" on the Close button now also wired to Click, so Esc
    and the button both call Close() on this modeless window.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.InnerLoopsAndPerpendicular.V005.UI.Views.InnerLoopsAndPerpendicularWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="Inner Loops And Perpendicular — V005"
        Height="780" Width="1000"
        MinHeight="780" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:LogLevelToColorConverter         x:Key="LogLevelToColor"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>

            <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Expander Margin="0">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="IsExpanded" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="Circular">
                                                <Setter Property="IsExpanded" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Expander.Header>
                                    <Grid Background="#DCE6F2" Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E3A5F"
                                                   VerticalAlignment="Center" Margin="10,0,10,0"/>
                                        <Border Grid.Column="1" Background="#FFFFFF"
                                                CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCount}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#1E3A5F"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Content="Select all"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" Margin="0,0,6,0" FontSize="10.5"
                                                    Click="SelectGroupButton_Click" Tag="{Binding Name}"/>
                                            <Button Content="Select none"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" FontSize="10.5"
                                                    Click="ClearGroupButton_Click" Tag="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsPresenter/>
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header bar             -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar                -->
            <RowDefinition Height="Auto"/>  <!-- Summary cards          -->
            <RowDefinition Height="200"/>   <!-- Shapes data grid/empty -->
            <RowDefinition Height="Auto"/>  <!-- Tolerance + Generate   -->
            <RowDefinition Height="*"/>     <!-- Perpendicular points   -->
            <RowDefinition Height="Auto"/>  <!-- Activity log           -->
            <RowDefinition Height="Auto"/>  <!-- Action buttons         -->
        </Grid.RowDefinitions>

        <!-- ─── HEADER BAR ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" CornerRadius="10" Margin="0,0,0,10">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Inner Loops And Perpendicular" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="V005  ·  Perpendicular roof-border point placement" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#14283F" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="Revit26_Plugin_Revised.InnerLoopsAndPerpendicular.V005"
                               FontFamily="Consolas" FontSize="10" Foreground="#7E94AA"/>
                </Border>
            </Grid>
        </Border>

        <!-- ─── TOOLBAR ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Select all"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding SelectAllCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Clear"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding ClearSelectionCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Re-analyze"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding AnalyzeCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ─── SUMMARY CARDS ───────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Selected shapes" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding SelectedShapeCount}" Style="{StaticResource MetricNumber}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="Perpendicular points" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding PerpendicularPointCount}" Style="{StaticResource MetricNumberWarning}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ─── SHAPES DATA GRID (all types — Circular / Rectangular / Other) ── -->
        <Border Grid.Row="3" Style="{StaticResource ContentCard}"
                Visibility="{Binding HasLoops, Converter={StaticResource BoolToVisibility}}">
            <DataGrid ItemsSource="{Binding LoopsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      Style="{StaticResource StandardDataGrid}"
                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                      CellStyle="{StaticResource StandardDataGridCell}"
                      RowStyle="{StaticResource StandardDataGridRow}">
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}">
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Index"
                                        Binding="{Binding Index}"
                                        IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding LoopType}"
                                        IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Shape"
                                        Binding="{Binding LoopShapeType}"
                                        IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="Perimeter (mm)"
                                        Binding="{Binding PerimeterMm, StringFormat={}{0:N0}}"
                                        IsReadOnly="True" Width="140"/>
                    <DataGridCheckBoxColumn Header="Selected"
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ─── EMPTY STATE (shapes) ────────────────────────────────────── -->
        <Border Grid.Row="3" Style="{StaticResource ContentCard}"
                Visibility="{Binding HasLoops, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                <TextBlock Text="No inner shapes detected"
                           Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="The selected roof has no inner boundary loops to process."
                           Style="{StaticResource HintText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ─── TOLERANCE + GENERATE ───────────────────────────────────── -->
        <Border Grid.Row="4" Style="{StaticResource ContentCard}" Margin="0,8,0,8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Tolerance (mm)"
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBox Grid.Column="1"
                         Style="{StaticResource BorderlessTextInput}"
                         Text="{Binding ToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="6"
                         Width="80" Height="30" FontSize="13"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="Used to gather adjacent SlabShapeVertices when resolving the lowest elevation for each new point. Only rectangular (4-side) selections produce candidates."
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>

                <Button Grid.Column="3" Content="Generate perpendicular points"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding GeneratePerpendicularPointsCommand}"/>
            </Grid>
        </Border>

        <!-- ─── PERPENDICULAR POINTS DATA GRID ─────────────────────────── -->
        <Border Grid.Row="5" Style="{StaticResource ContentCard}"
                Visibility="{Binding HasPerpendicularPoints, Converter={StaticResource BoolToVisibility}}">
            <DataGrid ItemsSource="{Binding PerpendicularPoints}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      Style="{StaticResource StandardDataGrid}"
                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                      CellStyle="{StaticResource StandardDataGridCell}"
                      RowStyle="{StaticResource StandardDataGridRow}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Use"
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="50"/>
                    <DataGridTextColumn Header="Shape #" Binding="{Binding ShapeIndex}" IsReadOnly="True" Width="70"/>
                    <DataGridTextColumn Header="Side" Binding="{Binding Side}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Candidates" Binding="{Binding CandidateCount}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="Selected point (m)" Binding="{Binding PointDisplay}" IsReadOnly="True" Width="160"/>
                    <DataGridTextColumn Header="Distance (mm)" Binding="{Binding DistanceMm, StringFormat={}{0:N1}}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="Elevation (mm)" Binding="{Binding ElevationMm, StringFormat={}{0:N0}}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ─── EMPTY STATE (perpendicular points) ─────────────────────── -->
        <Border Grid.Row="5" Style="{StaticResource ContentCard}"
                Visibility="{Binding HasPerpendicularPoints, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                <TextBlock Text="No perpendicular points generated yet"
                           Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Select shapes above and click 'Generate perpendicular points'."
                           Style="{StaticResource HintText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ─── ACTIVITY LOG ────────────────────────────────────────────── -->
        <Border Grid.Row="6" Background="{StaticResource BrushLogBg}"
                CornerRadius="8" Margin="0,8,0,10" MaxHeight="150">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Collapsed by default; user expands via the header toggle.
                     Bottom corners round off while collapsed. -->
                <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}"
                        Padding="12,7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=LogToggle}" Value="True">
                                    <Setter Property="CornerRadius" Value="8,8,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <ToggleButton x:Name="LogToggle" IsChecked="False"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Cursor="Hand" ToolTip="Show / hide activity log">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <TextBlock x:Name="Chevron" Text="&#x25B8;"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontSize="11.5" Width="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activity log"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#x25BE;"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Button Content="Clear"
                                Style="{StaticResource DarkGhostButton}"
                                Command="{Binding ClearLogCommand}"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8"
                              Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                               Foreground="{StaticResource BrushLogTextDim}"
                                               FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Level}"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                               FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                                               Width="64"/>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{StaticResource BrushLogText}"
                                               FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ─── ACTION BUTTONS ──────────────────────────────────────────── -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close"
                    Style="{StaticResource OutlineButton}"
                    Width="90" Height="38" IsCancel="True"
                    Click="CloseButton_Click" Margin="0,0,10,0"/>
            <Button Content="Apply perpendicular points"
                    Style="{StaticResource PrimaryButton}"
                    Width="210"
                    Command="{Binding ApplyPerpendicularCommand}"/>
        </StackPanel>
    </Grid>
</Window>
