<!--
=======================================================
File: MainWindow.xaml
Location: UI/Views/
Changes vs V007 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (title bar + metrics card), scrollable
    middle (selection, settings, preview grid), fixed footer (log +
    Copy All / Copy Selected, summary, Preview / Apply / Close).
  - Footer is never inside a ScrollViewer; the DataGrid scrolls itself.
  - No behaviour change — every binding/command is the V007 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.RoofEdgeVertexReducer.V008.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="Roof Edge Vertex Reducer — V008" Height="700" Width="460"
        MinHeight="700" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Scrollable middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Roof Edge Vertex Reducer" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Straight-edge interior point simplification" Style="{StaticResource HeaderSubtitle}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="V008" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Metrics card -->
            <UniformGrid Columns="2" Margin="10,10,10,0">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Preview Rows" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PreviewRows.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Log Entries" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Logs.Count}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ SCROLLABLE MIDDLE ═══════════════════════════════ -->
        <Grid Grid.Row="1" Margin="10,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- Selection -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Selection" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select Roof" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectRoofCommand}"/>
                            <TextBlock Text="{Binding RoofLabel}" Style="{StaticResource FieldValue}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="Tolerance" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" Width="94"/>
                            <TextBox Style="{StaticResource BoxedTextInput}" Width="60" MaxLength="10" FontSize="10"
                                     Text="{Binding ToleranceMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Neighbor Offset" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" Width="94"/>
                            <TextBox Style="{StaticResource BoxedTextInput}" Width="60" MaxLength="10" FontSize="10"
                                     Text="{Binding NeighborOffset, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="N" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                        <TextBlock Text="Outer loops only — keeps the max-Z point plus the point N positions away on each side."
                                   Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Preview grid (scrolls itself) -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Preview Results" Style="{StaticResource SectionTitle}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False"
                              Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                              CellStyle="{StaticResource StandardDataGridCell}"
                              RowStyle="{StaticResource StandardDataGridRow}"
                              IsReadOnly="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="*"/>
                            <DataGridTextColumn Header="Point" Binding="{Binding PointId}" Width="50"/>
                            <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="70"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="10,0,10,10">
            <!-- Log -->
            <Border CornerRadius="10" Background="{StaticResource BrushLogBg}" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" Grid.Column="0" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Log" Foreground="{StaticResource BrushLogText}" FontSize="11" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogsCommand}" Margin="0,0,6,0"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLogs_Click" Margin="0,0,6,0"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogsCommand}"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" x:Name="LogList" ItemsSource="{Binding Logs}" Height="110"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource BrushLogText}"
                             SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="10.5"
                                           Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Summary line -->
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource StatusText}" Margin="2,0,2,8"/>

            <!-- Buttons: primary actions → Close, right-aligned -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Preview" Style="{StaticResource SecondaryButton}" MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding PreviewCommand}" IsEnabled="{Binding CanPreview}"/>
                <Button Content="Apply" Style="{StaticResource RunButton}" MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}" MinWidth="80" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
