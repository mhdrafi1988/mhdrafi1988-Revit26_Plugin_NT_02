<!--
=======================================================
File: RoofShapeFromLinkWindow.xaml  (V002, ToolWindowShell)
  HEADER  4 metric tiles (roofs, points, matched, to apply)
  BODY    Roofs · Linked files (searchable tick list) · Options (global source, offset)
          · editable Shape points grid · Activity log
  FOOTER  shell status strip; Apply -> Close
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.RoofShapeFromLink.V002.UI.Views.RoofShapeFromLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding WindowTitle}"
        Width="1100" Height="860"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSystemSecondaryBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Roof Shape From Link"
                           Subtitle="Reads the roof above each selected footprint roof from the ticked linked files and sets each shape-editing point to the linked roof's top-surface elevation (or its nearest shape point), minus a fixed number."
                           Version="{Binding Source={x:Static svc:ToolCatalog.RoofShapeFromLink}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══ -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Roofs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RoofCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Rows.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="With linked elevation" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MatchedCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="To apply" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding IncludedCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═══ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>

                <!-- Roofs -->
                <TextBlock Text="Roofs" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource ContentCard}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RoofSummary}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Change selection…" Style="{StaticResource SmallSecondaryButton}" Width="140"
                                Command="{Binding ChangeSelectionCommand}"/>
                    </Grid>
                </Border>

                <!-- Linked files -->
                <TextBlock Text="Linked files" Style="{StaticResource SectionTitle}" Margin="0,10,0,0"/>
                <Border Style="{StaticResource ContentCard}" Padding="12,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2"
                                     Text="{Binding LinkSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search linked files by name"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Select all"  Style="{StaticResource SmallSecondaryButton}" Width="86" Command="{Binding SelectAllLinksCommand}"/>
                                <Button Content="Select none" Style="{StaticResource SmallSecondaryButton}" Width="86" Margin="6,0,0,0" Command="{Binding SelectNoLinksCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox ItemsSource="{Binding LinksView}" MinHeight="70" MaxHeight="150"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text="{Binding RoofCount, Mode=OneWay, StringFormat='  ({0} roof(s))'}" Foreground="Gray"/>
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <TextBlock Text="Options" Style="{StaticResource SectionTitle}" Margin="0,10,0,0"/>
                <Border Style="{StaticResource ContentCard}" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Take elevation from:" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Width="120" Margin="8,0,0,0"
                                      ItemsSource="{Binding GlobalSourceChoices}" SelectedItem="{Binding GlobalSource}"/>
                            <TextBlock Text="(sets every row; change a single row in the grid)" Style="{StaticResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Subtract:" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2" Width="80" Margin="8,0,0,0"
                                     Text="{Binding GlobalOffset, StringFormat=F3, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource UnitLabel}"/>
                            <TextBlock Text="(New Z = linked Z − thickness − this number; editable per row)" Style="{StaticResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="Subtract host roof thickness" VerticalAlignment="Center"
                                      IsChecked="{Binding SubtractThickness}"/>
                            <TextBlock Text="(New Z = linked Z − roof type thickness − Subtract; the point is then set from the roof base surface)" Style="{StaticResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Nearest point: corner and edge points only" VerticalAlignment="Center"
                                      IsChecked="{Binding BoundaryPointsOnly}"/>
                            <Button Content="Read elevations" Style="{StaticResource PrimaryButton}" Width="150" Margin="24,0,0,0"
                                    Command="{Binding ReadElevationsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Shape points -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Shape points" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding UnitLabel, StringFormat='Elevations in {0}  ·  click a header to sort, drag its edge to resize'}"
                               Style="{StaticResource HintText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- View bar: search, filters, grouping, columns -->
                <Border Style="{StaticResource ContentCard}" Padding="10,8" Margin="0,6,0,0">
                    <WrapPanel>
                        <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2" Width="170" Margin="0,0,8,4"
                                 ToolTip="Search roof, linked roof, note, status and source"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Roof" VerticalAlignment="Center" Margin="0,0,4,4"/>
                        <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2" Width="110" Margin="0,0,10,4"
                                 Text="{Binding RoofFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Status" VerticalAlignment="Center" Margin="0,0,4,4"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" Width="96" Margin="0,0,10,4"
                                  ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding StatusFilter}"/>
                        <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,4,4"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" Width="96" Margin="0,0,14,4"
                                  ItemsSource="{Binding SourceFilterChoices}" SelectedItem="{Binding SourceFilter}"/>
                        <CheckBox Content="Group by roof" IsChecked="{Binding GroupByRoof}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <CheckBox Content="Ticked only" IsChecked="{Binding TickedOnly}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <CheckBox Content="Compact rows" IsChecked="{Binding CompactRows}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <Button x:Name="ColumnsButton" Content="Columns ▾" Style="{StaticResource SmallSecondaryButton}" Width="86" Margin="0,0,6,4"
                                Click="Columns_Click"/>
                        <Button Content="Reset view" Style="{StaticResource SmallSecondaryButton}" Width="86" Margin="0,0,0,4"
                                Command="{Binding ResetViewCommand}"/>
                    </WrapPanel>
                </Border>

                <!-- Bulk bar: acts on the rows that pass the filters -->
                <Border Background="{StaticResource BrushStatusInfoSoft}" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding VisibleCount, StringFormat='Visible rows ({0}):'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" Width="96"
                                  ItemsSource="{Binding GlobalSourceChoices}" SelectedItem="{Binding BulkSource}"/>
                        <Button Content="Set" Style="{StaticResource SmallSecondaryButton}" Width="46" Margin="4,0,14,0" Command="{Binding SetVisibleSourceCommand}"/>
                        <TextBlock Text="Subtract" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2" Width="76"
                                 Text="{Binding BulkOffset, StringFormat=F3, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource UnitLabel}"/>
                        <Button Content="Set" Style="{StaticResource SmallSecondaryButton}" Width="46" Margin="4,0,14,0" Command="{Binding SetVisibleOffsetCommand}"/>
                        <Button Content="Tick" Style="{StaticResource SmallSecondaryButton}" Width="56" Command="{Binding TickVisibleCommand}"/>
                        <Button Content="Untick" Style="{StaticResource SmallSecondaryButton}" Width="56" Margin="6,0,0,0" Command="{Binding UntickVisibleCommand}"/>
                    </WrapPanel>
                </Border>

                <DataGrid x:Name="PointsGrid" Margin="0,6,0,0" MinHeight="260"
                          shell:ShellBehaviors.MaxHeightRatio="0.5"
                          shell:ShellBehaviors.ForwardMouseWheel="True"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ItemsSource="{Binding RowsView}"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          RowStyle="{StaticResource DataGridRowStyle}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
                          FrozenColumnCount="3"
                          RowHeight="{Binding RowHeight}">

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="True" Background="{StaticResource BrushSurfaceHeader}">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat='  ·  {0} point(s)'}" Style="{StaticResource HintText}"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="✓" Width="40" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Roof"        Binding="{Binding RoofLabel}"                          Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Pt"          Binding="{Binding Index}"                              Width="44"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Current Z"   Binding="{Binding CurrentZ, StringFormat=F3}"          Width="90"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Surface Z"   Binding="{Binding SurfaceZ, StringFormat=F3}"          Width="90"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nearest Z"   Binding="{Binding NearestZ, StringFormat=F3}"          Width="90"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nearest dist." Binding="{Binding NearestDistance, StringFormat=F3}" Width="90"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Base Z"      Binding="{Binding BaseZ, StringFormat=F3}"             Width="90"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Thickness"   Binding="{Binding Thickness, StringFormat=F3}"         Width="80"  IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{StaticResource BrushStatusOkSoft}">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushStatusOk}"/>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="No link">
                                                        <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Snapped">
                                                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Below">
                                                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Source" Width="110" SortMemberPath="Source">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource StandardComboBox}" Margin="2"
                                              ItemsSource="{Binding DataContext.SourceChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Subtract"    Binding="{Binding Offset, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="80"/>
                        <DataGridTextColumn Header="New Z"       Binding="{Binding NewZ, StringFormat=F3, UpdateSourceTrigger=LostFocus}"   Width="90">
                            <DataGridTextColumn.CellStyle>
                                <!-- A typed-in value (Source = Manual) is outlined so it stands out from calculated ones. -->
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="Manual">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushStatusWarn}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Offset from base" Binding="{Binding VertexOffset, StringFormat=F3}" Width="110" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Δ vs current" Width="130" SortMemberPath="Delta" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Height="6" CornerRadius="3" Margin="0,0,6,0" Width="{Binding DeltaBar}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrushStatusInfo}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeltaIsUp}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource BrushStatusWarn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding DeltaText}" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Linked roof" Binding="{Binding LinkedRoof}"                         Width="170" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Note"        Binding="{Binding Note}"                               Width="*"   IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding GridSummary}" Style="{StaticResource HintText}" Margin="2,6,0,0" TextWrapping="Wrap"/>

                <!-- Activity log -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}" MinHeight="100"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply to roofs" Style="{StaticResource PrimaryButton}" Width="150" Margin="0,0,8,0"
                        Command="{Binding ApplyCommand}"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
