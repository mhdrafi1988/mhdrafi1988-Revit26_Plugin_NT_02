<!--
=======================================================
File: InnerLoopDividerWindow.xaml
Location: UI/Views/
Changes vs V011:
  HEADER  four tiles: Selected shapes · New points (exactly what Apply
          adds) · Already there (skipped) · Total openings
  BODY    Division settings card: Count / Spacing mode, "Set all loops
          to", spacing (m), "Reset existing offsets first" (off by
          default — V011 reset them on launch).
          Grid: + Size, Source, Total, New, Existing; Points column is
          disabled in Spacing mode; "Segment Length" is the real gap.
  FOOTER  unchanged (status strip now fed by IsRunning / SummaryText).
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.InnerLoopDivider.V012.UI.Views.InnerLoopDividerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.InnerLoopDivider}, Path=Title}"
        Height="760" Width="1000"
        MinHeight="760" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:LogLevelToColorConverter         x:Key="LogLevelToColor"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>

            <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Expander Margin="0">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="IsExpanded" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="Circular">
                                                <Setter Property="IsExpanded" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Expander.Header>
                                    <Grid Background="{StaticResource BrushSystemTertiaryBackground}" Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushNavyPrimary}"
                                                   VerticalAlignment="Center" Margin="10,0,10,0"/>
                                        <Border Grid.Column="1" Background="{StaticResource BrushSurfaceCard}"
                                                CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCount}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushNavyPrimary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Content="Select All"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" Margin="0,0,6,0" FontSize="10.5"
                                                    Click="SelectGroupButton_Click" Tag="{Binding Name}"/>
                                            <Button Content="Select None"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" FontSize="10.5"
                                                    Click="ClearGroupButton_Click" Tag="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsPresenter/>
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Inner Loop Divider"
                           Subtitle="Shape points around roof openings"
                           Version="{Binding Source={x:Static svc:ToolCatalog.InnerLoopDivider}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Selected Shapes" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedShapeCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,6,0"
                        ToolTip="Points Apply will add to the selected loops">
                    <StackPanel>
                        <TextBlock Text="New Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding QueuedPointCount}" Style="{StaticResource MetricNumberAccent}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="0,0,6,0"
                        ToolTip="Planned points that are already shape points — skipped at Apply">
                    <StackPanel>
                        <TextBlock Text="Already There" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ExistingPointCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Total Openings" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalOpeningsCount}" Style="{StaticResource MetricNumberSuccess}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- ─── DIVISION SETTINGS ───────────────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: count mode -->
                        <RadioButton Grid.Row="0" Grid.Column="0" GroupName="DivisionMode"
                                     Content="Points per loop" VerticalAlignment="Center" Margin="0,0,12,0"
                                     IsChecked="{Binding UseCount, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Set all loops to"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="0" Grid.Column="2"
                                 Style="{StaticResource BorderlessTextInput}"
                                 Text="{Binding GlobalDivisionPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding UseCount}"
                                 MaxLength="3" Width="70" Height="30" FontSize="13"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="Points around the whole loop, corners included. Rows stay editable."
                                   Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,0,0,0"/>

                        <!-- Row 1: spacing mode -->
                        <RadioButton Grid.Row="1" Grid.Column="0" GroupName="DivisionMode"
                                     Content="Max spacing" VerticalAlignment="Center" Margin="0,8,12,0"
                                     IsChecked="{Binding UseSpacing, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Gap (m)"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,8,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Style="{StaticResource BorderlessTextInput}"
                                 Text="{Binding SpacingMeters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}"
                                 IsEnabled="{Binding UseSpacing}"
                                 MaxLength="6" Width="70" Height="30" FontSize="13" Margin="0,8,0,0"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="No gap along a loop longer than this. Circles get at least 3 points."
                                   Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,8,0,0"/>

                        <!-- Row 2: reset -->
                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                  Content="Reset existing offsets to 0 first"
                                  IsChecked="{Binding ResetOffsetsFirst, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="3"
                                   Text="Off by default. Flattens EVERY shape point on the roof, in the same Undo step as Apply."
                                   Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,10,0,0"/>
                    </Grid>
                </Border>

                <!-- ─── TOOLBAR ─── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button Content="Select All"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding SelectAllCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="Clear"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding ClearSelectionCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="Re-analyze"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding AnalyzeCommand}"/>
                </StackPanel>

                <!-- ─── DATA GRID ───────────────────────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}"
                        Visibility="{Binding HasLoops, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid ItemsSource="{Binding LoopsView}"
                              MinHeight="160"
                              shell:ShellBehaviors.MaxHeightRatio="0.45"
                              shell:ShellBehaviors.ForwardMouseWheel="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                              CellStyle="{StaticResource StandardDataGridCell}"
                              RowStyle="{StaticResource StandardDataGridRow}">
                        <DataGrid.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}">
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Index}"
                                                IsReadOnly="True" Width="44"/>
                            <DataGridCheckBoxColumn Header="Selected"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="70"/>
                            <DataGridTextColumn Header="Shape"
                                                Binding="{Binding LoopShapeType}"
                                                IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Size (mm)"
                                                Binding="{Binding SizeText}"
                                                IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Source"
                                                Binding="{Binding Source}"
                                                IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Perimeter (mm)"
                                                Binding="{Binding PerimeterMm, StringFormat={}{0:N0}}"
                                                IsReadOnly="True" Width="110"/>
                            <!-- Per-row editable count (Count mode only) -->
                            <DataGridTemplateColumn Header="Points" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource BorderlessTextInput}"
                                                 Text="{Binding RecommendedPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsCountMode}"
                                                 MaxLength="3"
                                                 Width="60" HorizontalAlignment="Left"
                                                 HorizontalContentAlignment="Center"
                                                 Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding PlannedTotal}"
                                                IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="New"
                                                Binding="{Binding PlannedNew}"
                                                IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Existing"
                                                Binding="{Binding PlannedExisting}"
                                                IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Gap (m)"
                                                Binding="{Binding DividedLengthMeters}"
                                                IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ─── EMPTY STATE ─────────────────────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}"
                        Visibility="{Binding HasLoops, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                        <TextBlock Text="No openings found"
                                   Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="The selected roof has no openings in its sketch or top surface."
                                   Style="{StaticResource HintText}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ─── ACTIVITY LOG (moved from footer) ─── -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click" Margin="0,0,6,0"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="0,0,6,0"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="LogList" ItemsSource="{Binding Log}" MinHeight="100" shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                                   FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                                                   Width="64"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add Shape Points"
                        Style="{StaticResource PrimaryButton}"
                        Width="200" Margin="0,0,10,0"
                        Command="{Binding ApplyDivisionCommand}"/>
                <Button Content="Close"
                        Style="{StaticResource OutlineButton}"
                        Width="90" Height="38" IsCancel="True"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
