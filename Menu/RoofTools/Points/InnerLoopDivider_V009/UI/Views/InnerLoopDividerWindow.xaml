<!--
=======================================================
File: InnerLoopDividerWindow.xaml
Location: UI/Views/
Renamed from RoofLoopAnalyzerWindow (V007) for consistency with the
tool's own name.

Changes vs V007 (per approved mockup):
  - mah:MetroWindow root → plain Window. Drops MahApps-only chrome
    attributes (TitleCharacterCasing, ShowMaxRestoreButton) and the
    3 MahApps.Metro merged resource dictionaries (Controls/Fonts/Theme)
    — this window's cards/grid/log already used SharedStyles.xaml for
    everything else, so nothing else in the layout changes.
  - Both mah:NumericUpDown spinners (global "Set all loops to" and the
    per-row "Div. points" column) → plain numeric TextBoxes using
    BorderlessTextInput, matching the numeric-field convention used
    elsewhere in the suite.
  - IsCancel="True" on the Close button now also wired to Click, so Esc
    and the button both call Close() on this modeless window (IsCancel
    alone only auto-closes for ShowDialog()).
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.InnerLoopDivider.V009.UI.Views.InnerLoopDividerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="Inner Loop Divider — V009"
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:LogLevelToColorConverter         x:Key="LogLevelToColor"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>

            <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Expander Margin="0">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="IsExpanded" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="Circular">
                                                <Setter Property="IsExpanded" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Expander.Header>
                                    <Grid Background="#DCE6F2" Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E3A5F"
                                                   VerticalAlignment="Center" Margin="10,0,10,0"/>
                                        <Border Grid.Column="1" Background="#FFFFFF"
                                                CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCount}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#1E3A5F"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Content="Select all"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" Margin="0,0,6,0" FontSize="10.5"
                                                    Click="SelectGroupButton_Click" Tag="{Binding Name}"/>
                                            <Button Content="Select none"
                                                    Style="{StaticResource SmallSecondaryButton}"
                                                    Height="22" Padding="8,0" FontSize="10.5"
                                                    Click="ClearGroupButton_Click" Tag="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsPresenter/>
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header bar          -->
            <RowDefinition Height="Auto"/>  <!-- Global division row -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar             -->
            <RowDefinition Height="Auto"/>  <!-- Summary cards       -->
            <RowDefinition Height="*"/>     <!-- Data grid / empty   -->
            <RowDefinition Height="Auto"/>  <!-- Activity log        -->
            <RowDefinition Height="Auto"/>  <!-- Action buttons      -->
        </Grid.RowDefinitions>

        <!-- ─── HEADER BAR ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" CornerRadius="10" Margin="0,0,0,10">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Inner Loop Divider" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="V009  ·  Hierarchical division point assignment" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#14283F" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="Revit26_Plugin_Revised.InnerLoopDivider.V009"
                               FontFamily="Consolas" FontSize="10" Foreground="#7E94AA"/>
                </Border>
            </Grid>
        </Border>

        <!-- ─── GLOBAL DIVISION CONTROL ────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Set all loops to"
                           Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <TextBox Grid.Column="1"
                         Style="{StaticResource BorderlessTextInput}"
                         Text="{Binding GlobalDivisionPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3"
                         Width="70" Height="30" FontSize="13"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="Applies this value to every loop instantly. Individual rows remain editable independently."
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <!-- ─── TOOLBAR ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Select all"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding SelectAllCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Clear"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding ClearSelectionCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Re-analyze"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding AnalyzeCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ─── SUMMARY CARDS ───────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Selected shapes" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding SelectedShapeCount}" Style="{StaticResource MetricNumber}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Division points" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding QueuedPointCount}" Style="{StaticResource MetricNumberAccent}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="Total openings" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding TotalOpeningsCount}" Style="{StaticResource MetricNumberSuccess}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ─── DATA GRID ───────────────────────────────────────────────── -->
        <Border Grid.Row="4" Style="{StaticResource ContentCard}"
                Visibility="{Binding HasLoops, Converter={StaticResource BoolToVisibility}}">
            <DataGrid ItemsSource="{Binding LoopsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      Style="{StaticResource StandardDataGrid}"
                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                      CellStyle="{StaticResource StandardDataGridCell}"
                      RowStyle="{StaticResource StandardDataGridRow}">
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}">
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Index"
                                        Binding="{Binding Index}"
                                        IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding LoopType}"
                                        IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Shape"
                                        Binding="{Binding LoopShapeType}"
                                        IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Perimeter (mm)"
                                        Binding="{Binding PerimeterMm, StringFormat={}{0:N0}}"
                                        IsReadOnly="True" Width="130"/>
                    <DataGridCheckBoxColumn Header="Selected"
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80"/>
                    <!-- Per-row editable division points -->
                    <DataGridTemplateColumn Header="Div. points" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource BorderlessTextInput}"
                                         Text="{Binding RecommendedPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="3"
                                         Width="70" HorizontalAlignment="Left"
                                         HorizontalContentAlignment="Center"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Segment length (m)"
                                        Binding="{Binding DividedLengthMeters}"
                                        IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ─── EMPTY STATE ─────────────────────────────────────────────── -->
        <Border Grid.Row="4" Style="{StaticResource ContentCard}"
                Visibility="{Binding HasLoops, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                <TextBlock Text="No inner loops detected"
                           Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="The selected roof has no inner boundary loops to divide."
                           Style="{StaticResource HintText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ─── ACTIVITY LOG — collapsible, collapsed by default ──────── -->
        <Expander Grid.Row="5" Margin="0,0,0,10" IsExpanded="False" Background="{StaticResource BrushLogBg}">
            <Expander.Header>
                <Grid>
                    <TextBlock Text="Activity log"
                               Foreground="{StaticResource BrushLogText}"
                               FontSize="11.5" VerticalAlignment="Center"/>
                    <Button Content="Clear"
                            Style="{StaticResource DarkGhostButton}"
                            Command="{Binding ClearLogCommand}"
                            HorizontalAlignment="Right"/>
                </Grid>
            </Expander.Header>
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="0,0,8,8" MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                               Foreground="{StaticResource BrushLogTextDim}"
                                               FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Level}"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                               FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                                               Width="64"/>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{StaticResource BrushLogText}"
                                               FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- ─── ACTION BUTTONS ──────────────────────────────────────────── -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close"
                    Style="{StaticResource OutlineButton}"
                    Width="90" Height="38" IsCancel="True"
                    Click="CloseButton_Click" Margin="0,0,10,0"/>
            <Button Content="Apply division points"
                    Style="{StaticResource PrimaryButton}"
                    Width="200"
                    Command="{Binding ApplyDivisionCommand}"/>
        </StackPanel>
    </Grid>
</Window>
