<!--
=======================================================
File: MultiplePointsWindow.xaml
Location: UI/Views/
Changes vs V001 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (title bar + version + metrics card),
    middle (settings, edges toolbar, edges grid that scrolls itself),
    fixed footer (log with Copy All / Copy Selected, Apply → Close).
  - No behaviour change — every binding/command is the V001 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.MultiplePoints.V002.UI.Views.MultiplePointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="Multiple Points — V002"
        Width="760" Height="760"
        MinWidth="760" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSystemSecondaryBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converter: LogLevel → coloured brush -->
            <conv:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle (grid scrolls itself) -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Multiple Points" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Select a roof, then add shape-edit points at each edge's midpoint and/or quarter points. Optionally add extra points on edges longer than a threshold, so no gap exceeds it. Works at any slope; optionally cap it to exclude steeper facets. Applies to every edge type — lines, arcs, splines." Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V002" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Edges" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Edges.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Preview Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalPreviewPoints}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Log Entries" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding LogEntries.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>               <!-- settings title -->
                <RowDefinition Height="Auto"/>               <!-- settings panel -->
                <RowDefinition Height="Auto"/>               <!-- edges toolbar  -->
                <RowDefinition Height="*" MinHeight="150"/>  <!-- edges grid     -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Points To Add" Style="{StaticResource SectionTitle}"/>
            <Grid Grid.Row="1">
                <Border Style="{StaticResource ContentCard}" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="Midpoint (1/2)" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.AddMidpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Quarter points (1/4, 3/4)" Margin="24,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.AddQuarterPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="Add extra points on edges longer than:" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.AddExtraOnLongEdges, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2" Width="62" Margin="8,0,0,0"
                                      IsEnabled="{Binding Settings.AddExtraOnLongEdges}"
                                      Text="{Binding Settings.ThresholdMeters, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="m" Style="{StaticResource UnitLabel}"/>
                            <TextBlock Text="(max spacing on that edge is capped at the threshold)"
                                       Style="{StaticResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Limit to roof slope under:" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.LimitMaxSlope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2" Width="62" Margin="8,0,0,0"
                                      IsEnabled="{Binding Settings.LimitMaxSlope}"
                                      Text="{Binding Settings.MaxSlopePercent, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="%" Style="{StaticResource UnitLabel}"/>
                            <TextBlock Text="(edges on steeper facets are hidden and excluded from Apply)"
                                       Style="{StaticResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Edges toolbar ── -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Edges" Style="{StaticResource SectionTitle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button Content="Select All"  Style="{StaticResource SmallSecondaryButton}" Width="86" Command="{Binding SelectAllCommand}"/>
                    <Button Content="Select None" Style="{StaticResource SmallSecondaryButton}" Width="86" Margin="6,0,0,0" Command="{Binding SelectNoneCommand}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding TotalPreviewPoints, StringFormat='Total preview: {0} point(s)'}"
                           Style="{StaticResource HintText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <DataGrid Grid.Row="3" Margin="0,6,0,0"
              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ItemsSource="{Binding Edges}"
                      Style="{StaticResource StandardDataGrid}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="✓" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="#"        Binding="{Binding Index}"                          Width="40"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Type"     Binding="{Binding CurveTypeName}"                  Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Len (m)"  Binding="{Binding LengthM, StringFormat=F3}"       Width="85"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Slope %"  Binding="{Binding FacetSlopePercent, StringFormat=F1}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Points"   Binding="{Binding PreviewPointCount}"              Width="*"   IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}" Height="100"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                       Foreground="{StaticResource BrushLogTextDim}"
                                       FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply Points" Style="{StaticResource RunButton}" Width="150" Margin="0,0,8,0"
                        Command="{Binding ApplyCommand}"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
