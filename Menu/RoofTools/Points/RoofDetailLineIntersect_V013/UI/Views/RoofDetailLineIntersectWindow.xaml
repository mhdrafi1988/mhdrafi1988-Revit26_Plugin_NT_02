<!--
=======================================================
File: RoofDetailLineIntersectWindow.xaml
Location: UI/Views/
Changes vs V012 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (title bar + version + metrics card),
    scrollable middle (selection, options), fixed footer (run log with
    Copy All / Copy Selected, then Run → Close right-aligned).
  - Window is now resizable (MinWidth/MinHeight = default size) instead
    of NoResize + SizeToContent; the header ✕ button is dropped in
    favour of the footer Close button.
  - No behaviour change — every binding/command is the V012 one.
=======================================================
-->
<Window
    x:Class="Revit26_Plugin_Revised.RoofDetailLineIntersect.V013.UI.Views.RoofDetailLineIntersectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
    Title="Roof Detail Line Intersect — V013"
    Width="520" Height="700"
    MinWidth="520" MinHeight="700"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters — instantiated here in the consuming window (never in SharedStyles.xaml) -->
            <shared:InverseBoolConverter       x:Key="InvBool"/>
            <shared:LogLevelToColorConverter   x:Key="LogColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemSecondaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Scrollable middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Roof Detail Line Intersect" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Curves · Endpoints · Shape Points · Line×Line" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V013" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="5" Margin="10,10,10,0">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Lines" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalLines}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Boundary" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding IntersectionsFound}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Line×Line" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding LineToLineIntersectionsFound}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Pts Placed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PointsPlaced}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ SCROLLABLE MIDDLE ═══════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,8,10,0">
            <StackPanel>
                <!-- ── Selection info ──────────────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,0">
                    <StackPanel>

                        <TextBlock Text="Selection"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="12,8,12,4"/>

                        <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>

                        <!-- Roof row -->
                        <Grid Margin="12,6,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource BrushAppleBlue}"
                                    CornerRadius="8" Padding="7,2" Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="ROOF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextOnDark}"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding RoofName}"
                                       Style="{StaticResource FieldValue}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding RoofIdText}"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>

                        <!-- Detail Lines row -->
                        <Grid Margin="12,6,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource BrushSuccess}"
                                    CornerRadius="8" Padding="7,2" Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextOnDark}">
                                    <Run Text="{Binding TotalLines, Mode=OneWay}"/>
                                    <Run Text=" LINES"/>
                                </TextBlock>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="Detail Lines selected"
                                       Style="{StaticResource FieldValue}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ViewName}"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ── Options  ───────────────────────────────── -->
                <Border Style="{StaticResource ContentCard}" Margin="0,6,0,0">
                    <StackPanel>

                        <TextBlock Text="Options"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="12,8,12,4"/>

                        <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>

                        <CheckBox Content="Include Line × Line Intersections"
                                  IsChecked="{Binding IncludeLineToLineIntersections}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                  Margin="12,10,12,4"
                                  FontSize="12.5"
                                  Foreground="{StaticResource BrushTextPrimary}"/>

                        <TextBlock Text="Also places a shape point wherever two of the selected detail lines cross each other, not just where they cross the roof boundary."
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"
                                   Margin="30,0,12,10"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="10,8,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                            <TextBlock Text="Run Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyLogCommand}"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}" Height="150"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                       Foreground="{StaticResource BrushLogTextDim}"
                                       FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Level}"
                                       Foreground="{Binding Level, Converter={StaticResource LogColor}}"
                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Width="64"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{StaticResource BrushLogText}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                    BorderBrush="{StaticResource BrushSeparatorThin}"
                    BorderThickness="0,1,0,0"
                    Margin="0,8,0,0"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="▶  Run"
                            Style="{StaticResource RunButton}"
                            Command="{Binding RunCommand}"
                            Width="90"
                            Margin="0,0,8,0"/>
                    <Button Content="Close"
                            Style="{StaticResource OutlineButton}"
                            Click="CloseButton_Click"
                            Width="80"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
