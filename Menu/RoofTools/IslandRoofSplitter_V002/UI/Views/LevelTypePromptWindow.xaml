<!--
  IslandRoofSplitter V002 — launch prompt, shown by the Command only when the source roof's level or
  roof type could not be detected (per Anas, 2026-10-15: ask here AND guard in the window).
  Modal, owned by the Revit main window. Creates nothing: it only returns the two chosen ids.
  No inline colours and no new style keys: every key below is already used by IslandRoofSplitterWindow.xaml.
-->
<Window x:Class="Revit26_Plugin_Revised.IslandRoofSplitter.V002.UI.Views.LevelTypePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island Roof Splitter — level &amp; roof type"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource BaseCard}" Padding="16,14" Margin="10">
        <StackPanel>
            <TextBlock Text="NEW ROOFS — CONFIRM LEVEL AND ROOF TYPE" Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,8" />
            <TextBlock x:Name="ReasonText" Style="{StaticResource HintText}" TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBlock Text="Level (name · elevation)" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="LevelCombo" Style="{StaticResource StandardComboBox}"
                      DisplayMemberPath="Display" Margin="0,2,0,4"
                      SelectionChanged="Selection_Changed" />
            <TextBlock x:Name="LevelNote" Style="{StaticResource HintText}" TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBlock Text="Roof type" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TypeCombo" Style="{StaticResource StandardComboBox}"
                      DisplayMemberPath="Name" Margin="0,2,0,4"
                      SelectionChanged="Selection_Changed" />
            <TextBlock x:Name="TypeNote" Style="{StaticResource HintText}" TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <TextBlock Text="Nothing is created yet — the window opens next with a preview, and you can change both there."
                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Continue" Style="{StaticResource RunButton}"
                        Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
                <Button Content="Cancel" Style="{StaticResource OutlineButton}"
                        IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
