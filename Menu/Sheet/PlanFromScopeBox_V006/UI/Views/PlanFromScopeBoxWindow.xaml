<!--
=======================================================
File: PlanFromScopeBoxWindow.xaml  (V006 — ToolWindowShell, CLAUDE.md v1.1)
Changes vs V005 (layout only):
  - Hosted in Shared/Controls/ToolWindowShell.
    HEADER: title / subtitle / version + metric cards.
    BODY:   scope-box grid (left) / sheet, naming and options settings
            (right), then the activity log (moved from the footer).
    FOOTER: shell status strip (IsBusy, indeterminate; "Level: …") +
            Create → Close. The "Working…" text and the level status line
            are now the shell's progress bar and summary.
  - Settings column's own ScrollViewer removed — the shell body is the
    one ScrollViewer. Grid and log cap their height
    (ShellBehaviors.MaxHeightRatio) and forward the mouse wheel.
  - No behaviour change — every binding/command is the V005 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.PlanFromScopeBox.V006.UI.Views.PlanFromScopeBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:vm="clr-namespace:Revit26_Plugin_Revised.PlanFromScopeBox.V006.UI.ViewModels"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.PlanFromScopeBox}, Path=Title}"
        Height="800" Width="960"
        MinHeight="800" MinWidth="960"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushSystemSecondaryBackground}">

    <!-- V004 FIX: switched from the absolute pack://application:,,, form to the
         assembly-relative pack syntax below. The absolute "application" authority
         requires a live System.Windows.Application.ResourceAssembly, which is not
         reliably set in a Revit add-in host — this is the documented cause of a
         "Provide value on TypeConverterMarkupExtension threw an exception" crash
         at window construction (same failure class already hit and fixed this way
         in SmartViewToSheetPlacer_V221's window). The assembly-relative form
         resolves against the current assembly directly, without needing a live
         Application object. LoadSharedStyles() in the code-behind is kept as a
         defensive no-op-if-already-merged runtime fallback. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated in the consuming window ONLY (never in SharedStyles). -->
            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:InverseBoolConverter             x:Key="InverseBoolConverter"/>
            <converters:IntToVisibilityConverter         x:Key="IntToVisibilityConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Plan From Scope Box"
                           Subtitle="Create plans from scope boxes · place on sheets · auto-group"
                           Version="{Binding Source={x:Static svc:ToolCatalog.PlanFromScopeBox}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding ActiveLevelDisplay, StringFormat='Level: {0}'}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Plans Created" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlansCreated}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Sheets Created" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SheetsCreated}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}" Padding="10,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Skipped ⊘" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Skipped}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Scope box grid card -->
                    <Border Grid.Column="0" Style="{StaticResource ContentCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Scope Boxes" Style="{StaticResource SectionTitle}"/>

                            <!-- toolbar -->
                            <Grid Grid.Row="1" Margin="12,0,12,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="25" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Select all" Style="{StaticResource SmallSecondaryButton}"
                                        Margin="6,0,0,0" Command="{Binding SelectAllCommand}"/>
                                <Button Grid.Column="2" Content="Clear" Style="{StaticResource SmallSecondaryButton}"
                                        Margin="5,0,0,0" Command="{Binding ClearSelectionCommand}"/>
                                <Button Grid.Column="3" Content="↻ Refresh" Style="{StaticResource SmallSecondaryButton}"
                                        Margin="5,0,0,0" Command="{Binding RefreshCommand}"/>
                            </Grid>

                            <!-- datagrid -->
                            <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.5" shell:ShellBehaviors.ForwardMouseWheel="True" MinHeight="200" Grid.Row="2" Margin="12,0,12,12"
                                      ItemsSource="{Binding ScopeBoxesView}"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource StandardDataGridCell}"
                                      RowStyle="{StaticResource StandardDataGridRow}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="False"
                                      HeadersVisibility="Column"
                                      RowHeight="Auto"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Scope Box" Binding="{Binding Name, Mode=OneWay}" Width="1.6*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="1*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Size (m)" Binding="{Binding SizeDisplay, Mode=OneWay}" Width="0.9*" IsReadOnly="True">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Existing Usage" Width="1.4*" CanUserSort="True"
                                                            SortMemberPath="ExistingUsage">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ExistingUsage, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Margin="0,4"
                                                           FontSize="12"
                                                           ToolTip="{Binding ExistingUsage, Mode=OneWay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExistingUsage}" Value="">
                                                                    <Setter Property="Text" Value="—"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
                                                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Fits" Width="60" CanUserSort="True"
                                                            SortMemberPath="Fits">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✓"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Fits}" Value="False">
                                                                    <Setter Property="Text" Value="⚠"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                        <StackPanel Grid.Column="2">
                            <!-- Sheet & view settings -->
                            <Border Style="{StaticResource ContentCard}">
                                <StackPanel>
                                    <TextBlock Text="Sheet &amp; View Settings" Style="{StaticResource SectionTitle}"/>

                                    <StackPanel Style="{StaticResource FieldRow}">
                                        <TextBlock Text="Title Block (A0)" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding TitleBlocks}"
                                                  SelectedItem="{Binding SelectedTitleBlock}"
                                                  DisplayMemberPath="Display"/>
                                    </StackPanel>

                                    <Grid Margin="12,4,12,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Scale (1:)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="10"
                                                     Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Margin (mm)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="10"
                                                     Text="{Binding MarginText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Gutter (mm)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="10"
                                                     Text="{Binding GutterText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="12,4,12,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Title block clear — right (mm)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="10"
                                                     Text="{Binding ClearRightText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Title block clear — bottom (mm)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="10"
                                                     Text="{Binding ClearBottomText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource HintText}" Margin="12,3,12,2">
                                        <Run Text="Sheet size:" Foreground="{StaticResource BrushTextTertiary}"/>
                                        <Run Text="{Binding SheetSizeDisplay, Mode=OneWay}" Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold"/>
                                        <Run Text="· clear zone is manual" Foreground="{StaticResource BrushTextTertiary}"/>
                                    </TextBlock>

                                    <StackPanel Style="{StaticResource FieldRow}" Margin="12,4,12,10">
                                        <TextBlock Text="Active Level (from current view)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource StyledTextInput}" IsEnabled="False"
                                                 Text="{Binding ActiveLevelDisplay, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Naming -->
                            <Border Style="{StaticResource ContentCard}">
                                <StackPanel>
                                    <TextBlock Text="Naming Patterns" Style="{StaticResource SectionTitle}"/>

                                    <Grid Margin="12,4,12,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Sheet Number" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="25"
                                                     Text="{Binding SheetNumberPattern, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Sheet Name" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="25"
                                                     Text="{Binding SheetNamePattern, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="12,4,12,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="View Number" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="25"
                                                     Text="{Binding ViewNumberPattern, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="View Name" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource StyledTextInput}" MaxLength="25"
                                                     Text="{Binding ViewNamePattern, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource HintText}" Margin="12,3,12,10"
                                               Text="Tokens: {ScopeBoxName} {Level} {Increment} {Date} · increment skips existing numbers"/>
                                </StackPanel>
                            </Border>

                            <!-- Options -->
                            <Border Style="{StaticResource ContentCard}">
                                <StackPanel>
                                    <TextBlock Text="Options" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Style="{StaticResource AppleToggleRow}" Margin="12,4,12,10">
                                        <ToggleButton Style="{StaticResource AppleToggleButton}"
                                                      IsChecked="{Binding OpenSheetsAfter}"/>
                                        <TextBlock Text="Open sheets after creation" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" FontSize="11.5" Foreground="{StaticResource BrushTextPrimary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                </Grid>

                <!-- ACTIVITY LOG (moved from footer) -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                                        Command="{Binding CopyAllLogsCommand}"/>
                                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="5,0,0,0"
                                                        Command="{Binding CopySelectedLogsCommand}"/>
                                                <Button Content="Export" Style="{StaticResource DarkGhostButton}" Margin="5,0,0,0"
                                                        Command="{Binding ExportLogsCommand}"/>
                                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="5,0,0,0"
                                                        Command="{Binding ClearLogsCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True" Grid.Row="1" x:Name="LogList" MinHeight="110"
                                 ItemsSource="{Binding LogEntries}"
                                 SelectionMode="Extended"
                                 SelectionChanged="LogList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 >
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="10.5" Margin="10,1"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}">
                                        <Run Text="{Binding Time, StringFormat=HH\\:mm\\:ss, Mode=OneWay}" Foreground="{StaticResource BrushLogTextDim}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Level, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Create Plans &amp; Sheets" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CreatePlansAndSheetsCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38"
                        Click="Close_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
