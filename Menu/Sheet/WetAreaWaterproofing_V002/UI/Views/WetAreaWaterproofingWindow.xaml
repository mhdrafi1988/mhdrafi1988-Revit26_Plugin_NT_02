<!--
=======================================================
File: WetAreaWaterproofingWindow.xaml  (Wet Area Waterproofing V002, Parts A and B)
V002: "Points to" is a search box (name, title on sheet, sheet number, sheet name, bubble number), and
      "Assign drafting views…" opens a picker panel (targets on the left, searchable view table on the right).
Tool 2.3.0: step 4 is a settings column on the left (Plans; Sections with Section / Callout settings, Search targets in,
      Fixture keywords) and, on the right, the section targets DataGrid (filter chips, search, Set for ticked, drag
      to reorder, counts per target) with the selected target's details pane under it.
ToolWindowShell layout (tool 2.2.0: six steps, one open at a time):
  STEPS   1 Find rooms · 2 Check outlines (skipped when every ticked outline closes) · 3 Roof ·
          4 Plans and sections · 5 Review (table of every roof, plan and section; untick rows) · 6 Run and report
  Before 2.2.0:
  BODY    left:  1 · Rooms — sources, keywords, level buttons, search, group, grid, tick helpers
          right: 2 · Waterproofing roof, Boundary repair, 3 · Plans, 4 · Section targets, Excel report
          below: activity log
  FOOTER  attention bar · Remove a run… · Back · Run without review (step 4) · Next / Create N items / Start again · Close
Overlay cards: result of a run, "Remove a run", "Assign drafting views". Column filters open in a pop-up.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.WetAreaWaterproofing.V002.UI.Views.WetAreaWaterproofingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:wp="clr-namespace:Revit26_Plugin_Revised.WetAreaWaterproofing.V002.UI.Controls"
        xmlns:wpc="clr-namespace:Revit26_Plugin_Revised.WetAreaWaterproofing.V002.UI.Converters"
        x:Name="Root"
        Title="Wet Area Waterproofing"
        Height="880" Width="1440"
        MinHeight="640" MinWidth="1180"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolConverter x:Key="InvertBool"/>
            <wpc:StepRowHeightConverter x:Key="StepRowHeight"/>
            <wpc:StateIsConverter x:Key="StateIs"/>
            <wpc:StepGlyphConverter x:Key="StepGlyph"/>

            <!-- Review "What happens" pill: colour by outcome (new / rep / upd / keep / skip / err). -->
            <Style x:Key="OutcomePill" TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource BrushTileSuccessBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushTileSuccessBorder}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileSuccessText}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OutcomeKind}" Value="rep">
                        <Setter Property="Background" Value="{StaticResource BrushTileInfoBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushTileInfoBorder}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileInfoText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OutcomeKind}" Value="upd">
                        <Setter Property="Background" Value="{StaticResource BrushTileInfoBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushTileInfoBorder}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileInfoText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OutcomeKind}" Value="keep">
                        <Setter Property="Background" Value="{StaticResource BrushTileWarningBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushTileWarningBorder}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileWarningText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OutcomeKind}" Value="skip">
                        <Setter Property="Background" Value="{StaticResource BrushInputBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextSecondary}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OutcomeKind}" Value="err">
                        <Setter Property="Background" Value="{StaticResource BrushTileDangerBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushTileDangerBorder}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileDangerText}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MmBox" TargetType="TextBox" BasedOn="{StaticResource BoxedTextInput}">
                <Setter Property="Width" Value="64"/>
                <Setter Property="MaxLength" Value="8"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Setter Property="Width" Value="128"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SettingRow" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="LastChildFill" Value="True"/>
            </Style>

            <!-- Column header: name, then the filter button. The column's SortMemberPath names the column. -->
            <DataTemplate x:Key="FilterHeader">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    <Button Content="⏷" Click="FilterButton_Click" ToolTip="Filter this column"
                            Margin="5,0,0,0" Padding="2,0" FontSize="9" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </DataTemplate>

            <!-- Status chip: colour by kind (ok / info / warn / error). -->
            <Style x:Key="StatusChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource BrushTileSuccessBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushTileSuccessBorder}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileSuccessText}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKind}" Value="info">
                        <Setter Property="Background" Value="{StaticResource BrushTileInfoBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushTileInfoBorder}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileInfoText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                        <Setter Property="Background" Value="{StaticResource BrushTileWarningBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushTileWarningBorder}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileWarningText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="error">
                        <Setter Property="Background" Value="{StaticResource BrushTileDangerBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushTileDangerBorder}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTileDangerText}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Section target status (tool 2.3.0): StatusChip colours, grey when the target is off. -->
            <Style x:Key="TargetStatusChip" TargetType="Border" BasedOn="{StaticResource StatusChip}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKind}" Value="off">
                        <Setter Property="Background" Value="{StaticResource BrushPillMutedBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushPillMutedText}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Level button: navy when the level is shown. -->
            <Style x:Key="LevelButton" TargetType="Button">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="Margin" Value="0,0,5,5"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{StaticResource BrushInputBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextOnDark}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <shell:ToolWindowShell Title="Wet Area Waterproofing"
                               Subtitle="Find wet rooms, add a waterproofing roof on each slab, and create a plan with detail references per room"
                               Version="{Binding Source={x:Static svc:ToolCatalog.WetAreaWaterproofingV002}, Path=Version, StringFormat=v{0}}"
                               IsRunning="{Binding IsBusy}"
                               IsIndeterminate="True"
                               SummaryText="{Binding StatusText}">

            <shell:ToolWindowShell.BodyContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Steps (tool 2.2.0): one open at a time; the open one fills the space, the others fold to one line. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding StepState1, Converter={StaticResource StepRowHeight}}"/>
                            <RowDefinition Height="{Binding StepState2, Converter={StaticResource StepRowHeight}}"/>
                            <RowDefinition Height="{Binding StepState3, Converter={StaticResource StepRowHeight}}"/>
                            <RowDefinition Height="{Binding StepState4, Converter={StaticResource StepRowHeight}}"/>
                            <RowDefinition Height="{Binding StepState5, Converter={StaticResource StepRowHeight}}"/>
                            <RowDefinition Height="{Binding StepState6, Converter={StaticResource StepRowHeight}}"/>
                        </Grid.RowDefinitions>
                    <!-- ═══ STEP 1 · FIND ROOMS ═══ -->
                    <Border Grid.Row="0" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1" Background="{StaticResource BrushCardBackground}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepState1}" Value="active">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepState1}" Value="active"><Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState1}" Value="done"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState1}" Value="locked"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState1}" Value="skipped"><Setter Property="Background" Value="{StaticResource BrushTextTertiary}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource StageNumberText}">
                                        <TextBlock.Text>
                                            <Binding Path="StepState1" Converter="{StaticResource StepGlyph}" ConverterParameter="1"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Find rooms" Style="{StaticResource StageTitleText}"/>
                                    <TextBlock Text="{Binding Step1Summary}" FontSize="11.5" Foreground="{StaticResource BrushSuccess}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding StepState1, Converter={StaticResource StateIs}, ConverterParameter='done,locked,skipped'}"/>
                                    <TextBlock Text="Pick the models, check the wet rooms found, tick the ones to waterproof" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding StepState1, Converter={StaticResource StateIs}, ConverterParameter='active,pending'}"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Change" Style="{StaticResource SmallSecondaryButton}" VerticalAlignment="Center"
                                    Command="{Binding GoToStepCommand}" CommandParameter="1"
                                    Visibility="{Binding StepState1, Converter={StaticResource StateIs}, ConverterParameter=done}"/>
                            </Grid>
                            <Grid Margin="14,0,14,12" Visibility="{Binding StepState1, Converter={StaticResource StateIs}, ConverterParameter=active}">
                                <DockPanel>

                                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource SettingRow}">
                                        <TextBlock Text="Source" Style="{StaticResource RowLabel}" Width="96"/>
                                        <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding RefreshCommand}" ToolTip="Read the model again with these sources and repair settings"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Press Refresh to apply" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushWarning}" FontSize="11"
                                                   Visibility="{Binding NeedsRefresh, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Host model" IsChecked="{Binding IncludeHost}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <CheckBox Content="Links:" IsChecked="{Binding IncludeLinks}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ItemsControl ItemsSource="{Binding LinkItems}" IsEnabled="{Binding IncludeLinks}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,0,10,0"
                                                                  Click="LinkCheckBox_Click"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource SettingRow}">
                                        <TextBlock Text="Wet keywords" Style="{StaticResource RowLabel}" Width="96"/>
                                        <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                Command="{Binding ApplyKeywordsCommand}" ToolTip="Mark the wet rooms again with these keywords and tick them"/>
                                        <TextBox Text="{Binding KeywordsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"
                                                 ToolTip="Comma-separated. A room is wet when a word of its name starts with a keyword."/>
                                    </DockPanel>

                                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource SettingRow}">
                                        <TextBlock Text="Show" Style="{StaticResource RowLabel}" Width="96"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Wet rooms only" IsChecked="{Binding WetOnly}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="All rooms" x:Name="AllRoomsRadio" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                                        <TextBlock Text="Levels" Style="{StaticResource RowLabel}" Width="96" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        <ItemsControl ItemsSource="{Binding LevelButtons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" Style="{StaticResource LevelButton}" Click="LevelButton_Click"
                                                            ToolTip="Click: show or hide this level. Ctrl+click: show only this level."/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>

                                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource SettingRow}">
                                        <Button DockPanel.Dock="Right" Content="Clear filters" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                Command="{Binding ClearFiltersCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="Columns ▾" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                Click="ColumnsButton_Click"/>
                                        <ComboBox DockPanel.Dock="Right" Width="96" Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding GroupBy}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Group by" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Style="{StaticResource BoxedTextInput}"
                                                 ToolTip="Search every column"/>
                                    </DockPanel>

                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Button Content="Tick visible" Style="{StaticResource SmallSecondaryButton}" Command="{Binding TickVisibleCommand}" Margin="0,0,6,0"/>
                                        <Button Content="Untick visible" Style="{StaticResource SmallSecondaryButton}" Command="{Binding UntickVisibleCommand}" Margin="0,0,6,0"/>
                                        <Button Content="Invert" Style="{StaticResource SmallSecondaryButton}" Command="{Binding InvertVisibleCommand}"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Click a header to sort, Shift+click to add a second sort. ⏷ opens the column's filter. Hover a status to see why. Doors, Drains, Fixtures and Sections are what the current targets find for the room."/>

                                    <DataGrid x:Name="RoomsGrid"
                                              ItemsSource="{Binding RowsView}"
                                              Style="{StaticResource StandardDataGrid}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                              SelectionMode="Extended" SelectionUnit="FullRow"
                                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              Sorting="RoomsGrid_Sorting">
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="GroupItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="GroupItem">
                                                                    <Expander IsExpanded="True" Background="{StaticResource BrushSystemTertiaryBackground}">
                                                                        <Expander.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource BrushNavyPrimary}"/>
                                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' · {0} room(s)'}" Foreground="{StaticResource BrushTextSecondary}"/>
                                                                            </StackPanel>
                                                                        </Expander.Header>
                                                                        <ItemsPresenter/>
                                                                    </Expander>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="34" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsTicked, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Source" SortMemberPath="Source" Binding="{Binding Source}" Width="120" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Level" SortMemberPath="Level" Binding="{Binding Level}" Width="80" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="No." SortMemberPath="Number" Binding="{Binding Number}" Width="70" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Name" SortMemberPath="Name" Binding="{Binding Name}" Width="*" MinWidth="120" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Area m²" SortMemberPath="Area" Binding="{Binding AreaM2, StringFormat=0.00}" Width="80" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Matched" SortMemberPath="Matched" Binding="{Binding Matched}" Width="84" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Slab top" SortMemberPath="Slab" Binding="{Binding SlabText}" Width="112" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Doors" SortMemberPath="Doors" Binding="{Binding Doors}" Width="62" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Drains" SortMemberPath="Drains" Binding="{Binding Drains}" Width="64" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Fixtures" SortMemberPath="Fixtures" Binding="{Binding Fixtures}" Width="72" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Sections" SortMemberPath="Sections" Binding="{Binding Sections}" Width="74" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTextColumn Header="Plan" SortMemberPath="Plan" Binding="{Binding Plan}" Width="56" IsReadOnly="True"
                                                                HeaderTemplate="{StaticResource FilterHeader}"/>
                                            <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="150" CanUserSort="True"
                                                                    HeaderTemplate="{StaticResource FilterHeader}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource StatusChip}" ToolTip="{Binding StatusDetail}">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ═══ STEP 2 · CHECK OUTLINES ═══ -->
                    <Border Grid.Row="1" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1" Background="{StaticResource BrushCardBackground}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepState2}" Value="active">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepState2}" Value="active"><Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState2}" Value="done"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState2}" Value="locked"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState2}" Value="skipped"><Setter Property="Background" Value="{StaticResource BrushTextTertiary}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource StageNumberText}">
                                        <TextBlock.Text>
                                            <Binding Path="StepState2" Converter="{StaticResource StepGlyph}" ConverterParameter="2"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Check outlines" Style="{StaticResource StageTitleText}"/>
                                    <TextBlock Text="{Binding Step2Summary}" FontSize="11.5" Foreground="{StaticResource BrushSuccess}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding StepState2, Converter={StaticResource StateIs}, ConverterParameter='done,locked,skipped'}"/>
                                    <TextBlock Text="Rooms whose outline did not close: fix them in Revit, change the repair settings, or untick them" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding StepState2, Converter={StaticResource StateIs}, ConverterParameter='active,pending'}"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Change" Style="{StaticResource SmallSecondaryButton}" VerticalAlignment="Center"
                                    Command="{Binding GoToStepCommand}" CommandParameter="2"
                                    Visibility="{Binding StepState2, Converter={StaticResource StateIs}, ConverterParameter=done}"/>
                            </Grid>
                            <Grid Margin="14,0,14,12" Visibility="{Binding StepState2, Converter={StaticResource StateIs}, ConverterParameter=active}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="420"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="ROOMS THAT NEED ATTENTION" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="These ticked rooms have no closed outline, or only an approximate one. Change the repair settings and press Refresh, fix the room in Revit, or go back and untick it. A room still without an outline is skipped by the run."/>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Refresh with these settings" Style="{StaticResource SmallSecondaryButton}" Command="{Binding RefreshCommand}"/>
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding OutlineProblems}" MinHeight="80"/>
                                    </DockPanel>
                                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                        <Border Style="{StaticResource SectionCard}" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="BOUNDARY REPAIR" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="Snap gaps up to" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBox Text="{Binding SnapText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" HorizontalAlignment="Left"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="Bridge gaps up to" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBox Text="{Binding BridgeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" HorizontalAlignment="Left"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="Area check ±" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="% of room area" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBox Text="{Binding AreaToleranceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" HorizontalAlignment="Left"/>
                                                </DockPanel>
                                                <CheckBox Content="Allow approximate outline (last resort)" IsChecked="{Binding AllowApproximate}" Margin="0,2,0,4"
                                                          ToolTip="When no repair closes the outline, use a hull around the boundary. Off by default: it can cover the wrong area."/>
                                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                           Text="Tried in order: other boundary location → clean → merge → snap → bridge → remove overlaps → room 3D shape → skip hole → approximate. An outline outside the area check still gets a roof, with a warning. Curved walls are drawn as short straight edges."/>
                                            </StackPanel>
                                        </Border>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ═══ STEP 3 · ROOF ═══ -->
                    <Border Grid.Row="2" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1" Background="{StaticResource BrushCardBackground}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepState3}" Value="active">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepState3}" Value="active"><Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState3}" Value="done"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState3}" Value="locked"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState3}" Value="skipped"><Setter Property="Background" Value="{StaticResource BrushTextTertiary}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource StageNumberText}">
                                        <TextBlock.Text>
                                            <Binding Path="StepState3" Converter="{StaticResource StepGlyph}" ConverterParameter="3"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Roof" Style="{StaticResource StageTitleText}"/>
                                    <TextBlock Text="{Binding Step3Summary}" FontSize="11.5" Foreground="{StaticResource BrushSuccess}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding StepState3, Converter={StaticResource StateIs}, ConverterParameter='done,locked,skipped'}"/>
                                    <TextBlock Text="Roof type, workset and height" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding StepState3, Converter={StaticResource StateIs}, ConverterParameter='active,pending'}"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Change" Style="{StaticResource SmallSecondaryButton}" VerticalAlignment="Center"
                                    Command="{Binding GoToStepCommand}" CommandParameter="3"
                                    Visibility="{Binding StepState3, Converter={StaticResource StateIs}, ConverterParameter=done}"/>
                            </Grid>
                            <Grid Margin="14,0,14,12" Visibility="{Binding StepState3, Converter={StaticResource StateIs}, ConverterParameter=active}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource SectionCard}" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="WATERPROOFING ROOF" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                                <CheckBox Content="Create roofs" IsChecked="{Binding CreateRoofs}" FontWeight="SemiBold" Margin="0,0,0,8"
                                                          ToolTip="Untick to make only plans and sections in this run"/>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="Roof type" Style="{StaticResource RowLabel}"/>
                                                    <ComboBox ItemsSource="{Binding RoofTypes}" SelectedItem="{Binding SelectedRoofType}" Style="{StaticResource StandardComboBox}"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}" IsEnabled="{Binding IsWorkshared}"
                                                           ToolTip="Workset for the new roofs. Greyed out when the model is not workshared.">
                                                    <TextBlock Text="Workset" Style="{StaticResource RowLabel}"/>
                                                    <ComboBox ItemsSource="{Binding Worksets}" SelectedItem="{Binding SelectedWorkset}" Style="{StaticResource StandardComboBox}"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="Offset above slab" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBox Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" HorizontalAlignment="Left"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="No slab found" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Text="Use room level + offset" Style="{StaticResource FieldValue}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <CheckBox Content="Add room No. + name to the roof's Comments" IsChecked="{Binding WriteComments}" Margin="0,2,0,4"
                                                          ToolTip="The run ID and room key are always written to Comments: re-runs and 'Remove a run' need them."/>
                                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                           Text="A room that already has a roof from an earlier run gets it replaced (same room, new outline)."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ═══ STEP 4 · PLANS AND SECTIONS ═══ -->
                    <Border Grid.Row="3" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1" Background="{StaticResource BrushCardBackground}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepState4}" Value="active">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepState4}" Value="active"><Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState4}" Value="done"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState4}" Value="locked"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState4}" Value="skipped"><Setter Property="Background" Value="{StaticResource BrushTextTertiary}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource StageNumberText}">
                                        <TextBlock.Text>
                                            <Binding Path="StepState4" Converter="{StaticResource StepGlyph}" ConverterParameter="4"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Plans and sections" Style="{StaticResource StageTitleText}"/>
                                    <TextBlock Text="{Binding Step4Summary}" FontSize="11.5" Foreground="{StaticResource BrushSuccess}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding StepState4, Converter={StaticResource StateIs}, ConverterParameter='done,locked,skipped'}"/>
                                    <TextBlock Text="Plan settings, section targets and drafting views" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding StepState4, Converter={StaticResource StateIs}, ConverterParameter='active,pending'}"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Change" Style="{StaticResource SmallSecondaryButton}" VerticalAlignment="Center"
                                    Command="{Binding GoToStepCommand}" CommandParameter="4"
                                    Visibility="{Binding StepState4, Converter={StaticResource StateIs}, ConverterParameter=done}"/>
                            </Grid>
                            <Grid Margin="14,0,14,12" Visibility="{Binding StepState4, Converter={StaticResource StateIs}, ConverterParameter=active}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left rail (tool 2.3.0): plans, then the section and callout settings. -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Style="{StaticResource SectionCard}" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                    <TextBlock Text="PLANS" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                                    <CheckBox Content="Create plans" IsChecked="{Binding CreatePlans}" FontWeight="SemiBold" Margin="0,0,0,8"
                                                              ToolTip="Sections sit on the room's plan: a plan is still made for a room that gets sections"/>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock Text="Plan type" Style="{StaticResource RowLabel}"/>
                                                        <ComboBox ItemsSource="{Binding PlanTypes}" SelectedItem="{Binding SelectedPlanType}" Style="{StaticResource StandardComboBox}"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock Text="View template" Style="{StaticResource RowLabel}"/>
                                                        <ComboBox ItemsSource="{Binding PlanTemplates}" SelectedItem="{Binding SelectedPlanTemplate}" Style="{StaticResource StandardComboBox}"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock Text="Scale 1:" Style="{StaticResource RowLabel}"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <TextBox DockPanel.Dock="Right" Text="{Binding CropMarginText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="Crop margin" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                                        <TextBox Text="{Binding PlanScaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" HorizontalAlignment="Left"
                                                                 ToolTip="Used unless the view template sets the scale"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock Text="Plan name" Style="{StaticResource RowLabel}"/>
                                                        <TextBox Text="{Binding PlanNamePattern, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"
                                                                 ToolTip="{}{Level}, {Number} and {Name} are filled in. A name already in use gets (2), (3)…"/>
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                               Text="One plan per room, cropped to the room plus the margin. A room that already has a plan from an earlier run keeps it (your annotations stay); its crop is refreshed."/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="SECTIONS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding SectionsSummary}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <Expander Header="Section settings" IsExpanded="True" Margin="0,0,0,6">
                                                    <StackPanel Margin="0,4,0,0">
                                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                               Text="Targets set to &quot;Section&quot; create a section view along the cut line, as wide as the row's Length."/>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock Text="Section view type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="110"/>
                                                        <ComboBox ItemsSource="{Binding SectionViewTypes}" SelectedItem="{Binding SelectedSectionViewType}"
                                                                  ToolTip="The view family type for the new section views"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock Text="Scale  1 :" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="110"/>
                                                        <TextBox Text="{Binding SectionScaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"
                                                                 HorizontalAlignment="Left" Width="60" ToolTip="Scale of the section views (a view template may override it)"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <TextBlock Text="Depth (far clip)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="110"/>
                                                        <TextBox Text="{Binding SectionDepthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"
                                                                 HorizontalAlignment="Left" Width="60" ToolTip="How far the section looks past its cut line"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <TextBox DockPanel.Dock="Right" Text="{Binding SectionTopText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"
                                                                 Width="60" ToolTip="Top of the section's crop, above the room's level"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="above" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                                        <TextBlock Text="Crop: below level" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="110"/>
                                                        <TextBox Text="{Binding SectionBottomText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"
                                                                 HorizontalAlignment="Left" Width="60" ToolTip="Bottom of the section's crop, below the room's level"/>
                                                    </DockPanel>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander Header="Callout settings" IsExpanded="False" Margin="0,0,0,6">
                                                    <StackPanel Margin="0,4,0,0">
                                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                               Text="Targets set to &quot;Callout&quot; create a cropped detail view instead of pointing to a drafting view. The crop margin also sizes &quot;Ref. Callout&quot; boxes."/>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock Text="Detail view type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="110"/>
                                                        <ComboBox ItemsSource="{Binding DetailViewTypes}" SelectedItem="{Binding SelectedCalloutViewType}"
                                                                  ToolTip="The view family type for the callout detail view"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock Text="Scale  1 :" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="110"/>
                                                        <TextBox Text="{Binding CalloutScaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"
                                                                 HorizontalAlignment="Left" Width="60" ToolTip="Scale of the callout detail view"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SettingRow}">
                                                        <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <TextBlock Text="Crop margin" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="110"/>
                                                        <TextBox Text="{Binding CalloutMarginText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"
                                                                 HorizontalAlignment="Left" Width="60" ToolTip="Extra space around the cut line in the callout crop"/>
                                                    </DockPanel>
                                                    </StackPanel>
                                                </Expander>
                                                    <Expander Header="Search targets in" IsExpanded="False" Margin="0,0,0,6">
                                                        <ItemsControl ItemsSource="{Binding Sources}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Expander Header="{Binding Header}" IsExpanded="True" Margin="6,0,0,2">
                                                                        <ItemsControl ItemsSource="{Binding Categories}" Margin="22,2,0,2">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <DockPanel Margin="0,1">
                                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource BrushTextSecondary}"/>
                                                                                        <CheckBox Content="{Binding Category}" IsChecked="{Binding IsOn}"/>
                                                                                    </DockPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                    <Expander Header="Fixture keywords" IsExpanded="False">
                                                        <StackPanel Margin="0,6,0,0">
                                                            <DockPanel Style="{StaticResource SettingRow}">
                                                                <TextBlock Text="Floor drain" Style="{StaticResource RowLabel}" Width="92"/>
                                                                <TextBox Text="{Binding DrainKeywordsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"/>
                                                            </DockPanel>
                                                            <DockPanel Style="{StaticResource SettingRow}">
                                                                <TextBlock Text="WC / closet" Style="{StaticResource RowLabel}" Width="92"/>
                                                                <TextBox Text="{Binding WcKeywordsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"/>
                                                            </DockPanel>
                                                            <DockPanel Style="{StaticResource SettingRow}">
                                                                <TextBlock Text="Shower / bath" Style="{StaticResource RowLabel}" Width="92"/>
                                                                <TextBox Text="{Binding ShowerKeywordsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"/>
                                                            </DockPanel>
                                                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                                       Text="Matched against each fixture's family and type name. Every door counts as a door. Press Refresh after a change."/>
                                                        </StackPanel>
                                                    </Expander>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Right (tool 2.3.0): the section targets grid on top, the selected target's details under it. -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" MinHeight="200"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource SectionCard}" Padding="0">
                                        <DockPanel>
                                            <!-- Toolbar -->
                                            <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                                                <Button DockPanel.Dock="Right" Content="Reset to defaults" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                        Click="ResetTargets_Click" ToolTip="Put the targets back to the tool's defaults: order, on/off, lengths and drafting view names"/>
                                                <Button DockPanel.Dock="Right" Content="Columns ▾" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                        Click="TargetColumnsButton_Click" ToolTip="Show or hide columns"/>
                                                <TextBox DockPanel.Dock="Right" Width="170" Margin="10,0,0,0" Text="{Binding TargetSearch, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource BoxedTextInput}" ToolTip="Search target, mode, drafting view, sheet / bubble or status"/>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                                    <RadioButton Content="{Binding TargetChipAllText}" GroupName="TargetFilter" Style="{StaticResource ChipToggle}" IsChecked="True"
                                                                 Command="{Binding SetTargetFilterCommand}" CommandParameter="All"/>
                                                    <RadioButton Content="{Binding TargetChipOnText}" GroupName="TargetFilter" Style="{StaticResource ChipToggle}"
                                                                 Command="{Binding SetTargetFilterCommand}" CommandParameter="On"/>
                                                    <RadioButton Content="{Binding TargetChipProblemsText}" GroupName="TargetFilter" Style="{StaticResource ChipToggle}"
                                                                 Command="{Binding SetTargetFilterCommand}" CommandParameter="Problems"
                                                                 ToolTip="Targets that are on and miss rooms or lose sections to the six-per-room limit"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="Create sections" IsChecked="{Binding CreateSections}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Drafting view" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                                    <RadioButton Content="One for all" IsChecked="{Binding OneDraftingViewForAll}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                 ToolTip="Every Ref. Section and Ref. Callout points to the same drafting view"/>
                                                    <RadioButton Content="One per target" IsChecked="{Binding DraftingViewPerTarget}" VerticalAlignment="Center"
                                                                 ToolTip="Each target points to its own drafting view (set it in the details below)"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Set for ticked -->
                                            <Border DockPanel.Dock="Top" Background="{StaticResource BrushTileInfoBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1"
                                                    Padding="10,5" Visibility="{Binding HasTickedTargets, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TargetsTickedText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Set for ticked:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Button Content="Mode ▾" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0" Click="BulkMode_Click"/>
                                                    <Button Content="Per item ▾" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,10,0" Click="BulkPerItem_Click"
                                                            ToolTip="Only for targets that can have several matches"/>
                                                    <TextBlock Text="Length" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox Text="{Binding BulkLengthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" Width="56"/>
                                                    <Button Content="Set" Style="{StaticResource SmallSecondaryButton}" Margin="4,0,10,0" Command="{Binding BulkSetLengthCommand}"/>
                                                    <Button Content="Turn on" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0" Command="{Binding BulkSetOnCommand}" CommandParameter="1"/>
                                                    <Button Content="Turn off" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0" Command="{Binding BulkSetOnCommand}" CommandParameter="0"/>
                                                    <Button Content="Assign drafting views…" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,4,0" Command="{Binding OpenAssignCommand}"/>
                                                    <Button Content="Untick all" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0" Command="{Binding ClearTargetTicksCommand}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Footer -->
                                            <DockPanel DockPanel.Dock="Bottom" Margin="10,5">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TargetsLimitText}" Foreground="{StaticResource BrushTileWarningText}" FontSize="11.5" Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding TargetsFooterText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <DataGrid x:Name="TargetsGrid" ItemsSource="{Binding TargetsView}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                      Style="{StaticResource StandardDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="True"
                                                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="0,1,0,1"
                                                      AllowDrop="True" Drop="TargetsGrid_Drop" DragOver="TargetsGrid_DragOver">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding On}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Width="30" CanUserResize="False">
                                                        <DataGridTemplateColumn.Header>
                                                            <CheckBox IsThreeState="True" IsChecked="{Binding DataContext.AllTargetsTicked, ElementName=Root}"
                                                                      ToolTip="Tick every target the filter shows, for &quot;Set for ticked&quot;"/>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsTicked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="Tick to change several targets at once"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Width="22" CanUserResize="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="⋮⋮" Foreground="{StaticResource BrushTextTertiary}" Cursor="SizeAll" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Background="Transparent" PreviewMouseLeftButtonDown="TargetDragHandle_MouseDown"
                                                                           ToolTip="Drag up or down to change the priority: higher rows win when a room would get more than six sections"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="#" Width="36" SortMemberPath="Priority">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource BrushSurfaceHeader}" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Priority}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushNavyPrimary}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="On" Width="38" SortMemberPath="On">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding On, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Target" Width="150" SortMemberPath="Label">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Mode" Width="112" SortMemberPath="SelectedMode">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode, UpdateSourceTrigger=PropertyChanged}"
                                                                          Style="{StaticResource StandardComboBox}" Margin="0,1"
                                                                          ToolTip="Ref. Section and Ref. Callout point to a drafting view; Callout creates a cropped detail view; Section creates a section view"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Per item" Width="150" SortMemberPath="PerItem">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding PerItem, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEnabled="{Binding CanHaveMany}" Style="{StaticResource StandardComboBox}" Margin="0,1"
                                                                          ToolTip="One section at the match nearest the room centre, or one for every match"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Length mm" Width="78">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" Width="60" Margin="0,1"
                                                                         ToolTip="Length of the cut line. For the full-room cuts: how far the line runs past the room on each side."/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Points to (drafting view · sheet / bubble)" Width="*" MinWidth="200" SortMemberPath="PointsToName">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <DockPanel VerticalAlignment="Center" ToolTip="{Binding PointsToDetail}">
                                                                    <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,0" Margin="6,0,0,0" Background="{StaticResource BrushTileInfoBackground}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding PointsToReference}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding PointsToIsNew}" Value="True"><Setter Property="Background" Value="{StaticResource BrushTileWarningBackground}"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding PointsToReference}" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource BrushTileInfoText}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding PointsToText}" TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding UsesDraftingView}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Rooms found" Width="104" SortMemberPath="RoomsWith">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                            ToolTip="Ticked rooms where the target finds a door, drain, fixture, corner or wall">
                                                                    <ProgressBar Width="44" Height="6" Minimum="0" Maximum="100" Value="{Binding CoveragePercent, Mode=OneWay}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding CoverageText}" Margin="6,0,0,0"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Will make" Width="72" SortMemberPath="Makes">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding MakesText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="StatusText">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource TargetStatusChip}">
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <!-- Details of the selected target -->
                                    <Border Grid.Row="1" Margin="0,8,0,0" Padding="12,10" Background="{StaticResource BrushCardBackground}" CornerRadius="5"
                                            BorderBrush="{StaticResource BrushNavyPrimary}" BorderThickness="1,2,1,1" DataContext="{Binding SelectedTarget}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right" Content="▼" Width="24" Padding="0" Style="{StaticResource SmallSecondaryButton}" ToolTip="Move down"
                                                            Command="{Binding DataContext.MoveTargetDownCommand, ElementName=Root}"/>
                                                    <Button DockPanel.Dock="Right" Content="▲" Width="24" Padding="0" Margin="0,0,3,0" Style="{StaticResource SmallSecondaryButton}"
                                                            ToolTip="Move up: higher rows win when a room would get more than six sections"
                                                            Command="{Binding DataContext.MoveTargetUpCommand, ElementName=Root}"/>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="On" Style="{StaticResource FieldLabel}" Width="72" VerticalAlignment="Center"/>
                                                    <CheckBox IsChecked="{Binding On}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PriorityText}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" Width="72" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Style="{StaticResource StandardComboBox}"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="Per item" Style="{StaticResource FieldLabel}" Width="72" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding PerItem}" IsEnabled="{Binding CanHaveMany}" Style="{StaticResource StandardComboBox}"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <TextBlock Text="{Binding LengthLabel}" Style="{StaticResource FieldLabel}" Width="72" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </DockPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="POINTS TO" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                                <StackPanel Visibility="{Binding UsesDraftingView, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Visibility="{Binding DataContext.DraftingViewPerTarget, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                                        <wp:DraftingViewSearchBox Items="{Binding DataContext.DraftingViewItems, ElementName=Root}"
                                                                                  Text="{Binding DraftingViewName, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Visibility="{Binding DataContext.OneDraftingViewForAll, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                                        <wp:DraftingViewSearchBox Items="{Binding DataContext.DraftingViewItems, ElementName=Root}"
                                                                                  Text="{Binding DataContext.SharedDraftingViewName, ElementName=Root, Mode=TwoWay}"/>
                                                        <TextBlock Text="One view for all targets: this name is shared by every Ref. Section and Ref. Callout." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PointsToDetail}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="Type a view name, title, sheet number, sheet name or bubble (A-501/3). A name that does not exist is created at the run."/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding NoDraftingNote}" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                           Visibility="{Binding IsCalloutOrSection, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Assign drafting views…" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Command="{Binding DataContext.AssignSelectedTargetCommand, ElementName=Root}"
                                                        ToolTip="Open the picker: every target on the left, every drafting view with its sheet and bubble on the right"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="FOUND IN ROOMS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <ProgressBar Width="70" Height="6" Minimum="0" Maximum="100" Value="{Binding CoveragePercent, Mode=OneWay}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CoverageSummary}" FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RoomsWithoutText}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding DroppedText}" Foreground="{StaticResource BrushTileWarningText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Text="Counted from the rooms ticked in step 1, as last read from the model. The Review lists every section exactly."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ═══ STEP 5 · REVIEW ═══ -->
                    <Border Grid.Row="4" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1" Background="{StaticResource BrushCardBackground}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepState5}" Value="active">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepState5}" Value="active"><Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState5}" Value="done"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState5}" Value="locked"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState5}" Value="skipped"><Setter Property="Background" Value="{StaticResource BrushTextTertiary}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource StageNumberText}">
                                        <TextBlock.Text>
                                            <Binding Path="StepState5" Converter="{StaticResource StepGlyph}" ConverterParameter="5"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Review" Style="{StaticResource StageTitleText}"/>
                                    <TextBlock Text="{Binding Step5Summary}" FontSize="11.5" Foreground="{StaticResource BrushSuccess}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding StepState5, Converter={StaticResource StateIs}, ConverterParameter='done,locked,skipped'}"/>
                                    <TextBlock Text="See everything the run will make, and untick what you do not want. Nothing is created yet." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding StepState5, Converter={StaticResource StateIs}, ConverterParameter='active,pending'}"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Change" Style="{StaticResource SmallSecondaryButton}" VerticalAlignment="Center"
                                    Command="{Binding GoToStepCommand}" CommandParameter="5"
                                    Visibility="{Binding StepState5, Converter={StaticResource StateIs}, ConverterParameter=done}"/>
                            </Grid>
                            <Grid Margin="14,0,14,12" Visibility="{Binding StepState5, Converter={StaticResource StateIs}, ConverterParameter=active}">
                                <DockPanel>
                                    <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,8">
                                        <Border Style="{StaticResource SectionCard}" Padding="10,6" Margin="0,0,8,0"><StackPanel><TextBlock Text="Roofs" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ReviewRoofsText}" FontWeight="SemiBold"/></StackPanel></Border>
                                        <Border Style="{StaticResource SectionCard}" Padding="10,6" Margin="0,0,8,0"><StackPanel><TextBlock Text="Plans" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ReviewPlansText}" FontWeight="SemiBold"/></StackPanel></Border>
                                        <Border Style="{StaticResource SectionCard}" Padding="10,6" Margin="0,0,8,0"><StackPanel><TextBlock Text="Sections" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ReviewSectionsText}" FontWeight="SemiBold"/></StackPanel></Border>
                                        <Border Style="{StaticResource SectionCard}" Padding="10,6" Margin="0,0,8,0"><StackPanel><TextBlock Text="Old views kept (you drew in them)" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ReviewKeptText}" FontWeight="SemiBold"/></StackPanel></Border>
                                        <Border Style="{StaticResource SectionCard}" Padding="10,6"><StackPanel><TextBlock Text="Skipped or problems" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ReviewProblemsText}" FontWeight="SemiBold"/></StackPanel></Border>
                                    </UniformGrid>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Untick all" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                Command="{Binding TickReviewCommand}" CommandParameter="0" ToolTip="Untick every row the filter shows"/>
                                        <Button DockPanel.Dock="Right" Content="Tick all" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                                Command="{Binding TickReviewCommand}" CommandParameter="1" ToolTip="Tick every row the filter shows"/>
                                        <TextBox DockPanel.Dock="Right" Width="240" Text="{Binding ReviewSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"
                                                 ToolTip="Search room, target, element, view or what happens"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="All" GroupName="ReviewFilter" Style="{StaticResource ChipToggle}" IsChecked="True" Command="{Binding SetReviewFilterCommand}" CommandParameter="All"/>
                                            <RadioButton Content="New" GroupName="ReviewFilter" Style="{StaticResource ChipToggle}" Command="{Binding SetReviewFilterCommand}" CommandParameter="New"/>
                                            <RadioButton Content="Replaces" GroupName="ReviewFilter" Style="{StaticResource ChipToggle}" Command="{Binding SetReviewFilterCommand}" CommandParameter="Replaces"/>
                                            <RadioButton Content="Kept" GroupName="ReviewFilter" Style="{StaticResource ChipToggle}" Command="{Binding SetReviewFilterCommand}" CommandParameter="Kept"/>
                                            <RadioButton Content="Problems" GroupName="ReviewFilter" Style="{StaticResource ChipToggle}" Command="{Binding SetReviewFilterCommand}" CommandParameter="Problems"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Unticking a roof keeps the room's old roof as it is. Unticking a plan also leaves out that room's sections, since they sit on its plan. An unticked section is not replaced by another one. Your unticks are kept while the window is open."/>
                                    <DataGrid ItemsSource="{Binding ReviewView}" Style="{StaticResource StandardDataGrid}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Extended"
                                              VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource BrushNavyPrimary}" Margin="4,8,0,2"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="34">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsTicked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTick}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="What" Binding="{Binding What}" Width="70" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="140" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Cuts through" Binding="{Binding CutsThrough}" Width="190" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Points to / makes" Binding="{Binding PointsTo}" Width="*" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="What happens" Width="300">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource OutcomePill}">
                                                            <TextBlock Text="{Binding Happens}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Happens}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ═══ STEP 6 · RUN AND REPORT ═══ -->
                    <Border Grid.Row="5" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1" Background="{StaticResource BrushCardBackground}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepState6}" Value="active">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepState6}" Value="active"><Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState6}" Value="done"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState6}" Value="locked"><Setter Property="Background" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StepState6}" Value="skipped"><Setter Property="Background" Value="{StaticResource BrushTextTertiary}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource StageNumberText}">
                                        <TextBlock.Text>
                                            <Binding Path="StepState6" Converter="{StaticResource StepGlyph}" ConverterParameter="6"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Run and report" Style="{StaticResource StageTitleText}"/>
                                    
                                    <TextBlock Text="Create, then the result and the Excel report" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding StepState6, Converter={StaticResource StateIs}, ConverterParameter='active,pending'}"/>
                                </StackPanel>
                                
                            </Grid>
                            <Grid Margin="14,0,14,12" Visibility="{Binding StepState6, Converter={StaticResource StateIs}, ConverterParameter=active}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="420"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding ResultTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ResultLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="warn">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="error">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                        <Border Style="{StaticResource SectionCard}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="EXCEL REPORT" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                                <CheckBox Content="Save Excel report after run" IsChecked="{Binding AutoSaveReport}" Margin="0,0,0,6"/>
                                                <DockPanel Style="{StaticResource SettingRow}">
                                                    <Button DockPanel.Dock="Right" Content="…" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0" Width="28"
                                                            Click="BrowseFolder_Click" ToolTip="Pick the report folder"/>
                                                    <TextBox Text="{Binding ReportFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"
                                                             ToolTip="{Binding ReportFolder}"/>
                                                </DockPanel>
                                                <WrapPanel>
                                                    <Button Content="Export now" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ExportNowCommand}" Margin="0,0,6,0"
                                                            ToolTip="Save the last run's report again"/>
                                                    <Button Content="Open report" Style="{StaticResource SmallSecondaryButton}" Command="{Binding OpenReportCommand}" Margin="0,0,6,0"/>
                                                    <Button Content="Open folder" Style="{StaticResource SmallSecondaryButton}" Command="{Binding OpenReportFolderCommand}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    </Grid>

                    <!-- ═══ ACTIVITY LOG ════════════════════════════════════ -->
                                        <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Activity Log" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogCommand}"/>
                                                        <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLogs_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                                <ListBox Grid.Row="1" x:Name="LogListBox"
                                                         ItemsSource="{Binding LogEntries}"
                                                         SelectionMode="Extended"
                                                         Background="Transparent" BorderThickness="0"
                                                         MinHeight="80" Padding="0"
                                                         shell:ShellBehaviors.MaxHeightRatio="0.18"
                                                         shell:ShellBehaviors.ForwardMouseWheel="True"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                                           Foreground="{StaticResource BrushLogTextDim}"
                                                                           FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding Level}"
                                                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                                           Width="58" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding Message}"
                                                                           Foreground="{StaticResource BrushLogText}"
                                                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>
                </Grid>
            </shell:ToolWindowShell.BodyContent>

            <!-- ═══ FOOTER ═══════════════════════════════════════════════════ -->
            <shell:ToolWindowShell.FooterContent>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
                    <Button DockPanel.Dock="Right" Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StateIs}, ConverterParameter=1|2|3|4}"/>
                    <Button DockPanel.Dock="Right" Content="{Binding CreateButtonText}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding CreateCommand}" ToolTip="Create the ticked rows. One Undo step."
                            Visibility="{Binding CurrentStep, Converter={StaticResource StateIs}, ConverterParameter=5}"/>
                    <Button DockPanel.Dock="Right" Content="Start again" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding StartAgainCommand}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StateIs}, ConverterParameter=6}"/>
                    <Button DockPanel.Dock="Right" Content="Run without review" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding RunCommand}" ToolTip="Create everything for the ticked rooms now, without the Review step. One Undo step."
                            Visibility="{Binding CurrentStep, Converter={StaticResource StateIs}, ConverterParameter=4}"/>
                    <Button DockPanel.Dock="Right" Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StateIs}, ConverterParameter=2|3|4|5}"/>
                    <Button DockPanel.Dock="Right" Content="Remove a run…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding RemoveRunCommand}" ToolTip="Delete the roofs, plans and section markers an earlier run created"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ReviewFooterText}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding CurrentStep, Converter={StaticResource StateIs}, ConverterParameter=5}"/>

                    <Border Background="{StaticResource BrushBannerWarningBackground}" BorderBrush="{StaticResource BrushBannerWarningBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Show these rooms" Style="{StaticResource SmallSecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding ShowAttentionCommand}"/>
                            <TextBlock Text="{Binding AttentionText}" Foreground="{StaticResource BrushBannerWarningText}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding AttentionText}"/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </shell:ToolWindowShell.FooterContent>
        </shell:ToolWindowShell>

        <!-- ═══ COLUMN FILTER POP-UP ════════════════════════════════════════════ -->
        <Popup x:Name="FilterPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" Closed="FilterPopup_Closed">
            <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Width="230" DataContext="{Binding ActiveFilter}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <StackPanel Visibility="{Binding IsTicks, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="All" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                    Command="{Binding DataContext.FilterSelectAllCommand, ElementName=Root}" CommandParameter="1"/>
                            <Button Content="None" Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding DataContext.FilterSelectAllCommand, ElementName=Root}" CommandParameter="0"/>
                        </StackPanel>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsContains, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Contains" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding ContainsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRange, Converter={StaticResource BoolToVis}}" Orientation="Horizontal">
                        <TextBlock Text="From" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"/>
                        <TextBlock Text="to" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <TextBox Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Clear" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                Command="{Binding DataContext.ClearFilterCommand, ElementName=Root}"/>
                        <Button Content="OK" Style="{StaticResource SmallSecondaryButton}" IsDefault="True"
                                Command="{Binding DataContext.ApplyFilterCommand, ElementName=Root}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══ REMOVE A RUN CARD ═══════════════════════════════════════════════ -->
        <Grid Background="#66000000" Visibility="{Binding RemoveVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ContentCard}" Width="460" MaxHeight="460" Padding="18,14"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Remove a run" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Deletes the roofs, plans and section markers the picked run created. Drafting views are kept (they may hold your details). Elements another user owns are left. One Undo step."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding CancelRemoveRunCommand}"/>
                        <Button Content="Remove" Style="{StaticResource DangerButton}" Command="{Binding ConfirmRemoveRunCommand}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" MinHeight="80">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RunId}" FontFamily="Consolas" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} element(s)'}" Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ ASSIGN DRAFTING VIEWS CARD (V002) ═══════════════════════════════════ -->
        <Grid Background="#66000000" Visibility="{Binding AssignVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ContentCard}" Width="1040" Height="600" Padding="18,14"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Assign drafting views" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Pick a target on the left, then double-click a drafting view (or press Assign). The next target is picked for you. Search by view name, title on sheet, sheet number, sheet name or bubble number; A-501/3 = sheet A-501, bubble 3."/>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource PrimaryButton}" Command="{Binding CloseAssignCommand}"/>
                        <TextBlock Text="{Binding PickerSummary}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: what is assigned -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="TARGETS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <ListBox ItemsSource="{Binding AssignSlots}" SelectedItem="{Binding SelectedSlot}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="IsEnabled" Value="{Binding CanAssign}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ViewName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Right: search and pick -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="DRAFTING VIEWS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Use as new name" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                        Command="{Binding AssignNewNameCommand}" ToolTip="Point the target to the typed text: a view with that name is created at the run"/>
                                <Button DockPanel.Dock="Right" Content="Assign" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                        Command="{Binding AssignPickedCommand}"/>
                                <TextBox x:Name="PickerSearchBox" Text="{Binding PickerQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"
                                         PreviewKeyDown="PickerSearchBox_PreviewKeyDown"
                                         ToolTip="Words are combined. s: sheet, d: bubble, n: view name, t: title on sheet (e.g. d:3 s:A-5)"/>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton Content="All" GroupName="PickerScope" Style="{StaticResource ChipToggle}" IsChecked="True"
                                             Command="{Binding SetPickerScopeCommand}" CommandParameter="All"/>
                                <RadioButton Content="On a sheet" GroupName="PickerScope" Style="{StaticResource ChipToggle}"
                                             Command="{Binding SetPickerScopeCommand}" CommandParameter="On a sheet"/>
                                <RadioButton Content="Not on a sheet" GroupName="PickerScope" Style="{StaticResource ChipToggle}"
                                             Command="{Binding SetPickerScopeCommand}" CommandParameter="Not on a sheet"/>
                            </StackPanel>
                            <DataGrid x:Name="PickerGrid" ItemsSource="{Binding PickerResults}" SelectedItem="{Binding SelectedPickerView}"
                                      Style="{StaticResource StandardDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False"
                                      MouseDoubleClick="PickerGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sheet" Binding="{Binding SheetNumber}" Width="80"/>
                                    <DataGridTextColumn Header="Bubble" Binding="{Binding DetailNumber}" Width="60"/>
                                    <DataGridTextColumn Header="Sheet name" Binding="{Binding SheetName}" Width="150"/>
                                    <DataGridTextColumn Header="View name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Title on sheet" Binding="{Binding TitleOnSheet}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
