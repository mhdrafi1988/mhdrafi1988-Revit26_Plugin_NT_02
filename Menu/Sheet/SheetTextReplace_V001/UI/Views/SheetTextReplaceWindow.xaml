<!--
=======================================================
File: SheetTextReplaceWindow.xaml  (Sheet Text Replace V001)
ToolWindowShell layout:
  HEADER  summary cards with a phase label (BEFORE / AFTER APPLY)
  BODY    left: sheet picker + Views popover (grouped by view type)
          right: Find / Replace / Prefix / Suffix + options
          below: preview grid, then the activity log
  FOOTER  "N changes will be made…", Close, Apply
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.SheetTextReplace.V001.UI.Views.SheetTextReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.SheetTextReplace.V001.UI.Views"
        xmlns:vm="clr-namespace:Revit26_Plugin_Revised.SheetTextReplace.V001.UI.ViewModels"
        Title="Sheet Text Replace"
        Height="880" Width="1120"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBool"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="PopupCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact summary card. -->
            <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource MetricCard}">
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <!-- Arrow toggle for a collapsible group header (open / closed). -->
            <Style x:Key="GroupArrowToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock x:Name="Glyph" Text="&#x25BE;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushNavyPrimary}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#x25B8;"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- View-type button in the Views popover: blue when every view of the type is ticked. -->
            <Style x:Key="TypePill" TargetType="Button" BasedOn="{StaticResource SmallSecondaryButton}">
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="0,0,4,4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPartChecked}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAllChecked}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushStatusInfoBorder}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushNavyDark}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Status badge in the preview grid. -->
            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="7,1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushStatusOkBorder}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.WillChangeShared}">
                        <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushStatusInfoBorder}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Excluded}">
                        <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Blocked}">
                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushStatusWarnBorder}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Skipped}">
                        <Setter Property="Background" Value="{StaticResource BrushStatusWarnSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushStatusWarnBorder}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Failed}">
                        <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushStatusErrorBorder}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Changed}">
                        <Setter Property="Background" Value="{StaticResource BrushStatusOk}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushStatusOk}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.WillChangeShared}">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Excluded}">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Blocked}">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Skipped}">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Failed}">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Changed}">
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NoteText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Style>

            <Style x:Key="FindBox" TargetType="TextBox" BasedOn="{StaticResource StyledTextInput}">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Sheet Text Replace"
                           Subtitle="Find and replace text notes in selected views on a sheet"
                           Version="{Binding Source={x:Static svc:ToolCatalog.SheetTextReplace}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER: summary ══════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="SUMMARY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    <Border CornerRadius="9" Padding="8,1" Margin="8,0,0,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrushStatusInfoBorder}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAfterPhase}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushStatusOkBorder}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PhaseText}" FontSize="10.5" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushStatusInfo}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAfterPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushStatusOk}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- BEFORE apply -->
                <StackPanel Visibility="{Binding IsBeforePhase, Converter={StaticResource BoolToVis}}">
                    <UniformGrid Columns="6" Margin="0,0,-6,0">
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Views checked" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ViewsCheckedText}" Style="{StaticResource MetricNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Text notes scanned" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding NotesScanned}" Style="{StaticResource MetricNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Matches found" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding MatchesFound}" Style="{StaticResource MetricNumberAccent}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Will change" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding WillChangeCount}" Style="{StaticResource MetricNumberSuccess}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Excluded by you" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ExcludedCount}" Style="{StaticResource MetricNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Will skip" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding WillSkipCount}" Style="{StaticResource MetricNumberWarning}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <WrapPanel Margin="2,8,0,0" Visibility="{Binding HasExample, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Example:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource NoteText}" local:SegmentText.Segments="{Binding ExampleOld}"/>
                        <TextBlock Text="  &#x2192;  " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource NoteText}" local:SegmentText.Segments="{Binding ExampleNew}"/>
                    </WrapPanel>
                    <TextBlock Margin="2,8,0,0" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"
                               Text="{Binding ExampleMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasExample}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- AFTER apply -->
                <StackPanel Visibility="{Binding IsAfterPhase, Converter={StaticResource BoolToVis}}">
                    <UniformGrid Columns="5" Margin="0,0,-6,0">
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Changed" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ChangedCount}" Style="{StaticResource MetricNumberSuccess}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Failed" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Views affected" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ViewsAffected}" Style="{StaticResource MetricNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Time (ms)" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ElapsedMs}" Style="{StaticResource MetricNumber}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Margin="2,8,0,0" Text="{Binding AfterHeadline}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushStatusOk}" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" Margin="2,4,0,0">
                        <ItemsControl ItemsSource="{Binding ResultLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text, StringFormat='– {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushStatusWarn}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushStatusError}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Inputs ──────────────────────────────────── -->
                <Grid Grid.Row="0" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sheet & views -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#x27F3; Refresh" Margin="0,8,12,0" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="Read the sheet again (after changes made in Revit)."/>
                                <TextBlock Text="Sheet &amp; Views" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>

                            <StackPanel Margin="12,0,12,12">
                                <TextBlock Text="Sheet" Style="{StaticResource FieldLabel}"/>
                                <Button x:Name="SheetButton" Click="SheetButton_Click" HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SmallSecondaryButton}" Height="28"
                                        ToolTip="Pick the sheet. Type to search by number or name.">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#x25BE;" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding CurrentSheetLabel}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Button>
                                <Popup x:Name="SheetPopup" PlacementTarget="{Binding ElementName=SheetButton}" Placement="Bottom"
                                       StaysOpen="False" Opened="SheetPopup_Opened">
                                    <Border Style="{StaticResource PopupCard}" Width="{Binding ActualWidth, ElementName=SheetButton}" MinWidth="320">
                                        <StackPanel>
                                            <TextBox x:Name="SheetSearchBox" Style="{StaticResource StyledTextInput}" Margin="0,0,0,6"
                                                     Text="{Binding SheetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="SheetSearchBox_PreviewKeyDown"
                                                     ToolTip="Type part of the sheet number or name. Enter picks the first match."/>
                                            <ListBox x:Name="SheetList" ItemsSource="{Binding SheetsView}" DisplayMemberPath="Label"
                                                     MaxHeight="280" BorderThickness="0"
                                                     PreviewMouseLeftButtonUp="SheetList_PreviewMouseLeftButtonUp"
                                                     KeyDown="SheetList_KeyDown"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <TextBlock Text="{Binding SheetHint}" Style="{StaticResource HintText}"/>

                                <TextBlock Text="Views on this sheet" Style="{StaticResource FieldLabel}" Margin="0,10,0,2"/>
                                <Button x:Name="ViewsButton" Content="{Binding ViewsButtonText}" HorizontalAlignment="Left"
                                        Style="{StaticResource SmallSecondaryButton}" Height="28" Click="ViewsButton_Click"
                                        IsEnabled="{Binding HasSheet}"
                                        ToolTip="Choose the views whose text notes are searched, grouped by view type."/>
                                <Popup x:Name="ViewsPopup" PlacementTarget="{Binding ElementName=ViewsButton}" Placement="Bottom" StaysOpen="False">
                                    <Border Style="{StaticResource PopupCard}" Width="540">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right" Content="None" Margin="4,0,0,0" Style="{StaticResource SmallSecondaryButton}"
                                                        Command="{Binding SelectNoViewsCommand}" ToolTip="Clear every shown view."/>
                                                <Button DockPanel.Dock="Right" Content="All" Margin="6,0,0,0" Style="{StaticResource SmallSecondaryButton}"
                                                        Command="{Binding SelectAllViewsCommand}" ToolTip="Tick every shown view that has text notes."/>
                                                <TextBox x:Name="ViewFilterBox" Style="{StaticResource StyledTextInput}"
                                                         Text="{Binding ViewFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Filter the views by name or type."/>
                                            </DockPanel>

                                            <!-- One button per view type: ticks / clears every view of that type. -->
                                            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,4">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding PillText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanCheck}"
                                                                Style="{StaticResource TypePill}" ToolTip="Select or clear every view of this type."/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0">
                                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Groups}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                                    <Border Padding="4,4" Background="{StaticResource BrushSystemTertiaryBackground}"
                                                                            BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,0,0,1">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ToggleButton Style="{StaticResource GroupArrowToggle}" IsChecked="{Binding IsExpanded}"/>
                                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False" IsEnabled="{Binding CanCheck}"
                                                                                      VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                      ToolTip="Select or clear every view of this type.">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" FontSize="12.5"/>
                                                                                    <TextBlock Text="{Binding Summary}" Margin="8,0,0,0" FontSize="11.5"
                                                                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                                                                </StackPanel>
                                                                            </CheckBox>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ItemsControl ItemsSource="{Binding Views}"
                                                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Padding="26,3,4,3" BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,0,0,1"
                                                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                                                                        ToolTip="{Binding RowTip}" ToolTipService.ShowOnDisabled="True">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasNotes}" Value="False">
                                                                                                    <Setter Property="Opacity" Value="0.45"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="70"/>
                                                                                            <ColumnDefinition Width="56"/>
                                                                                            <ColumnDefinition Width="40"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsEnabled="{Binding HasNotes}" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                                                        </CheckBox>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding ScaleText}" FontSize="11.5" VerticalAlignment="Center"
                                                                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding NoteCount, StringFormat='{}{0} notes'}" FontSize="11.5"
                                                                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                                            <TextBlock Text="&#x1F512;" ToolTip="{Binding LockTip}" Margin="0,0,4,0"
                                                                                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                                                                                            <TextBlock Text="&#x29C9;" ToolTip="{Binding SharedTip}" Foreground="{StaticResource BrushStatusInfo}"
                                                                                                       Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}"/>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Ticked views per type -->
                                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="7,1" Margin="0,0,4,4" BorderThickness="1"
                                                    Background="{StaticResource BrushStatusInfoSoft}" BorderBrush="{StaticResource BrushStatusInfoBorder}"
                                                    Visibility="{Binding HasChecked, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding PillText}" FontSize="11" Foreground="{StaticResource BrushStatusInfo}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Find & replace -->
                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Find &amp; Replace" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Find" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource FindBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRegexError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushStatusError}"/>
                                                    <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Replace with" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FindBox}" Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="With Regex on, $1, $2… insert the groups found."/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Prefix" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="0" Style="{StaticResource FindBox}" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Added at the start of each note that changes."/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Suffix" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource FindBox}" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Added at the end of each note that changes."/>
                            </Grid>
                            <WrapPanel Margin="12,0,12,0">
                                <CheckBox Content="Match case" IsChecked="{Binding MatchCase}" Margin="0,0,14,4"/>
                                <CheckBox Content="Whole word" IsChecked="{Binding WholeWord}" Margin="0,0,14,4"
                                          ToolTip="Match only where the text is not part of a longer word."/>
                                <CheckBox Content="Regex" IsChecked="{Binding UseRegex}" Margin="0,0,14,4"
                                          ToolTip=".NET regular expression in Find; $1, $2… in Replace with."/>
                                <CheckBox Content="Trim spaces" IsChecked="{Binding TrimSpaces}" Margin="0,0,14,4"
                                          ToolTip="Removes spaces at the start and end of each line and turns double spaces into one. Line breaks are kept."/>
                            </WrapPanel>
                            <TextBlock Margin="12,2,12,0" Text="{Binding RegexError}" Foreground="{StaticResource BrushStatusError}" FontSize="11.5"
                                       TextWrapping="Wrap" Visibility="{Binding HasRegexError, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Margin="12,2,12,12">
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="Only the found text is replaced, so bold, italic, underline and lists in the rest of the note are kept."/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="Prefix and suffix are added only to notes that change."/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="Trim spaces: removes spaces at the start and end of each line and turns double spaces into one. Line breaks are kept."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Preview ─────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Preview" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding PreviewHint}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="PreviewGrid" Margin="12,0,12,6" MinHeight="140"
                                  shell:ShellBehaviors.MaxHeightRatio="0.4"
                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  SelectionMode="Single" HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  MouseDoubleClick="PreviewGrid_MouseDoubleClick"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRow}">
                                    <Setter Property="ToolTip" Value="Double-click to show this note in Revit."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RowStatus.Excluded}">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox IsThreeState="False" HorizontalAlignment="Center"
                                                  IsChecked="{Binding DataContext.AllRowsIncluded, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                  IsEnabled="{Binding DataContext.CanToggleAllRows, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  ToolTip="Tick or untick every row that can change."/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsEditable}"
                                                      ToolTip="Only ticked rows are applied."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="View" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run Text="{Binding ViewName, Mode=OneWay}"/>
                                                <Run Text="{Binding ViewType, Mode=OneWay}" FontSize="11" Foreground="{StaticResource BrushTextTertiary}"/>
                                                <InlineUIContainer BaselineAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text=" &#x1F512;" ToolTip="View owned by another user"
                                                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text=" &#x29C9;" Foreground="{StaticResource BrushStatusInfo}"
                                                                   ToolTip="{Binding AlsoOnText, StringFormat='Also on {0}'}"
                                                                   Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </InlineUIContainer>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Current text" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource NoteText}" local:SegmentText.Segments="{Binding OldSegments}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="New text" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource NoteText}" local:SegmentText.Segments="{Binding NewSegments}"/>
                                                <Border HorizontalAlignment="Left" Margin="0,3,0,0" Padding="5,0" CornerRadius="3" BorderThickness="1"
                                                        BorderBrush="{StaticResource BrushBorderInput}"
                                                        Visibility="{Binding HasFormatting, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Only the found text is replaced, so the note's formatting stays.">
                                                    <TextBlock Text="{Binding FormattingText}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadge}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBadgeText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="12,0,12,10" Text="{Binding EmptyText}" FontSize="12" Foreground="{StaticResource BrushTextTertiary}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRows}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── Activity log ────────────────────────────── -->
                <Border Grid.Row="2" Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogCommand}"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLogs_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0"
                                 MinHeight="90" Padding="0"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding ApplyCommand}"
                        ToolTip="Change the ticked notes in one transaction (one Undo step in Revit)."/>
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
                <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
