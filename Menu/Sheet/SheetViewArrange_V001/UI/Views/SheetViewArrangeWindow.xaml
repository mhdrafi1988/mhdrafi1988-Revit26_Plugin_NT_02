<!--
=======================================================
File: SheetViewArrangeWindow.xaml  (Sheet View Arrange V001)
ToolWindowShell layout:
  HEADER  metric cards (views / rows / to move / skipped)
  BODY    left: sheet + spacing + layout options
          right: live sheet preview, status, Views grid
          below: activity log
  FOOTER  status strip, Apply → Close
The preview canvas is drawn in code-behind from ViewModel.Plan.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.SheetViewArrange.V001.UI.Views.SheetViewArrangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.SheetViewArrange.V001.UI.Converters"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="Sheet View Arrange"
        Height="820" Width="1060"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:GroupTickStateConverter x:Key="GroupTickState"/>
            <local:GroupSummaryConverter x:Key="GroupSummary"/>

            <!-- Arrow toggle for a collapsible group header (open / closed). -->
            <Style x:Key="GroupArrowToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock x:Name="Glyph" Text="&#x25BE;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushNavyPrimary}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#x25B8;"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Group header + rows template for the Views grid. NOT set on the grid in XAML: a GroupStyle that is
                 present while nothing is grouped makes WPF build the DataGridRows before they are attached to the
                 grid (binding warnings). The window adds it only while 'Group by' is on. -->
                                    <GroupStyle x:Key="ViewsGroupStyle">
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <!-- The rows' ItemsPresenter must be a direct child of this template (as in the default
                                                                 group template). Hosting it inside an Expander makes WPF build the DataGridRows
                                                                 before they are attached to the grid (binding warnings), so the header is built by hand. -->
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Grid.Row="0" Padding="4,3"
                                                                        Background="{StaticResource BrushSystemTertiaryBackground}"
                                                                        BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ToggleButton x:Name="ExpandToggle" Style="{StaticResource GroupArrowToggle}" IsChecked="True"
                                                                                      Loaded="GroupToggle_Loaded" Checked="GroupToggle_Changed" Unchecked="GroupToggle_Changed"
                                                                                      ToolTip="Collapse or expand this group."/>
                                                                        <CheckBox IsThreeState="True" VerticalAlignment="Center" Margin="4,0,8,0"
                                                                                  Click="GroupCheckBox_Click"
                                                                                  ToolTip="Tick or untick every view in this group.">
                                                                            <CheckBox.IsChecked>
                                                                                <MultiBinding Converter="{StaticResource GroupTickState}" Mode="OneWay">
                                                                                    <Binding/>
                                                                                    <Binding Path="DataContext.TickRevision" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                                                </MultiBinding>
                                                                            </CheckBox.IsChecked>
                                                                        </CheckBox>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                                                   Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>
                                                                        <TextBlock Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource BrushTextSecondary}">
                                                                            <TextBlock.Text>
                                                                                <MultiBinding Converter="{StaticResource GroupSummary}" Mode="OneWay">
                                                                                    <Binding/>
                                                                                    <Binding Path="DataContext.TickRevision" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ItemsPresenter x:Name="GroupRows" Grid.Row="1"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger SourceName="ExpandToggle" Property="IsChecked" Value="False">
                                                                    <Setter TargetName="GroupRows" Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>

            <!-- Removable tag for an active filter. -->
            <DataTemplate x:Key="FilterChipTemplate">
                <Border CornerRadius="10" Padding="9,1,3,1" Margin="0,0,5,4" Background="{StaticResource BrushStatusInfoSoft}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{StaticResource BrushStatusInfo}" VerticalAlignment="Center"/>
                        <Button Content="×" Command="{Binding RemoveCommand}" Padding="5,0" Margin="2,0,0,0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" FontSize="13" Foreground="{StaticResource BrushStatusInfo}"
                                ToolTip="Remove this filter"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- One tick box in a filter pop-up. -->
            <DataTemplate x:Key="FilterOptionTemplate">
                <CheckBox IsChecked="{Binding IsChecked}" Margin="4,3" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" MinWidth="110"/>
                        <TextBlock Text="{Binding Count}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5" Margin="8,0,0,0"/>
                    </StackPanel>
                </CheckBox>
            </DataTemplate>

            <Style x:Key="FilterPopupCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One margin / gap input: label, boxed number, "mm". -->
            <Style x:Key="MmBox" TargetType="TextBox" BasedOn="{StaticResource BoxedTextInput}">
                <Setter Property="Width" Value="64"/>
                <Setter Property="MaxLength" Value="7"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Sheet View Arrange"
                           Subtitle="Orders the views on a sheet by detail number and lays them out like a reading table"
                           Version="{Binding Source={x:Static svc:ToolCatalog.SheetViewArrange}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy}"
                           IsIndeterminate="True"
                           SummaryText="{Binding StatusText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Views" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ViewCount}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="to arrange" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Rows" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RowCount}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="on the sheet" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="To Move" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MoveCount}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="views" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="pinned / owned / unticked" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Left: options ───────────────────────────── -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Sheet" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SheetLabel}" Style="{StaticResource FieldValue}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding SheetLabel}"/>
                                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SmallSecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                                        ToolTip="Re-read the sheet after changing it in Revit."/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,10"
                                       Text="Order: by Detail Number (1, 2, 10 … A1, A2, B1). Reading: left → right, then the next row down."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Usable Area (inside title block)" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Top" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MarginTopMm}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Bottom" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Style="{StaticResource MmBox}" Text="{Binding MarginBottomMm}"/>
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="mm" Style="{StaticResource UnitLabel}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Left" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MarginLeftMm}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Right" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="5" Style="{StaticResource MmBox}" Text="{Binding MarginRightMm}"/>
                                <TextBlock Grid.Row="2" Grid.Column="6" Text="mm" Style="{StaticResource UnitLabel}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,2,12,10"
                                       Text="Measured inward from the title block's outer edge. Use Right / Bottom to clear the title strip."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Spacing &amp; Alignment" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Min gap between views" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MinHorizontalGapMm}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="2" Text="Min gap between rows" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MinVerticalGapMm}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,2,12,8"
                                       Text="A row wraps when the next view won't fit at the minimum gap. Rows are then spread to the full width, and rows are spread to the full height. Views sit on a common bottom line so titles align."/>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <TextBlock Text="Last row" Style="{StaticResource FieldLabel}" Margin="12,8,12,4"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Margin="12,0,12,4"
                                      ItemsSource="{Binding LastRowOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Mode"
                                      SelectedValue="{Binding LastRowMode}"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,8"
                                       Text="Only applies when there are two or more rows; a single row is always spread across the width."/>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding MovePinned}"/>
                                <TextBlock Text="Move pinned views" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,-4,12,10"
                                       Text="On: pinned views are moved and pinned again. Off: they stay where they are and are left out of the order."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Right: preview + views ──────────────────── -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Preview" Style="{StaticResource SectionTitle}"/>
                            <Border Margin="12,0,12,6" Height="300" Background="{StaticResource BrushSystemSecondaryBackground}"
                                    CornerRadius="6" ClipToBounds="True">
                                <Canvas x:Name="PreviewCanvas" SizeChanged="PreviewCanvas_SizeChanged"/>
                            </Border>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,6"
                                       Text="Blue: new position (number = detail number). Red: does not fit. Grey hatched: skipped, stays put. Dashed: usable area."/>

                            <Border Margin="12,0,12,6" Padding="10,6" CornerRadius="6"
                                    Background="{StaticResource BrushStatusWarnSoft}"
                                    BorderBrush="{StaticResource BrushStatusWarnBorder}" BorderThickness="1"
                                    Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushStatusWarn}" FontSize="12"/>
                            </Border>
                            <Border Margin="12,0,12,10" Padding="10,6" CornerRadius="6"
                                    Background="{StaticResource BrushStatusWarnSoft}"
                                    BorderBrush="{StaticResource BrushStatusWarnBorder}" BorderThickness="1"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushStatusWarn}" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0">
                        <StackPanel>
                            <Grid Margin="0,0,12,0">
                                <TextBlock Text="Views in Reading Order" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding GridCountText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Grid>

                            <!-- Filter: search, Type / Status / Row pop-ups, show mode -->
                            <WrapPanel Margin="12,0,12,4">
                                <Grid Margin="0,0,6,4">
                                    <TextBox Width="200" Style="{StaticResource StyledTextInput}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                             MaxLength="60"
                                             ToolTip="Finds words in the detail number, view name or view type. Display only — hidden ticked views are still arranged."/>
                                    <TextBlock Text="Search views…" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource BrushTextTertiary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button x:Name="TypeFilterButton" Content="{Binding TypeFilterLabel}" Margin="0,0,6,4"
                                        Style="{StaticResource SmallSecondaryButton}" Click="TypeFilterButton_Click"/>
                                <Popup x:Name="TypeFilterPopup" PlacementTarget="{Binding ElementName=TypeFilterButton}" Placement="Bottom" StaysOpen="False">
                                    <Border Style="{StaticResource FilterPopupCard}">
                                        <ItemsControl ItemsSource="{Binding TypeFilters}" ItemTemplate="{StaticResource FilterOptionTemplate}"/>
                                    </Border>
                                </Popup>

                                <Button x:Name="StatusFilterButton" Content="{Binding StatusFilterLabel}" Margin="0,0,6,4"
                                        Style="{StaticResource SmallSecondaryButton}" Click="StatusFilterButton_Click"/>
                                <Popup x:Name="StatusFilterPopup" PlacementTarget="{Binding ElementName=StatusFilterButton}" Placement="Bottom" StaysOpen="False">
                                    <Border Style="{StaticResource FilterPopupCard}">
                                        <ItemsControl ItemsSource="{Binding StatusFilters}" ItemTemplate="{StaticResource FilterOptionTemplate}"/>
                                    </Border>
                                </Popup>

                                <Button x:Name="RowFilterButton" Content="{Binding RowFilterLabel}" Margin="0,0,6,4"
                                        Style="{StaticResource SmallSecondaryButton}" Click="RowFilterButton_Click"/>
                                <Popup x:Name="RowFilterPopup" PlacementTarget="{Binding ElementName=RowFilterButton}" Placement="Bottom" StaysOpen="False">
                                    <Border Style="{StaticResource FilterPopupCard}">
                                        <ItemsControl ItemsSource="{Binding RowFilters}" ItemTemplate="{StaticResource FilterOptionTemplate}"/>
                                    </Border>
                                </Popup>

                                <ComboBox Width="124" Margin="0,0,6,4" Style="{StaticResource StandardComboBox}"
                                          ItemsSource="{Binding ShowModeOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Mode"
                                          SelectedValue="{Binding ShowMode}"
                                          ToolTip="Show all views, only the ticked ones or only the unticked ones."/>

                                <Button Content="Clear filters" Margin="0,0,6,4" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ClearFiltersCommand}"
                                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>
                            <ItemsControl Margin="12,0,12,2" ItemsSource="{Binding FilterChips}" ItemTemplate="{StaticResource FilterChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Sort + group (display only) -->
                            <WrapPanel Margin="12,0,12,6">
                                <TextBlock Text="Sort:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                <TextBlock Text="{Binding SortSummary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <Button Content="Reset" Margin="0,0,16,4" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ResetSortCommand}"
                                        Visibility="{Binding HasCustomSort, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="Group by" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <ComboBox Width="116" Margin="0,0,6,4" Style="{StaticResource StandardComboBox}"
                                          ItemsSource="{Binding GroupByOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Mode"
                                          SelectedValue="{Binding GroupBy}"
                                          ToolTip="Display only — the layout order stays by detail number."/>
                                <Button Content="Collapse all" Margin="0,0,6,4" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding CollapseAllCommand}"
                                        Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Expand all" Margin="0,0,6,4" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ExpandAllCommand}"
                                        Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>

                            <!-- Tick / untick -->
                            <Border Margin="12,0,12,8" Padding="8,5" CornerRadius="6"
                                    Background="{StaticResource BrushSystemSecondaryBackground}"
                                    BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1">
                                <DockPanel LastChildFill="False">
                                    <CheckBox x:Name="MasterTickBox" DockPanel.Dock="Left" VerticalAlignment="Center" IsThreeState="True"
                                              IsChecked="{Binding ShownTickState, Mode=OneWay}"
                                              IsEnabled="{Binding HasTickableShown}"
                                              Click="MasterTick_Click"
                                              ToolTip="Tick or untick every shown view."/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TickSummaryText}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <Button DockPanel.Dock="Right" Content="{Binding InvertShownLabel}" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding InvertShownCommand}" Margin="6,0,0,0"/>
                                    <Button DockPanel.Dock="Right" Content="{Binding UntickShownLabel}" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding UntickShownCommand}" Margin="6,0,0,0"/>
                                    <Button DockPanel.Dock="Right" Content="{Binding TickShownLabel}" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding TickShownCommand}" Margin="6,0,0,0"/>
                                </DockPanel>
                            </Border>

                            <DataGrid x:Name="ViewsGrid" Margin="12,0,12,6" MinHeight="160"
                                      shell:ShellBehaviors.MaxHeightRatio="0.4"
                                      shell:ShellBehaviors.ForwardMouseWheel="True"
                                      ItemsSource="{Binding RowsView}"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource StandardDataGridCell}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="True"
                                      EnableRowVirtualization="False"
                                      HeadersVisibility="Column"
                                      Sorting="ViewsGrid_Sorting"
                                      PreviewKeyDown="ViewsGrid_PreviewKeyDown">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRow}">
                                        <Style.Triggers>
                                            <!-- An unticked view stays where it is: show it faded. -->
                                            <DataTrigger Binding="{Binding IsTicked}" Value="False">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="34" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsTicked, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanTick}"
                                                          ToolTipService.ShowOnDisabled="True">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="ToolTip" Value="Tick to arrange this view; untick to leave it where it is."/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanTick}" Value="False">
                                                                    <Setter Property="ToolTip" Value="Left where it is anyway (owned by another user, or pinned while 'Move pinned views' is off)."/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="#" Width="38" SortMemberPath="Order" Binding="{Binding OrderText}"/>
                                    <DataGridTextColumn Header="Detail No." Width="72" SortMemberPath="DetailNumber" Binding="{Binding DetailNumber}"/>
                                    <DataGridTextColumn Header="View" Width="2*" SortMemberPath="ViewName" Binding="{Binding ViewName}"/>
                                    <DataGridTextColumn Header="Type" Width="84" SortMemberPath="ViewType" Binding="{Binding ViewTypeName}"/>
                                    <DataGridTextColumn Header="Size (mm)" Width="82" SortMemberPath="Size" Binding="{Binding SizeText}"/>
                                    <DataGridTextColumn Header="Row" Width="42" SortMemberPath="Row" Binding="{Binding RowText}"/>
                                    <DataGridTemplateColumn Header="Status" Width="1.4*" SortMemberPath="Status">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="8" Padding="7,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource BrushStatusInfoSoft}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="InPlace">
                                                                        <Setter Property="Background" Value="{StaticResource BrushStatusOkSoft}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="DoesNotFit">
                                                                        <Setter Property="Background" Value="{StaticResource BrushStatusErrorSoft}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                        <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Note}" Margin="6,0,0,0" FontSize="11"
                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Filters never change what is arranged: say so when ticked views are hidden. -->
                            <Border Margin="12,0,12,6" Padding="10,6" CornerRadius="6"
                                    Background="{StaticResource BrushStatusInfoSoft}"
                                    BorderBrush="{StaticResource BrushStatusInfoBorder}" BorderThickness="1"
                                    Visibility="{Binding HasHiddenTicked, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Show them" Margin="8,0,0,0"
                                            Style="{StaticResource SmallSecondaryButton}" Command="{Binding ClearFiltersCommand}"/>
                                    <TextBlock Text="{Binding HiddenTickedText}" TextWrapping="Wrap" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,10"
                                       Text="Click a row to select it (Ctrl / Shift for several), then press Space to tick or untick. Click a header to sort; Shift+click adds a second sort. Sorting, grouping and filtering only change this list — the layout order stays by detail number. Unticked views stay where they are in Revit."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Activity log ────────────────────────────── -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding CopyAllLogsCommand}"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Click="CopySelectedLogs_Click"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0"
                                 MinHeight="90" Padding="0"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding ApplyCommand}"
                        ToolTip="Move the views as shown in the preview (one Undo step)."/>
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
