<!--
=======================================================
File: SheetAutoRearrangeWindow.xaml  (V028 — ToolWindowShell, CLAUDE.md v1.1)
Changes vs V027 (layout only):
  - Hosted in Shared/Controls/ToolWindowShell.
    HEADER: title / subtitle / version + active-sheet chip (moved from the
            title bar) and metric cards.
    BODY:   views-on-sheet grid (left) / settings expanders (right; their
            ViewModel-bound open/closed state is unchanged), then the
            activity log and saved-log path (moved from the footer).
    FOOTER: shell status strip (IsBusy, indeterminate) + Export Log, Run /
            Close.
  - Expander column's own ScrollViewer removed — the shell body is the one
    ScrollViewer. Views grid, priority-groups list and log cap their
    height (ShellBehaviors.MaxHeightRatio) and forward the mouse wheel.
  - Inline colours → SharedStyles: sheet chip uses BadgePill; Max Fill /
    Note banners use BrushBannerInfo* / BrushBannerNote*.
  - No behaviour change — every binding/command is the V027 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.SheetAutoRearrange.V028.UI.Views.SheetAutoRearrangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:models="clr-namespace:Revit26_Plugin_Revised.SheetAutoRearrange.V028.Core.Models"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.SheetAutoRearrange.V028.UI.Views"
        xmlns:conv="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="{Binding Source={x:Static svc:ToolCatalog.SheetAutoRearrange}, Path=Title}"
        Height="920" Width="1180"
        MinHeight="920" MinWidth="1180"
        Background="{DynamicResource BrushSurfaceWindow}"
        FontFamily="{DynamicResource SystemFont}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally only, per suite convention -->
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:StatusToFitTextConverter x:Key="StatusToFitTextConverter"/>
            <local:StatusToFitBrushConverter x:Key="StatusToFitBrushConverter"/>
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <local:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
            <local:StrategySelectedBrushConverter x:Key="StrategySelectedBrushConverter"/>

            <!-- V014 NEW: local style for the Row Fill Strategy segmented
                 picker buttons. Kept tool-local (not added to the external
                 SharedStyles.xaml) since that file lives outside this
                 project and wasn't available to edit as part of this
                 change — flag to promote it to SharedStyles later if
                 another tool wants the same segmented-picker pattern. -->
            <!-- V022 FIX: was ToggleButton with IsChecked bound Mode=OneWay to
                 RowFillStrategy via EnumEqualsConverter. WPF's ToggleButton
                 writes its own local IsChecked value on click (native toggle
                 behavior) — for a OneWay-bound DP, that local write silently
                 overrides/disconnects the binding expression going forward,
                 so after the first click the button's checked visual stopped
                 tracking RowFillStrategy at all (latent in V021's 3-button
                 picker too, just less visible with only 3 buttons).
                 Switched to plain Button — Click already drives
                 _viewModel.RowFillStrategy correctly in code-behind.
                 FIRST FIX ATTEMPT (reverted): a Style.Triggers
                 MultiDataTrigger comparing RowFillStrategy to each
                 button's own Tag via RelativeSource Self/AncestorType —
                 Condition.Binding inside Style.Triggers does not reliably
                 resolve either RelativeSource form against the styled
                 element, which broke ResourceDictionary/Window.Resources
                 parsing badly enough to also break the containing
                 Expander's own expand/collapse. CURRENT FIX: this base
                 style now carries no selection logic at all — each of the
                 7 buttons below binds its own Background/BorderBrush/
                 Foreground directly via a per-instance MultiBinding
                 (RelativeSource Self IS valid on a plain instance-level
                 Binding, just not inside Style.Triggers), using
                 StrategySelectedBrushConverter. -->
            <Style x:Key="StrategySegmentButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ObjectDataProvider-free enum sources for ComboBoxes -->
            <x:Array x:Key="RowAlignmentValues" Type="{x:Type models:RowAlignment}">
                <models:RowAlignment>Top</models:RowAlignment>
                <models:RowAlignment>Center</models:RowAlignment>
                <models:RowAlignment>Bottom</models:RowAlignment>
            </x:Array>
            <x:Array x:Key="BlockAlignmentHValues" Type="{x:Type models:BlockAlignmentH}">
                <models:BlockAlignmentH>Left</models:BlockAlignmentH>
                <models:BlockAlignmentH>Center</models:BlockAlignmentH>
                <models:BlockAlignmentH>Right</models:BlockAlignmentH>
            </x:Array>
            <x:Array x:Key="BlockAlignmentVValues" Type="{x:Type models:BlockAlignmentV}">
                <models:BlockAlignmentV>Top</models:BlockAlignmentV>
                <models:BlockAlignmentV>Center</models:BlockAlignmentV>
                <models:BlockAlignmentV>Bottom</models:BlockAlignmentV>
            </x:Array>
            <x:Array x:Key="LeftoverGroupModeValues" Type="{x:Type models:LeftoverGroupMode}">
                <models:LeftoverGroupMode>Row</models:LeftoverGroupMode>
                <models:LeftoverGroupMode>Column</models:LeftoverGroupMode>
            </x:Array>

            <!-- ═══════════════════════════════════════════════════════════
                 LOCAL EXPANDER STYLE (V006 — NEW)
                 Tool-local override per suite convention: SharedStyles.xaml
                 has no Expander style, so this lives here rather than being
                 added to the shared dictionary. Navy chevron rotates via a
                 RenderTransform on IsExpanded; header row hosts an optional
                 status badge (Border+TextBlock) supplied per-instance in the
                 Header content, not baked into the template.
            ═══════════════════════════════════════════════════════════ -->
            <Style x:Key="CardExpander" TargetType="Expander">
                <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <DockPanel>
                                    <ToggleButton x:Name="HeaderToggle"
                                                  DockPanel.Dock="Top"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Padding="12,10" Cursor="Hand"
                                                  HorizontalContentAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="HeaderBg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Path x:Name="Chevron" Grid.Column="0"
                                                              Data="M 0,0 L 5,5 L 0,10"
                                                              Stroke="{StaticResource BrushTextTertiary}"
                                                              StrokeThickness="1.6"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              VerticalAlignment="Center" Width="8" Height="10"
                                                              Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>

                                                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeaderBg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ContentPresenter ContentSource="Header"/>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="Body" DockPanel.Dock="Top" Visibility="Collapsed"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ExpanderTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
            </Style>

            <!-- Small status badge shown in a collapsed/expanded expander header, e.g. "Sheet Order", "Auto-detected" -->
            <Style x:Key="ExpanderHeaderBadge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="7,2"/>
            </Style>
            <Style x:Key="ExpanderHeaderBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Sheet Auto Rearrange"
                           Subtitle="Reselect, remove &amp; repack views on the active sheet"
                           Version="{Binding Source={x:Static svc:ToolCatalog.SheetAutoRearrange}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <StackPanel>
                <!-- Active sheet chip (was in the title bar) -->
                <Border Style="{StaticResource BadgePill}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SheetChipText}" Style="{StaticResource BadgeText}"/>
                </Border>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Views" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalViewsMetric}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Selected" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedMetric}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Removed" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RemovedMetric}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Placed Ok" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PlacedOkMetric}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCard}" Margin="4,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Failed to Fit" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FailedToFitMetric}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="500"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Views on Sheet grid card -->
                    <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Views on Sheet" Style="{StaticResource SectionTitle}"/>

                            <!-- Toolbar -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,6">
                                <TextBox Width="160" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="25" Margin="0,0,6,0"/>
                                <Button Content="View Types ▾" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                        Click="ViewTypesButton_Click"/>
                                <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                                <Button Content="Clear" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ClearAllCommand}" Margin="0,0,6,0"/>
                                <Button Content="Refresh" Style="{StaticResource SmallSecondaryButton}" Command="{Binding RefreshCommand}"/>

                                <!-- View Type filter popover -->
                                <Popup x:Name="ViewTypesPopup" PlacementTarget="{Binding ElementName=ViewTypesPopup}"
                                       StaysOpen="False" Width="220">
                                    <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderDefault}"
                                            BorderThickness="1" CornerRadius="8" Padding="8">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <CheckBox Content="Floor Plan" IsChecked="{Binding ShowFloorPlan}" Margin="4,3"/>
                                            <CheckBox Content="Section" IsChecked="{Binding ShowSection}" Margin="4,3"/>
                                            <CheckBox Content="Elevation" IsChecked="{Binding ShowElevation}" Margin="4,3"/>
                                            <CheckBox Content="3D View" IsChecked="{Binding Show3D}" Margin="4,3"/>
                                            <CheckBox Content="Legend" IsChecked="{Binding ShowLegend}" Margin="4,3"/>
                                            <CheckBox Content="Schedule" IsChecked="{Binding ShowSchedule}" Margin="4,3"/>
                                            <CheckBox Content="Drafting View" IsChecked="{Binding ShowDrafting}" Margin="4,3"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <!-- DataGrid -->
                            <DataGrid shell:ShellBehaviors.MaxHeightRatio="0.55" shell:ShellBehaviors.ForwardMouseWheel="True" MinHeight="200" Grid.Row="2" Margin="0,0,0,0"
                                      ItemsSource="{Binding FilteredViewsSource}"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource StandardDataGridCell}"
                                      RowStyle="{StaticResource StandardDataGridRow}"
                                      AutoGenerateColumns="False"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="22" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                          PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="View Name" Width="3*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ViewName}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Scale" Width="1.1*" Binding="{Binding ScaleDisplay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Size on Sheet (mm)" Width="1.8*" IsReadOnly="True">
                                        <DataGridTextColumn.Binding>
                                            <MultiBinding StringFormat="{}{0:0}×{1:0}">
                                                <Binding Path="WidthMm"/>
                                                <Binding Path="HeightMm"/>
                                            </MultiBinding>
                                        </DataGridTextColumn.Binding>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Type" Width="1.1*" Binding="{Binding ViewTypeName}" IsReadOnly="True"/>

                                    <DataGridTemplateColumn Header="Fit" Width="1*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="6,2" HorizontalAlignment="Center"
                                                        Background="{Binding FitStatus, Converter={StaticResource StatusToFitBrushConverter}}"
                                                        Opacity="0.15">
                                                    <TextBlock Text="{Binding FitStatus, Converter={StaticResource StatusToFitTextConverter}}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{Binding FitStatus, Converter={StaticResource StatusToFitBrushConverter}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ── RIGHT: Expanders (state bound to the ViewModel, unchanged; scroll with the shell body) ── -->
                        <StackPanel Grid.Column="1">

                            <!-- V011 CHANGE: split into two separate expanders per
                                 explicit request — Layout Settings (Row Tolerance,
                                 Within-Row Align, Shelf Sub-Row Align) and Sheet
                                 Positioning (Sheet Position H/V, Shelf Sub-Col
                                 Align). Both collapsed by default, independent
                                 multi-expand, matching every other expander. -->

                            <!-- Expander: Layout Settings -->
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsLayoutSettingsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Text="Layout Settings" Style="{StaticResource ExpanderTitleText}"/>
                                </Expander.Header>

                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="12,8,12,4">
                                        <TextBlock Text="Row Tolerance" Width="90" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Width="60" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                 Text="{Binding RowToleranceMm}"/>
                                        <TextBlock Text="mm — same-row grouping range" Style="{StaticResource HintText}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="12,4,12,2">
                                        <TextBlock Text="Within-Row Align" Width="130" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Width="100" Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding Source={StaticResource RowAlignmentValues}}"
                                                  SelectedItem="{Binding RowAlignment}"/>
                                    </StackPanel>
                                    <TextBlock Text="Mixed-height views sharing a normal row." Style="{StaticResource HintText}" Margin="12,0,12,6"/>

                                    <!-- V014: "Shelf Sub-Row Align" / "Shelf Sub-Col
                                         Align" REMOVED — those controlled
                                         ShelfPackingService's Tall/Wide anchor
                                         sub-row/sub-column alignment, which no
                                         longer exists. MasterRowBandPackingService's
                                         three fill strategies place items
                                         bottom-aligned within their row per spec,
                                         with no separate user-facing alignment
                                         setting. -->

                                    <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,6"/>

                                    <!-- V024: Group Leftovers By picks whether the two settings
                                         below it (Row Tolerance/Align above, or Column
                                         Tolerance/Align here) drive the fallback layout for
                                         whatever the fill strategy above couldn't place. -->
                                    <StackPanel Orientation="Horizontal" Margin="12,4,12,2">
                                        <TextBlock Text="Group Leftovers By" Width="130" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Width="100" Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding Source={StaticResource LeftoverGroupModeValues}}"
                                                  SelectedItem="{Binding LeftoverGroupMode}"/>
                                    </StackPanel>
                                    <TextBlock Text="Views the fill strategy above couldn't place: grouped into rows (Row Tolerance/Align) or columns (Column Tolerance/Align, below)." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="12,0,12,6"/>

                                    <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                                        <TextBlock Text="Column Tolerance" Width="130" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Width="60" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                 Text="{Binding ColumnToleranceMm}"/>
                                        <TextBlock Text="mm — same-column grouping range" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="12,2,12,2">
                                        <TextBlock Text="Within-Column Align" Width="130" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Width="100" Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding Source={StaticResource BlockAlignmentHValues}}"
                                                  SelectedItem="{Binding WithinColumnAlign}"/>
                                    </StackPanel>
                                    <TextBlock Text="Mixed-width views sharing a column." Style="{StaticResource HintText}" Margin="12,0,12,6"/>
                                </StackPanel>
                            </Expander>

                            <!-- Expander: Sheet Positioning -->
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsSheetPositioningExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Text="Sheet Positioning" Style="{StaticResource ExpanderTitleText}"/>
                                </Expander.Header>

                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="12,8,12,2">
                                        <TextBlock Text="Sheet Position H" Width="130" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Width="100" Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding Source={StaticResource BlockAlignmentHValues}}"
                                                  SelectedItem="{Binding ColumnAlignH}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="12,2,12,2">
                                        <TextBlock Text="Sheet Position V" Width="130" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Width="100" Style="{StaticResource StandardComboBox}"
                                                  ItemsSource="{Binding Source={StaticResource BlockAlignmentVValues}}"
                                                  SelectedItem="{Binding ColumnAlignV}"/>
                                    </StackPanel>
                                    <TextBlock Text="Moves the whole packed group to a sheet edge/corner." Style="{StaticResource HintText}" Margin="12,0,12,4"/>
                                </StackPanel>
                            </Expander>

                            <!-- V026 NEW: Priority Groups — lets the user rank
                                 ViewTypes (e.g. Sections before Drafting Views) so
                                 SheetOrderPackingService places every view of the
                                 1st-ranked group before any view of the 2nd-ranked
                                 group, and so on. List is rebuilt from whatever
                                 ViewTypes are actually on the loaded sheet
                                 (SheetAutoRearrangeViewModel.RebuildPriorityGroups);
                                 rows are reordered with the ▲/▼ buttons. -->
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsPriorityGroupsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Text="Priority Groups" Style="{StaticResource ExpanderTitleText}"/>
                                </Expander.Header>

                                <StackPanel Margin="0,0,0,10">
                                    <CheckBox Content="Enable Priority Groups" IsChecked="{Binding EnablePriorityGroups}" Margin="12,8,12,4"/>
                                    <TextBlock Text="When on, every view of the 1st group below is placed before any view of the 2nd group, and so on. Reorder with the arrows — a view type not listed here places last, in its original grid order."
                                               Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="12,0,12,6"/>

                                    <ListBox shell:ShellBehaviors.MaxHeightRatio="0.25" shell:ShellBehaviors.ForwardMouseWheel="True" ItemsSource="{Binding PriorityGroups}"
                                             AlternationCount="{Binding PriorityGroups.Count}"
                                             IsEnabled="{Binding EnablePriorityGroups}"
                                             BorderThickness="1" BorderBrush="{StaticResource BrushBorderDefault}"
                                             Margin="12,0,12,8" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                               Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), StringFormat={}{0}.}"/>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding DisplayName}"/>
                                                    <Button Grid.Column="2" Content="▲" Padding="6,1" Margin="2,0" Style="{StaticResource SmallSecondaryButton}"
                                                            Command="{Binding DataContext.MovePriorityGroupUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="3" Content="▼" Padding="6,1" Style="{StaticResource SmallSecondaryButton}"
                                                            Command="{Binding DataContext.MovePriorityGroupDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>

                            <!-- V014: Row Fill Strategy — replaces the removed Tall
                                 View Detection / Wide View Detection expanders. See
                                 MasterRowBandPackingService for the algorithm.
                                 V022 CHANGE: expanded from a flat 3-way segmented
                                 picker to 7 strategies in two labeled groups (3
                                 existing band-based + 4 new non-banded) — 7 buttons
                                 no longer fit the old single-row 118px-wide layout.
                                 See FreeRectPackingService / RafisAlgoPackingService
                                 for the 4 new algorithms. -->
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsRowFillStrategyExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Row Fill Strategy" Style="{StaticResource ExpanderTitleText}"/>
                                        <Border Grid.Column="1" Style="{StaticResource ExpanderHeaderBadge}">
                                            <TextBlock Text="{Binding RowFillStrategy}" Style="{StaticResource ExpanderHeaderBadgeText}"/>
                                        </Border>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="0,0,0,10">

                                    <TextBlock Text="EXISTING (BAND-BASED)" Style="{StaticResource HintText}"
                                               FontWeight="Bold" FontSize="10" Margin="12,8,12,4"/>

                                    <!-- 3-way segmented picker — unchanged from V021 -->
                                    <UniformGrid Columns="3" Margin="12,0,12,4">
                                        <Button x:Name="ShelfStrategyBtn" Tag="Shelf" Click="StrategyButton_Click"
                                                      Style="{StaticResource StrategySegmentButton}"
                                                      Height="46" Margin="0,0,4,0">
                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Background">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="ShelfStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Background>
                                            <Button.BorderBrush>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Border">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="ShelfStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.BorderBrush>
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Foreground">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="ShelfStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Foreground>
                                            <StackPanel>
                                                <TextBlock Text="Shelf" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Band-grouped, simplest" FontSize="8.3" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="GuillotineStrategyBtn" Tag="Guillotine" Click="StrategyButton_Click"
                                                      Style="{StaticResource StrategySegmentButton}"
                                                      Height="46" Margin="0,0,4,0">
                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Background">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="GuillotineStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Background>
                                            <Button.BorderBrush>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Border">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="GuillotineStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.BorderBrush>
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Foreground">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="GuillotineStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Foreground>
                                            <StackPanel>
                                                <TextBlock Text="Guillotine" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="2-way split, balanced" FontSize="8.3" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="MaxRectsStrategyBtn" Tag="MaxRects" Click="StrategyButton_Click"
                                                      Style="{StaticResource StrategySegmentButton}"
                                                      Height="46">
                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Background">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="MaxRectsStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Background>
                                            <Button.BorderBrush>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Border">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="MaxRectsStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.BorderBrush>
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Foreground">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="MaxRectsStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Foreground>
                                            <StackPanel>
                                                <TextBlock Text="MaxRects" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="4-way split, densest" FontSize="8.3" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <TextBlock Text="NEW (FREE PACKING — NO BANDING)" Style="{StaticResource HintText}"
                                               FontWeight="Bold" FontSize="10" Margin="12,10,12,4"/>

                                    <!-- V022 NEW: 4-way segmented picker for the non-banded strategies -->
                                    <UniformGrid Columns="4" Margin="12,0,12,4">
                                        <Button x:Name="MaxFillStrategyBtn" Tag="MaxFill" Click="StrategyButton_Click"
                                                      Style="{StaticResource StrategySegmentButton}"
                                                      Height="46" Margin="0,0,4,0">
                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Background">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="MaxFillStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Background>
                                            <Button.BorderBrush>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Border">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="MaxFillStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.BorderBrush>
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Foreground">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="MaxFillStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Foreground>
                                            <StackPanel>
                                                <TextBlock Text="Max Fill" FontSize="10.3" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="2D bin pack, smallest-first" FontSize="7.6" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RafisAlgoStrategyBtn" Tag="RafisAlgo" Click="StrategyButton_Click"
                                                      Style="{StaticResource StrategySegmentButton}"
                                                      Height="46" Margin="0,0,4,0">
                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Background">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="RafisAlgoStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Background>
                                            <Button.BorderBrush>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Border">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="RafisAlgoStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.BorderBrush>
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Foreground">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="RafisAlgoStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Foreground>
                                            <StackPanel>
                                                <TextBlock Text="Rafi's Algo" FontSize="10.3" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Row-exhaustion free pack" FontSize="7.6" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SkylineStrategyBtn" Tag="Skyline" Click="StrategyButton_Click"
                                                      Style="{StaticResource StrategySegmentButton}"
                                                      Height="46" Margin="0,0,4,0">
                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Background">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="SkylineStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Background>
                                            <Button.BorderBrush>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Border">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="SkylineStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.BorderBrush>
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Foreground">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="SkylineStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Foreground>
                                            <StackPanel>
                                                <TextBlock Text="Skyline" FontSize="10.3" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Height-profile, fast" FontSize="7.6" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SkylineWasteMapStrategyBtn" Tag="SkylineWasteMap" Click="StrategyButton_Click"
                                                      Style="{StaticResource StrategySegmentButton}"
                                                      Height="46">
                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Background">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="SkylineWasteMapStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Background>
                                            <Button.BorderBrush>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Border">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="SkylineWasteMapStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.BorderBrush>
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StrategySelectedBrushConverter}" ConverterParameter="Foreground">
                                                    <Binding Path="RowFillStrategy"/>
                                                    <Binding ElementName="SkylineWasteMapStrategyBtn" Path="Tag"/>
                                                </MultiBinding>
                                            </Button.Foreground>
                                            <StackPanel>
                                                <TextBlock Text="Skyline+Waste" FontSize="10.3" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Skyline + gap reuse" FontSize="7.6" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <!-- V022 NEW: Max Fill info note (new default) -->
                                    <Border Background="{StaticResource BrushStatusInfoSoft}" BorderBrush="{StaticResource BrushStatusInfoBorder}" BorderThickness="1" CornerRadius="6" Margin="12,8,12,4" Padding="8,6">
                                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource BrushNavyPrimary}">
                                            <Run FontWeight="SemiBold" Text="Max Fill: "/>
                                            <Run Text="ignores Master Row/Band scaffolding — items sorted smallest-area-first, packed into free rectangles via Best-Short-Side-Fit (ties broken by max resulting free area). New default strategy."/>
                                        </TextBlock>
                                    </Border>

                                    <Border Background="{StaticResource BrushStatusWarnSoft}" BorderBrush="{StaticResource BrushStatusWarnBorder}" BorderThickness="1" CornerRadius="6" Margin="12,4,12,4" Padding="8,6">
                                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource BrushStatusWarn}">
                                            <Run FontWeight="SemiBold" Text="Note (Shelf / Guillotine / MaxRects only): "/>
                                            <Run Text="Master Row height is set by the tallest item still unplaced anywhere in the list, not just the tallest item in the current row. With a few unusually tall items in an otherwise short dataset, several rows in a row can end up using that same tall row-height before those items are finally placed. Ported here exactly as specified."/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- Expander 3: Live Sheet Preview -->
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsLiveSheetPreviewExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Text="Live Sheet Preview" Style="{StaticResource ExpanderTitleText}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,0,0,10">
                                    <Border Margin="12,4,12,4" Height="200" Background="{StaticResource BrushSurfaceWindow}"
                                            BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="6">

                                        <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
                                    </Border>
                                    <TextBlock Text="Preview updates on algorithm / alignment / gap change."
                                               Style="{StaticResource HintText}" Margin="12,0,12,0"/>
                                </StackPanel>
                            </Expander>

                            <!-- Expander 4: Overflow Handling -->
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsOverflowHandlingExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Overflow Handling" Style="{StaticResource ExpanderTitleText}"/>
                                        <Border Grid.Column="1" Style="{StaticResource ExpanderHeaderBadge}">
                                            <TextBlock Text="{Binding OverflowHandlingMode}" Style="{StaticResource ExpanderHeaderBadgeText}"/>
                                        </Border>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="0,0,0,10">
                                    <RadioButton x:Name="OverflowForceFitRadio" GroupName="Overflow" Margin="12,4,12,2"
                                                 Checked="OverflowRadio_Checked" Tag="ForceFit">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Force-Fit Anyway" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Not yet implemented in V006 — logs a warning and falls back to Place What's Placeable."
                                                       Style="{StaticResource HintText}" MaxWidth="300"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="OverflowAutoSheetRadio" GroupName="Overflow" Margin="12,6,12,2"
                                                 Checked="OverflowRadio_Checked" Tag="AutoOverflowSheet">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Auto-Create Overflow Sheet" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Not yet implemented in V006 — logs a warning and falls back to Place What's Placeable."
                                                       Style="{StaticResource HintText}" MaxWidth="300"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="OverflowPlaceablePlaceableRadio" GroupName="Overflow" Margin="12,6,12,2" IsChecked="True"
                                                 Checked="OverflowRadio_Checked" Tag="PlaceWhatsPlaceable">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Place What's Placeable" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Views that don't fit are placed just below the sheet, continuing the layout; they stay ticked but flagged Failed."
                                                       Style="{StaticResource HintText}" MaxWidth="300"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <!-- Expander 5: Gap & Margin Settings -->
                            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsGapMarginExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Text="Gap &amp; Margin Settings" Style="{StaticResource ExpanderTitleText}"/>
                                </Expander.Header>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Titleblock margins (usable area offset):" Style="{StaticResource HintText}" Margin="12,2,12,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,2,12,2">
                                        <TextBlock Text="Top" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                 Text="{Binding GapSettings.MarginTopMm}" Margin="0,0,16,0"/>
                                        <TextBlock Text="Bottom" Width="56" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                 Text="{Binding GapSettings.MarginBottomMm}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="12,2,12,2">
                                        <TextBlock Text="Left" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                 Text="{Binding GapSettings.MarginLeftMm}" Margin="0,0,16,0"/>
                                        <TextBlock Text="Right" Width="56" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                 Text="{Binding GapSettings.MarginRightMm}"/>
                                    </StackPanel>

                                    <TextBlock Text="Gap between views (global):" Style="{StaticResource HintText}" Margin="12,8,12,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,2,12,4">
                                        <TextBlock Text="H Gap" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                 Text="{Binding GapSettings.GlobalHorizontalGapMm}" Margin="0,0,16,0"/>
                                        <TextBlock Text="V Gap" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                 Text="{Binding GapSettings.GlobalVerticalGapMm}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                </Grid>

                <!-- ACTIVITY LOG + saved-log path (moved from footer) -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ListBox shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True" Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Log}" MinHeight="110"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushLogText}">
                                        <Run Text="{Binding Time, StringFormat='HH:mm:ss  ', Mode=OneWay}" Foreground="{StaticResource BrushLogTextDim}"/>
                                        <Run Text="{Binding Level, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                        <Run Text="{Binding Message, Mode=OneWay, StringFormat='  {0}'}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <!-- V008 NEW: copiable log file path, shown once a log has been saved (auto-save or manual export) -->
                <StackPanel Margin="0,4,0,0" Visibility="{Binding LastLogFilePath, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="Log saved to:" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding LastLogFilePath, Mode=OneWay}" IsReadOnly="True"
                             FontSize="10.5" Background="{StaticResource BrushSystemSecondaryBackground}"
                             BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                             Padding="6,4" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Export Log" Style="{StaticResource OutlineButton}" Command="{Binding ExportLogCommand}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Run" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
