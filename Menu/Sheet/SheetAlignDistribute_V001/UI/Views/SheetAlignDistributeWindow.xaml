<!--
=======================================================
File: SheetAlignDistributeWindow.xaml  (Sheet Align & Distribute V001)
ToolWindowShell layout:
  HEADER  metric cards (elements / grid / to move / in place / over the limit / largest move)
  BODY    left:  margins, per-view clearance, grid detection, align & distribute (with the four
                 suggested-layout buttons on top), movement limits
          right: live sheet preview and the Elements grid
          below: activity log
  FOOTER  status strip, Refresh / Copy report / Reset, Apply → Close
The preview canvas is drawn in code-behind from ViewModel.Plan.
UI preview: Claude/Previews/SheetAlignDistribute_V001_Window.html
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.SheetAlignDistribute.V001.UI.Views.SheetAlignDistributeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Revit26_Plugin_Revised.Shared.Services"
        xmlns:models="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        xmlns:local="clr-namespace:Revit26_Plugin_Revised.SheetAlignDistribute.V001.UI.Converters"
        xmlns:shell="clr-namespace:Revit26_Plugin_Revised.Shared.Controls"
        Title="Sheet Align and Distribute"
        Height="840" Width="1120"
        MinHeight="660" MinWidth="940"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <models:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <local:IsNotNullConverter x:Key="IsNotNull"/>
            <local:AlignStatusToBrushConverter x:Key="StatusFill" Target="Background"/>
            <local:AlignStatusToBrushConverter x:Key="StatusText" Target="Foreground"/>
            <local:AlignStatusToBrushConverter x:Key="StatusEdge" Target="Border"/>

            <Style x:Key="MmBox" TargetType="TextBox" BasedOn="{StaticResource BoxedTextInput}">
                <Setter Property="Width" Value="60"/>
                <Setter Property="MaxLength" Value="7"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- One "Suggested layouts" button: a card that turns navy-edged while its combination is loaded. -->
            <Style x:Key="SuggestionCard" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushCardBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="7,6,7,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyLight}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushTileInfoBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyPrimary}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Padding" Value="6,5,6,6"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NumberCell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Sheet Align and Distribute"
                           Subtitle="Lines the views on the open sheet up on the rows and columns they are already in"
                           Version="{Binding Source={x:Static svc:ToolCatalog.SheetAlignDistribute}, Path=Version, StringFormat=v{0}}"
                           IsRunning="{Binding IsBusy}"
                           IsIndeterminate="True"
                           SummaryText="{Binding StatusText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Elements" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementCount}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="on this sheet" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Grid" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding GridText}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="rows x columns" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="To move" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MoveCount}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="elements" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="In place" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding InPlaceCount}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="already on the line" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Over the limit" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding OverLimitCount}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="left alone" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="10" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Largest move" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LargestMoveText}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="of this plan" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="376"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── LEFT: settings ──────────────────────────── -->
                <StackPanel Grid.Row="0" Grid.Column="0">

                    <!-- Sheet -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Sheet" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding SheetLabel}" Style="{StaticResource FieldValue}"
                                       Margin="12,0,12,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SheetLabel}"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,2,12,10"
                                       Text="Only this sheet is read, and only its own views and schedules are ever moved."/>
                        </StackPanel>
                    </Border>

                    <!-- Margins -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="Usable area and margins" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource BadgePill}" Margin="0,10,12,5" VerticalAlignment="Center"
                                        ToolTip="Detected margins are measured off this sheet. Type in a box and they become yours; Re-detect hands them back to the sheet.">
                                    <TextBlock Text="{Binding MarginSourceText}" Style="{StaticResource BadgeText}"/>
                                </Border>
                            </StackPanel>
                            <Grid Margin="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Top" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MarginTopMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Bottom" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Style="{StaticResource MmBox}" Text="{Binding MarginBottomMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="mm" Style="{StaticResource UnitLabel}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Left" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MarginLeftMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Right" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="5" Style="{StaticResource MmBox}" Text="{Binding MarginRightMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="2" Grid.Column="6" Text="mm" Style="{StaticResource UnitLabel}"/>
                            </Grid>

                            <TextBlock Text="{Binding DetectedText}" Style="{StaticResource HintText}" Margin="12,4,12,0"/>
                            <Button Content="Re-detect from this sheet" Style="{StaticResource SmallSecondaryButton}"
                                    HorizontalAlignment="Left" Margin="12,6,12,0"
                                    Command="{Binding RedetectMarginsCommand}"
                                    ToolTip="Measure the margins and gaps off the sheet again and use them."/>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,4,12,10"
                                       Text="Detected margins are the gap between the title block edge and the outermost view on each side, as the sheet stands now — so aligning keeps the margins you already drew."/>
                        </StackPanel>
                    </Border>

                    <!-- Per-view clearance -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Per-view margin" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding PadTargetName}" Style="{StaticResource FieldValue}"
                                       Margin="12,0,12,4" TextWrapping="Wrap"/>
                            <Grid Margin="12,0,12,4" IsEnabled="{Binding HasPadTarget}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Top" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding PadTopMm, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Bottom" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Style="{StaticResource MmBox}" Text="{Binding PadBottomMm, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="mm" Style="{StaticResource UnitLabel}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Left" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding PadLeftMm, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Right" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="5" Style="{StaticResource MmBox}" Text="{Binding PadRightMm, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                                <TextBlock Grid.Row="2" Grid.Column="6" Text="mm" Style="{StaticResource UnitLabel}"/>
                            </Grid>

                            <TextBlock Text="{Binding PadDetectedText}" Style="{StaticResource HintText}" Margin="12,4,12,0"/>
                            <WrapPanel Margin="12,6,12,0" IsEnabled="{Binding HasPadTarget}">
                                <Button Content="Re-detect" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,4"
                                        Command="{Binding RedetectPadCommand}"
                                        ToolTip="Fill these boxes with what this view currently has clear on each side."/>
                                <Button Content="Clear" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,4"
                                        Command="{Binding ClearPadCommand}"
                                        ToolTip="Use the sheet gap for this view again."/>
                                <Button Content="Apply to all ticked" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,0,4"
                                        Command="{Binding ApplyPadToTickedCommand}"
                                        ToolTip="Give every ticked view the clearance now in these boxes."/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,2,12,10"
                                       Text="Pick a view in the grid to give it its own clearance. It is added to the minimum gap around that view, so a crowded detail keeps its breathing room when a row is evened out. Empty means the sheet gap."/>
                        </StackPanel>
                    </Border>

                    <!-- Grid detection -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Current grid" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Row tolerance" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding RowToleranceMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="2" Text="Column tolerance" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding ColumnToleranceMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding FootprintIncludesTitle}"/>
                                <TextBlock Text="Count the view title in the footprint" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding IncludeSchedules}"/>
                                <TextBlock Text="Include schedules on the sheet" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,10"
                                       Text="Views share a row when their footprints overlap vertically, or when any of their edges are within the row tolerance. Columns are the mirror. Plans, sections, details, drafting views and legends are all viewports and always included."/>
                        </StackPanel>
                    </Border>

                    <!-- Align and distribute -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Align and distribute" Style="{StaticResource SectionTitle}"/>

                            <!-- Suggested layouts (1.1.0): the best four combinations for this sheet. A click
                                 loads one into the dropdowns below; nothing moves until Apply. -->
                            <DockPanel Margin="12,0,12,4">
                                <TextBlock DockPanel.Dock="Right" Text="Click one, then Apply" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Suggested layouts" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Suggestions}" Margin="12,0,6,0"
                                          Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SuggestionCard}" Margin="0,0,6,6"
                                                ToolTip="{Binding ToolTipText}"
                                                AutomationProperties.Name="{Binding Title}"
                                                Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource BrushNavyPrimary}">
                                                        <TextBlock Text="{Binding RankText}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTextOnDark}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Margin="6,0,0,0" Padding="7,0" CornerRadius="8" HorizontalAlignment="Left"
                                                            Background="{StaticResource BrushTileSuccessBackground}"
                                                            BorderBrush="{StaticResource BrushTileSuccessBorder}" BorderThickness="1"
                                                            Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Best fit" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTileSuccessText}"/>
                                                    </Border>
                                                </DockPanel>
                                                <Border BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="1" CornerRadius="3"
                                                        Background="{StaticResource BrushSystemBackground}" HorizontalAlignment="Left" Margin="0,0,0,5">
                                                    <ItemsControl ItemsSource="{Binding Sketch}" Width="140" Height="54" IsHitTestVisible="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Rectangle Width="{Binding Width}" Height="{Binding Height}" StrokeThickness="1"
                                                                           Fill="{Binding Status, Converter={StaticResource StatusFill}}"
                                                                           Stroke="{Binding Status, Converter={StaticResource StatusEdge}}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding MovesText}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding InPlaceText}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding OverflowText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{StaticResource BrushStatusWarn}"
                                                           Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding FootText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Foreground="{StaticResource BrushTextTertiary}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,8" Text="{Binding SuggestionSummary}"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,8"
                                       Text="A suggestion with overflowing views (over the move limit or across the margins) can still be picked: Apply asks whether to place them anyway, place only the safe ones, or cancel."/>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <TextBlock Text="Align rows" Style="{StaticResource FieldLabel}" Margin="12,8,12,2"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Margin="12,0,12,6"
                                      ItemsSource="{Binding RowAlignOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding AlignRows}"/>

                            <TextBlock Text="Align columns" Style="{StaticResource FieldLabel}" Margin="12,0,12,2"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Margin="12,0,12,6"
                                      ItemsSource="{Binding ColumnAlignOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding AlignColumns}"/>

                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,6"
                                       Text="The shared line is the median of that row's or column's current edges, clamped inside the margins — the median so one badly placed view cannot drag the whole row with it."/>

                            <Border Style="{StaticResource SeparatorLine}"/>

                            <TextBlock Text="Distribute across a row" Style="{StaticResource FieldLabel}" Margin="12,8,12,2"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Margin="12,0,12,6"
                                      ItemsSource="{Binding DistributeOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding DistributeHorizontal}"/>

                            <TextBlock Text="Distribute down the sheet" Style="{StaticResource FieldLabel}" Margin="12,0,12,2"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Margin="12,0,12,6"
                                      ItemsSource="{Binding DistributeOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding DistributeVertical}"/>

                            <Grid Margin="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Minimum gap, horizontal" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MinGapHorizontalMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="2" Text="Minimum gap, vertical" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MinGapVerticalMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,2,12,10"
                                       Text="Off keeps every gap as it is, which is the smallest possible change. Distribute across a row sets X, so where it runs it replaces the column alignment for that row."/>
                        </StackPanel>
                    </Border>

                    <!-- Movement limits -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Movement limits" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Snap tolerance" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding SnapToleranceMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                                <TextBlock Grid.Row="2" Text="Max move" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MmBox}" Text="{Binding MaxMoveMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding MoveOverLimitAnyway}"/>
                                <TextBlock Text="Move past the limit anyway" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding MovePinned}"/>
                                <TextBlock Text="Move pinned elements" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding KeepInsideMargins}"/>
                                <TextBlock Text="Never cross the margins" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AppleToggleRow}">
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding StopOnOverlap}"/>
                                <TextBlock Text="Stop if two elements would overlap" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,10"
                                       Text="Snap tolerance stops a pointless nudge; Max move stops a view travelling so far that it is no longer an alignment. Set Max move to 0 for no limit. Every move goes in one transaction, so it is one Undo step and nothing is applied if a check fails."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── RIGHT: preview and grid ─────────────────── -->
                <StackPanel Grid.Row="0" Grid.Column="2">

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Sheet preview" Style="{StaticResource SectionTitle}"/>
                            <Border Margin="12,0,12,6" Padding="8" CornerRadius="4"
                                    Background="{StaticResource BrushSystemSecondaryBackground}"
                                    BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1">
                                <Canvas x:Name="PreviewCanvas" Height="300" ClipToBounds="True"
                                        Background="{StaticResource BrushSurfaceCard}"/>
                            </Border>
                            <WrapPanel Margin="12,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Border Width="18" Height="11" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{StaticResource BrushStatusInfoSoft}"
                                            BorderBrush="{StaticResource BrushStatusInfo}" BorderThickness="1.4"/>
                                    <TextBlock Text="Will move" Style="{StaticResource HintText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Border Width="18" Height="11" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{StaticResource BrushStatusOkSoft}"
                                            BorderBrush="{StaticResource BrushStatusOk}" BorderThickness="1.4"/>
                                    <TextBlock Text="In place" Style="{StaticResource HintText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Border Width="18" Height="11" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{StaticResource BrushStatusWarnSoft}"
                                            BorderBrush="{StaticResource BrushStatusWarn}" BorderThickness="1.4"/>
                                    <TextBlock Text="Over the limit" Style="{StaticResource HintText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Border Width="18" Height="11" CornerRadius="2" VerticalAlignment="Center"
                                            BorderBrush="{StaticResource BrushTextTertiary}" BorderThickness="1.4"/>
                                    <TextBlock Text="Where it sits now" Style="{StaticResource HintText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="18" Height="11" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{StaticResource BrushSystemSecondaryBackground}"
                                            BorderBrush="{StaticResource BrushTextDisabled}" BorderThickness="1.4"/>
                                    <TextBlock Text="Not ticked" Style="{StaticResource HintText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,2,12,10"
                                       Text="Drawn to scale: a few millimetres of correction on an A1 sheet is a hairline, so a view that is nearly in place shows as a double outline."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="12,10,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Elements on this sheet" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Tick all" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                            Command="{Binding TickAllCommand}"/>
                                    <Button Content="Untick all" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding UntickAllCommand}"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="ElementsGrid" Style="{StaticResource StandardDataGrid}"
                                      Margin="12,0,12,4"
                                      ItemsSource="{Binding Rows}"
                                      SelectedItem="{Binding SelectedRow}"
                                      SelectionMode="Single"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      shell:ShellBehaviors.MaxHeightRatio="0.42"
                                      shell:ShellBehaviors.ForwardMouseWheel="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRow}">
                                        <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="30" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsTicked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanTick}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="Take this element out of the run."/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Detail" Binding="{Binding DetailNumber}" Width="52"/>
                                    <DataGridTextColumn Header="View name" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="78"/>
                                    <DataGridTextColumn Header="W x H" Binding="{Binding SizeText}" Width="84"
                                                        ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Row" Binding="{Binding RowLabel}" Width="40"
                                                        ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Col" Binding="{Binding ColumnLabel}" Width="40"
                                                        ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Pad" Binding="{Binding PadLabel}" Width="54"
                                                        ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="dX" Binding="{Binding DeltaXLabel}" Width="46"
                                                        ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="dY" Binding="{Binding DeltaYLabel}" Width="46"
                                                        ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Move" Binding="{Binding DistanceLabel}" Width="50"
                                                        ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTemplateColumn Header="Status" Width="150" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="9" Padding="7,1" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" BorderThickness="1"
                                                        Background="{Binding Status, Converter={StaticResource StatusFill}}"
                                                        BorderBrush="{Binding Status, Converter={StaticResource StatusEdge}}">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusText}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,0,12,10"
                                       Text="dX and dY are in sheet millimetres, Y positive up. Click a row to set that view's own clearance on the left."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Log ─────────────────────────────────────── -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionCard}"
                        Background="{StaticResource BrushLogBg}" BorderThickness="0">
                    <Grid Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity log" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy all" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                        Command="{Binding CopyAllLogCommand}"/>
                                <Button Content="Copy selected" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                        Click="CopySelectedLogs_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0"
                                 MinHeight="86" Padding="0"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Re-read the sheet after changing it in Revit."/>
                    <Button Content="Copy report" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding CopyReportCommand}"
                            ToolTip="Copy the whole plan to the clipboard as a table."/>
                    <Button Content="Reset to defaults" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetToDefaultsCommand}"
                            ToolTip="Put every setting back and measure this sheet's margins again."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding ApplyCaption}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding ApplyCommand}"
                            ToolTip="Move the elements as shown in the preview (one Undo step)."/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
