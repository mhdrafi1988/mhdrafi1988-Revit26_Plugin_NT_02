<!--
=======================================================
File: FloorsAndRoofFromLinkedRoomsViaPlanViewWindow.xaml
Changes vs V004 (layout only, per Revit_Plugin_UI_Standard.md):
  - Fixed 900 x 760 window (was 420 wide, SizeToContent), Min = default.
  - Three zones: fixed top (title bar + version pill, metrics card with
    rooms found / processed / total), middle (left: linked file, floor type,
    roof type; right: room list that fills the height and scrolls itself),
    fixed footer (progress, summaries, always-visible log with Copy All /
    Copy Selected, Cancel on the left, Create Floors / Create Roof → Close).
  - Close moved from the title bar to the footer.
  - No behaviour change — every binding/command is the V004 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.FloorsAndRoofFromLinkedRoomsViaPlanView.V005.FloorsFromLinkedRoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="Floors and Roofs From Linked Rooms — V005"
        Width="900" Height="760"
        MinWidth="900" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:IntToVisibilityConverter  x:Key="IntToVisibilityConverter"/>
            <converters:LogLevelToColorConverter  x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════ TOP ══════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Floors and Roofs From Linked Rooms" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Create floors from linked room boundaries" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V005" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="12,12,12,0">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Rooms Found" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Rooms.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Processed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ProcessedCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Total To Process" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ══════════════ MIDDLE ══════════════ -->
        <Grid Grid.Row="1" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Loading linked files and floor types…" Style="{StaticResource HintText}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,0,0,8"/>
                    <!-- Linked file -->
                    <Border Style="{StaticResource SectionCard}" Padding="8,10">
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Linked file" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LinkedDocuments}"
                                      SelectedItem="{Binding SelectedLinkedDocument}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource StandardComboBox}"/>

                            <TextBlock Text="Link instance" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"
                                       Visibility="{Binding AvailableInstances.Count, Converter={StaticResource IntToVisibilityConverter}}"/>
                            <ComboBox ItemsSource="{Binding AvailableInstances}"
                                      SelectedItem="{Binding SelectedInstance}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource StandardComboBox}"/>
                        </StackPanel>
                    </Border>
                    <!-- Floor type + Create floors -->
                    <Border Style="{StaticResource SectionCard}" Padding="8,10">
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Floor type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding FloorTypes}"
                                      SelectedItem="{Binding SelectedFloorType}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource StandardComboBox}"/>
                        </StackPanel>
                    </Border>
                    <!-- Roof type + Create roof -->
                    <Border Style="{StaticResource SectionCard}" Padding="8,10">
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Roof type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding RoofTypes}"
                                      SelectedItem="{Binding SelectedRoofType}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource StandardComboBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Rooms -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="8,10" Margin="0">
                <Grid Margin="4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Rooms at this level ("/>
                        <Run Text="{Binding Rooms.Count, Mode=OneWay}"/>
                        <Run Text=" found)"/>
                    </TextBlock>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Rooms}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource FieldValue}"
                                               FontSize="11.5" Margin="6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Margin="0" VerticalAlignment="Center">
                                        <Run Text="{Binding AreaDisplay, StringFormat={}{0:0.0}}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding AreaUnitSymbol}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Select all" Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"/>
                        <Button Content="Deselect all" Command="{Binding DeselectAllCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ FOOTER ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel>
                <ProgressBar Height="6" Margin="0,0,0,2" IsIndeterminate="False"
                             Minimum="0" Maximum="{Binding TotalCount}" Value="{Binding ProcessedCount, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource HintText}" Margin="0,0,0,8"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding FloorSummaryText}" Style="{StaticResource HintText}"
                               Visibility="{Binding HasFloorSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Grid.Column="1" Content="Copy floor summary" Command="{Binding CopyFloorSummaryCommand}"
                            Style="{StaticResource SmallSecondaryButton}"
                            Visibility="{Binding HasFloorSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding RoofSummaryText}" Style="{StaticResource HintText}"
                               Visibility="{Binding HasRoofSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Grid.Column="1" Content="Copy roof summary" Command="{Binding CopyRoofSummaryCommand}"
                            Style="{StaticResource SmallSecondaryButton}"
                            Visibility="{Binding HasRoofSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <TextBlock Text="{Binding ToastMessage}" Style="{StaticResource HintText}" Margin="0,0,0,8"
                           Foreground="{StaticResource BrushSuccess}"
                           Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <!-- Log panel -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" Grid.Column="0" VerticalAlignment="Center" ToolTip="Show / hide the log">
                                <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Command="{Binding CopyAllLogsCommand}"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                                <Button x:Name="CopySelectedButton" Content="Copy Selected" Click="CopySelected_Click"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                                <Button Content="Export" Command="{Binding ExportLogsCommand}"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                                <Button Content="Clear" Command="{Binding ClearLogsCommand}"
                                        Style="{StaticResource DarkGhostButton}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" x:Name="LogListBox" ItemsSource="{Binding Logs}" Height="110" Margin="0,6,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionMode="Extended"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="10" IsHitTestVisible="True">
                                        <Run Text="{Binding Time, StringFormat=HH:mm:ss}" Foreground="{StaticResource BrushLogTextDim}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Message}" Foreground="{StaticResource BrushLogText}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Button Content="Cancel" Command="{Binding CancelCommand}"
                                Style="{StaticResource OutlineButton}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Create Floors" Command="{Binding RunFloorCommand}"
                                Style="{StaticResource RunButton}" Margin="0,0,8,0"/>
                        <Button Content="Create Roof" Command="{Binding RunRoofCommand}"
                                Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                        <Button Content="Close" Click="Close_Click" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
