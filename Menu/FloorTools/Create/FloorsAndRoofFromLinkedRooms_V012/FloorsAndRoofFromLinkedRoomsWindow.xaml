<!--
=======================================================
File: FloorsAndRoofFromLinkedRoomsWindow.xaml
Changes vs V011 (layout only, per Revit_Plugin_UI_Standard.md):
  - Header badge now shows the real version (V012; V011 still said V010);
    Close moved from the title bar to the footer.
  - Log moved from under the grid into the fixed footer (always visible,
    Copy All / Copy Selected), with progress and floor/roof summaries.
  - Create Floors / Create Roof moved from the Creation card to the footer
    (Cancel Run on the left, Create Floors / Create Roof → Close on the right);
    the right options pane now scrolls on its own.
  - No behaviour change — every binding/command is the V011 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.FloorsAndRoofFromLinkedRooms.V012.FloorsFromLinkedRoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="Floors and Roofs From Linked Rooms — V012"
        Width="1180" Height="760" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Assembly-relative pack URI (no Application object in Revit
                     add-ins — that would crash at load), per suite convention. -->
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:IntToVisibilityConverter         x:Key="IntToVisibilityConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>

            <!-- V006: IsTextSearchEnabled is OFF — the jump-to-match behavior would fight
                 the live substring filter implemented in code-behind
                 (NewLevelCombo_TextChanged). Styling derives from SharedStyles only
                 (DATAGRID SPEC item 7). -->
            <Style x:Key="NewLevelComboStyle" TargetType="ComboBox" BasedOn="{StaticResource StandardComboBox}">
                <Setter Property="IsEditable" Value="True"/>
                <Setter Property="StaysOpenOnEdit" Value="True"/>
                <Setter Property="IsTextSearchEnabled" Value="False"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Padding" Value="6,2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top: header -->
            <RowDefinition Height="Auto"/>  <!-- Fixed top: metrics -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Floors and Roofs From Linked Rooms" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Create floors and roofs from linked room boundaries — advanced level mapping" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource BadgePill}" VerticalAlignment="Center">
                    <TextBlock Text="V012" Style="{StaticResource BadgeText}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Metrics card — left group = live grid stats (always visible, updates
             as rooms load / selection changes / New Level mapping changes). Right group
             = last-run results (populated after Create Floors/Create Roof; hidden via
             opacity until a run has completed, per mockup). -->
        <Border Grid.Row="1" Style="{StaticResource BaseCard}" Margin="10,10,10,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Live grid stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="{Binding MetricTotalRooms}" Style="{StaticResource MetricNumber}"/>
                        <TextBlock Text="TOTAL ROOMS" Style="{StaticResource MetricLabel}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="{Binding MetricSelectedCount}" Style="{StaticResource MetricNumberAccent}"/>
                        <TextBlock Text="SELECTED" Style="{StaticResource MetricLabel}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="{Binding MetricMappedCount}" Style="{StaticResource MetricNumberSuccess}"/>
                        <TextBlock Text="MAPPED" Style="{StaticResource MetricLabel}" Margin="0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding MetricUnmappedCount}" Style="{StaticResource MetricNumberDanger}"/>
                        <TextBlock Text="UNMAPPED" Style="{StaticResource MetricLabel}" Margin="0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{StaticResource BrushSeparatorThin}" Margin="18,0"/>

                <!-- Last-run results — collapsed to a hint line until HasLastRun is true -->
                <Grid Grid.Column="2">
                    <TextBlock Text="No run yet this session." Style="{StaticResource HintText}"
                               Margin="0" VerticalAlignment="Center"
                               Visibility="{Binding HasLastRun, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding MetricCreatedCount}" Style="{StaticResource MetricNumberSuccess}"/>
                            <TextBlock Text="CREATED" Style="{StaticResource MetricLabel}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding MetricSkippedCount}" Style="{StaticResource MetricNumberWarning}"/>
                            <TextBlock Text="SKIPPED" Style="{StaticResource MetricLabel}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding MetricFailedCount}" Style="{StaticResource MetricNumberDanger}"/>
                            <TextBlock Text="FAILED" Style="{StaticResource MetricLabel}" Margin="0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding MetricLastRunLabel}" Style="{StaticResource FieldValue}" FontSize="12.5"/>
                            <TextBlock Text="LAST RUN" Style="{StaticResource MetricLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Body: grid (left) + primary controls (right pane) -->
        <Grid Grid.Row="2" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DataGrid area -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: filter + Select All/Clear/Refresh (DATAGRID SPEC item 1) -->
                <Border Grid.Row="0" Style="{StaticResource BaseCard}" CornerRadius="10,10,0,0"
                        BorderThickness="1,1,1,0" Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource StyledTextInput}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Select All" Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                        <Button Grid.Column="2" Content="Clear" Command="{Binding DeselectAllCommand}"
                                Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                        <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SmallSecondaryButton}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource HintText}" Margin="0" VerticalAlignment="Center">
                            <Run Text="{Binding FilteredRooms.Count, Mode=OneWay}"/>
                            <Run Text=" rooms"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- DataGrid (DATAGRID SPEC items 2-6). Rounded bottom corners come from
                     the wrapping Border (DataGrid has no CornerRadius). -->
                <Border Grid.Row="1" CornerRadius="0,0,10,10" BorderThickness="1"
                        BorderBrush="{StaticResource BrushCardBorder}" ClipToBounds="True">
                    <DataGrid Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                              CellStyle="{StaticResource StandardDataGridCell}"
                              RowStyle="{StaticResource StandardDataGridRow}"
                              ItemsSource="{Binding FilteredRooms}"
                              SelectedItem="{Binding SelectedRoom}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              BorderThickness="0">
                    <DataGrid.Columns>

                        <!-- Serial number -->
                        <DataGridTextColumn Header="#" Binding="{Binding SerialNumber}"
                                            Width="40" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Checkbox: centered, TwoWay, PreviewMouseLeftButtonDown blocks row-select
                             cascade (DATAGRID SPEC item 2) -->
                        <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Room Name: left-align text, sortable -->
                        <DataGridTextColumn Header="Room Name" Binding="{Binding RoomName}"
                                            Width="*" MinWidth="140" IsReadOnly="True"/>

                        <!-- Room Number: right-align numeric-style, sortable -->
                        <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}"
                                            Width="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- Linked File Level: read-only, shows match state via color -->
                        <DataGridTemplateColumn Header="Linked File Level" Width="150" SortMemberPath="LinkedLevelName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                                        <Setter Property="Background" Value="#FBEAEA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LinkedLevelName}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- New Level: V006 live substring-filter dropdown. ItemsSource is
                             assigned in code-behind (NewLevelCombo_Loaded) as a per-combo
                             ListCollectionView over HostLevels, so each row filters
                             independently. SelectedItem stays TwoWay to the row VM. -->
                        <DataGridTemplateColumn Header="New Level" Width="170" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding SelectedHostLevel, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Name"
                                              Loaded="NewLevelCombo_Loaded">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource NewLevelComboStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- RIGHT: primary controls pane -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Loading linked files and levels…" Style="{StaticResource HintText}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,0,0,8"/>

                    <!-- Linked file -->
                    <Border Style="{StaticResource SectionCard}" Padding="8,10">
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Linked file" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Linked file" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LinkedDocuments}"
                                      SelectedItem="{Binding SelectedLinkedDocument}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource StandardComboBox}" Margin="0,0,0,6"/>

                            <TextBlock Text="Link instance" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"
                                       Visibility="{Binding AvailableInstances.Count, Converter={StaticResource IntToVisibilityConverter}}"/>
                            <ComboBox ItemsSource="{Binding AvailableInstances}"
                                      SelectedItem="{Binding SelectedInstance}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource StandardComboBox}"/>

                            <!-- Elevation match tolerance. Unchecked (default) = tolerance
                                 field editable, 1mm default. Checked = exact match, tolerance
                                 forced to 0 and field disabled. Both changes trigger an
                                 immediate re-match of all loaded rooms (MainViewModel). -->
                            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushSeparatorThin}"
                                    Margin="0,8,0,0" Padding="0,8,0,0">
                                <StackPanel>
                                    <CheckBox Content="Exact elevation match"
                                              IsChecked="{Binding ExactElevationMatch}"
                                              FontSize="11.5" FontWeight="SemiBold"
                                              Foreground="{StaticResource BrushTextPrimary}"
                                              Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding ToleranceMmText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BoxedTextInput}"
                                                 Width="60" Height="26" FontSize="11.5" MaxLength="10"
                                                 IsEnabled="{Binding IsToleranceEditable}"/>
                                        <TextBlock Text="mm tolerance" Style="{StaticResource UnitLabel}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                               Text="Rooms are matched to host levels by elevation (link placement offset applied). No match within tolerance leaves the room unmapped — no new levels are created."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Floor type + Create floors / Roof type + Create roof.
                         V006: explicit IsEnabled bindings removed — CanExecute on the
                         commands already disables the buttons while IsBusy (the two were
                         redundant and could fight each other). -->
                    <Border Style="{StaticResource SectionCard}" Padding="8,10">
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Creation" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Floor type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding FloorTypes}"
                                      SelectedItem="{Binding SelectedFloorType}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource StandardComboBox}" Margin="0,0,0,6"/>

                            <TextBlock Text="Roof type" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                            <ComboBox ItemsSource="{Binding RoofTypes}"
                                      SelectedItem="{Binding SelectedRoofType}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource StandardComboBox}" Margin="0,0,0,6"/>

                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="Each selected room uses its own New Level mapping from the grid as the target level for creation. Unmapped rooms are skipped."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════ FOOTER ══════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="10,10">
            <StackPanel>
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Height="6" Margin="0,0,0,4" IsIndeterminate="False"
                                 Minimum="0" Maximum="{Binding TotalCount}" Value="{Binding ProcessedCount, Mode=OneWay}"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                </StackPanel>
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FloorSummaryText}" Style="{StaticResource HintText}"
                                   Visibility="{Binding HasFloorSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyFloorSummaryCommand}"
                                Style="{StaticResource SmallSecondaryButton}"
                                Visibility="{Binding HasFloorSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RoofSummaryText}" Style="{StaticResource HintText}"
                                   Visibility="{Binding HasRoofSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyRoofSummaryCommand}"
                                Style="{StaticResource SmallSecondaryButton}"
                                Visibility="{Binding HasRoofSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>

                    <TextBlock Text="{Binding ToastMessage}" Style="{StaticResource HintText}" Margin="0,0,0,8"
                               Foreground="{StaticResource BrushSuccess}"
                               Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <!-- Log panel — always visible in the fixed footer. -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" Grid.Column="0" VerticalAlignment="Center" ToolTip="Show / hide the log">
                                <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Command="{Binding CopyAllLogsCommand}"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                                <Button x:Name="CopySelectedButton" Content="Copy Selected" Click="CopySelected_Click"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                                <Button Content="Export" Command="{Binding ExportLogsCommand}"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                                <Button Content="Clear" Command="{Binding ClearLogsCommand}"
                                        Style="{StaticResource DarkGhostButton}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" x:Name="LogListBox" ItemsSource="{Binding Logs}" Height="90" Margin="0,6,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionMode="Extended"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="9.5" IsHitTestVisible="True" TextWrapping="Wrap">
                                        <Run Text="{Binding Time, StringFormat=HH:mm:ss, Mode=OneWay}" Foreground="{StaticResource BrushLogTextDim}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Level, Mode=OneWay}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource BrushLogText}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Button Content="Cancel Run" Command="{Binding CancelCommand}"
                                Style="{StaticResource OutlineButton}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Create Floors" Command="{Binding RunFloorCommand}"
                                Style="{StaticResource RunButton}" Margin="0,0,8,0"/>
                        <Button Content="Create Roof" Command="{Binding RunRoofCommand}"
                                Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                        <Button Content="Close" Click="Close_Click" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
