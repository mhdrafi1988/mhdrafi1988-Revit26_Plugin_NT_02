<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tool-local colour tokens for the grouped settings panels.
         Move these into SharedStyles if they should be shared; keys stay the same. -->
    <SolidColorBrush x:Key="Eps2D.Group.FloorBrush" Color="#5B7083" />
    <SolidColorBrush x:Key="Eps2D.Group.BoardsBrush" Color="#2E7D5B" />
    <SolidColorBrush x:Key="Eps2D.Group.RowLayoutBrush" Color="#C26A12" />
    <SolidColorBrush x:Key="Eps2D.Group.HatchingBrush" Color="#7B4FB0" />
    <SolidColorBrush x:Key="Eps2D.Group.LayersBrush" Color="#1F6FB2" />
    <SolidColorBrush x:Key="Eps2D.Group.OutputBrush" Color="#A33B3B" />
    <SolidColorBrush x:Key="Eps2D.Group.HeaderTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Eps2D.SwatchBorderBrush" Color="#7F7F7F" />

    <SolidColorBrush x:Key="Eps2D.Group.SquareBrush" Color="#0F7C8C" />
    <SolidColorBrush x:Key="Eps2D.Group.SizesBrush" Color="#6B6B2E" />

    <!-- Collapsible settings group: open by default; click the header to fold it. -->
    <Style x:Key="Eps2D.GroupExpander" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- A settings group: coloured header strip above the card content. -->
    <Style x:Key="Eps2D.GroupHeader" TargetType="Border">
        <Setter Property="CornerRadius" Value="4,4,0,0" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style x:Key="Eps2D.GroupHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Eps2D.Group.HeaderTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Eps2D.GroupBody" TargetType="Border">
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="CornerRadius" Value="0,0,4,4" />
        <Setter Property="Padding" Value="10,8,10,6" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
</ResourceDictionary>
