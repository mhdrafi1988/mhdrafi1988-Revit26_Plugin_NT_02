<!--
=======================================================
File: DtlLineDimWindow.xaml
Changes vs V008 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three zones: fixed top (title bar + version pill, metrics card with
    detail item / dimension types found and log entries, view warning),
    scrolling middle (Selection, Dimension Settings), fixed footer
    (always-visible log with Copy All / Copy Selected / Clear, last-run
    status, Export Log on the left, Generate Dimensions → Close).
  - "✕ Close" moved from the title bar to the footer; the warning banner's
    inline colours replaced with SharedStyles brushes.
  - No behaviour change — every binding/command is the V008 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin_Revised.DtlLineDim.V009.UI.Views.DtlLineDimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin_Revised.Shared.Models"
        Title="Detail Line Dimension — V009"
        Height="680" Width="560"
        MinHeight="680" MinWidth="560"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin_Revised;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════ TOP ══════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Detail Line Dimension" Style="{StaticResource HeaderTitle}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V009" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="14,12,14,0">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Detail Item Types" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DetailItemTypes.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Dimension Types" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DimensionTypes.Count}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Log Entries" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding LogEntries.Count}" Style="{StaticResource MetricNumberAccent}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <!-- View validation warning -->
            <Border Background="{StaticResource BrushInputBackground}" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="14,10,14,0"
                    Visibility="{Binding IsViewValid, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ViewValidationMessage, StringFormat='⚠ {0}'}"
                           FontSize="11.5" Foreground="{StaticResource BrushWarning}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- ══════════════ MIDDLE ══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10,14,8">
            <StackPanel>
                <!-- Selection card -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Selection" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="Detail Item Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding DetailItemTypes}"
                                      SelectedItem="{Binding SelectedDetailItemType}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldRow}" Margin="12,4,12,10">
                            <TextBlock Text="Dimension Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding DimensionTypes}"
                                      SelectedItem="{Binding SelectedDimensionType}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Settings card -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Dimension Settings" Style="{StaticResource SectionTitle}"/>

                        <Grid Margin="12,4,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tick Size" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource BoxedTextInput}"
                                             Text="{Binding TickSizeText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10" FontSize="10"
                                             Padding="4,2"
                                             HorizontalContentAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="mm" Style="{StaticResource UnitLabel}"/>
                                </Grid>
                                <TextBlock Text="Default 50mm — blank/invalid falls back automatically."
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Offset" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource BoxedTextInput}"
                                             Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10" FontSize="10"
                                             Padding="4,2"
                                             HorizontalContentAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="mm" Style="{StaticResource UnitLabel}"/>
                                </Grid>
                                <TextBlock Text="Default 300mm — blank/invalid falls back automatically."
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════ FOOTER ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel>
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                                <TextBlock Text="Activity Log" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}"/>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding CopyAllLogsCommand}"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Click="CopySelectedLog_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ClearLogsCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 Height="110" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <!-- Status bar -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Last run:" Style="{StaticResource StatusText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding RunSummary}" Style="{StaticResource StatusText}" FontWeight="SemiBold"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Export Log (.txt)" Style="{StaticResource OutlineButton}"
                            Command="{Binding ExportLogsCommand}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Generate Dimensions" Style="{StaticResource RunButton}" Margin="0,0,8,0"
                                Command="{Binding GenerateDimensionsCommand}"/>
                        <Button Content="Close" Style="{StaticResource SecondaryButton}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
